    kbr:hasSourceQuote "Pengakuan utang Retribusi secara langsung sebagaimana dimaksud pada ayat (2) huruf b merupakan Wajib Retribusi dengan kesadaran menyatakan masih mempunyai utang Retribusi dan belum melunasi kepada Pemerintah Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
