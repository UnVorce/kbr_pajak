    kbr:hasRuleId "R-PER-DJP-2025-7-2073faf507"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/85"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan secara jabatan sebagaimana dimaksud pada ayat (1) dilakukan berdasarkan hasil Pemeriksaan atau hasil penelitian administrasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
