    kbr:hasSourceLocator "PMK-2023-72#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak menggunakan masa manfaat sebagaimana dimaksud pada ayat (1) Wajib Pajak harus mengajukan permohonan kepada Direktur Jenderal Pajak untuk memperoleh penetapan kelompok masa manfaat selain sebagaimana dimaksud pada ayat (1)."^^xsd:string ;
