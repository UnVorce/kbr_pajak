kbr:Aturan_R_PP_2008_51_cdb832fb0e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2008_51 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2008_51_BT_1 ;
    kbr:hasRuleId "R-PP-2008-51-cdb832fb0e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2008-51#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "5. Pelaksanaan Konstruksi adalah pemberian jasa oleh orang pribadi atau badan yang dinyatakan ahli yang profesional di bidang pelaksanaan jasa konstruksi yang mampu menyelenggarakan kegiatannya untuk mewujudkan suatu hasil perencanaan menjadi bentuk bangunan atau bentuk fisik lain, termasuk di dalamnya pekerjaan konstruksi terintegrasi yaitu penggabungan fungsi layanan dalam model penggabungan perencanaan, pengadaan, dan pembangunan (engineering, procurement and construction) serta model penggabungan perencanaan dan pembangunan (design and build)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

kbr:Aturan_R_PP_2008_51_d6449f026c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2008_51 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2008_51_BT_1 ;
    kbr:hasRuleId "R-PP-2008-51-d6449f026c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2008-51#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "3. Pekerjaan Konstruksi adalah keseluruhan atau sebagian rangkaian kegiatan perencanaan dan/atau pelaksanaan beserta pengawasan yang mencakup pekerjaan arsitektural, sipil, mekanikal, elektrikal, dan tata lingkungan masing-masing beserta kelengkapannya untuk mewujudkan suatu bangunan atau bentuk fisik lain."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

