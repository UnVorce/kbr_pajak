    kbr:hasSourceLocator "PMK-2025-111#BT/25/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(2) Berita acara pelaksanaan permintaan penjelasan atas data dan/atau keterangan sebagaimana dimaksud pada ayat (1) ditandatangani oleh Wajib Pajak dan Account Representative dan/atau pegawai Direktorat Jenderal Pajak yang ditugaskan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_111_a1696e48a7 a kbr:Prosedur ;
