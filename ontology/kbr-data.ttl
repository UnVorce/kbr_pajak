    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_94de0d1a9f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_22 ;
    kbr:hasRuleId "R-PP-2009-32-94de0d1a9f"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Tempat Penyelenggaraan Pameran Berikat dan pengusaha di Tempat Penyelenggaraan Pameran Berikat sebagaimana dimaksud pada ayat (1) dan ayat (2) harus berbadan hukum Indonesia dan berkedudukan di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_96f70fd2f9 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_30 ;
    kbr:hasRuleId "R-PP-2009-32-96f70fd2f9"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap pemasukan barang dari tempat lain dalam daerah pabean ke Toko Bebas Bea, pengusaha di tempat lain dalam daerah pabean wajib membuat faktur pajak yang dibubuhi cap Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah tidak dipungut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_9a4b546e87 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_46 ;
    kbr:hasRuleId "R-PP-2009-32-9a4b546e87"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/46"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal izin Tempat Penimbunan Berikat dicabut, penyelenggara dan/atau pengusaha Tempat Penimbunan Berikat dalam jangka waktu paling lama 30 (tiga puluh) hari sejak tanggal pencabutan izin harus: a. melunasi semua Bea Masuk dan Pajak Dalam Rangka Impor yang terutang; b. mengekspor kembali barang yang masih ada di Tempat Penimbunan Berikat; atau c. memindahkan barang yang masih ada di Tempat Penimbunan Berikat ke Tempat Penimbunan Berikat lain."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_9a5553efda a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42A_3__7 ;
    kbr:hasRuleId "R-PP-2009-32-9a5553efda"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42A/3..7"^^xsd:string ;
    kbr:hasSourceQuote "Barang asal luar daerah pabean yang dimasukkan dari tempat lain dalam daerah pabean oleh pihak yang mendapat fasilitas ke Pusat Logistik Berikat yang ditujukan untuk tujuan tertentu: a. diberikan penangguhan Bea Masuk; b. tidak dipungut Pajak Dalam Rangka Impor; c. diberikan pembebasan Cukai; dan/atau d. tidak dipungut Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_9cd1d3c6e8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_24_1__7 ;
    kbr:hasRuleId "R-PP-2009-32-9cd1d3c6e8"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/24/1..7"^^xsd:string ;
    kbr:hasSourceQuote "pengusaha Tempat Penyelenggaraan Pameran Berikat atau pengusaha di Tempat Penyelenggaraan Pameran Berikat wajib membuat faktur pajak dan atas penyerahan barang tersebut dikenakan Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_9dc73b610d a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_43 ;
    kbr:hasRuleId "R-PP-2009-32-9dc73b610d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/43"^^xsd:string ;
    kbr:hasSourceQuote "(3) Izin yang dibekukan sebagaimana dimaksud pada ayat (1) dapat diubah menjadi pencabutan dalam hal penyelenggara Tempat Penimbunan Berikat: a. terbukti telah melakukan kegiatan yang menyimpang dari izin yang diberikan; atau b. tidak mampu lagi menyelenggarakan Tempat Penimbunan Berikat tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_9fee104551 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42A_1__2 ;
    kbr:hasRuleId "R-PP-2009-32-9fee104551"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42A/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(8) Pengusaha di Pusat Logistik Berikat sebagaimana dimaksud pada ayat (5) huruf b harus berbentuk badan usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_a3685fd7dd a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_29 ;
    kbr:hasRuleId "R-PP-2009-32-a3685fd7dd"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "Toko Bebas Bea dapat berlokasi di: a. terminal keberangkatan bandar udara internasional di kawasan pabean; b. pelabuhan utama di kawasan pabean; c. tempat transit pada terminal keberangkatan bandar udara internasional yang merupakan tempat khusus bagi penumpang transit tujuan luar negeri di kawasan pabean; d. pelabuhan utama yang merupakan tempat khusus bagi penumpang transit tujuan luar negeri di kawasan pabean; e. dalam kota; atau f. terminal kedatangan bandar udara internasional di kawasan pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_a58ac7010a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_31 ;
    kbr:hasRuleId "R-PP-2009-32-a58ac7010a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "a. memiliki bukti kepemilikan atau penguasaan suatu tempat atau bangunan yang mempunyai batas-batas yang jelas berikut peta lokasi/tempat dan rencana tata letak/denah yang akan dijadikan Toko Bebas Bea; b. memiliki . . . b. memiliki Surat Izin Tempat Usaha, Dokumen Lingkungan Hidup, Surat Izin Usaha Perdagangan, dan izin lainnya yang diperlukan dari instansi teknis terkait; dan c. telah melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan telah menyampaikan Surat Pemberitahuan Tahunan Pajak Penghasilan tahun pajak terakhir bagi yang sudah wajib menyampaikan Surat Pemberitahuan Tahunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_a6d3c3979a a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_32 ;
    kbr:hasRuleId "R-PP-2009-32-a6d3c3979a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "(3) Orang yang berhak membeli barang di Toko Bebas Bea yang berlokasi di terminal kedatangan bandar udara internasional di kawasan pabean sebagaimana dimaksud dalam Pasal 29 huruf f dengan mendapatkan pembebasan Bea Masuk dan tidak dipungut Pajak Dalam Rangka Impor dengan nilai atau jumlah tertentu adalah orang yang tiba dari luar daerah pabean."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_a733b8f875 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_43 ;
    kbr:hasRuleId "R-PP-2009-32-a733b8f875"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/43"^^xsd:string ;
    kbr:hasSourceQuote "(1) Izin penyelenggaraan Tempat Penimbunan Berikat dibekukan dalam hal pihak yang melakukan penyelenggaraan: a. melakukan kegiatan yang menyimpang dari izin yang diberikan berdasarkan bukti permulaan yang cukup; atau b. menunjukkan ketidakmampuan dalam penyelenggaraan Tempat Penimbunan Berikat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_ac6054ade5 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_25 ;
    kbr:hasRuleId "R-PP-2009-32-ac6054ade5"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/25"^^xsd:string ;
    kbr:hasSourceQuote "Untuk mendapatkan penetapan dan izin sebagaimana dimaksud pada ayat (1) yang bersifat tetap, pihak yang akan menjadi penyelenggara harus memenuhi persyaratan sebagai berikut: a. memiliki bukti kepemilikan atau penguasaan suatu tempat atau bangunan yang mempunyai batas-batas yang jelas berikut peta lokasi/tempat dan rencana tata letak/denah yang akan dijadikan Tempat Penyelenggaraan Pameran Berikat; b. memiliki Surat Izin Tempat Usaha, Dokumen Lingkungan Hidup, dan izin lainnya yang diperlukan dari instansi teknis terkait; dan c. telah melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan telah menyampaikan Surat Pemberitahuan Tahunan Pajak Penghasilan tahun pajak terakhir bagi yang sudah wajib menyampaikan Surat Pemberitahuan Tahunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_adc726a412 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_38 ;
    kbr:hasRuleId "R-PP-2009-32-adc726a412"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Barang sebagaimana dimaksud pada ayat (1), ayat (2), dan ayat (4), bukan merupakan barang untuk dikonsumsi di Kawasan Daur Ulang Berikat yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_af842300dc a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_38 ;
    kbr:hasRuleId "R-PP-2009-32-af842300dc"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap pemasukan barang dari Tempat Penimbunan Berikat ke Kawasan Daur Ulang Berikat, pengusaha Tempat Penimbunan Berikat wajib membuat faktur pajak yang dibubuhi cap Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah tidak dipungut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_b1d6d2caf6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_12 ;
    kbr:hasRuleId "R-PP-2009-32-b1d6d2caf6"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Penyelenggara Kawasan Berikat sebagaimana dimaksud pada ayat (2) melakukan kegiatan menyediakan dan mengelola kawasan untuk kegiatan pengusahaan Kawasan Berikat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_b33eee1b09 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_1 ;
    kbr:hasRuleId "R-PP-2009-32-b33eee1b09"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Daerah Pabean adalah wilayah Republik Indonesia yang meliputi wilayah darat, perairan, dan ruang udara di atasnya serta tempat-tempat tertentu di Zona Ekonomi Eksklusif dan Landas Kontinen yang di dalamnya berlaku Undang-Undang tentang Kepabeanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_b586a65476 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_4 ;
    kbr:hasRuleId "R-PP-2009-32-b586a65476"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Atas penyerahan barang kena pajak sebagaimana dimaksud pada ayat (3), harus dibuatkan faktur pajak oleh pengusaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_bc627bd9f5 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_19_8__9 ;
    kbr:hasRuleId "R-PP-2009-32-bc627bd9f5"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/19/8..9"^^xsd:string ;
    kbr:hasSourceQuote "(8) Dalam hal barang sebagaimana dimaksud pada ayat (5) tidak dimasukkan kembali ke dalam Kawasan Berikat tempat pengeluaran barang, maka: a. untuk barang asal impor, pengusaha Kawasan Berikat atau pengusaha di Kawasan Berikat wajib melunasi Bea Masuk dan Pajak Dalam Rangka Impor dan dikenai sanksi sesuai dengan ketentuan peraturan perundang- undangan; dan b. atas barang yang tidak dimasukkan kembali ke dalam Kawasan Berikat tempat pengeluaran barang, pengusaha Kawasan Berikat atau pengusaha di Kawasan Berikat wajib membuat faktur pajak dan memungut Pajak Pertambahan Nilai sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_c06aa30efe a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_4 ;
    kbr:hasRuleId "R-PP-2009-32-c06aa30efe"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Pengeluaran barang asal impor dari Tempat Penimbunan Berikat ke tempat lain dalam daerah pabean sebagaimana dimaksud pada ayat (1) huruf c, berlaku ketentuan kepabeanan di bidang impor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_c084fe90f1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42A_7__1 ;
    kbr:hasRuleId "R-PP-2009-32-c084fe90f1"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42A/7..1"^^xsd:string ;
    kbr:hasSourceQuote "(7) Barang sebagaimana dimaksud pada ayat (1), ayat (2), ayat (3), atau ayat (4) asal luar daerah pabean yang dikeluarkan ke tempat lain dalam daerah pabean dengan tujuan diimpor untuk dipakai: a. dilunasi Bea Masuk; b. dipungut Pajak Dalam Rangka Impor; dan/atau c. dilunasi cukainya untuk Barang Kena Cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_c12d048f17 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_1 ;
    kbr:hasRuleId "R-PP-2009-32-c12d048f17"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Toko Bebas Bea adalah Tempat Penimbunan Berikat untuk menimbun barang asal impor dan/atau barang asal Daerah Pabean untuk dijual kepada orang tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_c2bbd1a4c2 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_1 ;
    kbr:hasRuleId "R-PP-2009-32-c2bbd1a4c2"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Tempat Lelang Berikat adalah Tempat Penimbunan Berikat untuk menimbun barang impor dalam jangka waktu tertentu untuk dijual secara lelang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_c6ac572199 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_24_1__9 ;
    kbr:hasRuleId "R-PP-2009-32-c6ac572199"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/24/1..9"^^xsd:string ;
    kbr:hasSourceQuote "(1) dan ayat (2) asal impor dikeluarkan ke tempat lain dalam daerah pabean dengan tujuan diimpor untuk dipakai, pengusaha Tempat Penyelenggaraan Pameran Berikat atau pengusaha di Tempat Penyelenggaraan Pameran Berikat, wajib melunasi Bea Masuk dan Pajak Dalam Rangka Impor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_c88376b516 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42A_3__3 ;
    kbr:hasRuleId "R-PP-2009-32-c88376b516"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42A/3..3"^^xsd:string ;
    kbr:hasSourceQuote "Barang asal tempat lain dalam daerah pabean yang ditimbun di Pusat Logistik Berikat dalam hal tertentu dapat dikeluarkan kembali ke tempat lain dalam daerah pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_c980e21038 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_22 ;
    kbr:hasRuleId "R-PP-2009-32-c980e21038"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Pengusahaan Tempat Penyelenggaraan Pameran Berikat tetap, dilakukan oleh: a. pengusaha Tempat Penyelenggaraan Pameran Berikat tetap; atau b. pengusaha di Tempat Penyelenggaraan Pameran Berikat tetap merangkap sebagai Penyelenggara di Tempat Penyelenggaraan Pameran Berikat tetap."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_ce742b9dc2 a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_32 ;
    kbr:hasRuleId "R-PP-2009-32-ce742b9dc2"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "(2) Orang yang berhak membeli barang di Toko Bebas Bea yang berlokasi di dalam kota sebagaimana dimaksud dalam Pasal 29 huruf e dengan mendapatkan pembebasan Bea Masuk dan tidak dipungut Pajak Dalam Rangka Impor adalah: a. anggota korps diplomatik yang bertugas di Indonesia beserta keluarganya yang berdomisili di Indonesia berikut lembaga diplomatik; b. pejabat/tenaga ahli yang bekerja pada Badan Internasional di Indonesia yang memperoleh kekebalan diplomatik beserta keluarganya; dan c. orang yang akan keluar dari Daerah Pabean."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

