    kbr:hasSourceQuote "(1) Kementerian danjatau Dinas terkait dapat melakukan evaluasi efektivitas pemberian pengurangan penghasilan bruto yang diterima Wajib Pajak sebagaimana dimaksud dalam Pasal 2 ayat ( 1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2019_128_4e58456b1b a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2019_128 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_128_BT_2 ;
    kbr:hasRuleId "R-PMK-2019-128-4e58456b1b"^^xsd:string ;
