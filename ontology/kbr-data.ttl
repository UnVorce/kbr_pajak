    kbr:hasSourceLocator "PMK-2025-11#BT/7/1..5"^^xsd:string ;
    kbr:hasSourceQuote "ayat (1) Dalam hal sampai dengan batas waktu sebagaimana dimaksud dalam Pasal 18 ayat (3), Pengusaha di KPBPB tidak mengeluarkan kembali Barang Kena Pajak berwujud sebagaimana dimaksud dalam Pasal 18 ayat (2) huruf d dari KPBPB, pemasukan Barang Kena Pajak berwujud ke KPBPB dari TLDDP merupakan perolehan - 12 - Barang Kena Pajak berwujud oleh Pengusaha di KPBPB yang dikenai PPN atau PPN dan PPnBM."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2025_11_0c0c57e4d7 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2025_11 ;
