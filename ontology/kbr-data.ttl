    kbr:hasSourceQuote "g. Wajib Pajak telah mendapatkan keputusan persetujuan pengangsuran pembayaran Pajak atas Utang Pajak yang menjadi dasar dilakukan Pemblokiran;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
