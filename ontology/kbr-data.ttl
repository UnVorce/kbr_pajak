    kbr:hasSourceLocator "PMK-2023-72#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(4) Untuk memperoleh persetujuan Direktur Jenderal Pajak sebagaimana dimaksud pada ayat (3), Wajib Pajak harus mengajukan permohonan kepada Direktur Jenderal · Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

