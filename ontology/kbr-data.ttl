    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "(4) Bentuk pemanfaatan barang milik daerah sebagaimana dimaksud pada ayat (2), dilaksanakan dengan ketentuan: a. tidak bertentangan dengan peraturan perundang- undangan yang lebih tinggi; b. tidak menghambat iklim investasi di Provinsi; dan c. tidak menimbulkan ekonomi biaya tinggi"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_2d7e1da26f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
