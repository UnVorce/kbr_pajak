    kbr:hasRuleId "R-UU-1995-10-a51bf8e20d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "dibulatkan jumlahnya dalam ribuan rupiah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_a5f9cb52d4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_16 ;
