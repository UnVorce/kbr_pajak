kbr:Aturan_R_PMK_2023_41_261b71ecf7 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_41_BT_4 ;
    kbr:hasRuleId "R-PMK-2023-41-261b71ecf7"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-41#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Dokumen tertentu yang kedudukannya dipersamakan dengan Faktur Pajak sebagaimana dimaksud pada ayat (2) paling sedikit memuat keterangan sebagai berikut: a. nomor dan tanggal dokumen; b. nama dan nomor pokok wajib pajak Kreditur; c. nama dan nomor pokok wajib pajak atau nomor induk kependudukan Debitur; d. nama dan nomor pokok wajib pajak atau nomor induk kependudukan Pembeli Agunan; e. uraian Barang Kena Pajak; f. dasar pengenaan pajak; dan g. jumlah Pajak Pertambahan Nilai yang dipungut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2023_41_44989d875f a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2023_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_41_BT_5 ;
    kbr:hasRuleId "R-PMK-2023-41-44989d875f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-41#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "Atas pengambilalihan Agunan oleh Kreditur dari Debitur tidak diterbitkan Faktur Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2023_41_45b4a4bfd2 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2023_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_41_BT_8 ;
    kbr:hasRuleId "R-PMK-2023-41-45b4a4bfd2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-41#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Pembeli Agunan sebagaimana dimaksud dalam Pasal 2 ayat (1) yang merupakan Pengusaha Kena Pajak sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan dapat mengkreditkan Pajak Pertambahan Nilai yang tercantum dalam Faktur Pajak sebagaimana dimaksud dalam Pasal 4 ayat (1)"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2023_41_581f38127b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_41_BT_7 ;
    kbr:hasRuleId "R-PMK-2023-41-581f38127b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-41#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kreditur wajib melaporkan penyerahan Barang Kena Pajak berupa Agunan sebagaimana dimaksud dalam Pasal 2 ayat (1) dengan menggunakan Surat Pemberitahuan Masa_ Pajak Pertambahan Nilai sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2023_41_6c721711bc a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2023_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_41_BT_7 ;
    kbr:hasRuleId "R-PMK-2023-41-6c721711bc"^^xsd:string ;
