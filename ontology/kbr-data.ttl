kbr:Aturan_R_PMK_2023_48_8fb78c43ce a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_48 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_48_BT_3 ;
    kbr:hasRuleId "R-PMK-2023-48-8fb78c43ce"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-48#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Penjualan sebagaimana dimaksud dalam Pasal 2 ayat (1) termasuk: a. penyerahan Emas Perhiasan basil produksi dari Pabrikan Emas Perhiasan kepada Pengusaha Emas Perhiasan yang memesan Emas Perhiasan, dengan spesifikasi, bahan baku, barang setengah jadi, dan/atau bahan penolong/pembantu untuk Emas Perhiasan tersebut baik sebagian maupun seluruhnya disediakan atau diserahkan oleh Pengusaha Emas Perhiasan yang memesan Emas Perhiasan; dan b. penyerahan bahan baku berupa: 1. Emas Perhiasan; dan/atau 2. emas batangan, dari Pengusaha Emas Perhiasan yang memesan Emas Perhiasan kepada Pabrikan Emas Perhiasan, yang dimaksudkan untuk Menghasilkan Emas Perhiasan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2023_48_92a55ba693 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_48 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_48_BT_13 ;
    kbr:hasRuleId "R-PMK-2023-48-92a55ba693"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-48#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pabrikan Emas Perhiasan dan Pedagang Emas Perhiasan sebagaimana dimaksud dalam Pasal 12 ayat (1) wajib melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak. (2) Kewajiban melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (1) tetap berlaku bagi Pabrikan Emas Perhiasan dan Pedagang Emas Perhiasan yang memenuhi kriteria Pengusaha kecil sebagaimana diatur dalam ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2023_48_92f95f7d2f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_48 ;
