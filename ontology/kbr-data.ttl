    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_168 ;
    kbr:hasRuleId "R-PMK-2024-81-faa5af38d2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/168"^^xsd:string ;
    kbr:hasSourceQuote "(4) Terhadap Wajib Pajak yang diwajibkan untuk menyampaikan Surat Pemberitahuan secara elektronik sebagaimana dimaksud pada ayat (3), tetapi Wajib Pajak yang bersangkutan tetap menyampaikan Surat Pemberitahuan selain dengan cara elektronik, Direktorat Jenderal Pajak tidak memberikan bukti penerimaan Surat Pemberitahuan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

