    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_154_1__4 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-5fd24d4a5f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/154/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Dalam jangka waktu paling lama 5 (lima) tahun sejak terutangnya Pajak, Walikota atau Pejabat yang ditunjuk dapat menerbitkan STPD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
