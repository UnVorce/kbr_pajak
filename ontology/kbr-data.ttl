    kbr:hasSourceQuote "(1) Dalam hal status Badan Usaha pengelola dicabut, Pemerintah Daerah provinsi, Pemerintah Daerah kabupaten f kota, atau Dewan Nasional/kementerian/ lembaga pemerintah nonkementerian melakukan proses penetapan Badan Usaha pengelola yang baru sesuai dengan ketentuan peraturan perundang- undangan dalam waktu paling lama 30 (tiga puluh) hari kerja setelah pencabutan Badan Usaha pengelola."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

