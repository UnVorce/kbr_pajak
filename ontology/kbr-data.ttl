    kbr:hasSourceQuote "Dalam hal jual beli tanah dan/atau Bangunan tidak menggunakan perjanjian pengikatan jual beli sebagaimana dimaksud pada ayat (1) huruf a, saat terutang BPHTB untuk jual beli adalah pada saat ditandatanganinya akta jual beli."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

