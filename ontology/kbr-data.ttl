kbr:Aturan_R_PP_2022_50_5b34a0afd0 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_69_1__6 ;
    kbr:hasRuleId "R-PP-2022-50-5b34a0afd0"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/69/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Apabila Surat Pemberitahuan tidak disampaikan dalam jangka waktu sebagaimana dimaksud pada ayat (6), dikenai sanksi administratif dengan ketentuan sebagai berikut: a. sebesar sanksi administratif keterlambatan penyampaian Surat Pemberitahuan Tahunan Pajak Penghasilan Wajib Pajak badan untuk Surat Pemberitahuan Tahunan sebagaimana dimaksud pada ayat (3); atau b. sebesar sanksi administratif keterlambatan penyampaian Surat Pemberitahuan Masa Pajak Pertambahan Nilai untuk Surat Pemberitahuan Masa sebagaimana dimaksud pada ayat (4), sesuai dengan ketentuan dalam Pasal 7 Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

