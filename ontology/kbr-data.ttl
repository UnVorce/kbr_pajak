    kbr:hasRuleId "R-PP-2022-49-eca21caa5e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-49#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Jasa angkutan umum di air sebagaimana dimaksud pada ayat (U tidak termasuk jasa angkutan yang memenuhi ketentuan sebagai berikut: a. terdapat perjanjian sewa atau carter kapal; dan/atau b. kapal dipergunakan hanya untuk mengangkut muatan barang milik 1 (satu) pihak dan/atau untuk mengangkut orang dalam 1 (satu) perjalanan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

