    kbr:hasSourceLocator "UU-1983-8#BT/3A"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha kecil sebagaimana dimaksud pada ayat (1) dapat memilih untuk dikukuhkan sebagai Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_de5b38a382 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_16B_2__3 ;
    kbr:hasRuleId "R-UU-1983-8-de5b38a382"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/16B/2..3"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Masukan yang dibayar atas perolehan Barang Kena Pajak dan/atau Jasa Kena Pajak, impor Barang Kena Pajak, serta pemanfaatan Barang Kena Pajak Tidak Berwujud dari luar Daerah Pabean di dalam Daerah Pabean dan/atau pemanfaatan Jasa Kena Pajak dari luar Daerah Pabean di dalam Daerah Pabean yang atas penyerahannya dibebaskan dari pengenaan Pajak Pertambahan Nilai sebagaimana dimaksud pada ayat (1) tidak dapat dikreditkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_dec96e84a7 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1983-8-dec96e84a7"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Barang Kena Pajak adalah barang yang dikenai pajak berdasarkan Undang-Undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_df053c8e8e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_16A ;
    kbr:hasRuleId "R-UU-1983-8-df053c8e8e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/16A"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pajak yang terutang atas penyerahan Barang Kena Pajak dan atau penyerahan Jasa Kena Pajak kepada Pemungut Pajak Pertambahan Nilai dipungut, disetor, dan dilaporkan oleh Pemungut Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
