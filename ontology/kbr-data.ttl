    kbr:hasSourceLocator "PMK-2024-81#BT/312/6..9"^^xsd:string ;
    kbr:hasSourceQuote "Perusahaan reasuransi syariah sebagaimana dimaksud pada ayat ( 1) huruf c merupakan perusahaan yang menyelenggarakan us aha pengelolaan risiko berdasarkan prinsip syariah atas risiko yang dihadapi oleh Perusahaan Asuransi Syariah, perusahaan penjaminan syariah, atau perusahaan reasuransi syariah lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

