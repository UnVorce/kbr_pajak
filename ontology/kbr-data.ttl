    kbr:hasSourceLocator "UU-1995-11#BT/14/4..8"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal izin sebagaimana dimaksud pada ayat (1) dicabut, terhadap barang kena cukai yang belum dilunasi cukainya yang masih berada di dalam pabrik atau tempat penyimpanan harus dilunasi cukainya dan dikeluarkan dari pabrik atau tempat penyimpanan dalam waktu 30 (tiga puluh) hari sejak diterimanya surat keputusan pencabutan izin."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

