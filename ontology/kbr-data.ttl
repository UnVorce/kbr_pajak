    kbr:hasRuleId "R-PP-2021-40-3b75527705"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "Lokasi yang diusulkan untuk menjadi KEK harus memenuhi kriteria: a. sesuai dengan rencana tata ruang wilayah dan tidak berpotensi mengganggu kawasan lindung; b. mempunyai batas yang jelas; dan c. lahan yang diusulkan menjadi KEK telah dikuasai paling sedikit 50% (lima puluh persen) dari yang direncanakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_3d9c1604cb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
