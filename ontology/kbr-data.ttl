kbr:Aturan_R_PER_DJP_2025_7_079c28f412 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-079c28f412"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Permohonan pendaftaran Wajib Pajak yang disampaikan secara langsung atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir sebagaimana dimaksud dalam Pasal 14 ayat (2) bagi orang pribadi yang merupakan Penduduk dilakukan dengan mengaktivasi Nomor Induk Kependudukan sebagai Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_07d19f4043 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_20 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-07d19f4043"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak melakukan aktivasi Akun Wajib Pajak bersamaan dengan pendaftaran Wajib Pajak untuk memperoleh Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_0867d9a5fd a kbr:Kewajiban ;
