    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_150 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-14c325ed38"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/150"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam pelaksanaan Pemeriksaan sebagaimana dimaksud dalam Pasal 149, kewajiban Wajib Pajak dan Wajib Retribusi yang diperiksa terdiri atas : a. memperlihatkan dan/atau meminjamkan buku atau catatan, dokumen yang menjadi dasarnya, dan dokumen lain yang berhubungan dengan objek Pajak dan objek Retribusi yang terutang; b. memberikan kesempatan untuk memasuki tempat atau ruangan yang dianggap perlu dan memberikan bantuan guna kelancaran Pemeriksaan; dan/atau c. memberikan keterangan yang diperlukan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_151b2b1253 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_165_1__8 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-151b2b1253"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/165/1..8"^^xsd:string ;
    kbr:hasSourceQuote "(8) Dalam hal Wajib Pajak mengajukan keberatan, jangka waktu pelunasan atas jumlah Pajak yang belum dibayar pada saat pengajuan keberatan tertangguh sampai dengan 1 (satu) bulan sejak tanggal penerbitan Surat Keputusan Keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_157b749737 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_1_p5 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-157b749737"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/1#p5"^^xsd:string ;
    kbr:hasSourceQuote "Zona Nilai Tanah yang selanjutnya disingkat ZNT adalah poligon yang menggambarkan nilai tanah yang relatif sama dari sekumpulan bidang tanah didalamnya, yang batasannya bisa bersifat imajiner ataupun nyata sesuai dengan penggunaan tanah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_15ba32476a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_76 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-15ba32476a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "(1) Objek Retribusi Jasa Usaha sebagaimana dimaksud dalam Pasal 49 ayat (1) huruf b adalah pelayanan yang disediakan oleh Pemerintah Daerah dengan menganut prinsip komersial yang meliputi: a. pelayanan dengan menggunakan/memanfaatkan kekayaan daerah yang belum dimanfaatkan secara maksimal; dan/ atau b. pelayanan oleh Pemerintah Daerah sepanjang belum disediakan secara memadai oleh pihak swasta."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_16ae768edf a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_164 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-16ae768edf"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/164"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai tata cara penghapusan piutang Retribusi yang sudah kedaluwarsa diatur dengan Peraturan Walikota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_17aa79261a a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_162 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-17aa79261a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/162"^^xsd:string ;
    kbr:hasSourceQuote "Hak untuk melakukan Penagihan Retribusi menjadi kedaluwarsa setelah melampaui waktu 3 (tiga) tahun terhitung sejak saat terutangnya Retribusi, kecuali jika Wajib Retribusi melakukan tindak pidana di bidang Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_17d56c18e1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_131 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-17d56c18e1"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/131"^^xsd:string ;
    kbr:hasSourceQuote "NJOP sebagaimana dimaksud dalam Pasal 7 ayat (1) ditetapkan oleh Walikota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_188ef72d58 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_127 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-188ef72d58"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/127"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak sebagaimana dimaksud pada ayat (2) tidak mendaftarkan diri, Walikota atau Pejabat yang ditunjuk secara jabatan menerbitkan NPWPD berdasarkan data yang diperoleh atau dimiliki oleh Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_196293fb7e a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_167 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-196293fb7e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/167"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal keberatan Wajib Pajak ditolak atau dikabulkan sebagian, Wajib Pajak dikenai sanksi administratif berupa denda sebesar 30% (tiga puluh persen) dari jumlah Pajak berdasarkan keputusan keberatan dikurangi dengan Pajak yang telah dibayar sebelum mengajukan keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_19b178e1c5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_49 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-19b178e1c5"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "Jenis retribusi daerah terdiri atas: a. Retribusi Jasa Umum; b. Retribusi Jasa Usaha; dan c. Retribusi Perizinan Tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_19ca4946fb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_183 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-19ca4946fb"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/183"^^xsd:string ;
    kbr:hasSourceQuote "Data dan/atau informasi sebagaimana dimaksud pada ayat (1) berupa data dan/ atau informasi yang berkaitan dengan orang pribadi atau Badan yang terdaftar dan memiliki peredaran usaha."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_19e74327ce a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_148_8__9 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-19e74327ce"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/148/8..9"^^xsd:string ;
    kbr:hasSourceQuote "Pembatalan SPPT, SKPD dan/atau STPD yang seharusnya tidak diterbitkan sebagaimana dimaksud pada ayat (7) terdiri atas : a. Objek pajaknya tidak ada/tidak ditemukan; b. Hak subjek pajak terhadap objek pajak dinyatakan batal berdasarkan Keputusan Pejabat yang berwenang atau Putusan Pengadilan yang telah berlaku secara tetap; c. Objek Pajak yang dikecualikan dari PBB-P2; d. ditemukan NOP ganda; e. Objek pajak mengalami perubahan fungsi menjadi digunakan semata-mata hanya untuk melayani kepentingan umum; dan/atau f. NOP atas Ketetapan Objek Pajak Baru PBB yang pajak terutangnya tidak dilakukan pembayaran sampai dengan jatuh tempo"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_1a61b32e08 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_185 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-1a61b32e08"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/185"^^xsd:string ;
    kbr:hasSourceQuote "Permintaan hakim sebagaimana dimaksud pada ayat (5) harus menyebutkan nama tersangka atau nama tergugat, keterangan yang diminta, serta kaitan antara perkara pidana atau perdata yang bersangkutan dengan keterangan yang diminta."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_1a954a4812 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_187 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-1a954a4812"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/187"^^xsd:string ;
    kbr:hasSourceQuote "(1) Wajib Pajak yang karena kealpaannya tidak mengisi SPTPD dengan tidak benar atau tidak lengkap atau melampirkan keterangan yang tidak benar atau tidak menyampaikan SPTPD kepada Pemerintah Daerah sebagaimana dimaksud dalam Pasal 3 ayat (5) sehingga merugikan Keuangan Daerah, diancam dengan pidana sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_1aa652fff4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_68 ;
