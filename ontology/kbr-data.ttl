    kbr:hasSourceQuote "(3) Wilayah pemungutan BBNKB yang terutang merupakan wilayah Daerah tempat Kendaraan Bermotor terdaftar atau tempat lain yang ditetapkan Gubernur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
