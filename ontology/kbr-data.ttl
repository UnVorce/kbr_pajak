    kbr:hasRuleId "R-UU-1983-6-f151f47aa5"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/9/1..3a"^^xsd:string ;
    kbr:hasSourceQuote "(1) Menteri Keuangan menentukan tanggal jatuh tempo pembayaran dan penyetoran pajak yang terutang untuk suatu saat atau Masa Pajak bagi masing-masing jenis pajak paling lama 15 (lima belas) hari setelah saat terutangnya pajak atau berakhirnya Masa Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_f2c34016cd a kbr:Prosedur ;
