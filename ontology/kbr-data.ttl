    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_32 ;
    kbr:hasRuleId "R-UU-1995-10-f8114c3b6d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha tempat penimbunan sementara bertanggung jawab atas bea masuk yang terutang atas barang yang ditimbun di tempat penimbunan sementara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_f8aa0c6fe8 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_11A ;
    kbr:hasRuleId "R-UU-1995-10-f8aa0c6fe8"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/11A"^^xsd:string ;
    kbr:hasSourceQuote "Pemberitahuan pabean sebagaimana dimaksud pada ayat (1) tidak diperlukan terhadap barang pribadi penumpang, awak sarana pengangkut, pelintas batas, dan barang kiriman sampai dengan batas nilai pabean dan/atau jumlah tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_f9907c9609 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
