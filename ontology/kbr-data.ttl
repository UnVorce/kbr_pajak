    kbr:hasSourceQuote "(3) Permohonan Kesepakatan Harga Transfer Unilateral sebagaimana dimaksud pada ayat (1) dibuat dengan menggunakan contoh format pengajuan permohonan Kesepakatan Harga Transfer sebagaimana dimaksud dalam Pasal 56 ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
