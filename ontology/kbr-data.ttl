    kbr:hasSourceQuote "41. Surat Pemberitahuan Pajak Daerah yang selanjutnya disingkat SPTPD adalah surat yang oleh Wajib Pajak digunakan untuk melaporkan penghitungan dan/atau pembayaran Pajak, objek Pajak dan/atau bukan objek Pajak, dan/atau harta dan kewajiban sesuai dengan ketentuan peraturan perundang- undangan perpajakan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

