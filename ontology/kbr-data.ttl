kbr:Aturan_R_UU_2022_1_68ebe448b7 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_2022_1 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2022_1_BT_44 ;
    kbr:hasRuleId "R-UU-2022-1-68ebe448b7"^^xsd:string ;
    kbr:hasSourceLocator "UU-2022-1#BT/44"^^xsd:string ;
    kbr:hasSourceQuote "Yang dikecualikan dari objek BPHTB adalah Perolehan Hak atas Tanah dan/atau Bangunan: a. untuk . . . PRESIOEN REPUBLIK INDONESIA -30- a. untuk kantor Pemerintah, Pemerintahan Daerah, penyelenggara negara dan lembaga negara lainnya yang dicatat sebagai barang milik negara atau barang milik Daerah; b. oleh negara untuk penyelenggaraan pemerintahan dan/atau untuk pelaksanaan pembangunan guna kepentingan umum; c. untuk badan atau perwakilan lembaga internasional dengan syarat tidak menjalankan usaha atau melakukan kegiatan lain di luar fungsi dan tugas badan atau perwakilan lembaga tersebut yang diatur dengan Peraturan Menteri;. d. untuk perwakilan diplomatik dan konsulat berdasarkan asas perlakuan timbal balik; e. oleh orang pribadi atau Badan karena konversi hak atau karena perbuatan hukum lain dengan tidak adanya perubahan nama; f. oleh orang pribadi atau Badan karena wakaf; g. oleh orang pribadi atau Badan yang digunakan untuk kepentingan ibadah; dan h. untuk masyarakat berpenghasilan rendah sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_2022_1_69481391dc a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_2022_1 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2022_1_BT_46_1__6 ;
