    kbr:hasSourceQuote "suku cadang pesawat udara serta peralatan untuk perbaikan dan pemeliharaan pesawat udara yang diimpor oleh pihak yang ditunjuk oleh badan usaha angkutan udara niaga nasional yang digunakan dalam rangka pemberian jasa perawatan dan perbaikan pesawat udara kepada badan usaha angkutan udara niaga nasional;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_49_0ce2f762a6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_49 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_49_BT_16 ;
    kbr:hasRuleId "R-PP-2022-49-0ce2f762a6"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-49#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Jasa penyelenggaraan pendidikan luar sekolah sebagaimana dimaksud pada ayat (1) huruf b berupa jasa penyelenggaraan pendidikan pada jalur nonformal sebagaimana diatur dalam ketentuan peraturan perundang-undangan di bidang sistem pendidikan nasional."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_49_0f60312c0a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_49 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_49_BT_20 ;
    kbr:hasRuleId "R-PP-2022-49-0f60312c0a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-49#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Jasa angkutan umum di sungai dan danau sebagaimana dimaksud pada ayat (1) huruf b mempakan kegiatan pemindahan orang dan/atau barang dari suatu tempat ke tempat lain dengan menggunakan kapal yang dilakukan di sungai, danau, waduk, rawa, banjir kanal, atau terusan, dengan dipungut bayaran."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_49_1182debca8 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_49 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_49_BT_1 ;
    kbr:hasRuleId "R-PP-2022-49-1182debca8"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-49#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "6. Penyerahan Barang Kena Pajak adalah setiap kegiatan penyerahan Barang Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_49_135db9c6b3 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PP_2022_49 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_49_BT_31_1 ;
    kbr:hasRuleId "R-PP-2022-49-135db9c6b3"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-49#BT/31/1"^^xsd:string ;
