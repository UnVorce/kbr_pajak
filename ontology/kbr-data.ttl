kbr:Aturan_R_PP_2022_55_2162da62ae a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_55 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_9_4__6 ;
    kbr:hasRuleId "R-PP-2022-55-2162da62ae"^^xsd:string ;
