    kbr:hasSourceQuote "Wajib Pajak dapat diberikan pengurangan penghasilan bruto paling tinggi 200% (dua ratus persen) dari jumlah biaya yang dikeluarkan untuk kegiatan praktik kerja, pemagangan, dan/ atau pembelajaran."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

