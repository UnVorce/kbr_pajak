    kbr:hasSourceQuote "(1a) Menteri dapat menetapkan suatu kawasan, tempat, atau bangunan untuk dilakukannya suatu kegiatan tertentu selain kegiatan sebagaimana dimaksud pada ayat (1) sebagai tempat penimbunan berikat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

