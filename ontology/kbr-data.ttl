    kbr:hasRuleId "R-UU-1995-10-4f6a4e10de"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/93"^^xsd:string ;
    kbr:hasSourceQuote "Orang yang berkeberatan terhadap penetapan pejabat bea dan cukai mengenai tarif dan/atau nilai pabean untuk penghitungan bea masuk dapat mengajukan keberatan secara tertulis hanya kepada Direktur Jenderal dalam waktu 60 (enam puluh) hari sejak tanggal penetapan dengan menyerahkan jaminan sebesar tagihan yang harus dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_51bf3b2194 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_93A ;
    kbr:hasRuleId "R-UU-1995-10-51bf3b2194"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/93A"^^xsd:string ;
    kbr:hasSourceQuote "Orang yang berkeberatan terhadap penetapan pejabat bea dan cukai selain tarif dan/atau nilai pabean untuk penghitungan bea masuk dapat mengajukan keberatan secara tertulis hanya kepada Direktur Jenderal dalam waktu 60 (enam puluh) hari sejak tanggal penetapan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

