    kbr:hasSourceQuote "(2) Dalam hal Reklame diselenggarakan oleh pihak ketiga, nilai sewa Reklame sebagaimana dimaksud pada ayat (1) ditetapkan berdasarkan nilai kontrak Reklame."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_3ccb0da8a6 a kbr:Definisi ;
