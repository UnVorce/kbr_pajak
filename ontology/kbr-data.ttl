    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_33 ;
    kbr:hasRuleId "R-PMK-2023-172-4904e3e3f3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Dokumen Penentuan Harga Transfer sebagaimana dimaksud dalam Pasal 16 ayat (2) huruf c diterima dan dikelola secara khusus oleh Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
