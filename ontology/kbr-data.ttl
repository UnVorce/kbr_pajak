kbr:Aturan_R_PP_2000_131_0bd401c505 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2000_131 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2000_131_BT_4 ;
