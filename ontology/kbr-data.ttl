    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_e221119b32 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_2__2 ;
    kbr:hasRuleId "R-UU-1995-11-e221119b32"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/2..2"^^xsd:string ;
    kbr:hasSourceQuote "(7) Pengusaha Pabrik atau Importir yang melunasi cukainya dengan cara pelekatan pita cukai yang tidak melunasi utang cukai sampai dengan jangka waktu penundaan berakhir, selain harus melunasi utang cukai dimaksud juga dikenai sanksi administrasi berupa denda sebesar sepuluh persen setiap bulan dari nilai cukai yang seharus- nya dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_e59a71b68a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_4__1 ;
    kbr:hasRuleId "R-UU-1995-11-e59a71b68a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/4..1"^^xsd:string ;
    kbr:hasSourceQuote "Pemasukan atau pengeluaran Barang Kena Cukai ke atau dari Pabrik atau Tempat Penyimpanan, wajib diberitahukan kepada Kepala Kantor dan dilindungi dengan dokumen cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_e7c1a5f672 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_6 ;
    kbr:hasRuleId "R-UU-1995-11-e7c1a5f672"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "Harga dasar yang digunakan untuk perhitungan cukai atas barang kena cukai yang dibuat di Indonesia adalah harga jual pabrik atau harga jual eceran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_e8c6eb37d3 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_14_4__8 ;
    kbr:hasRuleId "R-UU-1995-11-e8c6eb37d3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/14/4..8"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal ketentuan sebagaimana dimaksud pada ayat (5) tidak dipenuhi, barang kena cukai sebagaimana dimaksud dalam Pasal 2 ayat (1) huruf d diatur lebih lanjut dengan peraturan menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_e9f893fa89 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_16A ;
    kbr:hasRuleId "R-UU-1995-11-e9f893fa89"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/16A"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pembukuan wajib diselenggarakan dengan baik yang mencerminkan keadaan atau kegiatan usaha yang sebenarnya dan sekurang-kurangnya terdiri dari catatan mengenai harta, kewajiban, modal, pendapatan, biaya, dan arus keluar masuknya barang kena cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_eaacf680cc a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_40B ;
    kbr:hasRuleId "R-UU-1995-11-eaacf680cc"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/40B"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai dugaan pelanggaran yang tidak dilakukan penyidikan sebagaimana dimaksud pada ayat (3) diatur dengan Peraturan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_eabf867660 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_26 ;
    kbr:hasRuleId "R-UU-1995-11-eabf867660"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "Pemindahan barang kena cukai sebagaimana dimaksud pada ayat (1) harus segera dilaporkan kepada Kepala Kantor dalam jangka waktu yang ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_eacd76815f a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_1__1 ;
    kbr:hasRuleId "R-UU-1995-11-eacd76815f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/1..1"^^xsd:string ;
    kbr:hasSourceQuote "Barang Kena Cukai yang dibuat di Indonesia dikenai cukai a. dua ratus lima puluh persen dari Harga Dasar apabila Harga Dasar yang digunakan adalah Harga Jual Pabrik; atau b. lima puluh lima persen dari Harga Dasar apabila Harga Dasar yang digunakan adalah Harga Jual Eceran."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_eb5953cee6 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_8 ;
    kbr:hasRuleId "R-UU-1995-11-eb5953cee6"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(3) Pengusaha pabrik, pengusaha tempat penyimpanan, importir barang kena cukai, atau setiap orang yang melanggar ketentuan tentang tidak dipungutnya cukai sebagaimana dimaksud pada ayat (2) dikenai sanksi administrasi berupa denda paling sedikit 2 (dua) kali nilai cukai dan paling banyak 10 (sepuluh) kali nilai cukai yang seharusnya dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_ebd3d72816 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_17 ;
    kbr:hasRuleId "R-UU-1995-11-ebd3d72816"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/17"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat bea dan cukai wajib menyelenggarakan buku rekening barang kena cukai untuk setiap pengusaha pabrik atau pengusaha tempat penyimpanan mengenai barang kena cukai tertentu yang masih terutang cukai dan berada di pabrik atau tempat penyimpanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_ebfee3f05b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_14_1__3a ;
    kbr:hasRuleId "R-UU-1995-11-ebfee3f05b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/14/1..3a"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang akan menjalankan kegiatan sebagai: a. pengusaha pabrik; b. pengusaha tempat penyimpanan; c. importir barang kena cukai; d. penyalur; atau e. pengusaha tempat penjualan eceran, wajib memiliki izin berupa Nomor Pokok Pengusaha Barang Kena Cukai dari Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_ec6eb8e8ca a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_8 ;
    kbr:hasRuleId "R-UU-1995-11-ec6eb8e8ca"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(4) Ketentuan lebih lanjut mengenai pelaksanaan ayat (1) dan ayat (2) diatur dengan atau berdasarkan peraturan menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

