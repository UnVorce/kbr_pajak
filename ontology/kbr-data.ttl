    kbr:hasSourceLocator "PMK-2009-105#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Piutang yang nyata-nyata tidak dapat ditagih sebagaimana dimaksud dalam Pasal 2 dapat dibebankan sebagai pengurang penghasilan bruto, sepanjang memenuhi persyaratan:"^^xsd:string ;
