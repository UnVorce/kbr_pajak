    kbr:hasSourceQuote "(1) Besaran pokok PAT yang terutang dihitung dengan cara mengalikan dasar pengenaan PAT sebagaimana dimaksud dalam Pasal 62 ayat (1) dengan tarif PAT sebagaimana dimaksud dalam Pasal 63"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
