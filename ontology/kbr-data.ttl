    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/73"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal tarif Retribusi sebagaimana dimaksud pada ayat (2) dinyatakan dalam satuan mata uang selain rupiah, pembayaran Retribusi dimaksud tetap harus dilakukan dalam satuan mata uang rupiah dengan menggunakan kurs yang ditetapkan oleh menteri yang menyelenggarakan urusan pemerintahan di bidang keuangan untuk kepentingan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_21e438e126 a kbr:Definisi ;
