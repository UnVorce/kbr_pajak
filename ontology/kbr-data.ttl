    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Kendaraan Bermotor adalah semua kendaraan beroda beserta gandengannya yang digunakan di semua jenis jalan darat atau kendaraan yang dioperasikan di air yang digerakkan oleh peralatan teknik berupa motor atau peralatan lainnya yang berfungsi untuk mengubah suatu sumber daya energi tertentu menjadi tenaga gerak kendaraan bermotor yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

