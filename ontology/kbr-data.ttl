    kbr:hasSourceLocator "PMK-2023-172#BT/55/6..10"^^xsd:string ;
    kbr:hasSourceQuote "(7) Kesepakatan Harga Transfer sebagaimana dimaksud pada ayat (1) berupa kesepakatan: a. kriteria dalam Penentuan Harga Transfer; dan b. Penentuan Harga Transfer di muka, untuk Periode Kesepakatan Harga Transfer dan Pemberlakuan Mundur dalam hal Wajib Pajak meminta Pemberlakuan Mundur dalam permohonan Kesepakatan Harga Transfer."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

