    kbr:hasSourceLocator "PMK-2024-81#BT/191/2..5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Penghasilan clari pengalihan hak atas tanah clan/atau bangunan sebagaimana climaksucl pacla ayat (1) huruf a merupakan penghasilan yang cliterima atau cliperoleh pihak yang mengalihkan hak atas tanah clan/ atau bangunan melalui penjualan, tukar menukar, jdih.kemenkeu.go.id - 151 - pelepasan hak, penyerahan hak, lelang, hibah, waris, atau cara lain yang disepakati antara para pihak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

