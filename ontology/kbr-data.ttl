    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/86/1..11"^^xsd:string ;
    kbr:hasSourceQuote "Peninjauan tarif Retribusi sebagaimana dimaksud pada ayat (5) khusus layanan PBG hanya terhadap besaran harga/indeks dalam tabel HSBGN/SHST dan Indeks Lokalitas."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
