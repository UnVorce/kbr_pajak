    kbr:hasSourceQuote "Imbalan bunga karena keterlambatan pengembalian kelebihan pembayaran Pajak Bumi dan Bangunan sebagaimana dimaksud dalam Pasal 139 ayat (1) diberikan dengan tarif bunga per bulan yang ditetapkan oleh Menteri, dari jumlah kelebihan pembayaran pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

