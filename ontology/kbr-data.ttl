kbr:Aturan_R_PMK_2024_79_e609a359b7 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_15 ;
    kbr:hasRuleId "R-PMK-2024-79-e609a359b7"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penghasilan sebagaimana dimaksud dalam Pasal 8 ayat (4) dan Pasal 9 ayat (4) diterima atau diperoleh Anggota yang merupakan subjek pajak luar negeri, penghasilan tersebut merupakan objek pemotongan Pajak Penghasilan sebagaimana diatur dalam Pasal 26 Undang- Undang Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

