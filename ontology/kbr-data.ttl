    kbr:hasRuleId "R-PMK-2023-41-a6a4d60373"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-41#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Besaran terten_tu sebagaimana dimaksud pada ayat (3) ditetapkan sebesar 10% (sepuluh persen) dari tarif sebagaimana diatur dalam Pasal 7 ayat (1) Undang- Undang Pajak Pertambahan Nilai dikalikan dengan dasar pengenaan pajak berupa harga jual Agunan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
