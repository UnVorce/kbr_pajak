    kbr:hasSourceQuote "Harga Transfer sebagaimana dimaksud pada ayat (2) memenuhi Prinsip Kewajaran dan Kelaziman Usaha dalam hal nilai indikator Harga Transfer sama dengan - 8 - nilai indikator harga Transaksi Independen yang sebanding."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

