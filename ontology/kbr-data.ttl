    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_57 ;
    kbr:hasRuleId "R-PMK-2024-81-e44b7f9d39"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "Penghapusan Nomor Pokok Wajib Pajak secarajabatan sebagaimana dimaksud pada ayat (1) dilakukan melalui penerbitan keputusan Penghapusan Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

