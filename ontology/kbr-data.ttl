    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-2d7e1da26f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Pemungutan Opsen Pajak MBLB dilakukan bersamaan dengan pemungutan Pajak terutang dari Pajak MBLB."^^xsd:string ;
