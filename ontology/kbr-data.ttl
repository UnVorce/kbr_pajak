    kbr:hasSourceLocator "PMK-2025-50#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Kriteria tertentu sebagaimana dimaksud pada ayat (1) huruf a meliputi: a. nilai transaksi dengan pemanfaat jasa penyediaan Sarana Elektronik yang digunakan untuk transaksi Aset Kripto oleh Penjual Aset Kripto di Indonesia melebihi jumlah tertentu dalam 12 (dua belas) bulan; dan/atau b. jumlah traffic atau pengakses melebihi jumlah tertentu dalam 12 (dua belas) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

