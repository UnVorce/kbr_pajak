    kbr:hasSourceQuote "Dalam melaksanakan kewenangan sebagaimana dimaksud pada ayat (1), Pejabat Bea dan Cukai dapat dilengkapi dengan senjata api yang jenis dan syarat-syarat penggunaannya diatur dengan Peraturan Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

