    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_65 ;
    kbr:hasRuleId "R-PP-2022-55-3b315d9a04"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/65"^^xsd:string ;
    kbr:hasSourceQuote "Pihak sebagaimana dimaksud pada ayat (2) huruf a dan huruf b tidak termasuk: a. Wqiib Pajak Perseroan Terbuka yang membeli kembali sahamnya; dan/atau b. yang memiliki hubungan istimewa sebagaimana diatur dalam Undang-Undang Pajak Penghasilan dengan Wajib Pajak Perseroan Terbuka."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

