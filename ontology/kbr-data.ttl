    kbr:hasSourceQuote "Wajib Pajak Perseroan Terbuka yang membeli kembali sahamnya sebagaimana dimaksud dalam huruf c angka I berdasarkan kebijakan pemerintah pusat atau lembaga dimaksud, dianggap tetap memenuhi persyaratan sebagaimana dimaksud dalam huruf b angka L dan angka2;"^^xsd:string ;
