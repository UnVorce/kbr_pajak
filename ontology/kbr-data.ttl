    kbr:hasSourceLocator "UU-1995-10#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "(4) Ketentuan mengenai pedoman penyelenggaraan pembukuan diatur lebih lanjut dengan atau berdasarkan peraturan menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

