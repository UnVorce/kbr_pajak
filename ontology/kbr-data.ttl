    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-d8282b9360"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/62"^^xsd:string ;
    kbr:hasSourceQuote "(7) Subjek Retribusi Jasa Umum merupakan orang pribadi atau Badan yang menggunakan atau menikmati pelayanan Jasa Umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_d987707f0b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
