    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_14 ;
    kbr:hasRuleId "R-UU-1997-19-07ead0172a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "Penyitaan terhadap Penanggung Pajak Badan dapat dilaksanakan terhadap barang milik perusahaan, pengurus, kepala perwakilan, kepala cabang, penanggung jawab, pemilik modal, baik di tempat kedudukan yang bersangkutan, di tempat tinggal mereka maupun di tempat lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_086973dd1e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1997-19-086973dd1e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "6. Jurusita Pajak adalah pelaksana tindakan penagihan pajak yang meliputi penagihan seketika dan sekaligus, pemberitahuan Surat Paksa, penyitaan dan penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_0af029c93f a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_39 ;
    kbr:hasRuleId "R-UU-1997-19-0af029c93f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "(1b) Apabila dalam jangka waktu sebagaimana dimaksud dalam ayat (1a) Pejabat tidak memberikan keputusan, permohonan Penanggung Pajak dianggap dikabulkan dan penagihan ditunda untuk sementara waktu."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_0b53b638a3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_7 ;
    kbr:hasRuleId "R-UU-1997-19-0b53b638a3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "(1) Surat Paksa berkepala kata-kata \"DEMI KEADILAN BERDASARKAN KETUHANAN YANG MAHA ESA\", mempunyai kekuatan eksekutorial dan kedudukan hukum yang sama dengan putusan pengadilan yang telah mempunyai kekuatan hukum tetap."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_0b898fc766 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_26 ;
    kbr:hasRuleId "R-UU-1997-19-0b898fc766"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(5) Larangan terhadap Pejabat dan Jurusita Pajak untuk membeli barang sitaan yang dilelang, berlaku juga terhadap istri, keluarga sedarah dan semenda dalam keturunan garis lurus, serta anak angkat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_0c0c0a0980 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_19 ;
    kbr:hasRuleId "R-UU-1997-19-0c0c0a0980"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Hak mendahulu untuk tagihan pajak melebihi segala hak mendahulu lainnya, kecuali terhadap : a. biaya perkara yang semata-mata disebabkan suatu penghukuman untuk melelang suatu barang bergerak dan atau barang tidak bergerak; b. biaya yang telah dikeluarkan untuk menyelamatkan barang dimaksud; c. biaya perkara yang semata-mata disebabkan pelelangan dan penyelesaian suatu warisan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_0d727be465 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_12 ;
    kbr:hasRuleId "R-UU-1997-19-0d727be465"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Walaupun Penanggung Pajak tidak hadir, penyitaan tetap dapat dilaksanakan dengan syarat salah seorang saksi sebagaimana dimaksud dalam ayat (2), berasal dari Pemerintah Daerah setempat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_11ac978e1f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_10_1__6 ;
    kbr:hasRuleId "R-UU-1997-19-11ac978e1f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak dinyatakan pailit, Surat Paksa diberitahukan kepada Kurator, Hakim Pengawas atau Balai Harta Peninggalan,"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_12613143a4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_34 ;
    kbr:hasRuleId "R-UU-1997-19-12613143a4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Penanggung Pajak yang disandera dilepas: a. apabila utang pajak dan biaya penagihan pajak telah dibayar lunas; b. apabila jangka waktu yang ditetapkan dalam Surat Perintah Penyanderaan itu telah terpenuhi; c. berdasarkan putusan pengadilan yang telah mempunyai kekuatan hukum tetap; atau d. berdasarkan... d. berdasarkan pertimbangan tertentu dari Menteri atau Gubernur Kepala Daerah Tingkat I."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_16a49f90d9 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_10_1__6 ;
    kbr:hasRuleId "R-UU-1997-19-16a49f90d9"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pemberitahuan Surat Paksa sebagaimana dimaksud dalam ayat (1) dituangkan dalam Berita Acara yang sekurang-kurangnya memuat hari dan tanggal pemberitahuan Surat Paksa, nama Jurusita Pajak, nama yang menerima, dan tempat pemberitahuan Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_17a894bfab a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1997-19-17a894bfab"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Undang-undang ini, yang dimaksud dengan : 1. Pajak adalah semua jenis pajak yang dipungut oleh Pemerintah Pusat, termasuk Bea Masuk dan Cukai, dan pajak yang dipungut oleh Pemerintah Daerah, menurut undang-undang dan peraturan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_1a7ad9e5ba a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_15 ;
    kbr:hasRuleId "R-UU-1997-19-1a7ad9e5ba"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Penambahan jenis barang bergerak yang dikecualikan dari penyitaan sebagaimana dimaksud dalam ayat (1) huruf a, huruf b, huruf c, huruf d, dan huruf f diatur dengan Peraturan Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_1c6417f5b6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_33 ;
    kbr:hasRuleId "R-UU-1997-19-1c6417f5b6"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Penyanderaan sebagaimana dimaksud pada ayat (1) hanya dapat dilaksanakan berdasarkan Surat Perintah Penyanderaan yang diterbitkan oleh Pejabat setelah mendapat izin tertulis dari Menteri atau Gubernur Kepala Daerah Tingkat I."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_1c99d7ac94 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_29 ;
    kbr:hasRuleId "R-UU-1997-19-1c99d7ac94"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "Pencegahan hanya dapat dilakukan terhadap Penanggung Pajak yang mempunyai jumlah utang pajak sekurang-kurangnya sebesar Rp. 100.000.000,00 (seratus juta rupiah) dan diragukan itikad baiknya dalam melunasi utang pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_1dbec9ef88 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_10_1__6 ;
    kbr:hasRuleId "R-UU-1997-19-1dbec9ef88"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "c. salah seorang ahli waris atau pelaksana wasiat atau yang mengurus harta peninggalannya, apabila Wajib Pajak telah meninggal dunia dan harta warisan belum dibagi;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_2150e86876 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_18 ;
    kbr:hasRuleId "R-UU-1997-19-2150e86876"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "(1) Terhadap barang yang telah disita oleh Kejaksaan atau Kepolisian sebagai barang bukti dalam kasus pidana, Jurusita Pajak menyampaikan Surat Paksa dengan dilampiri surat pemberitahuan yang menyatakan bahwa barang dimaksud akan disita apabila proses pembuktian telah selesai dan diputuskan bahwa barang bukti dikembalikan kepada Penanggung Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_21bea743dd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_39 ;
    kbr:hasRuleId "R-UU-1997-19-21bea743dd"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "(1a) Pejabat dalam jangka waktu paling lama 7 (tujuh) hari sejak tanggal diterima permohonan sebagaimana dimaksud dalam ayat (1), harus memberi keputusan atas permohonan yang diajukan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_270938eb41 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_5 ;
    kbr:hasRuleId "R-UU-1997-19-270938eb41"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(2) Jurusita Pajak dalam melaksanakan tugasnya harus dilengkapi dengan kartu tanda pengenal Jurusita Pajak dan harus diperlihatkan kepada Penanggung Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_27d64e5a68 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_8 ;
    kbr:hasRuleId "R-UU-1997-19-27d64e5a68"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(1) Surat Paksa diterbitkan apabila : a. Penanggung Pajak tidak melunasi utang pajak dan kepadanya telah diterbitkan Surat Teguran atau Surat Peringatan atau surat lain yang sejenis; b. terhadap Penanggung Pajak telah dilaksanakan penagihan seketika dan sekaligus; atau c. Penanggung Pajak tidak memenuhi ketentuan sebagaimana tercantum dalam keputusan persetujuan angsuran atau penundaan pembayaran pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_29b10f49c4 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_34 ;
    kbr:hasRuleId "R-UU-1997-19-29b10f49c4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Penanggung Pajak yang disandera dapat mengajukan gugatan terhadap pelaksanaan penyanderaan hanya kepada Pengadilan Negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_2bc9aceae4 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_42 ;
    kbr:hasRuleId "R-UU-1997-19-2bc9aceae4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "c. dalam hal Surat Perintah Melaksanakan Penyitaan sudah diterbitkan tetapi belum dilaksanakan, Surat Perintah Melaksanakan Penyitaan dimaksud dinyatakan batal demi hukum;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_2cf4315c7b a kbr:AturanHukum ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_33 ;
    kbr:hasRuleId "R-UU-1997-19-2cf4315c7b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya jumlah utang pajak sebagaimana dimaksud pada ayat (1) dan dalam Pasal 29 dapat diubah dengan Peraturan Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_2da1b4268f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_17 ;
    kbr:hasRuleId "R-UU-1997-19-2da1b4268f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/17"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal penyitaan dilaksanakan terhadap barang yang kepemilikannya terdaftar, salinan Berita Acara Pelaksanaan Sita diserahkan kepada instansi tempat kepemilikan barang dimaksud terdaftar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_2dabc592ec a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_27 ;
    kbr:hasRuleId "R-UU-1997-19-2dabc592ec"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "Lelang tidak dilaksanakan apabila Penanggung Pajak telah melunasi utang pajak dan biaya penagihan pajak, atau berdasarkan putusan pengadilan, atau putusan badan peradilan pajak, atau objek lelang musnah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_30635894c2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_5 ;
    kbr:hasRuleId "R-UU-1997-19-30635894c2"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam melaksanakan tugasnya, Jurusita Pajak dapat meminta bantuan Kepolisian, Kejaksaan, Departemen yang membidangi hukum dan perundang-undangan, Pemerintah Daerah setempat, Badan Pertanahan Nasional, Direktorat Jenderal Perhubungan Laut, Pengadilan Negeri, Bank atau pihak lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

