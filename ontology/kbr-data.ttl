    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/103"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi Tempat Rekreasi, Pariwisata, dan Olahraga sebagaimana dimaksud dalam Pasal 76 ayat (2) huruf e adalah orang pribadi atau Badan yang menurut Peraturan Perundang-Undangan diwajibkan untuk melakukan pembayaran retribusi, termasuk pemungut atau pemotong retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

