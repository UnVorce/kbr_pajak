    kbr:hasSourceLocator "PMK-2023-61#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "(2) Surat perintah Penyanderaan paling sedikit memuat: a. identitas Penanggung Pajak; b. alasan Penyanderaan; c. izin Penyanderaan; d. lamanya Penyanderaan; dan e. tempat Penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

