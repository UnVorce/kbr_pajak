    kbr:hasSourceQuote "Surat Perintah Membayar Kelebihan Pajak, Surat Perintah Membayar Imbalan Bunga, Surat Keputusan Pengembalian Kelebihan Pembayaran Pajak, dan Arsip Data Komputer disampaikan ke Kantor Pelayanan Perbendaharaan Negara secara elektronik a tau secara langsung oleh petugas yang ditunjuk."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
