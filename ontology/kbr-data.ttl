kbr:Aturan_R_PER_DJP_2025_11_f15b9a506d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_95 ;
    kbr:hasRuleId "R-PER-DJP-2025-11-f15b9a506d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-11#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak Badan yang diizinkan untuk menyelenggarakan pembukuan dengan menggunakan bahasa Inggris dan satuan mata uang dolar Amerika Serikat, wajib menyampaikan Surat Pemberitahuan Pajak Penghasilan Wajib Pajak Badan beserta lampirannya dalam bahasa Indonesia kecuali lampiran berupa laporan keuangan, dan menggunakan satuan mata uang dolar Amerika Serikat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_f37c9522b3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_128 ;
    kbr:hasRuleId "R-PER-DJP-2025-11-f37c9522b3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-11#BT/128"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal Surat Pemberitahuan yang menyatakan lebih bayar memenuhi kriteria sebagaimana dimaksud pada ayat (1), kepala Kantor Pelayanan Pajak menerbitkan surat pemberitahuan Surat Pemberitahuan dianggap tidak terdapat kelebihan pembayaran pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_f412878bb0 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_51 ;
    kbr:hasRuleId "R-PER-DJP-2025-11-f412878bb0"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-11#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "Penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak kepada Pembeli Barang Kena Pajak dan/atau Penerima Jasa Kena Pajak dengan karakteristik konsumen akhir sebagaimana dimaksud dalam Pasal 30 ayat (5) merupakan penyerahan yang dilakukan secara eceran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_f46d237244 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_115 ;
    kbr:hasRuleId "R-PER-DJP-2025-11-f46d237244"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-11#BT/115"^^xsd:string ;
    kbr:hasSourceQuote "(1) Angsuran Pajak Penghasilan Pasal 25 dalam hal Wajib Pajak memperoleh penghasilan tidak teratur sebagaimana dimaksud dalam Pasal 113 ayat (2) huruf b dihitung sebesar Pajak Penghasilan terutang dikurangi dengan Pajak Penghasilan yang dipotong dan/atau dipungut serta Pajak Penghasilan yang dibayar atau terutang di luar negeri yang boleh dikreditkan sesuai ketentuan Pasal 21, Pasal 22, Pasal 23, dan Pasal 24 Undang-Undang Pajak Penghasilan, dibagi 12 (dua belas) atau banyaknya bulan dalam Bagian Tahun Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_f6980762a1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_76 ;
    kbr:hasRuleId "R-PER-DJP-2025-11-f6980762a1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-11#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "(4) Surat Pemberitahuan Masa Pajak Pertambahan Nilai sebagaimana dimaksud pada ayat (1): a. dibuat sesuai contoh format; dan b. diisi sesuai petunjuk pengisian, sebagaimana tercantum dalam Lampiran huruf E yang merupakan bagian tidak terpisahkan dari Peraturan Direktur Jenderal ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_f6cc530370 a kbr:Definisi ;
