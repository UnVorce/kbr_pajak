    kbr:hasSourceQuote "Dalam menjalankan hak dan memenuhi kewajiban perpajakan sebagai kuasa, kuasa wajib mematuhi ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
