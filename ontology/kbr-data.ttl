kbr:Aturan_R_PMK_2024_78_5aeceb83af a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_78 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_78_BT_38_4 ;
