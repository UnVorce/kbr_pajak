    kbr:hasSourceQuote "KSO dan Anggota wajib melaporkan Pajak Penghasilan yang telah dibayar atau disetor sendiri sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

