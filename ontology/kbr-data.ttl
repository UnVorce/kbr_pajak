    kbr:hasSourceQuote "a. memiliki atau memegang kepemilikan saham dengan persentase tertentu; dan b. memenuhi kepemilikan saham paling singkat selama 365 (tiga ratus enam puluh lima) hari kalender termasuk hari pembayaran dividen."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

