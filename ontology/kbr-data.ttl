    kbr:hasSourceQuote "Pemberitahuan Pabean Kawasan Ekonomi Khusus yang selanjutnya disingkat PPKEK adalah pemberitahuan pabean untuk kegiatan pemasukan dan pengeluaran - 9 - Kepabeanan. d. cukai. - 9 -"^^xsd:string ;
