    kbr:hasSourceQuote "Tanggal yang tercantum dalam bukti penerimaan sebagaimana dimaksud pada ayat (1)) merupakan tanggal penerimaan permohonan Kesepakatan Harga Transfer."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
