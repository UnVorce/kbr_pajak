kbr:Aturan_R_PMK_2023_96_8f1bb41775 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_61_1__7 ;
