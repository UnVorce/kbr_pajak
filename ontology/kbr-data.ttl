    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "44. Surat Tagihan Pajak Daerah yang selanjutnya disingkat STPD adalah surat untuk melakukan tagihan Pajak dan/atau sanksi administratif berupa bunga dan/atau denda."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_dd24a5e831 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_38 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-dd24a5e831"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Wajib BPHTB merupakan orang pribadi atau Badan yang memperoleh Hak atas Tanah dan/atau Bangunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_de29857e07 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_42 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-de29857e07"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pejabat pembuat akta tanah atau notaris sesuai kewenangannya wajib: a. meminta bukti pembayaran BPHTB kepada Wajib Pajak, sebelum menandatangani akta pemindahan Hak atas Tanah dan/atau Bangunan; dan b. melaporkan pembuatan perjanjian pengikatan jual beli dan/atau akta atas tanah dan/atau Bangunan kepada Gubernur paling lambat pada tanggal l0 (sepuluh) bulan berikutnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_de34a1e28d a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
