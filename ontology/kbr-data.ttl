    kbr:hasRuleId "R-PMK-2023-48-f5221c8f93"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-48#BT/25"^^xsd:string ;
    kbr:hasSourceQuote "a. perlakuan Pajak Pertambahan Nilainya dilaksanakan berdasarkan Peraturan Menteri Keuangan Nomor 30/PMK.03/2014 tentang Pajak Pertambahan Nilai atas Penyerahan Emas Perhiasan, kecuali ketentuan yang mengatur mengenai tarif Pajak Pertambahan Nilai"^^xsd:string ;
