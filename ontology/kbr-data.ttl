    kbr:hasSourceQuote "5. Entitas Utama (Main Entity) adalah Entitas yang memasukkan laba atau rugi bersih akuntansi keuangan - 3 - dari suatu bentuk usaha tetap dalam laporan keuangannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
