    kbr:hasSourceLocator "UU-1983-7#BT/18/3e..4"^^xsd:string ;
    kbr:hasSourceQuote "Penjualan atau pengalihan saham perusahaan antara (conduit companA atau special purpose companA) yang didirikan atau bertempat kedudukan di negara yang memberikan perlindungan pajak (tax hauen countryl yang mempunyai hubungan istimewa dengan badan yang didirikan atau bertempat kedudukan di Indonesia atau bentuk usaha tetap di Indonesia dapat ditetapkan sebagai penjualan atau pengalihan saham badan yang didirikan atau bertempat kedudukan di Indonesia atau bentuk usaha tetap di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
