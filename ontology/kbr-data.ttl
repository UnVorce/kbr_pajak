    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_67 ;
    kbr:hasRuleId "R-PMK-2023-96-16d92d7e35"^^xsd:string ;
