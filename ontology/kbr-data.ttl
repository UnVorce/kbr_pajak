    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/1#p4"^^xsd:string ;
    kbr:hasSourceQuote "Harga Satuan Bangunan Gedung Negara yang selanjutnya disebut HSBGN adalah standar harga satuan tertinggi untuk biaya pelaksanaan konstruksi fisik pembangunan bangunan gedung negara yang diberlakukan sesuai dengan klasifikasi, lokasi dan tahun pembangunannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_195ea68a54 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_93 ;
