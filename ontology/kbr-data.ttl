    kbr:hasSourceQuote "Hasil penerimaan Pajak Rokok sebagaimana dimaksud dalam Pasal 3 ayat (2) huruf b, dialokasikan paling sedikit 50% (lima puluh persen) untuk mendanai pelayanan kesehatan masyarakat dan penegakan hukum."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

