kbr:Aturan_R_PMK_2024_81_54ef83af03 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_298 ;
    kbr:hasRuleId "R-PMK-2024-81-54ef83af03"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/298"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kontraktor atau pemegang kuasa/pemegang 1zm ditunjuk sebagai Pemungut Pajak Pertambahan Nilai. (2) Kontraktor atau pemegang kuasa/pemegang izin sebagaimana dimaksud pada ayat (1) merupakan: a. kontraktor kontrak kerja sama pengusahaan minyak dan gas bumi; dan b. kontraktor atau pemegang kuasa/pemegang izin pengusahaan sumber daya panas bumi, yang meliputi kantor pusat, cabang, maupun unitnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
