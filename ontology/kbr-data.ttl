    kbr:hasSourceQuote "Permohonan Perizinan Berusaha dan perizinan lainnya yang sedang dalam proses pengajuan sebelum berlakunya Peraturan Pemerintah ini dapat dilanjutkan sesuai dengan ketentuan peraturan perundang-undangan yang berlaku sebelum Peraturan Pemerintah ini ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_83bf3f4dd7 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2021_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_41_BT_24 ;
    kbr:hasRuleId "R-PP-2021-41-83bf3f4dd7"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/24"^^xsd:string ;
    kbr:hasSourceQuote "Badan Pengusahaan dalam pengusahaan Pelabuhan Laut sebagaimana dimaksud pada ayat {2) membentuk BUP."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_84864b9dbc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2021_41 ;
