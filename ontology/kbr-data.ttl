    kbr:hasSourceQuote "Makanan dan/atau Minuman adalah makanan dan/ atau minuman yang disediakan, dijual dan/ atau diserahkan, baik secara langsung maupun tidak langsung, atau melalui pesanan oleh restoran."^^xsd:string ;
