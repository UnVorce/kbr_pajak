    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "(1) Tingkat penggunaan jasa atas pelayanan Perizinan Tertentu merupakan jumlah penggunaan jasa yang dijadikan dasar alokasi beban biaya yang dipikul Pemerintah Daerah untuk penyelenggaraan jasa yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_18992de1b7 a kbr:Definisi ;
