    kbr:hasSourceQuote "Pajak Pertambahan Nilai yang terutang atas penyerahan Agunan yang diambil alih sebagaimana dimaksud dalam Pasal 2 ayat (1) dipungut, disetor, dan dilaporkan oleh Kreditur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
