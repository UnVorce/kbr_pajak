    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_76 ;
    kbr:hasRuleId "R-PMK-2023-61-87a15211df"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "Penanggung Pajak yang disandera ·dapat mengajukan gugatan terhadap pelaksanaan Penyanderaan hanya kepada Pengadilan Negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_87d7defd32 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_33_2__1 ;
    kbr:hasRuleId "R-PMK-2023-61-87d7defd32"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/33/2..1"^^xsd:string ;
    kbr:hasSourceQuote "Atas pemblokiran yang dilakukan melebihi jumlah Utang Pajak dan Biaya Penagihan Pajak yang menjadi dasar dilakukan Pemblokiran sebagaimana dimaksud pada ayat (1) huruf i, pencabutan blokir dilakukan terhadap nilai yang melebihi jumlah Utang Pajak dan Biaya Penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

