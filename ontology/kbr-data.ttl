    kbr:hasSourceQuote "(2) Permohonan SKB PPnBM sebagaimana dimaksud pada ayat (1) sah apabila ditandatangani oleh orang pribadi, pengurus, pejabat yang berwenang, atau kuasa sesuai dengan ketentuan peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
