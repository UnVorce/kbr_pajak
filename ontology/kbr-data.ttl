    kbr:hasSourceQuote "Seluruh barang dan peralatan yang dibeli oleh Kontraktor dalam rangka Operasi Perminyakan menjadi barang milik negara yang pembinaannya dilakukan oleh Pemerintah"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2017_53_29362ad90a a kbr:Definisi ;
