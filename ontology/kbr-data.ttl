    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_75 ;
    kbr:hasRuleId "R-PMK-2024-81-ae030355b3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal Wajib Pajak tidak melaksanakan kewajiban pendaftaran sebagaimana dimaksud dalam Pasal 71 ayat (1), Kepala Kantor Pelayanan Pajak melakukan Pemeriksaan atau penelitian administrasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_ae040ac0fb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_145 ;
    kbr:hasRuleId "R-PMK-2024-81-ae040ac0fb"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/145"^^xsd:string ;
    kbr:hasSourceQuote "Tarif bunga per bulan sebagaimana dimaksud pada ayat (1) merupakan tarif bunga yang berlaku pada tanggal dimulainya penghitungan imbalan bunga."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_ae99d8b6a2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_18 ;
    kbr:hasRuleId "R-PMK-2024-81-ae99d8b6a2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak orang pribadi sebagaimana dimaksud dalam Pasal 1 7 ayat (2) yang merupakan bukan Penduduk dan menerima atau memperoleh penghasilan dengan akumulasi belum melebihi penghasilan tidak kena pajak, orang pribadi dimaksud menggunakan nomor identitas perpajakan dengan format 16 (enam belas) digit setelah mendaftarkan identitasnya dalam administrasi perpajakan sebagaimana dimaksud dalam Pasal 16 ayat (6) huruf a."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_aea533e7fd a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_452 ;
    kbr:hasRuleId "R-PMK-2024-81-aea533e7fd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/452"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak orang pribadi merupakan suami istri yang: a. menghendaki perjanjian pemisahan harta dan penghasilan secara tertulis; atau b. istrinya menghendaki memilih untuk menjalankan hak dan kewajiban perpajakannya sendiri, sebagaimana dimaksud dalam Pasal 8 ayat (2) huruf b dan huruf c Undang-Undang Pajak Penghasilan, besarnya peredaran bruto sebagaimana dimaksud pada ayat (1) ditentukan berdasarkan penggabungan peredaran bruto dari usaha dan/ atau pekerjaan be bas suami dan istri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_aeaab12ee3 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_85 ;
    kbr:hasRuleId "R-PMK-2024-81-aeaab12ee3"^^xsd:string ;
