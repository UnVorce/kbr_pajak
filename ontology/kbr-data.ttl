    kbr:hasSourceQuote "(2) Penyidik sebagaimana dimaksud pada ayat (1), yaitu pejabat pegawai negeri sipil tertentu di lingkungan Pemerintah Provinsi yang diangkat oleh pejabat yang berwenang sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_f7ba539b5f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_47 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-f7ba539b5f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/47"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terdapat penyesuaian detail rincian objek atas pelayanan yang diberikan oleh BLUD sebagaimana dimaksud pada ayat (2), penyesuaian detail rincian objek diatur dengan Peraturan Gubernur sesuai ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_f89332606f a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_47 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-f89332606f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/47"^^xsd:string ;
    kbr:hasSourceQuote "Peraturan Gubernur sebagaimana dimaksud pada ayat (4) disampaikan kepada menteri yang menyelenggarakan urusan pemerintahan di bidang keuangan negara, menteri yang menyelenggarakan urusan pemerintahan dalam negeri, dan DPRD paling lambat 7 (tujuh) hari kerja sejak Peraturan Gubernur ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_f9d09d7b97 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
