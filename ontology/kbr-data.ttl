    kbr:hasSourceQuote "Tindak pidana di bidang perpajakan daerah tidak dapat dituntut apabila telah melampaui jangka waktu 5 (lima) tahun terhitung sejak saat Pajak terutang atau masa Pajak berakhir atau bagian Tahun Pajak berakhir atau Tahun Pajak yang bersangkutan berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

