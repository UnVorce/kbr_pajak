    kbr:hasRuleId "R-PP-2022-55-5b01e32962"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "(2) Biaya promosi dan penjualan yang dapat dikurangkan dari penghasilan bruto sebagaimana dimaksud pada ayat (1) hams memperhatikan hal sebagai berikut: a. untuk mempertahankan dan/atau meningkatkan penjualan; b. dikeluarkan PRES IDEN REPUBLIK INDONESIA -25- b. dikeluarkan secara wajar; dan c. menurut adat kebiasaan pedagang yang baik."^^xsd:string ;
