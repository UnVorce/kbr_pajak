    kbr:hasRuleId "R-UU-1995-10-887ff22b4b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "barang yang dinyatakan sebagai barang tidak dikuasai selain yang dimaksud pada ayat (3) pasal ini, oleh Pejabat Bea dan Cukai segera diberitahukan secara tertulis kepada pemiliknya bahwa barang tersebut akan dilelang jika tidak diselesaikan dalam jangka waktu enam puluh hari sejak disimpan di Tempat Penimbunan Pabean."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

