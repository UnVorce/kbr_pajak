    kbr:hasSourceQuote "Dalam hal tersangka tidak memenuhi panggilan sebagaimana dimaksud pada ayat (3), pelaksanaan hak dan pemenuhan kewajiban sebagai tersangka tidak dapat dilakukan oleh kuasa atau penasihat hukum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

