    kbr:hasSourceLocator "UU-1995-10#BT/59"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal tindakan hukum sebagaimana dimaksud pada ayat (2) telah diberitahukan dan ketua pengadilan niaga tidak memperpanjang secara tertulis perintah penangguhan sebagaimana dimaksud dalam Pasal 57 ayat (2), pejabat bea dan cukai mengakhiri tindakan penangguhan pengeluaran barang impor atau ekspor yang bersangkutan dan menyelesaikannya sesuai dengan ketentuan kepabeanan berdasarkan Undang-Undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

