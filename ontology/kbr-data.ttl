    kbr:hasSourceQuote "Jumlah Pajak yang belum dibayar pada saat pengajuan permohonan keberatan sebagaimana dimaksud pada ayat (8) tidak termasuk sebagai Utang Pajak sebagaimana dimaksud dalam Pasal 155 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
