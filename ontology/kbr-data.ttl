    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_22 ;
    kbr:hasRuleId "R-PMK-2023-96-10046c75e3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "(3) Importir menyampaikan PIBK sebagaimana dimaksud pada ayat (1) dilampiri dengan Dokumen Pelengkap Pabean, termasuk dokumen pemenuhan ketentuan larangan atau pembatasan dalam hal Barang Kiriman wajib memenuhi ketentuan larangan atau pembatasan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_11c24dcef0 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_60_1__6 ;
    kbr:hasRuleId "R-PMK-2023-96-11c24dcef0"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/60/1..6"^^xsd:string ;
    kbr:hasSourceQuote "c. surat kuasa, apabila permohonan dibuat oleh Penyelenggara Pos berdasarkan kuasa dari Importir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_1335dc12ac a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_20 ;
    kbr:hasRuleId "R-PMK-2023-96-1335dc12ac"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Barang Kiriman berupa Surat dapat dikeluarkan dari Kawasan Pabean atau tempat lain yang diperlakukan sama dengan TPS sebagai barang yang diimpor untuk dipakai setelah PJT menyampaikan CN beserta Barang Kiriman kepada Pejabat Bea dan Cukai yang menangani Barang Kiriman."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_139deccb4f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_18_5__8 ;
    kbr:hasRuleId "R-PMK-2023-96-139deccb4f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/18/5..8"^^xsd:string ;
    kbr:hasSourceQuote "(8) Barang Kiriman berupa Kartu Pos, Surat, Dokumen, dan Barang Kiriman Terten tu se bagaimana dimaksud pada ayat (7) dimasukkan dalam sub pos tersendiri untuk setiap pos pemberitahuan pabean kedatangan sarana Pengangkut (inward manifest)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

