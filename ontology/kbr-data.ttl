    kbr:hasSourceQuote "Permohonan sebagaimana dimaksud pada ayat (1) disampaikan dengan melampirkan: a. cetakan bukti pembuatan tagihan penerimaan negara bukan Pajak atau yang dipersamakan untuk pembayaran Biaya Penagihan Pajak; dan b. cetakan kode billing untuk pembayaran Utang Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

