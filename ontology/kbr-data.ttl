    kbr:hasSourceLocator "PMK-2024-81#BT/29/1/a"^^xsd:string ;
    kbr:hasSourceQuote "Nilai aktiva pengganti lebih rendah daripada nilai aktiva yang diganti PT Y mendapatkan fasilitas di tahun pajak 2024 dengan nilai penanaman modal sebesar Rp120.000.000.000. Pada tahun 2025, PT Y mulai berproduksi komersial dengan nilai realisasi sebesar Rp 100.000.000.000. Pada tahun pajak 2027, PT Y mengganti aktiva A senilai Rp 30.000.000.000 dengan aktiva B senilai 10.000.000.000 (lebih rendah dari nilai aktiva A)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

