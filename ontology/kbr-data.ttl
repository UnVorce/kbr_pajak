    kbr:diaturDalamPasal kbr:Pasal_PMK_2021_96_BT_16 ;
    kbr:hasRuleId "R-PMK-2021-96-e7aff5cf26"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2021-96#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Surat Ketetapan Pajak Lebih Bayar atau surat penolakan permohonan pengembalian PPnBM sebagaimana dimaksud pada ayat (2), diberikan paling lama 1 (satu) bulan terhitung sejak surat permohonan diterima lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2021_96_e8e10be057 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2021_96 ;
