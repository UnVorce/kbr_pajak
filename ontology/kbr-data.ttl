    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_93_22d2f19a62 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2021_93 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_93_BT_5_1 ;
    kbr:hasRuleId "R-PP-2021-93-22d2f19a62"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-93#BT/5/1"^^xsd:string ;
    kbr:hasSourceQuote "d. dilakukan dalam rangka restrukturisasi yang bertujuan tidak untuk mencari keuntungan dan tidak mengubah kantor pusat Kontraktor (ultimate parent entitg), tidak dikenai Pajak Penghasilan yang bersifat final atas pengalihan Partisipasi Interes sebagaimana dimaksud dalam Pasal 3 ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_93_2329a47a03 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2021_93 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_93_BT_3 ;
    kbr:hasRuleId "R-PP-2021-93-2329a47a03"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-93#BT/3"^^xsd:string ;
