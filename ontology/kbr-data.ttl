kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4cc8b62fd6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
