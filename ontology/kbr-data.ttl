    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pemanfaatan aset Provinsi yang tidak mengganggu penyelenggaraan tugas dan fungsi Perangkat Daerah dan/atau optimalisasi aset Provinsi dengan tidak mengubah status kepemilikan sesuai dengan ketentuan peraturan perundang-undangan sebagaimana dimaksud dalam Pasal 52 ayat (1) huruf e, termasuk pemanfaatan barang milik daerah sesuai dengan ketentuan peraturan perundang-undangan mengenai pengelolaan barang milik daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

