    kbr:hasRuleId "R-UU-1995-10-300f08fa5d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/94"^^xsd:string ;
    kbr:hasSourceQuote "(1) Orang yang dikenai sanksi administrasi berupa denda dapat mengajukan keberatan secara tertulis hanya kepada Direktur Jenderal dalam jangka waktu 60 (enam puluh hari) sejak tanggal penetapan dengan menyerahkan jaminan sebesar sanksi administrasi berupa denda yang ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_305583b244 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_38 ;
    kbr:hasRuleId "R-UU-1995-10-305583b244"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Utang atau tagihan kepada negara berdasarkan Undang-Undang ini yang tidak atau kurang dibayar dikenai bunga sebesar 2% (dua persen) setiap bulan untuk paling lama 24 (dua puluh empat) bulan dihitung sejak tanggal jatuh tempo sampai hari pembayarannya, dan bagian bulan dihitung 1 (satu) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_33f001fc17 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_109 ;
    kbr:hasRuleId "R-UU-1995-10-33f001fc17"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/109"^^xsd:string ;
    kbr:hasSourceQuote "Barang sebagaimana dimaksud pada ayat (1) diselesaikan berdasarkan ketentuan sebagaimana diatur dalam Pasal 73."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_34d7d31d26 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_82 ;
    kbr:hasRuleId "R-UU-1995-10-34d7d31d26"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "Jika permintaan sebagaimana dimaksud pada ayat (2) tidak dipenuhi: a. pejabat bea dan cukai berwenang melakukan tindakan sebagaimana dimaksud pada ayat (2) atas risiko dan biaya yang bersangkutan; dan b. yang bersangkutan dikenai sanksi administrasi berupa denda sebesar Rp25.000.000,00 (dua puluh lima juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

