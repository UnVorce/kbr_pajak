    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_86 ;
    kbr:hasRuleId "R-PMK-2023-61-88f894bb6a"^^xsd:string ;
