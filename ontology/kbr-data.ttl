kbr:Aturan_R_PMK_2014_111_6f6ea85545 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2014_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2014_111_BT_7 ;
    kbr:hasRuleId "R-PMK-2014-111-6f6ea85545"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2014-111#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Sebelum jangka waktu masa berlaku Kartu Izin Praktik sebagaimana dimaksud pada ayat (4) berakhir, Konsultan Pajak harus menyampaikan permohonan kepada Direktur Jenderal Pajak untuk mendapatkan perpanjangan masa berlaku Kartu Izin Praktik."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

