    kbr:hasSourceLocator "PMK-2023-61#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal di 1 (satu) kota terdapat lebih dari 1 (satu) Kantor Wilayah atau Kantor Pelayanan Pajak, 'Kepala Kantor Wilayah atau. Kepala Kantor Pelayanan Pajak yang menerbitkan Surat Paksa dapat memerintahkan Jurusita Pajaknya untuk memberitahukan Surat Paksa di luar wilayah kerjanya sepanjang masih berada di kota setempat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
