kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_02ee848370 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_4 ;
