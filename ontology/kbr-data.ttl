    kbr:hasSourceQuote "Insentif fiskal sebagaimana dimaksud pada ayat (2) dapat diberikan atas permohonan Wajib Pajak dan Wajib Retribusi atau diberikan secara jabatan oleh Walikota berdasarkan pertimbangan :"^^xsd:string ;
