    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "a. penyediaan tempat kegiatan usaha diukur berdasarkan luas tempat usaha, frekuensi layanan, dan/atau jangka waktu pemakaian fasilitas Pasar Grosir, Pertokoan, dan/atau tempat usaha lainnya;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_8281f95526 a kbr:Definisi ;
