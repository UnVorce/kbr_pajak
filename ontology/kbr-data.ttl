    kbr:hasSourceLocator "PP-2022-50#BT/59/8..9"^^xsd:string ;
    kbr:hasSourceQuote "(9) Tata cara penyegelan sebagaimana dimaksud pada ayat(7) huruf d dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
