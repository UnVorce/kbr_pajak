    kbr:hasSourceLocator "PMK-2024-136#BT/3/9..9"^^xsd:string ;
    kbr:hasSourceQuote "Kepentingan Kepemilikan sebagaimana dimaksud pada ayat (9) dihitung berdasarkan nilai perubahan terakhir kepemilikan Entitas"^^xsd:string ;
