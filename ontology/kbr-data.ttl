    kbr:hasSourceLocator "PMK-2023-61#BT/47/4..1"^^xsd:string ;
    kbr:hasSourceQuote "(4) Terhadap pelaksanaan pencabutan sita atas kondisi tertentu sebagaimana dimaksud pada ayat (2) huruf b, Pejabat melakukan Penyitaan terlebih dahulu atas Barang yang diserahkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

