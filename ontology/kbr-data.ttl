kbr:Aturan_R_PP_2022_55_e8bfded6d6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_55 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_73 ;
    kbr:hasRuleId "R-PP-2022-55-e8bfded6d6"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/73"^^xsd:string ;
    kbr:hasSourceQuote "a. kewajiban melakukan pemotongan Pajak Penghasilan sebagaimana dimaksud dalam Pasal 30 bagi pemberi kerja atau pemberi penggantian atau imbalan dalam bentuk natura dan/atau kenikmatan mulai berlaku untuk penghasilan yang diterima atau diperoleh sejak tanggal I Januari 2023;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2022_55_e904dc095d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_55 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_45_1__6 ;
    kbr:hasRuleId "R-PP-2022-55-e904dc095d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/45/1..6"^^xsd:string ;
