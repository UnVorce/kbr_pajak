    kbr:diaturDalam kbr:Reg_PMK_2019_35 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_35_BT_12 ;
    kbr:hasRuleId "R-PMK-2019-35-9f3709a920"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-35#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Tata cara penghapusan Nomor Pokok Wajib Pajak dilaksanakan sesuai dengan peraturan menteri keuangan yang mengatur mengenai tata cara pendaftaran Wajib Pajak dan penghapusan Nomor Pokok Wajib Pajak serta pengukuhan dan pencabutan pengukuhan Pengusaha"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

