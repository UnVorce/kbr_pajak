    kbr:hasSourceQuote "Tahun Pajak sebagaimana dimaksud pada ayat (1) merupakan jangka waktu yang lamanya 1 (satu) tahun kalender, kecuali bila Wajib Pajak menggunakan tahun buku yang tidak sama dengan tahun kalender."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

