    kbr:hasSourceLocator "PMK-2023-172#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "(2) Direktur Jenderal Pajak menyampaikan pemberitahuan tertulis mengenai penghentian perundingan sebagaimana dimaksud pada ayat (1) kepada: a. Pemohon; b. Wajib Pajak dalam negeri yang terkait dengan permintaan pelaksanaan Prosedur Persetujuan Bersama sebagaimana dimaksud dalam Pasal 41 ayat (3) huruf c dan huruf d; dan/atau c. Pejabat Berwenang Mitra Persetujuan Penghindaran Pajak Berganda."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

