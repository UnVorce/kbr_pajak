    kbr:hasSourceQuote "c. 4% (empat persen) untuk kepemilikan dan/atau penguasaan Kendaraan Bermotor ketiga;"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_4c975d352d a kbr:Definisi ;
