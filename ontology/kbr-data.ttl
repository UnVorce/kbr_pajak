    kbr:hasSourceLocator "PMK-2023-61#BT/143/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal terhadap Wajib Pajak diterbitkan Surat Paksa sebagaimana dimaksud dalam Pasal 139 ayat (3) huruf a dan Pasal 141 ayat (2) huruf a, daluwarsa penagihan Pajak dihitung sejak tanggal diberitahukannya Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

