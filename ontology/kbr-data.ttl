    kbr:hasSourceQuote "(3) NJOP sebagaimana dimaksud pada ayat (1) ditetapkan setiap 1 (satu) tahun."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_d259d937db a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_41 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-d259d937db"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/41"^^xsd:string ;
    kbr:hasSourceQuote "(1) Besaran pokok BPHTB yang terutang dihitung dengan cara mengalikan dasar pengenaan BPHTB sebagaimana dimaksud dalam Pasal 39 ayat (1) setelah dikurangi nilai perolehan objek pajak tidak kena pajak sebagaimana dimaksud dalam Pasal 39 ayat (4) atau ayat (5), dengan tarif BPHTB sebagaimana dimaksud dalam Pasal 40."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_d2b2478f47 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_84 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-d2b2478f47"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "Bentuk pemanfaatan barang milik daerah dan tata cara penghitungan besaran tarif sebagaimana dimaksud pada ayat (1) dapat ditetapkan dengan Peraturan Gubernur untuk pemanfaatan barang milik daerah berupa: a. sewa yang masa sewanya lebih dari 1 (satu) tahun; b. kerja sama pemanfaatan; c. bangun guna serah atau bangun serah guna; atau d. kerja sama penyediaan infrastruktur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_d37058ad9b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_1_p2 ;
