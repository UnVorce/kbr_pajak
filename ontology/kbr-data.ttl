    kbr:hasSourceLocator "PMK-2018-192#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(1) Bukti pemenuhan pembayaran PPh Luar Negeri bagi WPDN yang mengkreditkan PPh Luar Negeri sebagaimana dimaksud dalam Pasal 6 ayat ( 1) dapat berupa: a. salinan bukti pembayaran atau bukti pemotongan PPh Luar Negeri; atau b. salinan bukti lainnya yang dapat menunjukkan adanya pembayaran atau pemotongan PPh Luar Negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2018_192_86b3b1ff51 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2018_192 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2018_192_BT_8 ;
    kbr:hasRuleId "R-PMK-2018-192-86b3b1ff51"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2018-192#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(2) Bukti pemenuhan pembayaran PPh Luar Negeri sebagaimana dimaksud pada ayat (1) sekurang- kurangnya memuat data atau informasi sebagai berikut: a . nama WPDN; dan b. jumlah PPh Luar Negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2018_192_86b7dd2997 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2018_192 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2018_192_BT_2 ;
    kbr:hasRuleId "R-PMK-2018-192-86b7dd2997"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2018-192#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "WPDN dikenai Pajak Penghasilan atas penghasilan yang diterima atau diperoleh dalam suatu Tahun Pajak, termasuk penghasilan yang diterima atau diperoleh dari sumber penghasilan di luar negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2018_192_99046adde3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2018_192 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2018_192_BT_4 ;
    kbr:hasRuleId "R-PMK-2018-192-99046adde3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2018-192#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "a . penghasilan usaha termasuk penghasilan dari cabang atau perwakilan WPDN di luar negeri adalah se besar penghasilan neto; b. penghasilan yang berasal dari Trust di luar negen adalah sebesar penghasilan neto atau bagian penghasilan neto yang diterima atau diperoleh WPDN; dan c. penghasilan lainnya adalah sebesar penghasilan neto."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2018_192_a7abb1490b a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2018_192 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2018_192_BT_7 ;
    kbr:hasRuleId "R-PMK-2018-192-a7abb1490b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2018-192#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal jumlah PPh Luar Negeri melebihi besarnya PPh Luar Negeri yang dapat dikreditkan sebagaimana dimaksud dalam Pasal 6 ayat (4), ayat (5), atau ayat (7), kelebihan terse but: a . tidak dapat diperhitungkan dengan Pajak Penghasilan yang terutang; b. tidak boleh dibebankan sebagai biaya atau pengurang penghasilan; dan c. tidak dapat dimintakan restitusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2018_192_b2653e2c85 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2018_192 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2018_192_BT_9 ;
    kbr:hasRuleId "R-PMK-2018-192-b2653e2c85"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2018-192#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal PPh Luar Negeri yang telah dikreditkan ternyata kemudian dikurangkan atau dikembalikan, Pajak Penghasilan yang terutang berdasarkan Undang-Undang PPh ditambah dengan jumlah yang dikurangkan atau dikembalikan terse but pada Tahun Pajak dilakukannya pengurangan atau pengembalian."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2018_192_be6c83c6f6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2018_192 ;
