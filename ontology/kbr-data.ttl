kbr:Aturan_R_PMK_2019_128_600fac01d5 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2019_128 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_128_BT_7_1__5 ;
    kbr:hasRuleId "R-PMK-2019-128-600fac01d5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-128#BT/7/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pemberitahuan sebagaimana dimaksud pada ayat (1) telah diterima secara lengkap dan benar, sistem OSS mengeluarkan notifikasi yang menyatakan Wajib Pajak memenuhi kriteria untuk memperoleh tambahan pengurangan penghasilan bruto kepada Wajib Pajak bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
