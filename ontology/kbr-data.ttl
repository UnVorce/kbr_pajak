    kbr:hasSourceLocator "PMK-2024-118#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "15. Surat Tagihan Pajak Pajak Bumi dan Bangunan adalah"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2024_118_7ee75247fd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_118 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_118_BT_56 ;
    kbr:hasRuleId "R-PMK-2024-118-7ee75247fd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-118#BT/56"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan pencabutan sebagaimana dimaksud dalam Pasal 55 ayat (1) harus memenuhi persyaratan sebagai berikut: a. diajukan secara tertulis dalam bahasa Indonesia dengan disertai alasan pencabutan; b. 1 (satu) permohonan pencabutan untuk 1 (satu) permohonan pembetulan, pengurangan, penghapusan, pembatalan, atau pengajuan keberatan; dan c. surat permohonan pencabutan ditandatangani oleh Wajib Pajak, Wakil, atau Kuasa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2024_118_7f3017f2dc a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_118 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_118_BT_40_1__6 ;
    kbr:hasRuleId "R-PMK-2024-118-7f3017f2dc"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-118#BT/40/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak harus memenuhi permintaan sebagaimana dimaksud pada ayat (4) huruf a paling lama 15 (lima belas) hari kerja sejak tanggal surat permintaan dikirim."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

