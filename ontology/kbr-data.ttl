    kbr:hasSourceQuote "Kerugian Entitas Konstituen yang timbul dari penghasilan sebagaimana dimaksud pada ayat (1) dikecualikan dari penghitungan Laba atau Rugi GloBE."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_80d518c574 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
