    kbr:hasSourceQuote "Nilai Jual Kendaraan Bermotor, yang selanjutnya disingkat NJKB adalah harga pasaran umum atas suatu kendaraan bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_c558000d4d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_74 ;
