kbr:Aturan_R_PMK_2024_81_b41c57589c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_70_1__5 ;
