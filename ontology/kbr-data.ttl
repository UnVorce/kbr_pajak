    kbr:hasSourceLocator "PMK-2023-61#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "(4) Permohonan sebagaimana dimaksud pada ayat (2) disampaikan dengan melampirkan: a. putusan pengadilan sebagaimana dimaksud dalam Pasal 76 ayat (3); . b. surat perintah Penyanderaan; dan c. surat pemberitahuan pelepasan Penanggung Pajak yang disandera."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
