    kbr:hasSourceLocator "PMK-2025-15#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "Surat Ketetapan Pajak atau Surat Ketetapan Pajak Pajak Bumi dan Bangunan dari hasil Pemeriksaan yang dilaksanakan tanpa: a. penyampaian Surat Pemberitahuan Hasil Pemeriksaan; atau b. Pembahasan Akhir Hasil Pemeriksaan, dapat dibatalkan secara jabatan oleh Direktur Jenderal Pajak atau berdasarkan permohonan Wajib Pajak sebagaimana diatur dalam Pasal 36 ayat (1) huruf d Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

