    kbr:hasSourceLocator "PMK-2023-143#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "29. Surat Keputusan Pengembalian Kelebihan Pembayaran Pajak Rokok yang selanjutnya disingkat SKP-KP2R adalah surat keputusan sebagai dasar untuk menerbitkan SPM pengembalian penerimaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

