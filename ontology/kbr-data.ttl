    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "38. Reklame adalah benda, alat, perbuatan, atau media yang bentuk dan corak ragamnya dirancang untuk tujuan komersial memperkenalkan, menganjurkan, mempromosikan, atau menarik perhatian umum terhadap sesuatu."^^xsd:string ;
