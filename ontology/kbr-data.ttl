    kbr:hasSourceQuote "(4) Pemungutan Opsen PKB dan Opsen BBNKB yang dikenakan atas pokok Pajak terutang dilakukan bersamaan dengan Pemungutan Pajak terutang dari PKB dan BBNKB."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

