kbr:Aturan_R_PMK_2025_15_63e5421ac3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_19_1__2 ;
    kbr:hasRuleId "R-PMK-2025-15-63e5421ac3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/19/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(2) Permohonan pembahasan dengan Tim Quality Assurance Pemeriksaan sebagaimana dimaksud pada ayat (1) disampaikan oleh Wajib Pajak, Wakil, atau Kuasa dari Wajib Pajak yang diperiksa kepada: a. Kepala Kantor Wilayah Direktorat Jenderal Pajak dalam hal Pemeriksaan dilakukan oleh Pemeriksa Pajak pada Kantor Pelayanan Pajak atau Kantor Wilayah Direktorat Jenderal Pajak; atau b. Direktur Pemeriksaan dan Penagihan, dalam hal Pemeriksaan dilakukan oleh Pemeriksa Pajak pada Direktorat Pemeriksaan dan Penagihan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_64d61c52c4 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_6_1__5 ;
    kbr:hasRuleId "R-PMK-2025-15-64d61c52c4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/6/1..5"^^xsd:string ;
    kbr:hasSourceQuote "jangka waktu pengujian paling lama 10 (sepuluh) hari kerja"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
