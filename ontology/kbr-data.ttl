    kbr:hasSourceQuote "(3) Saat Retribusi Pelayanan Kesehatan yang terutang terjadi pada saat menggunakan pelayanan kesehatan atau sejak diterbitkan SKRD atau dokumen lain yang dipersamakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

