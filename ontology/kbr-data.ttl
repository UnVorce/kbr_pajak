    kbr:hasSourceLocator "PP-2022-50#BT/7/6..6"^^xsd:string ;
    kbr:hasSourceQuote "(6) Dalam hal setelah Wajib Pajak melakukan pengungkapan ketidakbenaran perbuatan sebagaimana dimaksud pada ayat (5) masih ditemukan data yang menyatakan lain dari pengungkapan ketidakbenaran perbuatan tersebut, terhadap Wajib Pajak tetap dapat dilakukan Pemeriksaan Bukti Permulaan atas Masa Pajak, Bagian Tahun Pajak, dan/atau Tahun Pajak, untuk jenis pajak yang dilakukan pengungkapan ketidakbenaran perbuatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

