    kbr:hasSourceQuote "c. pajak tambahan grup usaha patungan (joint venture group) harus dikurangi dengan bagian yang dapat dialokasikan kepada masing-masing Entitas Induk dari pajak tambahan setiap anggota grup usaha patungan (joint venture group) yang dikenakan berdasarkan Qualified IIR, dan"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
