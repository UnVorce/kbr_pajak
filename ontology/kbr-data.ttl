kbr:Aturan_R_PMK_2019_186_a190a3f4f4 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_22_7__9 ;
    kbr:hasRuleId "R-PMK-2019-186-a190a3f4f4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/22/7..9"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penghitungan PBB terutang menggunakan komponen penerimaan kotor hasil operasi pertambangan sebagaimana diatur secara khusus berdasarkan Kontrak Karya atau Perjanjian Karya Pengusahaan Pertambangan Batubara, penghitungan penenmaan kotor tersebut diperoleh dari perkalian hasil produksi mineral atau batubara sebagaimana dimaksud pada ayat (3) dengan harga jual mineral atau batubara sebagaimana dimaksud pada ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_a7c1a6dbd5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_40_9__11 ;
    kbr:hasRuleId "R-PMK-2019-186-a7c1a6dbd5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/40/9..11"^^xsd:string ;
    kbr:hasSourceQuote "(9) Tanggal diterimanya SPPT oleh Wajib Pajak merupakan: a. tanggal yang tercantum dalam tanda terima penyampaian SPPT, dalam hal disampaikan secara langsung; b. tanggal yang tercantum dalam bukti pengiriman, dalam hal disampaikan melalui pos, perusahaan jasa ekspedisi atau jasa kurir; atau c. tanggal pengiriman melalui saluran elektronik tertentu yang ditetapkan oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_a83fbf6fbb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
