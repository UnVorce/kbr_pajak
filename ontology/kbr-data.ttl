    kbr:hasSourceQuote "PAB untuk kepemilikan dan/atau penguasaan Alat Berat terutang terhitung sejak Wajib Pajak diakui secara sah memiliki dan/atau menguasai Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_4d0dde8b27 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_81 ;
