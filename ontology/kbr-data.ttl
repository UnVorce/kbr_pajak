    kbr:hasSourceQuote "Lembaga Jasa Keuangan sektor pasar modal wajib memberitahukan saldo harta kekayaan Penanggung Pajak paling lama 1 (satu) bulan terhitung sejak tanggal diterimanya permintaan pemberitahuan sebagaimana dimaksud pada ayat (7)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

