    kbr:hasSourceQuote "Penyidik sebagaimana dimaksud pada ayat (1) adalah pejabat pegawai negeri sipil tertentu di lingkungan Pemerintah Daerah Provinsi yang diangkat oleh pejabat yang berwenang sesuai dengan ketentuan peraturan perundang- undangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_3ec8c18de8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_83_1__9 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-3ec8c18de8"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/83/1..9"^^xsd:string ;
    kbr:hasSourceQuote "b. jika SPTPD tidak disampaikan kepada Kepala Perangkat Daerah yang melaksanakan fungsi penunjang pendapatan daerah dalam jangka waktu 15 (lima belas) hari dan setelah ditegur secara tertulis tidak disampaikan pada waktunya sebagaimana ditentukan dalam surat teguran, pajak yang terutang dihitung secara jabatan;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_3eeac30ebd a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_83_1__9 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-3eeac30ebd"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/83/1..9"^^xsd:string ;
    kbr:hasSourceQuote "Atas permohonan Wajib Pajak, Gubernur dapat melakukan pembetulan STPD, SKPD, SKPDKB, SKPDKBT, SKPDN, atau SKPDLB dalam bentuk SKP yang dalam penerbitannya terdapat kesalahan tulis dan/atau kesalahan hitung dan/atau kekeliruan penerapan ketentuan tertentu dalam peraturan perundang-undangan perpajakan Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_3f510aeb4c a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_56 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-3f510aeb4c"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/56"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal kejadian luar biasa yang ditetapkan oleh Gubernur sesuai dengan ketentuan peraturan perundang- undangan, atas pelayanan kesehatan yang diberikan dapat tidak dikenakan retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_403061d3e2 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_83_1__9 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-403061d3e2"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/83/1..9"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak dapat mengajukan banding kepada Pengadilan Pajak dalam jangka waktu 3 (tiga) bulan sejak diterimanya SKK."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_42d9e4a01a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_95 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-42d9e4a01a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Gubernur menetapkan Keputusan Penghapusan Piutang Retribusi yang sudah kedaluwarsa sebagaimana dimaksud pada ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_438dd04b74 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_78 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-438dd04b74"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "Peraturan Gubernur sebagaimana dimaksud pada ayat (3) menjadi dasar dalam penyusunan dokumen perencanaan dan penganggaran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_451cf0f4fb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_11 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-451cf0f4fb"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Dikecualikan dari objek BBNKB sebagaimana dimaksud pada ayat (1) yaitu penyerahan atas: a. kereta api; b. Kendaraan Bermotor yang semata-mata digunakan untuk keperluan pertahanan dan keamanan negara; c. Kendaraan Bermotor kedutaan, konsulat, perwakilan negara asing dengan asas timbal balik, dan lembaga internasional yang memperoleh fasilitas pembebasan pajak dari pemerintah pusat; d. Kendaraan Bermotor berbasis energi terbarukan; dan Dokumen ini telah ditandatangani secara elektronik menggunakan sertifikat elektronik yang diterbitkan oleh Balai Sertifikasi Elektronik (BSrE) Badan Siber dan Sandi Negara. Dokumen digital yang asli dapat diperoleh dengan memindai QR Code, memasukkan kode pada Aplikasi NDE Pemerintah Daerah Provinsi Jawa Barat, atau mengakses tautan berikut https://sidebar.jabarprov.go.id/v/95C90148AA 95C90148AA 12 e. Kendaraan Bermotor yang dimiliki dan/atau dikuasai pabrikan atau importir yang semata-mata tersedia untuk dipamerkan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_45a4df71e6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_81 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-45a4df71e6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "(2) Ketentuan umum dan tata cara pemungutan Pajak dan Retribusi sebagaimana dimaksud pada ayat (1), meliputi pengaturan mengenai: a. pendaftaran dan pendataan Pajak; b. penetapan besaran Pajak dan Retribusi Terutang; c. pembayaran dan penyetoran; d. pelaporan; e. pengurangan, pembetulan, dan pembatalan ketetapan; f. pemeriksaan Pajak; g. penagihan Pajak dan Retribusi; h. keberatan; Dokumen ini telah ditandatangani secara elektronik menggunakan sertifikat elektronik yang diterbitkan oleh Balai Sertifikasi Elektronik (BSrE) Badan Siber dan Sandi Negara. Dokumen digital yang asli dapat diperoleh dengan memindai QR Code, memasukkan kode pada Aplikasi NDE Pemerintah Daerah Provinsi Jawa Barat, atau mengakses tautan berikut https://sidebar.jabarprov.go.id/v/95C90148AA 95C90148AA 31 i. gugatan; j. penghapusan piutang Pajak dan Retribusi oleh Gubernur; dan k. pengaturan lain yang berkaitan dengan tata cara pemungutan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_460af5fedf a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_1_p1 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-460af5fedf"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "11. Wajib Pajak adalah orang pribadi atau badan, meliputi pembayar pajak, pemotong pajak, dan pemungut pajak, yang mempunyai hak dan kewajiban perpajakan sesuai ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_47d7f22279 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_3 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-47d7f22279"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(2) Jenis Pajak sebagaimana dimaksud dalam Pasal 2 yang dipungut berdasarkan penghitungan sendiri oleh Wajib Pajak terdiri atas: a. PBBKB; b. Pajak Rokok; dan c. Opsen Pajak MBLB."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_47fa9431d3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_94 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-47fa9431d3"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/94"^^xsd:string ;
    kbr:hasSourceQuote "Keputusan Gubernur sebagaimana dimaksud pada ayat (4) ditetapkan setelah penagihan dilakukan sampai dengan batas waktu kedaluwarsa penagihan sebagaimana dimaksud dalam Pasal 92 ayat (1), dibuktikan dengan dokumen pelaksanaan penagihan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_48d2ea389b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_51 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-48d2ea389b"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jenis pelayanan yang merupakan objek Retribusi Jasa Umum sebagaimana dimaksud dalam Pasal 49 ayat (1) huruf a adalah pelayanan kesehatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_48ea13b26c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_95 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-48ea13b26c"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Piutang Retribusi yang tidak mungkin ditagih lagi karena hak untuk melakukan penagihan sudah kedaluwarsa dapat dihapuskan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_491cd5a307 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_105 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-491cd5a307"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/105"^^xsd:string ;
    kbr:hasSourceQuote "Pelaporan SPTPD sebagaimana dimaksud pada ayat (1) dilakukan setiap masa Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4a130f377e a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
