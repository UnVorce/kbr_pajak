    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_44_03829b3ab4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_44 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_44_BT_8 ;
    kbr:hasRuleId "R-PP-2022-44-03829b3ab4"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-44#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Penyerahan dilakukan dalam rangka kegiatan usaha atau pekerjaannya sebagaimana dimaksud pada ayat (2) huruf b merupakan seluruh penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak yang diserahkan baik dalam aktivitas operasional maupun aktivitas nonoperasional."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_44_05b5ca9563 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_44 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_44_BT_7 ;
    kbr:hasRuleId "R-PP-2022-44-05b5ca9563"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-44#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Penyerahan Jasa Kena Pajak di dalam Daerah Pabean yang dilakukan oleh Pengusaha yang dimanfaatkan di dalam atau di luar Daerah Pabean dikenai Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_44_084fcc63e4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_44 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_44_BT_27_5 ;
    kbr:hasRuleId "R-PP-2022-44-084fcc63e4"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-44#BT/27/5"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Pertambahan Nilai yang tercantum dalam Faktur Pajak sebagaimana dimaksud pada ayat (4) merupakan Pajak Masukan yang dapat dikreditkan oleh Pengusaha Kena Pajak Pembeli atau Penerima Jasa sepanjang memenuhi ketentuan pengkreditan Pajak Masukan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_44_090be6ccc0 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_44 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_44_BT_27_1__3 ;
    kbr:hasRuleId "R-PP-2022-44-090be6ccc0"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-44#BT/27/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Faktur Pajak yang dibuat dengan mencantumkan identitas Pembeli atau Penerima Jasa berupa nama, alamat, dan nomor induk kependudukan, bagi subjek pajak dalam negeri orang pribadi sesuai dengan ketentuan peraturan perundang-undangan sebagaimana dimaksud pada ayat (2) huruf b angka 2 merupakan Faktur Pajak yang memenuhi ketentuan sebagaimana diatur dalam Pasal 13 ayat (5) huruf b angka I Undang-Undang Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PP_2022_44_0b2c171ae4 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_44 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_44_BT_4 ;
    kbr:hasRuleId "R-PP-2022-44-0b2c171ae4"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-44#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Tanggung jawab secara renteng sebagaimana dimaksud pada ayat (1) dapat ditagih melalui penerbitan surat ketetapan pajak kurang bayar atau surat ketetapan pajak kurang bayar tambahan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan dalam hal Pembeli atau Penerima Jasa tidak atau kurang melakukan pembayaran Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah sebagaimana dimaksud pada ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

