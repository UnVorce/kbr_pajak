    kbr:hasSourceQuote "Pemeriksaan pabean terhadap Barang Kiriman yang diimpor oleh Importir yang mendapat pengakuan sebagai operator ekonomi bersertifikat ( authorized economic operator) dan/ atau Importir yang ditetapkan sebagai mitra utama kepabeanan dilakukan dengan relatif· sedikit."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

