    kbr:hasSourceLocator "PMK-2025-112#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Surat Pemberitahuan adalah surat yang oleh wajib pajak digunakan untuk melaporkan penghitungan dan/atau pembayaran pajak, objek pajak dan/atau bukan objek pajak, dan/atau harta dan kewajiban sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2025_112_bed11dbea3 a kbr:Larangan ;
