    kbr:hasSourceQuote "Subjek Retribusi sebagaimana dimaksud pada ayat (1) merupakan orang pribadi atau Badan yang menggunakan atau menikmati pelayanan Jasa Umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

