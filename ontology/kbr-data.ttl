    kbr:hasRuleId "R-PP-2010-94-05e83291bd"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan mengenai dasar pemotongan Pajak Penghasilan atas pembayaran royalti sebagaimana dimaksud pada ayat (1) diatur dengan Peraturan Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
