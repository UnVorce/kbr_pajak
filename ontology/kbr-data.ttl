    kbr:hasSourceLocator "PP-2021-40#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "Pemasukan barang ke Pelaku Usaha di KEK dari lokasi sebagaimana dimaksud dalam Pasal 90 huruf e, menggunakan pemberitahuan pabean, dan diberikan fasilitas dan kemudahan berupa: a. pembebasan cukai, sepanjang barang tersebut merupakan bahan baku atau bahan penolong dalam pembuatan barang hasil akhir yang bukan merupakan barang kena cukai; dan/atau b. tidak dipungut Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

