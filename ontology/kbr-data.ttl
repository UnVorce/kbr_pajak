    kbr:hasSourceQuote "(7) Penerbitan surat persetujuan atau surat penolakan sebagaimana dimaksud pada ayat (6) dilakukan dalam jangka waktu paling lama 3 (tiga) hari kerja terhitung setelah permohonan diterima secara lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

