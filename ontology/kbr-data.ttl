    kbr:hasSourceLocator "UU-1995-10#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "(3) Ketentuan tentang jaminan diatur lebih lanjut oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
