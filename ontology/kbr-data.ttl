    kbr:hasSourceLocator "PMK-2015-169#BT/3/2..6"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya biaya pinjaman sesuai dengan perbandingan utang dan modal sebagaimana dimaksud dalam Pasal 2 ayat (1) yang dapat diperhitungkan dalam menghitung penghasilan kena pajak juga wajib memperhatikan ketentuan Pasal 6 dan Pasal 9 Undang-Undang Nomor 7 Tahun 1983 tentang Pajak Penghasilan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 36 Tahun 2008."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

