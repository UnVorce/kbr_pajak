    kbr:hasSourceLocator "PMK-2025-15#BT/23/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Penangguhan Pemeriksaan sebagaimana dimaksud pada ayat (1) diberitahukan secara tertulis melalui surat pemberitahuan Pemeriksaan ditangguhkan kepada Wajib Pajak, Wakil, Kuasa, pegawai, atau anggota keluarga yang telah dewasa dari Wajib Pajak yang diperiksa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_8a64d4da15 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_21 ;
