    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_6_1__6 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-926c4a0447"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/6/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dasar pengenaan PKB khusus untuk Kendaraan Bermotor di air, ditetapkan hanya berdasarkan nilai jual Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_926ece2eb2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
