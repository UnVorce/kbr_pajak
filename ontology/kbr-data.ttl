kbr:Aturan_R_UU_1983_8_ceeeee0883 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_1__4a ;
    kbr:hasRuleId "R-UU-1983-8-ceeeee0883"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/1..4a"^^xsd:string ;
    kbr:hasSourceQuote "Apabila dalam suatu Masa Pajak, Pajak Keluaran lebih besar daripada Pajak Masukan, selisihnya merupakan Pajak Pertambahan Nilai yang harus disetor oleh Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_d049b5a3d3 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_16D ;
    kbr:hasRuleId "R-UU-1983-8-d049b5a3d3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/16D"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Pertambahan Nilai dikenakan atas penyerahan Barang Kena Pajak berupa aktiva yang menurut tujuan semula tidak untuk diperjualbelikan oleh Pengusaha Kena Pajak, kecuali atas penyerahan aktiva yang Pajak Masukannya tidak dapat dikreditkan sebagaimana dimaksud dalam Pasal 9 ayat (8) huruf b dan huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_d11d1e900c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_1_p2 ;
    kbr:hasRuleId "R-UU-1983-8-d11d1e900c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "18. Harga Jual adalah nilai berupa uang, termasuk semua biaya yang diminta atau seharusnya diminta oleh penjual karena penyerahan Barang Kena Pajak, tidak termasuk Pajak Pertambahan Nilai yang dipungut menurut Undang-Undang ini dan potongan harga yang dicantumkan dalam Faktur Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_d3d39bb31d a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_6__6d ;
    kbr:hasRuleId "R-UU-1983-8-d3d39bb31d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/6..6d"^^xsd:string ;
    kbr:hasSourceQuote "Apabila sampai dengan jangka waktu 3 (tiga) tahun sejak Masa Pajak pengkreditan pertama kali Pajak Masukan sebagaimana dimaksud pada ayat (2a) Pengusaha Kena Pajak belum melakukan penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak danlatau ekspor Barang Kena Pajak dan/atau Jasa Kena Pajak terkait dengan Pajak Masukan tersebut, Pajak Masukan yang telah dikreditkan dalam jangka waktu 3 (tiga) tahun tersebut menjadi tidak dapat dikreditkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_dcdbd209c7 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_3A ;
