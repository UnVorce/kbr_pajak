    kbr:hasSourceQuote "Walikota dapat menunjuk Bank Umum dan/atau e-commerce yang bertindak sebagai pelaksana operasional sistem online terhadap Pajak Daerah dan Retribusi Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_db0950741c a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
