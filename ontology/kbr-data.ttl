    kbr:hasSourceQuote "Hasil pungutan retribusi sebagaimana dimaksud pada ayat (1) merupakan Pendapatan Asli Daerah yang harus disetor ke Kas Umum Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
