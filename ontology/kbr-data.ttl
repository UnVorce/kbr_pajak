    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_13 ;
    kbr:hasRuleId "R-PMK-2024-79-ce98e9682b"^^xsd:string ;
