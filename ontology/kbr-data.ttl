    kbr:hasSourceQuote "(1) Nilai jual tenaga listrik sebagaimana dimaksud dalam Pasal 25 ayat (1) huruf b ditetapkan untuk: a. Tenaga Listrik yang berasal dari sumber lain dengan pembayaran; dan b. Tenaga Listrik yang dihasilkan sendiri."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
