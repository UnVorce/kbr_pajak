    kbr:hasSourceLocator "UU-2002-14#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Majelis/Hakim Tunggal sebagaimana dimaksud dalam Pasal 47 sudah mulai bersidang dalam jangka waktu 6 (enam) bulan sejak tanggal diterimanya Surat Banding."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
