    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-d291af17ca"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/144"^^xsd:string ;
    kbr:hasSourceQuote "(2) Masa Pajak sebagaimana dimaksud pada ayat (1) merupakan jangka waktu yang digunakan oleh Wajib Pajak untuk menghitung Pajak terutang yang harus dibayarkan atau disetorkan ke kas Daerah dan dilaporkan dalam SPTPD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

