    kbr:hasSourceQuote "NJOP bumi untuk Areal Produktif Perhutanan sebagaimana dimaksud pada ayat (1) huruf a angka 1 ditentukan berdasarkan Nilai Jual Pengganti I DISTRIBUSI II - 23- yang merupakan hasil perkalian pendapatan bersih hasil hutan dengan Angka Kapitalisasi;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_e613590413 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
