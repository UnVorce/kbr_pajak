    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_b075f13262 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_206 ;
    kbr:hasRuleId "R-PMK-2024-81-b075f13262"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/206"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak sebagaimana dimaksud pada ayat (1) yang telah melakukan penyetoran Pajak Penghasilan Pasal 4 - jdih.kemenkeu.go.id -161 - ayat (2) dan telah dilakukan penelitian pembayaran pajak, dianggap telah menyampaikan Surat Pemberitahuan Masa Pajak Penghasilan Unifikasi sesuai dengan tanggal pembayaran yang tercantum dalam Surat Setoran Pajak atau sarana administrasi lain yang disamakan dengan Surat Setoran Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_b086d5dd92 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_246 ;
    kbr:hasRuleId "R-PMK-2024-81-b086d5dd92"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/246"^^xsd:string ;
    kbr:hasSourceQuote "Nilai saham sebagaimana dimaksud pada ayat (1) merupakan: a. nilai saham pada saat penutupan bursa di akhir tahun 1996 atau pada tanggal 30 Desember 1996, apabila saham tersebut telah diperdagangkan di bursa efek dalam tahun 1996 atau sebelumnya; atau b. nilai saham perusahaan pada saat penawaran umum perdana, apabila saham perusahaan diperdagangkan di bursa efek pada atau setelah 1 Januari 1997."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_b08e2bb293 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_239 ;
    kbr:hasRuleId "R-PMK-2024-81-b08e2bb293"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/239"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal pembeli sebagaimana dimaksud pada ayat (1) merupakan Wajib Pajak luar negeri, Perseroan ditunjuk sebagai pemungut pajak. (5) Perseroan sebagai pemungut pajak sebagaimana dimaksud pada ayat (4) membuat bukti pemungutan dan menyampaikannya kepada pihak yang dipungut. (6) Perseroan sebagai pemungut pajak sebagaimana dimaksud pada ayat (4) wajib menyetorkan Pajak Penghasilan Pasal 26 yang dipungut paling lambat tanggal 15 (lima belas) bulan berikutnya setelah bulan saat terutangnya pajak melalui Collecting Agent dan melaporkannya kepada Direktur Jenderal Pajak paling lama 20 (dua puluh) hari setelah Masa Pajak berakhir dengan menggunakan Surat Pemberitahuan Masa Pajak Penghasilan Unifikasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_b0af97af89 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_36 ;
    kbr:hasRuleId "R-PMK-2024-81-b0af97af89"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "(6) Apabila jangka waktu sebagaimana dimaksud pada ayat (5) terlampaui dan Kepala Kantor Pelayanan Pajak tidak menerbitkan keputusan, permohonan W ajib Pajak Warisan Belum Terbagi dianggap dikabulkan dan Kepala Kantor Pelayanan Pajak harus menerbitkan surat keputusan Penghapusan Nomor Pokok Wajib Pajak paling lama 1 (satu) bulan setelah jangka waktu sebagaimana dimaksud pada ayat (4) berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_b146b7ba1f a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_21 ;
    kbr:hasRuleId "R-PMK-2024-81-b146b7ba1f"^^xsd:string ;
