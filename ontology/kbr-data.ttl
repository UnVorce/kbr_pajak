    kbr:hasRuleId "R-UU-1995-10-965b1b5af7"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "Kapal patroli atau sarana lain yang digunakan oleh pejabat bea dan cukai sebagaimana dimaksud pada ayat (1) dapat dilengkapi dengan senjata api yang jumlah dan jenisnya ditetapkan dengan peraturan pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_966fa06994 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_38 ;
    kbr:hasRuleId "R-UU-1995-10-966fa06994"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Penghitungan utang atau tagihan kepada negara menurut Undang-Undang ini dibulatkan jumlahnya dalam ribuan rupiah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9847edf90a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_34 ;
    kbr:hasRuleId "R-UU-1995-10-9847edf90a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal ketentuan sebagaimana dimaksud dalam Pasal 25 dan Pasal 26 tidak lagi dipenuhi, Bea Masuk atas barang impor yang terutang menjadi tanggung jawab : a. Orang yang mendapatkan pembebasan atau kekeringan; atau b. Orang yang menguasai barang yang bersangkutan dalam hal Orang sebagaimana dimaksud huruf a tidak ditemukan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9958e87c71 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_2A ;
    kbr:hasRuleId "R-UU-1995-10-9958e87c71"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/2A"^^xsd:string ;
    kbr:hasSourceQuote "(2) Bea keluar dikenakan terhadap barang ekspor dengan tujuan untuk: a. menjamin terpenuhinya kebutuhan dalam negeri; b. melindungi kelestarian sumber daya alam; c. mengantisipasi kenaikan harga yang cukup drastis dari komoditi ekspor tertentu di pasaran internasional; atau d. menjaga stabilitas harga komoditi tertentu di dalam negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_997d216d9b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_84 ;
    kbr:hasRuleId "R-UU-1995-10-997d216d9b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat Bea dan Cukai berwenang meminta kepada importir atau eksportir untuk menyerahkan buku, catatan, surat menyurat yang bertalian dengan Impor atau Ekspor, dan mengambil contoh barang untuk pemeriksaan Pemberitahuan Pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9bee85b874 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_42 ;
    kbr:hasRuleId "R-UU-1995-10-9bee85b874"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jaminan yang disyaratkan menurut Undang-undang ini dapat dipergunakan : a. sekali; atau b. terus-menerus."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9ce2193153 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_2 ;
    kbr:hasRuleId "R-UU-1995-10-9ce2193153"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Barang yang telah dimuat di sarana pengangkut untuk dikeluarkan dari daerah pabean dianggap telah diekspor dan diperlakukan sebagai barang ekspor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9d4fda6276 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_109 ;
    kbr:hasRuleId "R-UU-1995-10-9d4fda6276"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/109"^^xsd:string ;
    kbr:hasSourceQuote "Barang impor sebagaimana dimaksud dalam Pasal 102, Pasal 103 huruf d, atau Pasal 104 huruf a, barang ekspor sebagaimana dimaksud dalam Pasal 102A, atau barang tertentu sebagaimana dimaksud dalam Pasal 102D yang berasal dari tindak pidana, dirampas untuk negara."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9e11d3a0f3 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_52 ;
    kbr:hasRuleId "R-UU-1995-10-9e11d3a0f3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/52"^^xsd:string ;
    kbr:hasSourceQuote "(1) Orang yang tidak menyelenggarakan pembukuan sebagaimana dimaksud dalam Pasal 49 dikenai sanksi administrasi berupa denda sebesar Rp50.000.000,00 (lima puluh juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9ec7bdb824 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_15_1__5 ;
    kbr:hasRuleId "R-UU-1995-10-9ec7bdb824"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/15/1..5"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal nilai pabean untuk penghitungan bea masuk tidak dapat ditentukan berdasarkan nilai transaksi sebagaimana dimaksud pada ayat (1), ayat (2) , ayat (3), dan metode deduksi sebagaimana dimaksud pada ayat (4) , nilai pabean untuk penghitungan bea masuk ditentukan berdasarkan metode komputasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9ef80e9b1f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_50 ;
    kbr:hasRuleId "R-UU-1995-10-9ef80e9b1f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/50"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal orang sebagaimana dimaksud pada ayat (1) tidak berada di tempat, kewajiban untuk menyerahkan laporan keuangan, buku, catatan dan dokumen yang menjadi bukti dasar pembukuan, surat yang berkaitan dengan kegiatan usaha termasuk data elektronik, surat yang berkaitan dengan kegiatan di bidang kepabeanan beralih kepada yang mewakili."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_9f9eb31760 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_88 ;
    kbr:hasRuleId "R-UU-1995-10-9f9eb31760"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/88"^^xsd:string ;
    kbr:hasSourceQuote "Selama pemeriksaan atas bangunan atau tempat sebagaimana dimaksud pada ayat (1) dan atas permintaan pejabat bea dan cukai, pemilik atau yang menguasai bangunan atau tempat tersebut wajib menyerahkan surat atau dokumen yang berkaitan dengan barang yang berada di tempat tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

