    kbr:diaturDalam kbr:Reg_PMK_2022_112 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2022_112_BT_9 ;
    kbr:hasRuleId "R-PMK-2022-112-e14db18039"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2022-112#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Nomor Identitas Tempat Kegiatan Usaha sebagaimana dimaksud pada ayat ( 1) disampaikan oleh Direktur Jenderal Pajak kepada Wajib Pajak melalui: a. laman Direktorat Jenderal Pajak; b. alamat pos elektronik Wajib Pajak; c. contact center Direktorat Jenderal Pajak; dan/ atau d. saluran lainnya yang ditentukan Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2022_112_f650aba126 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PMK_2022_112 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2022_112_BT_10 ;
    kbr:hasRuleId "R-PMK-2022-112-f650aba126"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2022-112#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal layanan administrasi perpajakan dan administrasi pihak lain belum dapat menggunakan Nomor Pokok Wajib Pajak dengan format 16 (enam belas) digit, Wajib Pajak orang pribadi bukan Penduduk, Wajib Pajak Badan, dan Wajib Pajak Instansi Pemerintah tetap dapat menggunakan Nomor Pokok Wajib Pajak dengan format 15 (lima belas) digit untuk pelaksanaan hak dan pemenuhan kewajiban perpajakan sampai dengan tanggal 31 Desember 2023."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2022_112_f7b5dff694 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2022_112 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2022_112_BT_11 ;
    kbr:hasRuleId "R-PMK-2022-112-f7b5dff694"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2022-112#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "a. Wajib Pajak menggunakan Nomor Induk Kependudukan sebagai Nomor Pokok Wajib Pajak dan Nomor Pokok Wajib Pajak dengan format 16 (enam belas) digit dalam layanan administrasi yang diselenggarakan oleh Direktorat Jenderal Pajak dan pihak lain;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

