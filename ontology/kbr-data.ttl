    kbr:hasSourceQuote "(2) Dalam hal pembayaran sebagaimana dimaksud pada ayat (1) menggunakan voucer atau bentuk lain yang sejenis yang memuat nilai rupiah atau mata uang lain, dasar pengenaan PBJT ditetapkan sebesar nilai rupiah atau mata uang lainnya tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

