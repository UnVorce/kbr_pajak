    kbr:hasSourceQuote "26. Surat Ketetapan Pajak Lebih Bayar adalah Surat Ketetapan Pajak yang menentukan jumlah kelebihan pembayaran pajak karenajumlah kredit pajak lebih besar daripada pajak yang terutang atau seharusnya tidak terutang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

