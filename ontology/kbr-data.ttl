    kbr:hasRuleId "R-PERPRES-2018-40-a8afeb50e9"^^xsd:string ;
    kbr:hasSourceLocator "PERPRES-2018-40#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "Penyusunan Harga Perkiraan Sendiri untuk pengadaan barang dan/atau jasa sebagaimana dimaksud dalam Pasal 10 ayat(2) rhurufb, hurufc, dan hurufd dilakukan berdasarkan keahlian dan bersumber dari: a. perkiraan perhitungan biaya yang dilakukan oleh konsultan (engineer's e stimatel ; b. kontrak sejenis; dan/atau c. informasi yang dapat dipertanggungjawabkan. Penyusunan Harga Perkiraan Sendiri tidak diperlukan untuk pengadaan sistem informasi sebagaimana dirnaksud dalam Pasal 10 ayat (2) huruf a."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

