    kbr:hasSourceLocator "UU-1985-12#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya Nilai Jual Objek Pajak Tidak Kena Pajak ditetapkan sebesar Rp.8.000.000,00 (delapan juta rupiah) untuk setiap Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_7dfc287cc8 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_28 ;
    kbr:hasRuleId "R-UU-1985-12-7dfc287cc8"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap Iuran Pembangunan Daerah (Ipeda), Pajak Kekayaan (PKk), Pajak Jalan, dan Pajak Rumah Tangga (PRT) yang terhutang untuk tahun pajak 1985 dan sebelumnya berlaku ketentuan peraturan perundang-undangan perpajakan yang lama sampai dengan tanggal 31 Desember 1990."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_806a67d2c6 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_3 ;
    kbr:hasRuleId "R-UU-1985-12-806a67d2c6"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "a. digunakan semata-mata untuk melayani kepentingan umum di bidang ibadah, sosial, kesehatan, pendidikan dan kebudayaan nasional, yang tidak dimaksudkan untuk memperoleh keuntungan;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_88b1dffa7e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_8 ;
    kbr:hasRuleId "R-UU-1985-12-88b1dffa7e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(1) Tahun pajak adalah jangka waktu satu tahun takwim."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
