    kbr:hasSourceQuote "Bea masuk sebagaimana dimaksud pada ayat (4) huruf a, dan ayat 5 huruf (a), termasuk bea masuk anti dumping, bea masuk imbalan, bea masuk tindakan pengamanan, dan bea masuk pembalasan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

