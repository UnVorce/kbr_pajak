    kbr:hasSourceQuote "Surat Pemberitahuan Pajak Daerah yang selanjutnya disingkat SPTPD adalah Surat Pemberitahuan Pajak Daerah yang digunakan oleh Wajib Pajak untuk melaporkan perhitungan dan pembayaran pajak yang terutang menurut ketentuan peraturan perundang-undangan perpajakan Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

