    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_179 ;
    kbr:hasRuleId "R-PMK-2024-81-d82d34f78f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/179"^^xsd:string ;
    kbr:hasSourceQuote "(1) Apabila Surat Pemberitahuan tidak disampaikan dalam jangka waktu penyampaian atau batas waktu perpanjangan penyampaian Surat Pemberitahuan, Wajib Pajak dikenai sanksi administratif berupa denda sesuai dengan ketentuan dalam Pasal 7 ayat (1) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_d85ae8780d a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_183_1__4 ;
    kbr:hasRuleId "R-PMK-2024-81-d85ae8780d"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/183/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan telah ditegur secara tertulis sebagaimana dimaksud pada ayat ( 1) huruf d, tidak berlaku atas Surat Pemberitahuan lebih bayar untuk Masa, Tahun Pajak atau Bagian Tahun Pajak pada saat: a. Wajib Pajak belum terdaftar; b. Wajib Pajak merupakan Wajib Pajak Nonaktif; atau c. Wajib Pajak dikecualikan dari kewajiban penyampaian Surat Pemberitahuan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_d8b0e6ebb4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_131_5__9 ;
    kbr:hasRuleId "R-PMK-2024-81-d8b0e6ebb4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/131/5..9"^^xsd:string ;
    kbr:hasSourceQuote "(8) Dalam hal berdasarkan laporan hasil penelitian tidak terdapat kelebihan pembayaran pajak yang seharusnya tidak terutang, Direktur Jenderal Pajak menyampaikan pemberitahuan penolakan permohonan pengembalian - jdih.kemenkeu.go.id - 110 - kelebihan pembayaran pajak yang seharusnya tidak terutang kepada pemohon sesuai dengan ketentuan sebagaimana dimaksud dalam Pasal 12."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_d91512b0e8 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_29_1_b__a ;
    kbr:hasRuleId "R-PMK-2024-81-d91512b0e8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/29/1/b..a"^^xsd:string ;
    kbr:hasSourceQuote "b. Tuan H (Subjek Pajak Luar Negeri dengan negara domisili tanpa perjanjian penghindaran pajak berganda) sebesar Rp100.000.000 Persentase besaran 500. 000. 000. 000 dividen yang = mendapatkan fasilitas (l.500.000.000.000 + 500.000.000.000) = 25% Dividen Tuan H yang mendapatkan fasilitas: 25% x Rp100.000.000 = Rp25.000.000 (mendapatkan fasilitas tarif 10%) Dividen Tuan H yang tidak mendapatkan fasilitas: Rp100.000.000 - Rp25.000.000 = Rp75.000.000 (menggunakan tarif Pasal 26 Undang-Undang Pajak Penghasilan)"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

