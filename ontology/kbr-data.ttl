    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/97"^^xsd:string ;
    kbr:hasSourceQuote "Kondisi Wajib Pajak sebagaimana dimaksud pada ayat (1) meliputi kemampuan membayar Wajib Pajak atau tingkat likuiditas Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

