    kbr:hasSourceQuote "(1) Dalam hal terdapat selisih kekurangan Pajak Penghasilan yang terutang berdasarkan Nilai Kontrak Jasa Konstruksi dengan Pajak Penghasilan berdasarkan pembayaran yang telah dipotong atau disetor sendiri sebagaimana dimaksud dalam Pasal 5 ayat (1), selisih kekurangan tersebut disetor sendiri oleh Penyedia Jasa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

