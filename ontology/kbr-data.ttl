    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-5c82a19235"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/1#p4"^^xsd:string ;
    kbr:hasSourceQuote "Retribusi Pelayanan Pasar adalah pungutan Daerah sebagai pembayaran atas pemberian pelayanan Pasar yang diselenggarakan oleh Pemerintah Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_5c89ce3a44 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
