    kbr:hasSourceQuote "Tarif PKB untuk kepemilikan dan/atau penguasaan Kendaraan Bermotor pertama ditetapkan sebesar 1,12% (satu koma satu dua persen)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4abde2d1ec a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_6_1__6 ;
