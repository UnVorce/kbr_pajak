    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/90"^^xsd:string ;
    kbr:hasSourceQuote "(4) Ketentuan lebih lanjut mengenai administrasi dan tata cara keringanan, pengurangan, pembebasan, dan penundaan pembayaran atas pokok Pajak, pokok Retribusi, dan/atau sanksinya diatur dalam Peraturan Wali Kota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_b1e34eb5ca a kbr:Definisi ;
