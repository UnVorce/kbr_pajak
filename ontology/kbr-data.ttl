kbr:Aturan_R_PMK_2023_61_d1e372def8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_46 ;
    kbr:hasRuleId "R-PMK-2023-61-d1e372def8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/46"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal telah diterima berita acara Pemblokiran atau dokumen yang dipersamakan sebagaimana dimaksud dalam Pasal 43 ayat (1) dan Penanggung Pajak tetap tidak melunasi Utang Pajak dan Biaya. Penagihan Pajak, Jurusita Pajak melaksanakan Penyitaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

