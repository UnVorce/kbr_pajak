    kbr:hasSourceLocator "PMK-2023-61#BT/9/2/b..d"^^xsd:string ;
    kbr:hasSourceQuote "3. sekutu komanditer/ sekutu pasif bertanggung jawab atas Utang Pajak dan Biaya Penagihan Pajak secara proporsional berdasarkan porsi kepemilikan modal terhadap Utang Pajak Wajib Pajak Badan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
