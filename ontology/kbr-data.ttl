    kbr:hasRuleId "R-PMK-2023-172-401007b08e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/61/2..5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal perundingan Kesepakatan Harga Transfer menghasilkan ketidaksepakatan sebagaimana dimaksud pada ayat (1), Direktur Jenderal Pajak menghentikan proses Kesepakatan Harga Transfer dan menerbitkan pemberitahuan tertulis kepada Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

