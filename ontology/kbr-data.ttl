    kbr:hasSourceQuote "(1) Retribusi Pelayanan Parkir di Tepi Jalan Umum dipungut di wilayah Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_1b22347323 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
