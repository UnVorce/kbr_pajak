    kbr:hasSourceQuote "Bea Masuk Imbalan sebagaimana dimaksud pada ayat (1) merupakan tambahan dari Bea Masuk yang dipungut berdasarkan Pasal 12 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_4ef18b8603 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_54 ;
    kbr:hasRuleId "R-UU-1995-10-4ef18b8603"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/54"^^xsd:string ;
    kbr:hasSourceQuote "Atas permintaan pemilik atau pemegang hak atas merek atau hak cipta, ketua pengadilan niaga dapat mengeluarkan perintah tertulis kepada pejabat bea dan cukai untuk menangguhkan sementara waktu pengeluaran barang impor atau ekspor dari kawasan pabean yang berdasarkan bukti yang cukup, diduga merupakan hasil pelanggaran merek dan hak cipta yang dilindungi di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_4f6a4e10de a kbr:Kewajiban ;
