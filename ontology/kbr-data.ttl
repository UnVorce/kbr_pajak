    kbr:hasSourceQuote "Pembayaran sebanyak-banyaknya 20% (dua puluh persen) dari manfaat pensiun yang dibayarkan secara sekaligus pada saat Pegawai sebagai peserta pensiun atau meninggal dunia;"^^xsd:string ;
