    kbr:hasSourceQuote "Opsen Pajak Kendaraan Bermotor yang selanjutnya disebut Opsen PKB adalah Opsen yang dikenakan oleh Kabupaten/Kota atas pokok PKB sesuai ketentuan peraturan perundang-undangan."^^xsd:string ;
