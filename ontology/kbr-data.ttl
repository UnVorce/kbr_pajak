    kbr:hasSourceQuote "16. Anggota KSO yang selanjutnya disebut Anggota adalah orang pribadi atau Badan termasuk bentuk usaha tetap yang melakukan perjanjian kerja sama KSO."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

