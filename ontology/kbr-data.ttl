    kbr:hasSourceQuote "a. surat persetujuan atas permohonan pengenaan Pajak Penghasilan hanya atas penghasilan yang diterima atau diperoleh dari Indonesia, apabila persyaratan sebagaimana dimaksud dalam Pasal 443 terpenuhi;"^^xsd:string ;
