    kbr:hasSourceQuote "Berdasarkan permohonan pendaftaran Wajib Pajak orang pribadi sebagaimana dimaksud dalam Pasal 19, Kepala Kantor Pelayanan Pajak menerbitkan Nomor Pokok Wajib Pajak paling lama 1 (satu) hari kerja setelah permohonan diterima secara lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

