    kbr:hasSourceQuote "Pemeriksaan tersangka tindak pidana di bidang perp4jakan tidak dilakukan apabila yang bersangkutan telah dipanggil 2 (dua) kali secara sah dan tidak hadir tanpa memberikan alasan yang patut dan wajar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_a085072881 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_47 ;
    kbr:hasRuleId "R-PP-2022-50-a085072881"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/47"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak menyetujui seluruh jumlah pajak yang masih harus dibayar dalam Pembahasan Akhir Hasil Pemeriksaan, pelunasan atas jumlah pajak yang masih harus dibayar dilakukan paling lama 1 (satu) bulan terhitung sejak tanggal penerbitan Surat Ketetapan Pajak sebagaimana dimaksud dalam Pasal 9 ayat (3) Undang- Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

