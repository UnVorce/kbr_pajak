    kbr:hasSourceQuote "a . pakaian seragam; b. peralatan untuk keselamatan kerja; c. sarana antar jemput Pegawai; d. penginapan untuk awak kapal dan sejenisnya; dan/atau e. natura dan/atau kenikmatan yang diterima dalam rangka penanganan endemi, pandemi, atau bencana nasional."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

