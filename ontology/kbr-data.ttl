    kbr:hasSourceQuote "9 (sembilan) bulan sampai dengan 12 (dua belas) bulan ditetapkan sebesar Rp. 300.000,00 (tiga ratus ribu rupiah)"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
