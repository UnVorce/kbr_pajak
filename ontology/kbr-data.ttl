    kbr:hasRuleId "R-PMK-2023-61-500b3e611c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Rekening Keuangan adalah rekening yang dikelola oleh Lembaga Jasa Keuangan, Lembaga Jasa Keuangan Lainnya, dan/ atau Entitas Lain, yang meliputi rekening bagi bank, rekening efek dan subrekening efek bagi perusahaan efek dan bank kustodian, polis asuransi bagi perusahaan asuransi, dan/atau aset keuangan lain bagi Lembaga Jasa Keuangan Lainnya dan/atau Entitas Lain."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

