    kbr:hasSourceLocator "UU-1995-10#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "a. kelebihan pembayaran bea masuk sebagaimana dimaksud dalam Pasal 16 ayat (5), Pasal 17 ayat (3), atau karena kesalahan tata usaha;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_77a77aabd4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_82A ;
    kbr:hasRuleId "R-UU-1995-10-77a77aabd4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/82A"^^xsd:string ;
    kbr:hasSourceQuote "Untuk kepentingan pengawasan, pejabat bea dan cukai berwenang melakukan pemeriksaan karena jabatan atas fisik barang impor atau barang ekspor sebelum atau sesudah pemberitahuan pabean disampaikan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_786319a0a8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_67 ;
    kbr:hasRuleId "R-UU-1995-10-786319a0a8"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/67"^^xsd:string ;
    kbr:hasSourceQuote "(5) Harga terendah untuk barang yang akan dilelang sebagaimana dimaksud pada ayat (1) ditetapkan oleh Menteri, jika harga yang ditetapkan tidak tercapai, barang dapat dimusnahkan atau untuk tujuan lain atas persetujuan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_7923139d6d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_91 ;
    kbr:hasRuleId "R-UU-1995-10-7923139d6d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "Untuk keperluan pemeriksaan sebagaimana dimaksud dalam Pasal 90 ayat (1) atas permintaan atau isyarat Pejabat Bea dan Cukai, pengangkut wajib menghentikan sarana pengangkutnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_7c3a27e45b a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_90 ;
    kbr:hasRuleId "R-UU-1995-10-7c3a27e45b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/90"^^xsd:string ;
    kbr:hasSourceQuote "Sarana pengangkut yang disegel oleh penegak hukum lain atau dinas pos dikecualikan dari pemeriksaan sebagaimana dimaksud pada ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_7d33ea9355 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_82 ;
    kbr:hasRuleId "R-UU-1995-10-7d33ea9355"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang salah memberitahukan jenis dan/atau jumlah barang dalam pemberitahuan pabean atas impor yang mengakibatkan kekurangan pembayaran bea masuk dikenai sanksi administrasi berupa denda paling sedikit 100% (seratus persen) dari bea masuk yang kurang dibayar dan paling banyak 1.000% (seribu persen) dari bea masuk yang kurang dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_7d7a5506cb a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_37 ;
    kbr:hasRuleId "R-UU-1995-10-7d7a5506cb"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Kewajiban membayar bea masuk sebagaimana dimaksud pada ayat (1) dapat diberikan penundaan dalam hal pembayarannya ditetapkan secara berkala atau menunggu keputusan pembebasan atau keringanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_7df41d8c61 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_89 ;
    kbr:hasRuleId "R-UU-1995-10-7df41d8c61"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/89"^^xsd:string ;
    kbr:hasSourceQuote "(4) Barangsiapa yang menyebabkan Pejabat Bea dan Cukai tidak dapat melaksanakan ketentuan sebagaimana dimaksud dalam Pasal 87 dan Pasal 88 dikenai sanksi administrasi berupa denda sebesar Rp. 5.000.000,00 (lima juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_7e3cbb5f0e a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_16 ;
    kbr:hasRuleId "R-UU-1995-10-7e3cbb5f0e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "importir yang salah memberitahukan nilai pabean untuk penghitungan bea masuk sehingga mengakibatkan kekurangan pembayaran bea masuk dikenai sanksi administrasi berupa denda paling sedikit 100% (seratus persen) dari bea masuk yang kurang dibayar dan paling banyak 1000% (seribu persen) dari bea masuk yang kurang dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_7eceed4b6a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_95 ;
    kbr:hasRuleId "R-UU-1995-10-7eceed4b6a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Orang yang berkeberatan terhadap penetapan Direktur Jenderal atas tarif dan nilai pabean sebagaimana dimaksud dalam Pasal 17 ayat (2), keputusan Direktur Jenderal sebagaimana dimaksud dalam Pasal 93 ayat (2), Pasal 93A ayat (4), atau Pasal 94 ayat (2) dapat mengajukan permohonan banding kepada Pengadilan Pajak dalam jangka waktu 60 (enam puluh) hari sejak tanggal penetapan atau tanggal keputusan, setelah pungutan yang terutang dilunasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_80a37875d8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
