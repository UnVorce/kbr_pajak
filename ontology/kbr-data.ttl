    kbr:hasSourceLocator "PMK-2024-136#BT/27/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Entitas Konstituen sebagaimana dimaksud pada ayat (1) tidak menyusun laporan keuangan secara terpisah dari Entitas Utama, Entitas Konstituen harus menghitung laba atau rugi bersih akuntansi keuangan - 41 - yang seharusnya dibukukan sesuai dengan standar akuntansi yang digunakan dalam menyusun Laporan Keuangan Konsolidasi dari Entitas Induk Utama."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

