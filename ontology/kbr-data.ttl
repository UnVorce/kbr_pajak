    kbr:hasSourceQuote "Pejabat Bea dan Cukai dan/atau SKP menetapkan tarif dan nilai pabean berdasarkan pemeriksaan pabean sebagaimana dimaksud dalam Pasal 24 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

