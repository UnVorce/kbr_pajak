    kbr:hasSourceQuote "(4) Terhadap pelaksanaan pencabutan sita sebagaimana dimaksud pada ayat (2) huruf b dan huruf h, Pejabat melakukan Penyitaan terlebih dahulu atas Barang yang diserahkan atau didapatkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
