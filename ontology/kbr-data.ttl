    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_4 ;
    kbr:hasRuleId "R-PERPU-2017-1-87b1070779"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Lembaga jasa keuangan, lembaga jasa keuangan lainnya, dan/ atau entitas lain wajib memberikan informasi dan/ atau bukti atau keterangan sebagaimana dimaksud pada ayat (1) kepada Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_8cd003f300 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_6 ;
    kbr:hasRuleId "R-PERPU-2017-1-8cd003f300"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "Menteri Keuangan dan/ atau pegawai Kementerian Keuangan dalam melaksanakan tugas yang berkaitan dengan pelaksanaan akses dan pertukaran informasi keuangan untuk kepentingan perpajakan, tidak dapat dituntut secara pidana maupun digugat secara perdata."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_92ae2b5a26 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_2_1 ;
    kbr:hasRuleId "R-PERPU-2017-1-92ae2b5a26"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/2/1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal lembaga jasa keuangan, lembaga jasa keuangan lainnya, dan/ atau entitas lain sebagaimana dimaksud pada ayat (1) terikat oleh kewajiban merahasiakan berdasarkan ketentuan peraturan perundang-undangan, kewajiban merahasiakan tersebut tidak berlaku dalam melaksanakan Peraturan Pemerintah Pengganti Undang- Undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_97fee039a4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_3 ;
    kbr:hasRuleId "R-PERPU-2017-1-97fee039a4"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "b. Otoritas Jasa Keuangan menyampaikan kepada Direktorat Jenderal Pajak paling lama 30 (tiga puluh) hari sebelum batas waktu berakhirnya periode pertukaran informasi keuangan antara Indonesia dengan negara atau yurisdiksi lain berdasarkan perjanjian internasional di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_99cd3a3278 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_2_1 ;
    kbr:hasRuleId "R-PERPU-2017-1-99cd3a3278"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/2/1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal diminta oleh Direktur Jenderal Pajak, lembaga jasa keuangan, lembaga jasa keuangan lainnya, dan/atau entitas lain sebagaimana dimaksud pada ayat (1) yang memperoleh atau menyelenggarakan dokumentasi dalam bahasa lain selain Bahasa Indonesia, harus memberikan terjemahan dokumentasi dimaksud ke dalam Bahasa Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_b2844c293b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_2_3__6 ;
    kbr:hasRuleId "R-PERPU-2017-1-b2844c293b"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/2/3..6"^^xsd:string ;
    kbr:hasSourceQuote "Dalam rangka penyampaian laporan sebagaimana dimaksud pada ayat (2) huruf a, lembaga jasa keuangan, lembaga jasa keuangan lainnya, dan/ atau entitas lain sebagaimana dimaksud pada ayat (1) wajib melakukan prosedur identifikasi rekening keuangan sesuai standar pertukaran informasi keuangan berdasarkan perjanjian internasional di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_cf81d09644 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_6 ;
    kbr:hasRuleId "R-PERPU-2017-1-cf81d09644"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "Pimpinan dan/ atau pegawai Otoritas Jasa Keuangan yang memenuhi kewajiban penyampaian laporan sebagaimana dimaksud dalam Pasal 3 ayat (1) huruf a, tidak dapat dituntut secara pidana dan/atau digugat secara perdata."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_e53859c82c a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_6 ;
    kbr:hasRuleId "R-PERPU-2017-1-e53859c82c"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "Pimpinan dan/ atau pegawai lembaga jasa keuangan, pimpinan dan/ atau pegawai lembaga jasa keuangan lainnya, dan pimpinan dan/ atau pegawai entitas lain sebagaimana dimaksud dalam Pasal 2 ayat (1) yang memenuhi kewajiban penyampaian laporan sebagaimana dimaksud dalam Pasal 2 ayat (2), dan/ atau pemberian informasi dan/atau bukti atau keterangan sebagaimana dimaksud dalam Pasal 4 ayat (2), tidak dapat dituntut secara pidana dan/ atau digugat secara perdata."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PERPU_2017_1_f0c43dd825 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERPU_2017_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERPU_2017_1_BT_2_1 ;
    kbr:hasRuleId "R-PERPU-2017-1-f0c43dd825"^^xsd:string ;
    kbr:hasSourceLocator "PERPU-2017-1#BT/2/1"^^xsd:string ;
    kbr:hasSourceQuote "a. pembukaan rekening keuangan baru bagi nasabah baru; atau b. transaksi baru terkait rekening keuangan bagl nasabah lama, yang menolak untuk mematuhi ketentuan identilikasi rekening keuangan sebagaimana dimaksud pada ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_004a286626 a kbr:Kewajiban ;
