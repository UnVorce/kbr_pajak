    kbr:hasSourceQuote "(1) Wajib Pajak dapat mengajukan keberatan kepada Walikota atau Pejabat yang ditunjuk terhadap SPPT, SKPD, SKPDKB, SKPDKBT, SKPDLB, SKPDN, atau pemotongan atau Pemungutan oleh pihak ketiga."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_8771bda359 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_48 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-8771bda359"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "(1) Wilayah pemungutan Opsen BBNKB yang terutang merupakan wilayah Daerah tempat kendaraan bermotor terdaftar. (2) Besaran pokok Opsen BBNKB yang terutang dihitung dengan cara mengalikan dasar pengenaan pajak sebagaimana dimaksud dalam Pasal 47 ayat (1) dengan tarif sebagaimana dimaksud dalam Pasal 47 ayat (2). (3) Saat terutang Opsen BBNKB ditetapkan pada saat terutangnya BBNKB."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

