    kbr:hasSourceQuote "kedaluwarsa Penagihan Pajak sebagaimana dimaksud pada ayat (1) tertangguh apabila sebelum jangka waktu sebagaimana dimaksud pada ayat (2): a. diterbitkan Surat Teguran dan/atau Surat Paksa; atau b. ada pengakuan Utang Pajak dari Wajib Pajak, baik langsung maupun tidak langsung."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

