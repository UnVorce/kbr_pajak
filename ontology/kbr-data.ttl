    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2023_48_bc24bedcfe a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_48 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_48_BT_8_1__6 ;
