    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/7/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dasar pengenaan PKB merupakan hasil perkalian antara 2 (dua) unsur pokok, yaitu: a. NJKB; dan b. bobot yang mencerminkan secara relatif tingkat kerusakan jalan dan/atau pencemaran lingkungan akibat penggunaan Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_c326f37dcb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
