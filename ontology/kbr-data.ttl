    kbr:hasSourceQuote "f. Barang sitaan telah dilakukan penjualan secara lelang atau penggunaan, penjualan, dan/ atau pemindahbukuan Barang sitaan yang dikecualikan dari penjualan secara lelang;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
