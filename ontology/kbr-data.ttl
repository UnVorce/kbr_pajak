    kbr:hasSourceLocator "PMK-2023-168#BT/21/2..2"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan mengenai kewajiban sebagaimana dimaksud pada ayat ( 1) tetap berlaku dalam hal terdapat penghasilan yang diberikan, termasuk apabila jumlah pajak yang dipotong pada bulan yang bersangkutan nihil."^^xsd:string ;
