    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_35_1__7 ;
    kbr:hasRuleId "R-PMK-2023-96-a31ff3672c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/35/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(4) Apabila pelunasan bea masuk melebihi jangka waktu yang ditetapkan sebagaimana dimaksud pada ayat (1) dan ayat (2) , Penyelenggara Pos dikenai sanksi administrasi berupa denda sebesar 10% (sepuluh persen) dari bea masuk yang wajib dilunasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

