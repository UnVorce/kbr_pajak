    kbr:hasSourceLocator "UU-1983-7#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Penghasilan neto suami-isteri sebagaimana dimaksud pada ayat (2) huruf b dan huruf c dikenai pajak berdasarkan penggabungan penghasilan neto suami-isteri dan besarnya pajak yang harus dilunasi oleh masing-masing suami-isteri dihitung sesuai dengan perbandingan penghasilan neto mereka."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

