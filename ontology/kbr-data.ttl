    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_2 ;
    kbr:hasRuleId "R-PMK-2023-96-85cbb84c52"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "( 1) Penyelenggara Pos melakukan pengurusan pemenuhan Kewajiban Pabean atas impor dan ekspor Barang Kiriman."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

