    kbr:hasRuleId "R-PMK-2023-164-5de5dfa550"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-164#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Menteri adalah menteri yang menyelenggarakan urusan pemerintahan di bidang keuangan negara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_164_5f7f3e54ec a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_164 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_164_BT_22 ;
    kbr:hasRuleId "R-PMK-2023-164-5f7f3e54ec"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-164#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "2. dalam hal Wajib Pajak telah menghitung dan melaporkan Pajak Penghasilan untuk Tahun Pajak 2022 menggunakan mekanisme Pajak Penghasilan Berdasarkan Ketentuan Umum Pajak Penghasilan dalam Surat Pemberitahuan Tahunan Pajak Penghasilan Tahun Pajak 2022 dan akan menerapkan ketentuan sebagaimana dimaksud pada angka 1 huruf a) dan huruf c), Wajib Pajak harus melakukan pembetulan Surat Pemberitahuan Tahunan Pajak Penghasilan dimaksud sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_164_60beea1bcc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_164 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_164_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2023-164-60beea1bcc"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-164#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Surat Pemberitahuan Tahunan adalah Surat Pemberitahuan untuk suatu Tahun Pajak atau bagian Tahun Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_164_6160e97d37 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2023_164 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_164_BT_9 ;
    kbr:hasRuleId "R-PMK-2023-164-6160e97d37"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-164#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal berdasarkan laporan sebagaimana dimaksud pada ayat (1) terdapat kelebihan Pajak Penghasilan yang terjadi karena Wajib Pajak orang pribadi sebagaimana dimaksud dalam Pasal 4 ayat ( 1) huruf a memperhitungkan bagian peredaran bruto atas penghasilan dari usaha tidak dikenai Pajak Penghasilan sebagaimana dimaksud dalam Pasal 6 ayat (3), Wajib Pajak dapat mengajukan permohonan pengembalian pajak yang seharusnya tidak terutang sesuai dengan ketentuan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_164_6926318889 a kbr:Kewajiban ;
