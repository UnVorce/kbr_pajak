    kbr:hasSourceQuote "(1) Dalam rangka penyediaan Uang Persediaan Pengembalian Pajak sebagaimana dimaksud dalam Pasal 271 ayat (1) huruf a, Kepala Kantor Pelayanan Pajak menerbitkan Surat Perintah Membayar Uang Persediaan Pengembalian Pajak atas dasar perkiraan pengeluaran pengembalian Pajak Pertambahan Nilai sesuru dengan ketentuan peraturan perundang- - jdih.kemenkeu.go.id - 200 - undangan mengenai tata cara pembayaran dalam rangka pelaksanaan Anggaran Pendapatan dan Belanja Negara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

