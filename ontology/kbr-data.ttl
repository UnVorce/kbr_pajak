    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/90"^^xsd:string ;
    kbr:hasSourceQuote "Tingkat penggunaan jasa sebagaimana dimaksud pada ayat (1) merupakan jumlah penggunaan jasa yang dijadikan dasar alokasi beban biaya yang dipikul Pemerintah Provinsi DKI Jakarta untuk penyelenggaraan jasa yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_dbfe47cb77 a kbr:Definisi ;
