    kbr:hasSourceQuote "(1) Pelayanan Retribusi perpanjangan pengesahan rencana penggunaan tenaga kerja asing sebagaimana dimaksud dalam Pasal 60 ayat (1), merupakan pelayanan pengesahan rencana penggunaan tenaga kerja asing perpanjangan sesuai wilayah kerja tenaga kerja asing sesuai dengan ketentuan peraturan perundang-undangan mengenai penggunaan tenaga kerja asing."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_fc8e8c9ffa a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_57 ;
