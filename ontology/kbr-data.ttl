    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-8281f95526"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Bangunan adalah konstruksi teknik yang ditanam atau dilekatkan secara tetap di atas permukaan Bumi dan di bawah permukaan Bumi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

