    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_111_BT_13 ;
    kbr:hasRuleId "R-PMK-2025-111-4a22dfcdd1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-111#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(4) Terhadap penyampaian surat teguran secara langsung sebagaimana dimaksud pada ayat (3) huruf e, dibuatkan berita acara penyampaian surat teguran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_111_4a6ea3cc5b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2025_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_111_BT_3_5__8 ;
    kbr:hasRuleId "R-PMK-2025-111-4a6ea3cc5b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-111#BT/3/5..8"^^xsd:string ;
    kbr:hasSourceQuote "Tata cara Pengawasan Wajib Pajak dalam pemenuhan kewajiban pelaporan surat pemberitahuan objek pajak Pajak Bumi dan Bangunan sebagaimana dimaksud pada ayat (4) huruf d dilaksanakan sesuai dengan Peraturan Menteri Keuangan yang mengatur mengenai ketentuan perpajakan dalam rangka pelaksanaan sistem inti administrasi perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

