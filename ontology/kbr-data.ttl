    kbr:hasSourceQuote "(3) Ketentuan sebagaimana dimaksud dalam Pasal 26 ayat (21, ayat (3), dan ayat (4) berlaku muto;tis mutandis untuk dokumen tertentu yang kedudukannya dipersamakan dengan Faktur Pajak sebagaimana dimaksud pada ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

