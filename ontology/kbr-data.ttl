kbr:Aturan_R_PMK_2025_111_67d453b120 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2025_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_111_BT_23 ;
