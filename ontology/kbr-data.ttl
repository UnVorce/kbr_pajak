    kbr:hasSourceLocator "PMK-2024-81#BT/102/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pembayaran dan penyetoran pajak dilakukan dengan menggunakan: a. Surat Setoran Pajak; b. Meterai, untuk pembayaran Bea Meterai; atau c. sarana administrasi lain yang disamakan dengan Surat Setoran Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e405aebb12 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_427_1__5 ;
    kbr:hasRuleId "R-PMK-2024-81-e405aebb12"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/427/1..5"^^xsd:string ;
    kbr:hasSourceQuote "a. menyampaikan persyaratan kelengkapan berupa realisasi aktiva tetap beserta gambar tata letak; b. memenuhi persyaratan untuk diberikan Surat Keterangan Fiskal sesuai dengan ketentuan yang mengatur mengenai tata cara pemberian Surat Keterangan Fiskal; dan c. menyampaikan persyaratan kelengkapan berupa dokumen yang berkaitan dengan: 1. transaksi penjualan hasil produksi ke pasaran pertama kali antara lain berupa Faktur Pajak atau bukti tagihan; atau 2. pertama kali hasil produksi digunakan sendiri untuk proses produksi lebih lanjut antara lain berupa laporan pemakaian sendiri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e41d033b95 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_121_1__2 ;
    kbr:hasRuleId "R-PMK-2024-81-e41d033b95"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/121/1..2"^^xsd:string ;
    kbr:hasSourceQuote "Denda administratif sebagaimana dimaksud pada ayat (2) tidak dikenakan terhadap angsuran atau penundaan atas pembayaran Surat Tagihan Pajak Pajak Bumi dan Bangunan yang hanya memuat denda administratif."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

