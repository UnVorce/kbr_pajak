    kbr:hasSourceQuote "(1) Besaran pokok Pajak Rokok yang terutang dihitung dengan cara mengalikan dasar pengenaan Pajak Rokok sebagaimana dimaksud dalam Pasal 34 dengan tarif Pajak Rokok sebagaimana dimaksud dalam Pasal 35."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

