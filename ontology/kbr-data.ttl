    kbr:hasSourceQuote "atau perbuatan sepihak atau keadaan yang terjadi karena jual beli, tukar-menukar, hibah, warisan, atau pemasukan ke dalam badan usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
