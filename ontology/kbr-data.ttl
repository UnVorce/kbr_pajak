    kbr:hasSourceQuote "Hubungan Keuangan antara Pemerintah Pusat dan Pemerintahan Daerah adalah suatu sistem penyelenggaraan keuangan yang mengatur hak dan kewajiban keuangan antara pemerintah pusat dan pemerintahan daerah yang dilaksanakan secara adil, transparan, akuntabel, dan selaras berdasarkan undang-undang."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_2022_1_afaa52d9e3 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_2022_1 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2022_1_BT_115 ;
    kbr:hasRuleId "R-UU-2022-1-afaa52d9e3"^^xsd:string ;
    kbr:hasSourceLocator "UU-2022-1#BT/115"^^xsd:string ;
    kbr:hasSourceQuote "DBH sumber daya alam kehutanan yang bersumber dari provisi sumber daya hutan sebagaimana dimaksud pada ayat (1) hurufb yang dihasilkan dari wilayah Daerah yang bersangkutan, ditetapkan sebesar 80% (delapan puluh persen), dibagikan kepada: a. provinsi yang bersangkutan sebesar 16% (enam belas persen); b. kabupaten/kota penghasil sebesar 32% (tiga puluh dua persen); c. kabupaten/kota lainnya yang berbatasan langsung dengan kabupaten/kota penghasil sebesar 160/o (enam belas persen); dan d. kabupaten/kota lainnya dalam provinsi yang bersangkutan sebesar 16% (enam belas persen)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_APPROVED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

