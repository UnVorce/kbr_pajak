    kbr:hasSourceQuote "Dalam hal ada pengakuan Utang Pajak dari Wajib Pajak sebagaimana dimaksud pada ayat (3) huruf b, kedaluwarsa Penagihan dihitung sejak tanggal pengakuan tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_f72487b3db a kbr:Definisi ;
