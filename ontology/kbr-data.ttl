    kbr:hasSourceQuote "Jenis pelayanan pemberian izin yang merupakan objek Retribusi Perizinan Tertentu sebagaimana dimaksud dalam Pasal 66 ayat (1) huruf c meliputi: a. persetujuan bangunan gedung; dan b. penggunaan tenaga kerja asing."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_cc9e6a1e39 a kbr:Definisi ;
