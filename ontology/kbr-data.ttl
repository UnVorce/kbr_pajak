    kbr:hasSourceLocator "PMK-2023-80#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "34. Pembuat Meterai Dalam Bentuk Lain yang selanjutnya disebut Pembuat Meterai adalah Wajib Pajak yang telah memiliki izin untuk mencetak atau membuat meterai dalam bentuk lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

