    kbr:hasSourceQuote "Entitas Konstituen yang dimiliki secara minoritas merupakan Entitas Konstituen dimana Entitas Induk Utama memiliki Kepentingan Kepemilikan sebesar 30% (tiga puluh persen) atau kurang, secara langsung atau tidak langsung pada Entitas tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

