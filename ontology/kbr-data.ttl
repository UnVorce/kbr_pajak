    kbr:hasSourceLocator "PP-2010-79#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terjadi perubahan bentuk hukum dan/atau perubahan status domisili dan/atau pengalihan participating interest atau kepemilikan saham dan/atau hal lain dari kontraktor yang mengakibatkan perubahan perhitungan pajak penghasilan, besaran bagian penerimaan negara harus tetap."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_fb67ffabeb a kbr:Larangan ;
