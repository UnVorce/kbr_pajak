    kbr:hasRuleId "R-PP-2022-50-4743c897de"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "22. Surat Keputusan Keberatan adalah surat keputusan atas keberatan terhadap Surat Ketetapan Pajak atau terhadap pemotongan atau pemungutan oleh pihak ketiga yang diajukan oleh Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_4801f4c0aa a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_43 ;
    kbr:hasRuleId "R-PP-2022-50-4801f4c0aa"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/43"^^xsd:string ;
    kbr:hasSourceQuote "(3) Direktur Jenderal Pajak menerbitkan surat pelaksanaan Putusan Gugatan setelah menerima Putusan Gugatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_4835d8d237 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_41 ;
    kbr:hasRuleId "R-PP-2022-50-4835d8d237"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/41"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terdapat Putusan Gugatan atas Surat Ketetapan Pajak sebagaimana dimaksud pada ayat (1) yang penerbitannya tidak sesuai dengan prosedur atau tata cara penerbitan, Direktur Jenderal Pajak setelah menerima Putusan Gugatan tersebut menindaklanjuti Putusan Gugatan dengan menerbitkan kembali Surat Ketetapan Pajak sesuai dengan prosedur atau tata cara yang diatur dalam ketentuan peraturan perundang- undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_48a0717382 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_37_1__5 ;
    kbr:hasRuleId "R-PP-2022-50-48a0717382"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/37/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terdapat kekeliruan pengkreditan Pajak Masukan Pajak Pertambahan Nilai pada surat keputusan atau surat ketetapan sebagaimana dimaksud pada ayat (1) , pembetulan atas kekeliruan tersebut hanya dapat dilakukan jika terdapat perbedaan besarnya Pajak Masukan yang menjadi kredit pajak dan Pajak Masukan tersebut tidak mengandung persengketaan antara fiskus dan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_48fa8e0e01 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_23 ;
    kbr:hasRuleId "R-PP-2022-50-48fa8e0e01"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/23"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak menerbitkan Surat Ketetapan Pajak Nihil berdasarkan hasil Pemeriksaan terhadap Surat Pemberitahuan jika jumlah kredit pajak atau jumlah pajak yang dibayar sama dengan jumlah pajak yang terutang, atau pajak tidak terutang dan tidak ada kredit pajak atau tidak ada pembayaran pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

