kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_e742ef182f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
