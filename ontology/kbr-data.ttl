    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_30_6 ;
    kbr:hasRuleId "R-PMK-2023-61-b515a9b928"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/30/6"^^xsd:string ;
    kbr:hasSourceQuote "(6) Lembaga Jasa Keuangan sektor perbankan, Lembaga Jasa Keuangan sektor perasuransian, Lembaga Jasa Keuangan Lainnya, dan/atau Entitas Lain wajib memberitahukan saldo harta kekayaan Penanggung Pajak paling lama 1 (satu) bulan terhitung sejak tanggal diterimanya permintaan pemberitahuan sebagaimana dimaksud pada ayat (5)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

