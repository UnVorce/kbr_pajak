    kbr:hasSourceQuote "Khusus untuk pelayanan persetujuan bangunan gedung sebagaimana dimaksud dalam Pasal 87 ayat (1), biaya penyelenggaraan pemberian izin mengacu pada ketentuan peraturan perundang-undangan mengenai bangunan gedung."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

