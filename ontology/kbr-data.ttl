    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2010_2_2f3729010f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2010_2 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2010_2_BT_1 ;
    kbr:hasRuleId "R-PMK-2010-2-2f3729010f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-2#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Peraturan Menteri Keuangan ini yang dimaksud dengan Biaya Promosi adalah bagian dari biaya penjualan yang dikeluarkan oleh Wajib Pajak dalam rangka memperkenalkan dan/ atau menganjurkan pemakaian suatu produk baik langsung maupun tidak langsung untuk mempertahankan dan/ atau meningkatkan penjualan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2010_2_5782f96e74 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2010_2 ;
