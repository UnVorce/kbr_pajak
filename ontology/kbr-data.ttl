    kbr:hasSourceLocator "PP-2021-41#BT/17"^^xsd:string ;
    kbr:hasSourceQuote "(5) Selain sumber pendapatan sebagaimana dimaksud pada ayat (21, Badan Pengusahaan dapat memperoleh pendapatan dari: a. anggaran pendapatan dan belanja negara; dan/atau b. anggaran pendapatan dan belanja daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

