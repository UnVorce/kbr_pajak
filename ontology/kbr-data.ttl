    kbr:hasSourceQuote "Prinsip dan sasaran dalam penetapan tarif Retribusi Jasa Umum ditetapkan dengan memperhatikan: a. biaya penyediaan jasa yang bersangkutan; b. kemampuan masyarakat; c. aspek keadilan; dan d. efektivitas pengendalian atas pelayanan tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
