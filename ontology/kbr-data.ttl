    kbr:hasSourceQuote "Penyesuaian penghasilan sebagaimana dimaksud pada ayat (1) dilakukan dengan cara mengecualikan penghasilan dari penghitungan Laba atau Rugi GloBE dari Entitas Konstituen dalam Grup PMN di suatu negara atau yurisdiksi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_f5db5dc1bf a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_56_1__7 ;
    kbr:hasRuleId "R-PMK-2024-136-f5db5dc1bf"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/56/1..7"^^xsd:string ;
    kbr:hasSourceQuote "Periode tertentu sebagaimana dimaksud pada ayat (1) meliputi seluruh Tahun Pajak yang dimulai pada atau sebelum tanggal 31 Desember 2026 sampai dengan Tahun Pajak yang berakhir pada tanggal 30 Juni 2028."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

