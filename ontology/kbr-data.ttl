kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_5933ea5ba6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_9 ;
