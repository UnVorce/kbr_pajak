    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/147"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam rangka penelitian sebagaimana dimaksud pada ayat (2), Walikota atau Pejabat yang ditunjuk dapat meminta data, informasi dan/atau keterangan dari Wajib Pajak serta dalam hal diperlukan dapat dilakukan peninjauan atau penelitian setempat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

