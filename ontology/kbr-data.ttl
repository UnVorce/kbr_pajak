    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/105"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak untuk jenis Pajak yang dipungut berdasarkan penghitungan sendiri oleh Wajib Pajak sebagaimana dimaksud dalam Pasal 3 ayat (2) dan ayat (4) wajib mengisi SPTPD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_d0d08f3adc a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_108 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-d0d08f3adc"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/108"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Retribusi tertentu tidak membayar tepat pada waktunya sebagaimana dimaksud dalam Pasal 90 ayat (2), atau kurang membayar, Wajib Retribusi dikenakan sanksi administratif berupa bunga sebesar 1% (satu persen) per bulan dari Retribusi terutang yang tidak atau kurang dibayar dihitung dari tanggal jatuh tempo pembayaran sampai dengan tanggal pembayaran, untuk jangka waktu paling lama 24 (dua puluh empat) bulan dan ditagih dengan menggunakan STRD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

