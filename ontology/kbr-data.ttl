    kbr:hasSourceLocator "PMK-2023-172#BT/10/1..1"^^xsd:string ;
    kbr:hasSourceQuote "Metode dalam penilaian harta berwujud dan/ atau harta tidak berwujud (tangible asset and intangible asset valuation) sebagaimana dimaksud dalam Pasal 9 ayat (1) huruf d angka 4 dilakukan sesuai dengan ketentuan peraturan perundang-undangan yang mengatur mengenai tata cara penilaian untuk tujuan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

