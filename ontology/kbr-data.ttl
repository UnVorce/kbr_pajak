    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-cf395895ce"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "Dasar Pengenaan Pajak Reklame merupakan nilai sewa Reklame."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_cf88bc5871 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_74_1__6 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-cf88bc5871"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/74/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Jenis penyediaan/pelayanan barang dan/atau jasa yang merupakan objek Retribusi Jasa Usaha sebagaimana dimaksud dalam Pasal 66 ayat (1) huruf b meliputi: a. penyediaan tempat kegiatan usaha berupa pasar grosir, pertokoan, dan tempat kegiatan usaha lainnya; b. penyediaan tempat pelelangan ikan, ternak, hasil bumi, dan hasil hutan termasuk fasilitas lainnya dalam lingkungan tempat pelelangan; 36 c. penyediaan tempat khusus parkir di luar badan jalan; d. penyediaan tempat penginapan/pesanggrahan/vila; e. pelayanan rumah pemotongan hewan ternak; f. pelayanan jasa kepelabuhanan; g. pelayanan tempat rekreasi, pariwisata, dan olahraga; h. pelayanan penyeberangan orang atau barang dengan menggunakan kendaraan di air; i. penjualan hasil produksi usaha Pemerintah Provinsi DKI Jakarta; dan j. pemanfaatan aset Pemerintah Provinsi DKI Jakarta yang tidak mengganggu penyelenggaraan tugas dan fungsi Satuan Kerja Perangkat Daerah dan/atau optimalisasi aset Pemerintah Provinsi DKI Jakarta dengan tidak mengubah status kepemilikan sesuai dengan ketentuan peraturan perundang- undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_cf97a90619 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_6_1__6 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-cf97a90619"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/6/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(3) Nilai jual Kendaraan Bermotor sebagaimana dimaksud pada ayat (1) huruf a dan ayat (2) ditentukan berdasarkan harga pasaran umum atas suatu Kendaraan Bermotor pada minggu pertama bulan Desember Tahun Pajak sebelumnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_d103969d10 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_37_1__4 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-d103969d10"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/37/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Objek BPHTB merupakan Perolehan Hak atas Tanah dan/atau Bangunan yang meliputi: a. pemindahan hak karena: 1. jual beli; 2. tukar-menukar; 3. hibah; 4. hibah wasiat; 5. waris; 6. pemasukan dalam perseroan atau badan hukum lain; 7. pemisahan hak yang mengakibatkan peralihan; 8. penunjukan pembeli dalam lelang; 9. pelaksanaan putusan hakim yang mempunyai kekuatan hukum tetap; 10. penggabungan usaha; 11. peleburan usaha; 12. pemekaran usaha; atau 13. hadiah. b. pemberian hak baru karena: 1. kelanjutan pelepasan hak; atau 2. di luar pelepasan hak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_d1e37ffbb1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_96_1__6 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-d1e37ffbb1"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/96/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Insentif fiskal sebagaimana dimaksud pada ayat (1) dapat diberikan atas permohonan Wajib Pajak dan/atau Wajib Retribusi atau diberikan secara jabatan oleh Gubernur berdasarkan pertimbangan:"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_d1f13c1aac a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_45 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-d1f13c1aac"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/45"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan peredaran usaha sebagaimana dimaksud pada ayat (2) huruf a tidak berlaku untuk penjualan dan/atau penyerahan Makanan dan/atau Minuman yang dilakukan secara insidental."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

