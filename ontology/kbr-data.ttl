    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/47"^^xsd:string ;
    kbr:hasSourceQuote "Jenis pelayanan yang merupakan objek Retribusi Jasa Umum sebagaimana dimaksud dalam Pasal 46 ayat (1) huruf a, meliputi: a. pelayanan kesehatan; dan b. pelayanan kebersihan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_3193ea852b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_57 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-3193ea852b"^^xsd:string ;
