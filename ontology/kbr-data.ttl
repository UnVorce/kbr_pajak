    kbr:hasSourceQuote "a. pemberitahuan tertulis kepada Wajib Pajak dalam negeri bahwa usulan permintaan pelaksanaan Prosedur Persetujuan Bersama dapat ditindaklanjuti dan permintaan pelaksanaan Prosedur Persetujuan Bersama secara tertulis kepada Pejabat Berwenang Mitra Persetujuan Penghindaran Pajak Berganda, dalam hal usulan permintaan pelaksanaan Prosedur Persetujuan Bersama memenuhi persyaratan dan kesesuaian materi;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

