    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-8da4a04f2e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/134/1..9"^^xsd:string ;
    kbr:hasSourceQuote "Dokumen lain yang dipersamakan sebagaimana dimaksud pada ayat (6) dapat berupa karcis, kupon, kartu langganan, surat perjanjian, dan surat pemberitahuan pembayaran dari aplikasi pelayanan atau perizinan elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_8e4e7d453f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_173_1__6 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-8e4e7d453f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/173/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Pemberian insentif fiskal kepada Wajib Pajak dan/atau Wajib Retribusi pelaku usaha mikro dan ultra mikro sebagaimana dimaksud pada ayat (3) huruf c, dilakukan sesuai dengan kriteria usaha mikro dan ultra mikro dalam peraturan perundang-undangan di bidang usaha mikro, kecil, menengah, dan koperasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_8fab70621e a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_170 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-8fab70621e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/170"^^xsd:string ;
    kbr:hasSourceQuote "Jika pengajuan keberatan diterima sebagian atau seluruhnya, kelebihan pembayaran Retribusi dikembalikan dengan ditambah imbalan bunga sebesar 0,6% (nol koma enam persen) per bulan dihitung dari Retribusi yang lebih dibayar untuk paling lama 12 (dua belas) bulan serta bagian dari bulan dihitung penuh 1 (satu) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_907231590b a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
