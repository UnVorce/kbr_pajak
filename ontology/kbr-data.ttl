    kbr:hasSourceQuote "(1) Dalam hal pemberitahuan Surat Paksa sebagaimana dimaksud dalam Pasal 15 dilaksanakan di luar wilayah kerja Kantor Wilayah atau Kantor Pelayanan Pajak yang jdih.kemenkeu.go.id -19- menerbitkan Surat Paksa, Kepala Kantor Wilayah atau Kepala Kantor Pelayanan Pajak yang menerbitkan Surat Paksa meminta bantuan kepada Pejabat yang wilayah kerjanya meliputi tempat pemberitahuan Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

