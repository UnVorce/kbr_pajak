    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_40B ;
    kbr:hasRuleId "R-UU-1995-11-f675f7da46"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/40B"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal hasil penelitian dugaan pelanggaran sebagaimana dimaksud pada ayat (1) merupakan pelanggaran administratif di bidang cukai, diselesaikan secara administratif sesuai dengan ketentuan peraturan perundang-undangan di bidang cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_f7c4b9b899 a kbr:AturanTarif ;
