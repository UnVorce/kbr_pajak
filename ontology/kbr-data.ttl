    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_201 ;
    kbr:hasRuleId "R-PMK-2024-81-bf83babaa8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/201"^^xsd:string ;
    kbr:hasSourceQuote "Atas penghasilan yang diterima atau diperoleh Wajib Pajak dari pengalihan Real Estat kepada Special Purpose Company atau Kontrak Investasi Kolektif dalam skema Kontrak Investasi Kolektif tertentu, terutang Pajak Penghasilan yang bersifat final."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
