kbr:Aturan_R_UU_1983_6_3689021ac7 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_28_1__10 ;
