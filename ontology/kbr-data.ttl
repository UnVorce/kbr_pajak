    kbr:hasSourceLocator "PMK-2025-15#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak, Wakil, atau Kuasa dari Wajib Pajak yang diperiksa menyatakan menolak untuk dilakukan Pemeriksaan, Wajib Pajak, Wakil, atau Kuasa dari Wajib Pajak yang diperiksa harus menyampaikan surat pernyataan penolakan Pemeriksaan yang ditandatangani paling lama 7 (tujuh) hari terhitung sejak Surat Pemberitahuan Pemeriksaan disampaikan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

