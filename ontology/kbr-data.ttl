    kbr:hasSourceLocator "UU-1983-6#BT/41A"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang wajib memberikan keterangan atau bukti yang diminta sebagaimana dimaksud dalam Pasal 35 tetapi dengan sengaja tidak memberi keterangan atau bukti, atau memberi keterangan atau bukti yang tidak benar dipidana dengan pidana kurungan paling lama 1 (satu) tahun dan denda paling banyak Rp25.000.000,00 (dua puluh lima juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_cf5fdaa836 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_32A_1__7 ;
    kbr:hasRuleId "R-UU-1983-6-cf5fdaa836"^^xsd:string ;
