    kbr:hasSourceQuote "Direktur Jenderal Pajak karena jabatannya dapat melakukan penghapusan Nomor Pokok Wajib Pajak dan/atau pencabutan pengukuhan Pengusaha Kena Pajak berdasarkan Pemeriksaan atau penelitian."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

