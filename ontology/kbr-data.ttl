    kbr:hasRuleId "R-PMK-2024-81-e52cfa04f6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/103"^^xsd:string ;
    kbr:hasSourceQuote "Pengisian Deposit Pajak dilakukan dengan: a. pembayaran melalui sistem penenmaan negara secara elektronik; b. permohonan Pemindahbukuan; atau c. permohonan atas sisa kelebihan pembayaran pajak atau sisa imbalan bunga setelah diperhitungkan dengan Utang Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e5425b0169 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_338 ;
    kbr:hasRuleId "R-PMK-2024-81-e5425b0169"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/338"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pihak Lain wajib menyetorkan Pajak Pertambahan Nilai yang dipungut sebagaimana dimaksud dalam Pasal 332 ayat (3) dan ayat (4) untuk setiap Masa Pajak paling lambat akhir bulan berikutnya setelah Masa Pajak berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e56880bf7b a kbr:Kewajiban ;
