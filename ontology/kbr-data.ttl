    kbr:hasRuleId "R-PP-2010-79-4cc4784023"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Pengembalian biaya operasi untuk minyak bumi dilakukan hanya terhadap lifting minyak bumi, sedangkan pengembalian biaya operasi untuk gas bumi dilakukan hanya terhadap nilai penjualan gas bumi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

