    kbr:hasSourceQuote "Nomor Pokok Wajib Pajak Cabang sebagaimana dimaksud pada ayat (1) huruf c digunakan untuk pelaksanaan hak dan pemenuhan kewajiban perpajakan sampai dengan tanggal 31 Desember 2023."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

