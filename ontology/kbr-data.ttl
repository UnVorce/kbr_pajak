    kbr:hasSourceQuote "(8) Penyampaian permohonan penmjauan kembali Kesepakatan Harga Transfer secara elektronik sebagaimana dimaksud pada ayat (7) hurufb dilakukan dalam hal sistem sudah tersedia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
