    kbr:hasSourceLocator "PP-2021-40#BT/23"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap usulan yang dokumennya telah lengkap, Dewan Nasional melakukan kajian terhadap usulan pembentukan KEK dalam waktu paling lama 30 (tiga puluh) hari kerja terhitung sejak diterimanya usulan tertulis dan dokumen persyaratan secara lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
