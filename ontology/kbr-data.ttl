kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_cb46614a34 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
