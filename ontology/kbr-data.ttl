    kbr:hasSourceQuote "f. atas pembelian bahan-bahan berupa hasil kehutanan, perkebunan, pertanian, peternakan, dan perikanan yang belum melalui proses industri manufaktur oleh badan usaha industri atau eksportir sebesar 0,25% (nol koma dua puluh lima persen) dari harga pembelian tidak termasuk Pajak Pertambahan Nilai;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

