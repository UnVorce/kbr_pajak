    kbr:hasSourceQuote "4. Gas Bumi adalah hasil proses alami berupa hidrokarbon yang dalam kondisi tekanan dan temperatur atmosfer berupa fasa gas yang diperoleh dari proses penambangan minyak dan gas bumi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
