    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/107"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang dengan sengaja tidak memenuhi kewajiban perpajakan sebagaimana dimaksud dalam Pasal 3 ayat (5), sehingga merugikan keuangan daerah, diancam dengan pidana kurungan atau pidana denda sesuai dengan Undang-Undang mengenai hubungan keuangan antara pemerintah pusat dan pemerintahan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

