    kbr:hasSourceLocator "PMK-2025-111#BT/6/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Berdasarkan surat permintaan penjelasan atas data dan/atau keterangan sebagaimana dimaksud dalam Pasal 5 ayat (1), Wajib Pajak memberikan tanggapan dengan: a. memenuhi kewajiban perpajakan; dan/atau b. menyampaikan penjelasan atas kewajiban perpajakan, sebagaimana tercantum dalam surat permintaan penjelasan atas data dan/atau keterangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

