    kbr:hasSourceQuote "Bukti Pemotongan Pajak Penghasilan adalah dokumen berupa formulir atau dokumen lain yang dipersamakan sesuai dengan ketentuan peraturan perundang- undangan di bidang perpajakan, yang dibuat oleh Pemotong Pajak Penghasilan sebagai bukti atas pemotongan Pajak Penghasilan yang dilakukan dan menunjukkan besarnya Pajak Penghasilan yang telah dipotong."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

