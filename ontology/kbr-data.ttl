kbr:Aturan_R_PMK_2023_61_5fd9712a7a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_66 ;
    kbr:hasRuleId "R-PMK-2023-61-5fd9712a7a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pejabat menerbitkan surat perintah Penyanderaan seketika setelah menerima izin Penyanderaan dari Menteri sebagaimana dimaksud dalam Pasal 65 ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

