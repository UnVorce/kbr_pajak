    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/100/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Dalam pemberian fasilitas angsuran atau penundaan pembayaran Pajak terutang sebagaimana dimaksud pada ayat (4), Gubernur memperhatikan kepatuhan Wajib Pajak dalam pembayaran Pajak selama 2 (dua) tahun terakhir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_ec90966ef6 a kbr:Definisi ;
