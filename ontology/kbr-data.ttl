    kbr:hasSourceQuote "Tahun Pajak adalah jangka waktu yang lamanya 1 (satu) tahun kalender, kecuali apabila wajib pajak menggunakan tahun buku yang tidak sama dengan tahun kalender."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_d284a8c5ca a kbr:Definisi ;
