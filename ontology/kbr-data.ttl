    kbr:hasSourceQuote "(5) Titik kewajaran sebagaimana dimaksud pada ayat (1) huruf a merupakan titik indikator harga yang terbentuk dari satu atau lebih pembanding yang memiliki nilai indikator harga yang sama."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
