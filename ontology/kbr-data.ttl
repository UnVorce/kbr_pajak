    kbr:hasRuleId "R-PER-DJP-2025-7-a86dd78f70"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Pengujian pemenuhan kewajiban subjektif dan objektif sebagai Pengusaha Kena Pajak dilakukan dengan -49- melakukan penelitian lapangan di alamat tempat tinggal, tempat kedudukan, dan/atau tempat kegiatan usaha Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_a875744af3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_53 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-a875744af3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/53"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1) atau ayat (2), kepada Wajib Pajak diterbitkan bukti penerimaan surat;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_a915d682a9 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_5_3__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-a915d682a9"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/5/3..5"^^xsd:string ;
    kbr:hasSourceQuote "Anggota keluarga yang telah terdaftar dalam satu data unit keluarga tidak dapat dicantumkan dalam data unit keluarga lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ab1bc8fc5e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_47_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ab1bc8fc5e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/47/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(3) Selain dilakukan berdasarkan hasil Pemeriksaan, Kepala Kantor Pelayanan Pajak juga dapat melakukan penghapusan Nomor Pokok Wajib Pajak secara jabatan berdasarkan hasil penelitian administrasi terhadap:"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ab1d792f1f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_66_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ab1d792f1f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/66/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Dokumen pendukung sebagaimana dimaksud pada ayat (3) berupa salinan izin praktik untuk konsultan pajak atau salinan surat keterangan terdaftar untuk pihak lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ab77d2f15d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_48 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ab77d2f15d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha kecil sebagaimana dimaksud pada ayat (2) dapat memilih untuk melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak kecuali yang diwajibkan untuk dikukuhkan sebagai Pengusaha Kena Pajak sesuai dengan ketentuan peraturan perundang- undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ab87ca9785 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_30 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ab87ca9785"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak Baru mengirimkan Kartu Nomor Pokok Wajib Pajak dan Surat Keterangan Terdaftar sebagaimana dimaksud pada ayat (2) huruf a kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ab8ec34416 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_61 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ab8ec34416"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/61"^^xsd:string ;
    kbr:hasSourceQuote "Surat pencabutan pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (3) disampaikan kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ab9ce4cc5e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_21 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ab9ce4cc5e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "Atas permintaan Kode Otorisasi baru sebagaimana dimaksud pada ayat (2), Kepala Kantor Pelayanan Pajak memberikan Kode Otorisasi baru dengan menerbitkan surat penerbitan Kode Otorisasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ac6cec2c79 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ac6cec2c79"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Karbon adalah pajak yang dikenakan atas emisi karbon yang memberikan dampak negatif bagi lingkungan hidup."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ac845a77d6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_29 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ac845a77d6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak dapat melakukan pemindahan tempat Wajib Pajak terdaftar secara jabatan sesuai dengan tempat tinggal atau tempat kedudukan menurut keadaan yang sebenarnya dengan menerbitkan surat pindah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ac9da5af3f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_70 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ac9da5af3f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/70"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kepala Kantor Pelayanan Pajak tempat Wajib Pajak terdaftar dapat mencabut penetapan atas penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf c secara jabatan berdasarkan hasil pemeriksaan atau hasil penelitian administrasi sesuai dengan data dan/atau informasi yang dimiliki atau diperoleh Direktorat Jenderal Pajak, bahwa Wajib Pajak tidak lagi memenuhi kriteria sebagai Pemungut Bea Meterai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ace8a69751 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ace8a69751"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Instansi Pemerintah adalah instansi pemerintah pusat, instansi pemerintah daerah, dan instansi pemerintah desa, yang melaksanakan kegiatan pemerintahan serta memiliki kewenangan dan tanggung jawab penggunaan anggaran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_add4f50b9a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_10_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-add4f50b9a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(2) Wajib Pajak orang pribadi sebagaimana dimaksud pada ayat (1) huruf a wajib mendaftarkan diri pada Kantor Pelayanan Pajak yang wilayah kerjanya meliputi tempat tinggal orang pribadi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ae2d145366 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_20 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ae2d145366"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "aktivasi Akun Wajib Pajak harus dilakukan oleh: a. Wajib Pajak yang bersangkutan untuk Wajib Pajak orang pribadi; atau b. salah satu wakil Wajib Pajak untuk Wajib Pajak Warisan Belum Terbagi, Badan, atau Instansi Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b1cdb71331 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_52_6__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b1cdb71331"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/52/6..4"^^xsd:string ;
    kbr:hasSourceQuote "(7) Atas permohonan pengukuhan Pengusaha Kena Pajak yang disampaikan melalui Portal Wajib Pajak dan Contact Center: a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (3) , ayat (4) , ayat (5), atau ayat (6) kepada Wajib Pajak diterbitkan bukti penerimaan elektronik; atau b. dalam hal permohonan tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (3) , ayat (4) , ayat (5), atau ayat (6), kepada Wajib Pajak tidak diterbitkan bukti penerimaan elektronik dan permohonan Wajib Pajak tidak diproses lebih lanjut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b21f15388d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b21f15388d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Nomor Pokok Wajib Pajak sebagaimana dimaksud pada ayat (1) berupa: a. Nomor Induk Kependudukan yang telah diaktivasi sebagai Nomor Pokok Wajib Pajak dalam administrasi perpajakan, bagi Wajib Pajak orang pribadi yang merupakan Penduduk; dan b. nomor dengan format 16 (enam belas) digit yang dihasilkan oleh sistem administrasi Direktorat Jenderal Pajak sebagai Nomor Pokok Wajib Pajak, bagi Wajib Pajak orang pribadi bukan Penduduk, Wajib Pajak Badan, dan Wajib Pajak Instansi Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b3407458a0 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_54_8__9 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b3407458a0"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/54/8..9"^^xsd:string ;
    kbr:hasSourceQuote "(9) Kepala Kantor Pelayanan Pajak memberikan akses pembuatan faktur pajak kepada Pengusaha sejak tanggal dimulainya kewajiban sebagai Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (8)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b365421fa5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_15_5__10 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b365421fa5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/15/5..10"^^xsd:string ;
    kbr:hasSourceQuote "(8) Permohonan pendaftaran Wajib Pajak melalui Portal Wajib Pajak, laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak, dan/atau Contact Center sebagaimana dimaksud dalam Pasal 14 ayat (1) bagi selain orang pribadi yang merupakan Penduduk dilakukan dengan: a. mengisi dan menyampaikan formulir pendaftaran Wajib Pajak secara daring dan mengunggah salinan dokumen yang disyaratkan sebagaimana dimaksud dalam Pasal 14, untuk permohonan yang disampaikan melalui Portal Wajib Pajak atau laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak; atau b. menyampaikan data pendaftaran yang disyaratkan sebagaimana tercantum dalam formulir pendaftaran Wajib Pajak, untuk permohonan melalui Contact Center."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b3faea6803 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b3faea6803"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Setiap Wajib Pajak yang telah memenuhi persyaratan subjektif dan objektif wajib mendaftarkan diri pada Kantor Pelayanan Pajak yang wilayah kerjanya meliputi tempat tinggal Wajib Pajak atau tempat kedudukan Wajib Pajak"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b4ec6011d9 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_27 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b4ec6011d9"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal perubahan data Wajib Pajak sebagaimana dimaksud pada ayat (1) menyebabkan perubahan informasi dalam Kartu Nomor Pokok Wajib Pajak, Surat Keterangan Terdaftar, dan/atau surat pengukuhan Pengusaha Kena Pajak, Kepala Kantor Pelayanan Pajak menerbitkan Kartu Nomor Pokok Wajib Pajak, Surat Keterangan Terdaftar, dan/atau surat pengukuhan Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b5b9ff6a61 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_56_5__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b5b9ff6a61"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/56/5..6"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Pengusaha Badan: a. bertempat kedudukan di Kantor Virtual; b. telah diterbitkan surat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 54 ayat (5) huruf a atau ayat (6); dan c. diketahui memiliki tempat kegiatan usaha yang sebenarnya yang berada pada wilayah kerja Kantor -57- Pelayanan Pajak yang berbeda dengan wilayah kerja Kantor Pelayanan Pajak tempat kedudukannya, Kepala Kantor Pelayanan Pajak memindahkan secara jabatan Wajib Pajak ke wilayah kerja Kantor Pelayanan Pajak tempat kegiatan usaha yang sebenarnya dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b5f81495f8 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b5f81495f8"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Penjualan atas Barang Mewah adalah pajak penjualan atas barang mewah sebagaimana diatur dalam Undang-Undang Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b62ed166a6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_82 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b62ed166a6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak diterbitkan bukti penerimaan elektronik;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b644b459dd a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b644b459dd"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Nomor identitas perpajakan sebagaimana dimaksud dalam Pasal 7 ayat (1) digunakan orang pribadi atau Badan sebagai identitas untuk kepentingan administrasi perpajakan tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b64fd67aa8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_81 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b64fd67aa8"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "Permohonan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan dilakukan secara elektronik melalui: a. Portal Wajib Pajak; dan/atau b. laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak, dan disampaikan dengan disertai dokumen pendukung."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b81b3d65d5 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_68_7__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b81b3d65d5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/68/7..2"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal permohonan tidak memenuhi ketentuan pengisian formulir secara lengkap dan/atau masih memenuhi kriteria sebagaimana dimaksud dalam Pasal 62 ayat (2) , kepada Wajib Pajak tidak diterbitkan bukti penerimaan elektronik atau bukti penerimaan surat dan permohonan Wajib Pajak tidak diproses lebih lanjut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b88342cb22 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b88342cb22"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Peraturan Direktur Jenderal ini yang dimaksud dengan: 1. Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan adalah Undang-Undang Nomor 6 Tahun 1983 tentang Ketentuan Umum dan Tata Cara Perpajakan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 6 Tahun 2023 tentang Penetapan Peraturan Pemerintah Pengganti Undang-Undang Nomor 2 Tahun 2022 tentang Cipta Kerja menjadi Undang- Undang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_b96be10ac3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_66_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-b96be10ac3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/66/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Permohonan perubahan data atas status Wajib Pajak sebagaimana dimaksud pada ayat (1) dilakukan secara: a. elektronik melalui Portal Wajib Pajak; atau b. langsung ke Kantor Pelayanan Pajak atau Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan, dalam hal Wajib Pajak tidak dapat mendaftarkan diri secara elektronik sebagaimana dimaksud pada huruf a, dan disampaikan dengan disertai dokumen pendukung."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ba190fe531 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ba190fe531"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "8. Warga Negara Indonesia adalah orang bangsa Indonesia asli atau orang bangsa lain yang telah disahkan sebagai warga negara Indonesia berdasarkan ketentuan peraturan perundang-undangan yang mengatur tentang kewarganegaraan Republik Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ba3ed5cef6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_60 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ba3ed5cef6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "b. menolak permohonan pencabutan pengukuhan Pengusaha Kena Pajak dengan menerbitkan surat penolakan pencabutan Pengukuhan Pengusaha Kena Pajak, dalam hal Pengusaha masih memenuhi ketentuan sebagai Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_bae4f41fbc a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_78 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-bae4f41fbc"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan perubahan data Objek Pajak secara langsung atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir sebagaimana dimaksud dalam Pasal 76 ayat (4) dilakukan dengan: a. mengisi dan menandatangani formulir permohonan perubahan data objek pajak Pajak Bumi dan Bangunan; dan b. melampirkan dokumen pendukung sebagaimana dimaksud dalam Pasal 76 ayat (5). (2) Atas permohonan perubahan data Objek Pajak yang disampaikan secara langsung atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir: a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak diterbitkan bukti penerimaan surat; atau b. dalam hal permohonan tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1): 1. permohonan dikembalikan kepada Wajib Pajak secara langsung, untuk permohonan yang disampaikan secara langsung; atau 2. kepada Wajib Pajak diterbitkan surat pengembalian permohonan, untuk permohonan yang disampaikan melalui pos, perusahaan jasa ekspedisi atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_bc0e4d871a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_63_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-bc0e4d871a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/63/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(3) Berdasarkan penelitian administrasi sebagaimana dimaksud pada ayat (1), Kepala Kantor Pelayanan Pajak menerbitkan keputusan berupa: a. surat penolakan penetapan Pengusaha Kena Pajak Toko Retail untuk penambahan status sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf a; b. surat penolakan penetapan Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan untuk penambahan status sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf b; c. surat penolakan penetapan Pemungut Bea Meterai untuk penambahan status sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf c; dan d. surat penolakan penetapan atau keterangan lainnya untuk penambahan status sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf e, dalam hal permohonan tidak memenuhi ketentuan penambahan status Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_bd289c28d1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_7__12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-bd289c28d1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/7..12"^^xsd:string ;
    kbr:hasSourceQuote "(12) Dalam hal Wajib Pajak memerlukan pencetakan dokumen sebagaimana dimaksud pada ayat (4) dan ayat (10), Wajib Pajak dapat menyampaikan permintaan pencetakan dokumen tersebut ke seluruh Kantor Pelayanan Pajak atau Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_be5370bb23 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-be5370bb23"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "b. Wajib Pajak Warisan Belum Terbagi wajib mendaftarkan diri paling lambat pada akhir bulan berikutnya setelah Wajib Pajak orang pribadi yang meninggalkan warisan tersebut meninggal dunia;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_be60dc7c71 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_15_5__10 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-be60dc7c71"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/15/5..10"^^xsd:string ;
    kbr:hasSourceQuote "(9) Atas permohonan yang telah disampaikan sebagaimana dimaksud pada ayat (8), kepada Wajib Pajak: a. diterbitkan bukti penerimaan elektronik; dan b. dilakukan penelitian atas kesesuaian pemenuhan persyaratan permohonan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_bf77971b56 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_6__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-bf77971b56"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/6..8"^^xsd:string ;
    kbr:hasSourceQuote "c. untuk Instansi Pemerintah Daerah, berupa salinan dokumen pelaksanaan anggaran yang mencantumkan kode satuan kerja dan surat pengangkatan kepala satuan kerja perangkat daerah provinsi dan kabupaten/kota sebagai pengguna anggaran;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_bf7bf3aac1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_48 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-bf7bf3aac1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak dapat melakukan pembenahan basis data Pengusaha Kena Pajak dengan menguji pemenuhan kewajiban subjektif dan objektif sebagai Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c036a6d449 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_43 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c036a6d449"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/43"^^xsd:string ;
    kbr:hasSourceQuote "(2) Data dan/atau informasi sebagaimana dimaksud pada ayat (1) merupakan data dan/atau informasi yang menunjukkan bahwa Wajib Pajak: a. menyampaikan Surat Pemberitahuan Masa atau Surat Pemberitahuan Tahunan, kecuali untuk pelaporan Surat Pemberitahuan Masa atau Surat Pemberitahuan Tahunan sebelum Wajib Pajak ditetapkan sebagai Wajib Pajak Nonaktif; b. melakukan pembayaran pajak, kecuali untuk pembayaran pajak sebelum Wajib Pajak ditetapkan sebagai Wajib Pajak Nonaktif; c. melakukan kegiatan usaha atau pekerjaan bebas; d. mengajukan layanan yang dapat mengubah status menjadi pengaktifan kembali Wajib Pajak Nonaktif; atau e. melakukan pelaksanaan hak dan pemenuhan kewajiban perpajakan lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c0e7cca49b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_90 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c0e7cca49b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/90"^^xsd:string ;
    kbr:hasSourceQuote "Pengecekan kode verifikasi sebagaimana dimaksud pada ayat (3) huruf a dapat dilakukan melalui: a. laman Direktorat Jenderal Pajak; b. telepon kring pajak; atau c. Kantor Pelayanan Pajak/Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan tempat Produk Pelayanan atau keputusan dalam bentuk elektronik diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c1cbc91955 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_24_4__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c1cbc91955"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/24/4..8"^^xsd:string ;
    kbr:hasSourceQuote "(4) Permohonan perubahan data dilakukan secara elektronik melalui: a. Portal Wajib Pajak; b. laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak; dan/atau c. Contact Center, dan disampaikan disertai dokumen pendukung yang menunjukkan adanya perubahan tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c207e1770a a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_32 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c207e1770a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal berdasarkan hasil penelitian administrasi diketahui bahwa Wajib Pajak tidak melaksanakan: a. pelaporan tempat kegiatan usaha sebagaimana dimaksud dalam Pasal 31 ayat (1), Kepala Kantor Pelayanan Pajak memberikan Nomor Identitas Tempat Kegiatan Usaha secara jabatan; dan/atau b. penghapusan Nomor Identitas Tempat Kegiatan Usaha sebagaimana dimaksud dalam Pasal 31 ayat (6), Kepala Kantor Pelayanan Pajak menghapus Nomor Identitas Tempat Kegiatan Usaha secara jabatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c21df4ff73 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_37 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c21df4ff73"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "(4) Kepala Kantor Pelayanan Pajak menyampaikan keputusan sebagaimana dimaksud pada ayat (2) kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c21f4f5ab3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_15_9__12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c21f4f5ab3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/15/9..12"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak memerlukan pencetakan dokumen sebagaimana dimaksud pada ayat (5) dan ayat (10) Wajib Pajak dapat menyampaikan permintaan pencetakan dokumen tersebut ke seluruh Kantor Pelayanan Pajak atau Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c3a22c593e a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c3a22c593e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "d. Wajib Pajak Instansi Pemerintah wajib mendaftarkan diri paling lama sebelum melakukan pemotongan dan/atau pemungutan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c59fee661a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_34_1__1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c59fee661a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/34/1..1"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kepala Kantor Pelayanan Pajak dapat menetapkan Wajib Pajak Nonaktif, berdasarkan permohonan Wajib Pajak atau secara jabatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c5beda2506 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_52_6__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c5beda2506"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/52/6..4"^^xsd:string ;
    kbr:hasSourceQuote "(6) Dalam hal permohonan pengukuhan Pengusaha Kena Pajak diajukan oleh Pengusaha Badan yang menggunakan Kantor Virtual sebagai tempat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 51 ayat (1), permohonan sebagaimana dimaksud pada ayat (5) dilakukan dengan menyampaikan data permohonan yang dipersyaratkan sebagaimana tercantum dalam formulir pengukuhan Pengusaha Kena Pajak dengan disertai: a. peta dan foto lokasi usaha; b. surat pernyataan tentang kegiatan usaha dan tempat kegiatan usaha yang sebenarnya; dan -52- c. kontrak, perjanjian atau dokumen sejenis sebagaimana dimaksud dalam Pasal 51 ayat (5) huruf b, atau Pasal 51ayat (6) huruf b, yang diunggah melalui saluran yang telah ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c678b14038 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_5_3__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c678b14038"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/5/3..5"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak wanita kawin sebagaimana dimaksud pada ayat (2) huruf b memiliki suami yang tidak berpenghasilan sebagaimana diatur dalam ketentuan peraturan perundang-undangan di bidang Pajak Penghasilan, wanita kawin tersebut dapat menambahkan data unit keluarga dengan ketentuan sebagai berikut: 1. data seluruh anggota keluarga yang meliputi Wajib Pajak sendiri, suami, dan anak yang belum dewasa, termasuk anak tiri atau anak angkat yang tercantum dalam kartu keluarga Wajib Pajak atau kartu keluarga lain; dan 2. data anggota keluarga sedarah atau semenda dalam garis keturunan lurus selain anggota keluarga sebagaimana dimaksud pada angka 1 yang menjadi tanggungan sepenuhnya yang tercantum pada kartu keluarga Wajib Pajak atau kartu keluarga lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c6b7e50527 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_10_7__9 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c6b7e50527"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/10/7..9"^^xsd:string ;
    kbr:hasSourceQuote "Dikecualikan dari penentuan tempat kedudukan Wajib Pajak Badan sebagaimana dimaksud pada ayat (7) bagi Wajib Pajak Badan yang berbentuk Kerja Sama Operasi, tempat kedudukan Wajib Pajak Badan ditetapkan pada tempat tinggal atau tempat kedudukan salah satu anggota Kerja Sama Operasi yang berada di dalam wilayah hukum Negara Kesatuan Republik Indonesia yang ditunjuk dalam: a. perjanjian kerja sama Kerja Sama Operasi; atau b. surat penunjukan, untuk mewakili Kerja Sama Operasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c6c0931b23 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_46_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c6c0931b23"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/46/1..3"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak diterbitkan bukti penerimaan surat;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c7c5878897 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_46_6__11 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c7c5878897"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/46/6..11"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal keputusan penolakan penghapusan Nomor Pokok Wajib Pajak diterbitkan hanya karena Wajib Pajak masih memiliki utang pajak dan Wajib Pajak melunasi utang pajak tersebut dalam jangka waktu 1 (satu) bulan sejak keputusan penolakan penghapusan Nomor Pokok Wajib Pajak diterbitkan, Wajib Pajak tidak perlu mengajukan kembali permohonan penghapusan Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c8f4956abc a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_37 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c8f4956abc"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "(1) Atas permohonan penetapan Wajib Pajak Nonaktif yang telah diberikan bukti penerimaan elektronik atau bukti penerimaan surat, Kepala Kantor Pelayanan Pajak melakukan penelitian terhadap pemenuhan ketentuan kriteria sebagaimana dimaksud dalam Pasal 34 ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_c96ea83330 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-c96ea83330"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak warisan yang belum terbagi sebagai satu kesatuan menggantikan yang berhak yang selanjutnya disebut Wajib Pajak Warisan Belum Terbagi adalah Wajib Pajak warisan yang belum terbagi sebagai satu kesatuan menggantikan yang berhak sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ca4ad382f9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_10_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ca4ad382f9"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(5) Tempat tinggal sebagaimana dimaksud pada ayat (4) ditentukan menurut keadaan yang sebenarnya, yakni: -15- a. tempat tinggal tetap Wajib Pajak orang pribadi yang meninggalkan warisan beserta keluarganya sebelum meninggal dunia; atau b. tempat pusat kepentingan ekonomi harta warisan berada, dalam hal Wajib Pajak orang pribadi yang meninggalkan warisan tersebut: 1. mempunyai tempat tinggal tetap sebagaimana dimaksud dalam huruf a di 2 (dua) tempat atau lebih; atau 2. tidak mempunyai tempat tinggal tetap sebagaimana dimaksud dalam huruf a."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ca7dd4b5be a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_66_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ca7dd4b5be"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/66/1..5"^^xsd:string ;
    kbr:hasSourceQuote "a. untuk permohonan melalui Portal Wajib Pajak sebagaimana dimaksud pada ayat (3) huruf a: 1. mengisi, menandatangani secara elektronik dan menyampaikan formulir perubahan data pihak yang dapat ditunjuk sebagai kuasa Wajib Pajak; dan 2. mengunggah salinan dokumen pendukung;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_cb5958a4b3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_51_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-cb5958a4b3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/51/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Badan yang menggunakan Kantor Virtual sebagai tempat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (1) huruf a harus memenuhi persyaratan sebagai berikut: a. memiliki klasifikasi lapangan usaha utama di bidang jasa yang kegiatan usahanya dapat dilakukan di Kantor Virtual; b. memiliki kontrak, perjanjian, atau dokumen sejenis sebagaimana dimaksud pada ayat (4) huruf a dengan durasi kontrak penggunaan Kantor Virtual minimal 1 (satu) tahun terhitung sejak pengajuan permohonan Pengusaha Kena Pajak diajukan; dan c. tidak menggunakan Kantor Virtual tersebut semata- mata sebagai alamat korespondensi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_cc12128871 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_74 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-cc12128871"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/74"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak harus menerbitkan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan paling lama 1 (satu) hari kerja setelah jangka waktu penerbitan keputusan berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_cc14b54a46 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-cc14b54a46"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "a. harus mendaftarkan diri untuk memperoleh Nomor Pokok Wajib Pajak dalam hal memenuhi persyaratan subjektif dan objektif;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_cdc06127d6 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_63_4__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-cdc06127d6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/63/4..6"^^xsd:string ;
    kbr:hasSourceQuote "5 (lima) hari kerja untuk penambahan status sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf a, huruf b, dan huruf d terhitung setelah bukti penerimaan elektronik atau bukti penerimaan surat diterbitkan;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ce827fcd0d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_55 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ce827fcd0d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/55"^^xsd:string ;
    kbr:hasSourceQuote "(4) Tanggal pengukuhan Pengusaha Kena Pajak yang tercantum dalam surat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (3) huruf a yang merupakan tanggal dimulainya kewajiban sebagai Pengusaha Kena Pajak yaitu sesuai dengan tanggal penerbitan surat pengukuhan Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d0db644163 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_53 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d0db644163"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/53"^^xsd:string ;
    kbr:hasSourceQuote "Permohonan pengukuhan Pengusaha Kena Pajak secara langsung atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir sebagaimana dimaksud dalam sebagaimana dimaksud dalam Pasal  52 ayat (2) dilakukan oleh Pengusaha dengan mengisi dan menandatangani formulir pengukuhan Pengusaha Kena Pajak disertai peta dan foto lokasi usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d10d79d304 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_31 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d10d79d304"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "Nomor Identitas Tempat Kegiatan Usaha juga diberikan secara jabatan bagi tempat tinggal atau tempat kedudukan Wajib Pajak pada saat pendaftaran Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d151de0b4a a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d151de0b4a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Dikecualikan dari ketentuan sebagaimana dimaksud pada ayat (1) huruf c, Wajib Pajak Badan berbentuk Kerja Sama Operasi wajib mendaftarkan diri paling lama 1 (satu) bulan setelah saat: a. pendirian Kerja Sama Operasi, dalam hal di dalam perjanjian kerja sama Kerja Sama Operasi menunjukkan adanya kriteria sebagaimana diatur dalam Peraturan Menteri yang mengatur mengenai perlakuan perpajakan dalam Kerja Sama Operasi; atau b. melakukan kegiatan sesuai dengan kriteria sebagaimana diatur dalam Peraturan Menteri yang mengatur mengenai perlakuan perpajakan dalam -18- Kerja Sama Operasi, dalam hal di dalam perjanjian kerja sama Kerja Sama Operasi tidak menunjukkan adanya kriteria tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d1cb3f5e0e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_21 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d1cb3f5e0e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak dapat mengajukan permintaan Kode Otorisasi baru ke Direktorat Jenderal Pajak dengan alasan sebagai berikut: a. masa berlaku Kode Otorisasi akan atau telah berakhir; b. passphrase Kode Otorisasi tidak diketahui atau lupa; atau c. sebab lain sehingga Wajib Pajak harus meminta Kode Otorisasi baru."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d296fa675f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_67 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d296fa675f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/67"^^xsd:string ;
    kbr:hasSourceQuote "(1) Atas permohonan perubahan data atas penambahan status Wajib Pajak untuk pihak yang dapat ditunjuk sebagai kuasa Wajib Pajak sebagaimana dimaksud dalam Pasal 66 ayat (3), Kepala Kantor Pelayanan Pajak tempat Wajib Pajak terdaftar menerbitkan surat pemberitahuan perubahan data. (2) Kepala Kantor Pelayanan Pajak tempat Wajib Pajak terdaftar menyampaikan surat pemberitahuan perubahan -66- data sebagaimana dimaksud pada ayat (1) kepada Wajib Pajak melalui: a. Akun Wajib Pajak; dan b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d3de9f9b80 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_13 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d3de9f9b80"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "a. belum memiliki Nomor Pokok Wajib Pajak, wakil dari Wajib Pajak Warisan Belum Terbagi harus melakukan pendaftaran Nomor Pokok Wajib Pajak bagi orang pribadi yang meninggalkan warisan untuk mendapatkan Nomor Pokok Wajib Pajak dengan status Warisan Belum Terbagi;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d40557532a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_23 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d40557532a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/23"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pengajuan aktivasi Akun Wajib Pajak dilakukan secara: a. elektronik melalui Portal Wajib Pajak; atau b. langsung ke Kantor Pelayanan Pajak atau Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d43f7ae336 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d43f7ae336"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Pelaksanaan hak dan/atau pemenuhan kewajiban perpajakan sebagaimana dimaksud pada ayat (1) meliputi administrasi: a. pembayaran Pajak Penghasilan; b. pembayaran Pajak Penjualan atas Barang Mewah; c. pemotongan atau pemungutan Pajak Penghasilan; d. pemungutan Pajak Pertambahan Nilai; e. pembayaran Pajak Bumi dan Bangunan sektor perkebunan, Pajak Bumi dan Bangunan sektor perhutanan, Pajak Bumi dan Bangunan sektor pertambangan minyak dan gas bumi, Pajak Bumi dan Bangunan sektor pertambangan untuk pengusahaan panas bumi, Pajak Bumi dan Bangunan sektor pertambangan mineral atau batubara, dan Pajak Bumi dan Bangunan sektor lainnya; f. penyetoran Bea Meterai; g. pembayaran Pajak Karbon; h. pemotongan atau pemungutan Pajak Karbon; i. pelaporan Pajak Penghasilan, Pajak Pertambahan Nilai, Pajak Bumi dan Bangunan, Pajak Karbon, dan Bea Meterai; j. pemberian layanan perpajakan; k. pengembalian atas kelebihan pembayaran pajak; l. pemberian imbalan bunga; m. pengajuan upaya administratif dan upaya hukum di bidang perpajakan; dan n. pelaksanaan hak dan pemenuhan kewajiban perpajakan lainnya, sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d7c77ae710 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d7c77ae710"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal data Nomor Induk Kependudukan sebagaimana dimaksud pada ayat (2) telah tervalidasi dengan basis data kependudukan namun belum diaktivasi sebagai Nomor Pokok Wajib Pajak, data pendaftaran sebagaimana tercantum dalam formulir pendaftaran Wajib Pajak diverifikasi dan direkam dalam sistem administrasi Direktorat Jenderal Pajak, termasuk merekam data alamat pos elektronik dan nomor telepon seluler yang dapat diverifikasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d8f4375e7f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d8f4375e7f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pendaftaran Wajib Pajak dilakukan secara elektronik melalui: a. Portal Wajib Pajak; b. laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak; dan/atau c. Contact Center. (2) Dalam hal Wajib Pajak tidak dapat melaksanakan pendaftaran secara elektronik sebagaimana dimaksud pada ayat (1), Wajib Pajak melaksanakan pendaftaran: a. secara langsung; atau b. melalui pos, perusahaan jasa ekspedisi, atau jasa kurir, ke Kantor Pelayanan Pajak, Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan, atau tempat lain yang ditetapkan oleh Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_d93a26cda1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_46_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-d93a26cda1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/46/1..3"^^xsd:string ;
    kbr:hasSourceQuote "b. dalam hal permohonan tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1): 1. permohonan dikembalikan kepada Wajib Pajak secara langsung, untuk permohonan yang disampaikan secara langsung; atau -45- 2. kepada Wajib Pajak diterbitkan surat pengembalian permohonan Nomor Pokok Wajib Pajak, untuk permohonan yang disampaikan melalui pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_dac669093a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_85 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-dac669093a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/85"^^xsd:string ;
    kbr:hasSourceQuote "(4) Surat keputusan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan sebagaimana dimaksud pada ayat (3) disampaikan kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_db35c344a4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_7 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-db35c344a4"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Selain Nomor Pokok Wajib Pajak sebagaimana dimaksud dalam Pasal 2 ayat (1), Direktur Jenderal Pajak menerbitkan nomor identitas perpajakan dalam bentuk Nomor Pokok Wajib Pajak berdasarkan permohonan atau secara jabatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_dbf179194f a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_27 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-dbf179194f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "Keputusan sebagaimana dimaksud pada ayat (2) diterbitkan paling lama 1 (satu) hari kerja setelah bukti penerimaan elektronik atau bukti penerimaan surat diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_dc75193891 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-dc75193891"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "2. Undang-Undang Pajak Penghasilan adalah Undang- Undang Nomor 7 Tahun 1983 tentang Pajak Penghasilan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 6 Tahun 2023 tentang Penetapan Peraturan Pemerintah Pengganti Undang-Undang Nomor 2 Tahun 2022 tentang Cipta Kerja menjadi Undang-Undang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_dcc6dd368a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_49 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-dcc6dd368a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha sebagaimana dimaksud dalam Pasal 48 ayat (1) yang berbentuk Kerja Sama Operasi wajib melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dalam hal: a. Kerja Sama Operasi telah melebihi batasan Pengusaha kecil yang batasannya ditetapkan oleh Menteri; dan/atau b. 1 (satu) atau lebih anggota Kerja Sama Operasi telah dikukuhkan sebagai Pengusaha Kena Pajak, sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_dd0a5fa661 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_35 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-dd0a5fa661"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/35"^^xsd:string ;
    kbr:hasSourceQuote "b. dalam hal permohonan tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1) atau ayat (2), kepada Wajib Pajak tidak diterbitkan bukti penerimaan elektronik dan permohonan Wajib Pajak tidak diproses lebih lanjut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_dd37fd5c78 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_77 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-dd37fd5c78"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak diterbitkan bukti penerimaan elektronik;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_dd7969a06a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_59 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-dd7969a06a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/59"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan pencabutan pengukuhan Pengusaha Kena Pajak secara langsung atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir sebagaimana dimaksud dalam Pasal 57 ayat (4) dilakukan dengan: a. mengisi dan menandatangani formulir permohonan pencabutan pengukuhan Pengusaha Kena Pajak; dan b. melampirkan dokumen pendukung yang menunjukkan bahwa ketentuan sebagai Pengusaha Kena Pajak tidak lagi dipenuhi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_de1317adb8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_6__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-de1317adb8"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/6..8"^^xsd:string ;
    kbr:hasSourceQuote "a. untuk Instansi Pemerintah Pusat, berupa salinan dokumen daftar isian pelaksanaan anggaran yang mencantumkan kode satuan kerja dan surat keputusan mengenai penunjukan kuasa pengguna anggaran;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_de18fbc03a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_7__12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-de18fbc03a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/7..12"^^xsd:string ;
    kbr:hasSourceQuote "(9) Dalam hal permohonan yang telah dilakukan penelitian sebagaimana dimaksud pada ayat (8): a. memenuhi persyaratan penerbitan Nomor Pokok Wajib Pajak, kepada Wajib Pajak diterbitkan bukti penerimaan surat; atau b. tidak memenuhi persyaratan penerbitan Nomor Pokok Wajib Pajak: 1. permohonan Wajib Pajak dikembalikan secara langsung, untuk permohonan yang disampaikan secara langsung; atau 2. kepada Wajib Pajak diterbitkan surat pengembalian permohonan atau surat penolakan pendaftaran Wajib Pajak, untuk permohonan yang disampaikan melalui pos, perusahaan jasa ekspedisi atau jasa kurir dengan bukti pengiriman surat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_de9da88cda a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_84 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-de9da88cda"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "(1) Atas permohonan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan yang telah diterbitkan bukti penerimaan elektronik atau bukti penerimaan surat, Kepala Kantor Pelayanan Pajak melakukan pemeriksaan atau penelitian administrasi terhadap pemenuhan persyaratan permohonan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e00c811030 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_5_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e00c811030"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/5/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penggabungan pelaksanaan hak dan pemenuhan kewajiban perpajakan sebagaimana dimaksud dalam Pasal 4 ayat (1) dilakukan sepanjang wanita kawin dan anak yang belum dewasa telah menjadi bagian dari data unit keluarga untuk kepentingan perpajakan. (2) Data unit keluarga sebagaimana dimaksud pada ayat (1) merupakan: a. bagi Wajib Pajak pria kawin, meliputi: 1. data seluruh anggota keluarga yang meliputi Wajib Pajak sendiri, istri, dan anak yang belum dewasa, termasuk anak tiri atau anak angkat yang tercantum dalam kartu keluarga Wajib Pajak atau kartu keluarga lain; dan 2. data anggota keluarga sedarah atau semenda dalam garis keturunan lurus selain anggota keluarga sebagaimana dimaksud pada angka 1 yang menjadi tanggungan sepenuhnya yang tercantum pada kartu keluarga Wajib Pajak atau kartu keluarga lain; -11- b. bagi Wajib Pajak wanita kawin sebagaimana dimaksud dalam Pasal 4 ayat (3) huruf b atau huruf c, meliputi data Wajib Pajak sendiri; c. bagi Wajib Pajak pria atau wanita tidak kawin yang memiliki Nomor Pokok Wajib Pajak sendiri, meliputi: 1. data Wajib Pajak sendiri; dan 2. data anggota keluarga sedarah atau semenda dalam garis keturunan lurus yang menjadi tanggungan sepenuhnya, baik dalam satu kartu keluarga maupun berada pada kartu keluarga lain; atau d. bagi Wajib Pajak wanita kawin sebagaimana dimaksud dalam Pasal 4 ayat (4), meliputi: 1. data seluruh anggota keluarga yang meliputi Wajib Pajak sendiri, dan anak yang belum dewasa, termasuk anak tiri atau anak angkat yang tercantum dalam kartu keluarga Wajib Pajak atau kartu keluarga lain; dan 2. data anggota keluarga sedarah atau semenda dalam garis keturunan lurus sebagaimana dimaksud dalam huruf a angka 2."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e09bf8bc79 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_86_4_z ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e09bf8bc79"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/86/4/z"^^xsd:string ;
    kbr:hasSourceQuote "z. surat penolakan penetapan Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan (Deemed VAT) sebagaimana dimaksud dalam Pasal 63 ayat (3) huruf b; aa. surat penolakan penetapan Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 63 ayat (3) huruf c; bb. logo “TAX FREE SHOP” sebagaimana dimaksud dalam Pasal 68 ayat (2) huruf a angka 1; cc. logo “TAX REFUND FOR TOURISTS” sebagaimana dimaksud dalam Pasal 68 ayat (2) huruf a angka 2; dd. surat pencabutan penetapan Pengusaha Kena Pajak Toko Retail (VAT Refund) sebagaimana dimaksud dalam Pasal 69 ayat (2) huruf a; ee. surat pencabutan penetapan Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan (Deemed VAT) sebagaimana dimaksud dalam Pasal 69 ayat (2) huruf b; ff. surat pencabutan penetapan Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 69 ayat (2) huruf c dan Pasal 70 ayat (2); gg. surat pencabutan keterangan dapat ditunjuk sebagai kuasa Wajib Pajak sebagaimana dimaksud dalam Pasal 69 ayat (2) huruf d; hh. surat penolakan pencabutan penetapan Pengusaha Kena Pajak Toko Retail (VAT Refund) sebagaimana dimaksud dalam Pasal 69 ayat (3) huruf a; ii. surat penolakan pencabutan penetapan Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan (Deemed VAT) sebagaimana dimaksud dalam Pasal 69 ayat (3) huruf b; jj. surat penolakan pencabutan penetapan Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 69 ayat (3) huruf c; kk. Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan (SKT PBB) sebagaimana dimaksud dalam Pasal 74 ayat (2) huruf a dan ayat (3), Pasal 75 ayat (1), Pasal 79 ayat (2) huruf a, serta Pasal 80 ayat (3); ll. surat penolakan pendaftaran objek pajak Pajak Bumi dan Bangunan sebagaimana dimaksud dalam Pasal 74 ayat (2) huruf b; mm. surat pemberitahuan perubahan data objek pajak Pajak Bumi dan Bangunan sebagaimana dimaksud dalam Pasal 79 ayat (2) huruf a dan Pasal 80 ayat (3); nn. surat penolakan perubahan data objek pajak Pajak Bumi dan Bangunan sebagaimana dimaksud dalam Pasal 79 ayat (2) huruf b; oo. surat keputusan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan (SKT PBB) sebagaimana dimaksud dalam Pasal 84 ayat (2) huruf a dan ayat (3), serta Pasal 85 ayat (3); dan pp. surat penolakan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan (SKT PBB) sebagaimana dimaksud dalam Pasal 84 ayat (2) huruf b, dibuat dengan menggunakan contoh format sebagaimana tercantum dalam Lampiran II yang merupakan bagian tidak terpisahkan dari Peraturan Direktur Jenderal ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e186e9b8ec a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_5_3__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e186e9b8ec"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/5/3..5"^^xsd:string ;
    kbr:hasSourceQuote "Penyampaian data unit keluarga sebagaimana dimaksud pada ayat (1) dilakukan melalui mekanisme perubahan data Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e1a27ddbb7 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_87 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e1a27ddbb7"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/87"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pelaksanaan hak dan pemenuhan kewajiban perpajakan oleh Wajib Pajak dapat dilaksanakan: a. secara elektronik, yaitu melalui: 1. Portal Wajib Pajak; 2. laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak; dan/atau 3. Contact Center; atau b. selain secara elektronik, yaitu: 1. secara langsung; atau 2. melalui pos, perusahaan jasa ekspedisi, atau jasa kurir, ke Kantor Pelayanan Pajak, Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan, atau tempat lain yang ditetapkan oleh Direktur Jenderal Pajak. (2) Pelaksanaan hak dan pemenuhan kewajiban perpajakan melalui laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak sebagaimana dimaksud pada ayat (1), dilakukan -84- sepanjang laman atau aplikasi lain yang disediakan Instansi Pemerintah, lembaga, asosiasi, dan pihak lain tersebut telah bekerja sama atau ditunjuk oleh Menteri atau Direktur Jenderal Pajak. (3) Dalam hal pelaksanaan hak dan pemenuhan kewajiban sebagaimana dimaksud pada ayat (1) disampaikan oleh Wajib Pajak melalui pos, jasa ekspedisi, atau jasa kurir tidak lengkap atau tidak dapat divalidasi oleh sistem administrasi Direktorat Jenderal Pajak, permohonan tersebut dianggap bukan sebagai permohonan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e1e6f066d7 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_58 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e1e6f066d7"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/58"^^xsd:string ;
    kbr:hasSourceQuote "a. mengisi, menandatangani secara elektronik, dan menyampaikan formulir permohonan pencabutan pengukuhan Pengusaha Kena Pajak; dan b. mengunggah salinan dokumen pendukung yang menunjukkan bahwa ketentuan sebagai Pengusaha Kena Pajak tidak lagi dipenuhi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e20f5cd344 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_30 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e20f5cd344"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Tanggal pengukuhan Pengusaha Kena Pajak di Kantor Pelayanan Pajak Baru sesuai dengan tanggal pengukuhan Pengusaha Kena Pajak di Kantor Pelayanan Pajak Lama."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e219215e8a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_75 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e219215e8a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap Wajib Pajak dapat diterbitkan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan secara jabatan oleh Kepala Kantor Pelayanan Pajak berdasarkan hasil Pemeriksaan atau penelitian administrasi sesuai data dan/atau informasi yang dimiliki atau diperoleh Direktorat Jenderal Pajak, termasuk data dan/atau informasi yang diperoleh dari kegiatan ekstensifikasi dan kegiatan pengumpulan data."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e3b61a19cf a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_47_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e3b61a19cf"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/47/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kepala Kantor Pelayanan Pajak dapat melakukan penghapusan Nomor Pokok Wajib Pajak secara jabatan sebagaimana dimaksud dalam Pasal 44 ayat (1) berdasarkan data dan/atau informasi yang dimiliki atau diperoleh Direktorat Jenderal Pajak"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e3ecbe821b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_45 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e3ecbe821b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/45"^^xsd:string ;
    kbr:hasSourceQuote "a. mengisi, menandatangani secara elektronik, dan menyampaikan formulir penghapusan Nomor Pokok Wajib Pajak; dan b. mengunggah salinan dokumen pendukung sebagaimana dimaksud dalam Pasal 44 ayat (9)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e45eae81d5 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_54_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e45eae81d5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/54/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(2) Bukti penerimaan elektronik atau bukti penerimaan surat sebagaimana dimaksud pada ayat (1) diterbitkan paling lama 1 (satu) hari kerja setelah permohonan pengukuhan Pengusaha Kena Pajak disampaikan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e515d03fb8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_28 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e515d03fb8"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "(4) Keputusan sebagaimana dimaksud pada ayat (3) diterbitkan paling lama 5 (lima) hari kerja setelah bukti penerimaan elektronik atau bukti penerimaan surat diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e525699bf3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_66_6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e525699bf3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/66/6"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal permohonan memenuhi ketentuan pengisian formulir secara lengkap, kepada Wajib Pajak diterbitkan: 1. bukti penerimaan elektronik, dalam hal permohonan dilakukan melalui Portal Wajib Pajak; atau 2. bukti penerimaan surat, dalam hal permohonan dilakukan secara langsung."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e58836da52 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_66_6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e58836da52"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/66/6"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal permohonan tidak memenuhi ketentuan pengisian formulir secara lengkap, kepada Wajib Pajak tidak diterbitkan bukti penerimaan elektronik atau bukti penerimaan surat dan permohonan Wajib Pajak tidak diproses lebih lanjut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e5e54cfc36 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e5e54cfc36"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Dokumen sebagaimana dimaksud pada ayat (4) disampaikan kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e5fc83e034 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_92 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e5fc83e034"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/92"^^xsd:string ;
    kbr:hasSourceQuote "terhadap Wajib Pajak yang menggunakan Kantor Virtual sebagai tempat kedudukan dan telah dikukuhkan sebagai Pengusaha Kena Pajak di Kantor Virtual sebelum Peraturan Direktur Jenderal ini berlaku tetapi tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 51 ayat (1) huruf a, harus mengajukan permohonan perubahan data Wajib Pajak berupa perubahan tempat kedudukan Wajib Pajak menjadi tempat kegiatan usaha menurut keadaan sebenarnya paling lambat tanggal 31 Desember 2025;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e5fccfcc05 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_68_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e5fccfcc05"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/68/1..2"^^xsd:string ;
    kbr:hasSourceQuote "e. status Wajib Pajak lainnya yang ditetapkan Direktur Jenderal Pajak"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e67b37b258 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_7 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e67b37b258"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Nomor identitas perpajakan sebagaimana dimaksud pada ayat (1) berupa: a. Nomor Induk Kependudukan, bagi orang pribadi yang merupakan Penduduk; dan b. nomor dengan format 16 (enam belas) digit yang dihasilkan oleh sistem administrasi Direktorat Jenderal Pajak, bagi orang pribadi bukan Penduduk dan Badan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e7408a0584 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_71_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e7408a0584"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/71/1..2"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak dapat melaksanakan pendaftaran Objek Pajak secara elektronik sebagaimana dimaksud pada ayat (2) , Wajib Pajak melaksanakan pendaftaran Objek Pajak : a. secara langsung; atau b. melalui pos, perusahaan jasa ekspedisi, atau jasa kurir, ke Kantor Pelayanan Pajak, Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan, atau tempat lain yang ditetapkan oleh Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e7bb94fd2e a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_62_8__9 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e7bb94fd2e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/62/8..9"^^xsd:string ;
    kbr:hasSourceQuote "b. dalam hal permohonan tidak memenuhi ketentuan pengisian formulir secara lengkap dan/atau tidak memenuhi persyaratan sebagaimana dimaksud pada ayat (3), kepada Wajib Pajak tidak diterbitkan bukti penerimaan elektronik atau bukti penerimaan surat dan permohonan Wajib Pajak tidak diproses lebih lanjut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e8039d1049 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_40 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e8039d1049"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan pengaktifan kembali Wajib Pajak Nonaktif melalui Portal Wajib Pajak sebagaimana dimaksud dalam Pasal 39 ayat (2) huruf a, dilakukan dengan mengisi, menandatangani secara elektronik, dan menyampaikan formulir pengaktifan kembali Wajib Pajak Nonaktif. (2) Permohonan pengaktifan kembali Wajib Pajak Nonaktif secara elektronik melalui Contact Center sebagaimana dimaksud dalam Pasal 39 ayat (2) huruf c, dilakukan dengan menyampaikan data pengaktifan kembali Wajib Pajak yang disyaratkan sebagaimana tercantum dalam formulir pengaktifan kembali Wajib Pajak Nonaktif."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e89b1b2c42 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e89b1b2c42"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "b. penghasilan yang diperoleh wanita kawin tersebut tidak dapat digabungkan dengan suaminya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e8b8b6d2d8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_6__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e8b8b6d2d8"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/6..8"^^xsd:string ;
    kbr:hasSourceQuote "d. untuk Instansi Pemerintah Daerah yang berbentuk badan layanan umum daerah, berupa salinan dokumen pelaksanaan anggaran yang mencantumkan kode satuan kerja dan surat keputusan bupati, wali kota, gubernur, atau pejabat yang berwenang mengenai penetapan Instansi Pemerintah yang menerapkan pola pengelolaan keuangan badan layanan umum daerah;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e8d465df1d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_6__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e8d465df1d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/6..8"^^xsd:string ;
    kbr:hasSourceQuote "e. untuk Instansi Pemerintah Desa, berupa surat pengangkatan kepala desa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e8f24061f5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e8f24061f5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "a. tempat tinggal Wajib Pajak orang pribadi sebagaimana dimaksud dalam Pasal 10 ayat (2) atau Wajib Pajak Warisan Belum Terbagi sebagaimana dimaksud dalam Pasal 10 ayat (4);"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e912ec258a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_10_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e912ec258a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(3) Tempat tinggal sebagaimana dimaksud pada ayat (2) ditentukan menurut keadaan yang sebenarnya, yakni: a. tempat tinggal tetap orang pribadi beserta keluarganya; b. tempat pusat kepentingan pribadi dan ekonomi dilakukan, dalam hal orang pribadi tersebut: 1. mempunyai tempat tinggal tetap sebagaimana dimaksud dalam huruf a di 2 (dua) tempat atau lebih; atau 2. tidak mempunyai tempat tinggal tetap sebagaimana dimaksud dalam huruf a; atau c. tempat orang pribadi lebih lama tinggal dalam kurun waktu 1 (satu) tahun kalender terakhir, dalam hal tempat pusat kepentingan pribadi dan ekonomi dilakukan sebagaimana dimaksud dalam huruf b tidak dapat ditentukan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_e9fb5a7788 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_46_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-e9fb5a7788"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/46/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(3) Atas permohonan penghapusan Nomor Pokok Wajib Pajak yang telah diterbitkan bukti penerimaan elektronik atau bukti penerimaan surat, Kepala Kantor Pelayanan Pajak melakukan Pemeriksaan terhadap pemenuhan persyaratan subjektif dan/atau objektif Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ea6f9add97 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_24_4__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ea6f9add97"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/24/4..8"^^xsd:string ;
    kbr:hasSourceQuote "(7) Dalam hal perubahan data terkait perubahan Wajib Pajak orang pribadi menjadi Wajib Pajak Warisan Belum Terbagi sebagaimana dimaksud pada ayat (3) huruf a angka 7, dokumen pendukung yang harus dilampirkan meliputi: a. salinan akta kematian, surat keterangan kematian, atau dokumen sejenis; b. dokumen yang menunjukkan kedudukan sebagai wakil Wajib Pajak Warisan Belum Terbagi, dengan ketentuan sebagai berikut: 1. dalam hal diwakili oleh pelaksana wasiat, harus melampirkan salinan akta wasiat, surat wasiat, atau dokumen lain yang dipersamakan; atau 2. dalam hal diwakili oleh pihak yang mengurus harta peninggalan, harus melampirkan salinan dokumen penunjukan pihak yang mengurus harta peninggalan; dan c. surat kuasa khusus sebagaimana dimaksud dalam Pasal 32 ayat (3) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan, dalam hal permohonan perubahan data dilaksanakan oleh seorang kuasa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_eae9c79d2c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-eae9c79d2c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "5. Wajib Pajak adalah orang pribadi atau badan, meliputi pembayar pajak, pemotong pajak, dan pemungut pajak, yang mempunyai hak dan kewajiban perpajakan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_eaf0073f97 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_33 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-eaf0073f97"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Nomor Identitas Tempat Kegiatan Usaha sebagaimana dimaksud dalam Pasal 31 ayat (1) digunakan dalam pelaksanaan administrasi perpajakan berupa: a. pemberian akses kepada pengurus, pegawai di kantor cabang, atau pegawai di Subunit Organisasi Wajib Pajak untuk dapat membuat atau menandatangani bukti pemotongan Pajak Penghasilan dan faktur pajak; b. identifikasi lokasi tempat bekerja setiap pegawai dalam pelaporan Surat Pemberitahuan Masa Pajak Penghasilan Pasal 21; c. identifikasi lokasi tempat tinggal, tempat kedudukan, dan cabang tempat kegiatan usaha Wajib Pajak Orang Pribadi Pengusaha Tertentu dan Wajib Pajak Badan yang dikenakan Pajak Penghasilan final sesuai dengan Peraturan Pemerintah yang mengatur mengenai penyesuaian pengaturan di bidang Pajak Penghasilan untuk melaporkan peredaran usaha masing-masing tempat dimaksud dalam Surat Pemberitahuan Tahunan Pajak Penghasilan; d. identifikasi alamat Pengusaha Kena Pajak penjual barang kena pajak dan/atau pemberi jasa kena pajak yang -35- digunakan untuk melakukan penyerahan barang kena pajak dan/atau jasa kena pajak dan alamat pembeli barang kena pajak dan/atau penerima jasa kena pajak yang menerima pengiriman atau penyerahan barang kena pajak dan/atau jasa kena pajak, untuk pembuatan faktur pajak; e. identifikasi lokasi objek pajak Pajak Bumi dan Bangunan untuk pelaporan objek pajak Pajak Bumi dan Bangunan; dan f. administrasi perpajakan lainnya sesuai ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ebf17832e1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ebf17832e1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(5) Permohonan pendaftaran untuk Wajib Pajak Badan dilampiri dengan dokumen persyaratan sebagai berikut: a. untuk Wajib Pajak Badan baik yang berorientasi pada profit (profit oriented) maupun yang tidak berorientasi pada profit (non profit oriented), yaitu salinan dokumen pendirian badan usaha, berupa: 1. akta pendirian atau dokumen pendirian dan perubahannya, bagi Wajib Pajak Badan dalam negeri; atau 2. surat keterangan penunjukan dari kantor pusat, bagi bentuk usaha tetap atau kantor perwakilan perusahaan asing;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ed3524583b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_15_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ed3524583b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/15/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(2) Aktivasi Nomor Induk Kependudukan sebagai Nomor Pokok Wajib Pajak sebagaimana dimaksud pada ayat (1) dilakukan dengan terlebih dahulu memvalidasi data Nomor Induk Kependudukan dengan basis data kependudukan melalui sistem administrasi Direktorat Jenderal Pajak yang terintegrasi dengan sistem administrasi kependudukan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ed7bee636c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_47_5__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ed7bee636c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/47/5..6"^^xsd:string ;
    kbr:hasSourceQuote "(6) Direktur Jenderal Pajak atau Kepala Kantor Pelayanan Pajak dapat melakukan pembenahan basis data administrasi Nomor Pokok Wajib Pajak dalam hal terdapat data dan/atau informasi yang menunjukkan bahwa: a. data dan/atau informasi Wajib Pajak yang terdapat dalam administrasi perpajakan berbeda dengan keadaan yang sebenarnya; dan b. Wajib Pajak masih memenuhi persyaratan subjektif dan objektif pada saat diterbitkannya surat keputusan penghapusan Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_edd2f7836f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_70 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-edd2f7836f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/70"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pencabutan penetapan atas penambahan status Wajib Pajak secara jabatan sebagaimana dimaksud pada ayat (1) dilakukan dengan menerbitkan surat pencabutan penetapan Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 69 ayat (2) huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ee1da73478 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_37 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ee1da73478"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "(3) Keputusan sebagaimana dimaksud pada ayat (2) diterbitkan paling lama 5 (lima) hari kerja setelah bukti penerimaan elektronik atau bukti penerimaan surat diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ee59f684a6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_37 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ee59f684a6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "a. surat penetapan Wajib Pajak Nonaktif, dalam hal Wajib Pajak memenuhi kriteria sebagaimana dimaksud dalam Pasal 34 ayat (2);"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ee8cae62a8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_80 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ee8cae62a8"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/80"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak dapat melakukan perubahan data Objek Pajak secara jabatan berdasarkan data dan/atau informasi yang dimiliki atau diperoleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_eefa8622cc a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_10_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-eefa8622cc"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(4) Wajib Pajak Warisan Belum Terbagi sebagaimana dimaksud pada ayat (1) huruf b wajib mendaftarkan diri pada Kantor Pelayanan Pajak yang wilayah kerjanya meliputi tempat tinggal Wajib Pajak orang pribadi yang meninggalkan warisan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f02926f210 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_24_4__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f02926f210"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/24/4..8"^^xsd:string ;
    kbr:hasSourceQuote "(8) Dalam hal perubahan data Wajib Pajak dilakukan secara jabatan sebagaimana dimaksud pada ayat (2), Kepala Kantor Pelayanan Pajak memberitahukan perubahan tersebut kepada Wajib Pajak dengan menyampaikan surat pemberitahuan perubahan data."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f112b13696 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f112b13696"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Permohonan pendaftaran untuk Wajib Pajak orang pribadi yang bukan Penduduk dilampiri dengan dokumen persyaratan sebagai berikut: a. salinan paspor; b. pasfoto berwarna Wajib Pajak yang bersangkutan; dan -19- c. pasfoto berwarna Wajib Pajak yang bersangkutan dengan memegang paspor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f1477ba7b7 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_38 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f1477ba7b7"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "(2) Selain berdasarkan kriteria sebagaimana dimaksud dalam Pasal 34 ayat (2), penetapan Wajib Pajak Nonaktif secara jabatan juga dapat dilakukan terhadap Wajib Pajak yang memenuhi persyaratan: a. Wajib Pajak tidak melaporkan Surat Pemberitahuan Masa atau Surat Pemberitahuan Tahunan secara berturut-turut dalam 5 (lima) tahun terakhir; b. Wajib Pajak tidak dilakukan pemotongan atau pemungutan pajak oleh pihak ketiga atau pihak lain secara berturut-turut dalam 5 (lima) tahun terakhir; c. Wajib Pajak tidak melakukan pembayaran pajak secara berturut-turut dalam 5 (lima) tahun terakhir; d. Wajib Pajak tidak memiliki tunggakan pajak dan/atau tidak sedang melakukan upaya hukum; e. Wajib Pajak tidak sedang dilakukan pemeriksaan pajak, pemeriksaan bukti permulaan, dan/atau penyidikan tindak pidana perpajakan; dan f. Wajib Pajak tidak mendapatkan fasilitas atau insentif perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f1cf231d20 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_72 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f1cf231d20"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan pendaftaran Objek Pajak melalui Portal Wajib Pajak sebagaimana dimaksud dalam Pasal 71 ayat (2) huruf a, dilakukan dengan: a. mengisi dan menyampaikan formulir permohonan pendaftaran objek pajak Pajak Bumi dan Bangunan; dan b. mengunggah salinan digital dokumen sebagaimana dimaksud dalam Pasal 71 ayat (4) dan ayat (5)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f244d933db a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_86_4_p__y ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f244d933db"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/86/4/p..y"^^xsd:string ;
    kbr:hasSourceQuote "p. surat penghapusan Nomor Pokok Wajib Pajak sebagaimana dimaksud dalam Pasal 46 ayat (5) huruf a dan ayat (7), serta Pasal 47 ayat (4); q. surat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 27 ayat (4), Pasal 54 ayat (5) huruf a dan ayat (6), serta Pasal 55 ayat (3) huruf a; r. surat penolakan pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 54 ayat (5) huruf b; s. surat pencabutan pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 60 ayat (2) huruf a dan ayat (4), serta Pasal 61 ayat (3); -82- t. surat penolakan pencabutan pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 60 ayat (2) huruf b; u. surat penetapan Pengusaha Kena Pajak Toko Retail (VAT Refund) sebagaimana dimaksud dalam Pasal 63 ayat (2) huruf a; v. surat penetapan Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan (Deemed VAT) sebagaimana dimaksud dalam Pasal 63 ayat (2) huruf b; w. surat penetapan Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 63 ayat (2) huruf c dan Pasal 64 ayat (2); x. surat keterangan dapat ditunjuk sebagai kuasa Wajib Pajak sebagaimana dimaksud dalam Pasal 63 ayat (2) huruf d; y. surat penolakan penetapan Pengusaha Kena Pajak Toko Retail (VAT Refund) sebagaimana dimaksud dalam Pasal 63 ayat (3) huruf a;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f4e5b57927 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f4e5b57927"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Berdasarkan permohonan pendaftaran sebagaimana dimaksud pada ayat (1), Kepala Kantor Pelayanan Pajak menindaklanjuti dengan: a. menerbitkan bukti penerimaan surat; b. mengaktivasi Nomor Induk Kependudukan sebagai Nomor Pokok Wajib Pajak dan menerbitkan surat keterangan aktivasi Nomor Induk Kependudukan; c. menerbitkan Kartu Nomor Pokok Wajib Pajak dan Surat Keterangan Terdaftar; dan/atau d. mengaktivasi Akun Wajib Pajak dan Kode Otorisasi serta menerbitkan surat penerbitan Akun Wajib Pajak dan surat penerbitan Kode Otorisasi Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f630ae347d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_64 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f630ae347d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kepala Kantor Pelayanan Pajak tempat Wajib Pajak terdaftar dapat melakukan penetapan penambahan atas status Wajib Pajak secara jabatan berdasarkan hasil pemeriksaan atau hasil penelitian administrasi sesuai dengan data dan/atau informasi yang dimiliki atau diperoleh Direktorat Jenderal Pajak, termasuk data dan/atau informasi yang diperoleh dari kegiatan pengumpulan data bahwa Wajib Pajak memenuhi kriteria sebagai Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f713461b72 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f713461b72"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak Orang Pribadi Pengusaha Tertentu adalah Wajib Pajak orang pribadi yang melakukan kegiatan usaha perdagangan atau jasa, tidak termasuk jasa sehubungan dengan pekerjaan bebas, pada 1 (satu) atau lebih tempat kegiatan usaha yang berbeda dengan tempat tinggal Wajib Pajak sebagaimana dimaksud dalam peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f990d22a02 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_20 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f990d22a02"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Penyampaian surat penerbitan Akun Wajib Pajak dan surat penerbitan Kode Otorisasi Direktorat Jenderal Pajak sebagaimana dimaksud pada ayat (5) kepada Wajib Pajak dilakukan melalui: a. Akun Wajib Pajak; dan b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f9d67610f0 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_86_1_a__m ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f9d67610f0"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/86/1/a..m"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dokumen berupa: -79- a. formulir pendaftaran sebagaimana dimaksud dalam Pasal 15 ayat (4) huruf b, Pasal 15 ayat (8), Pasal 16 ayat (3) dan Pasal 16 ayat (7) huruf a untuk: 1. Wajib Pajak orang pribadi dan Warisan Belum Terbagi; 2. Wajib Pajak Badan; 3. Wajib Pajak Instansi Pemerintah; b. formulir aktivasi Akun Wajib Pajak sebagaimana dimaksud dalam Pasal 20 ayat (4); c. formulir permintaan Kode Otorisasi sebagaimana dimaksud dalam Pasal 21 ayat (3); d. formulir pemberitahuan Sertifikat Elektronik penyelenggara sertifikasi elektronik sebagaimana dimaksud dalam Pasal 22 ayat (2); e. formulir perubahan data Wajib Pajak sebagaimana dimaksud dalam Pasal 25 ayat (1) huruf a dan Pasal 26 ayat (1) huruf a untuk: 1. Wajib Pajak orang pribadi dan Warisan Belum Terbagi; 2. Wajib Pajak Badan; 3. Wajib Pajak Instansi Pemerintah; f. formulir penetapan Wajib Pajak Nonaktif sebagaimana dimaksud dalam Pasal 35 ayat (1) huruf a dan Pasal 36 ayat (1) huruf a; g. formulir pengaktifan kembali Wajib Pajak Nonaktif sebagaimana dimaksud dalam Pasal 40 ayat (1) dan ayat (2), serta Pasal 41 ayat (1); h. formulir penghapusan Nomor Pokok Wajib Pajak sebagaimana dimaksud dalam Pasal 45 ayat (1) huruf a dan Pasal 46 ayat (1) huruf a; i. formulir pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 52 ayat (3), ayat (4), ayat (5), dan ayat (6), serta Pasal 53 ayat (1) dan ayat (2); j. surat pernyataan tentang kegiatan usaha dan tempat kegiatan usaha yang sebenarnya sebagaimana dimaksud dalam Pasal 52 ayat (4) huruf b, Pasal 52 ayat (6) huruf b, dan Pasal 53 ayat (2) huruf b; k. formulir permohonan pencabutan pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 58 ayat (1) huruf a dan Pasal 59 ayat (1) huruf a; l. formulir penetapan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (6) huruf a angka 1 dan huruf b angka 1 untuk: 1. Pengusaha Kena Pajak Toko Retail (VAT Refund); 2. Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan (Deemed VAT); 3. Pemungut Bea Meterai; 4. pihak yang dapat ditunjuk sebagai kuasa Wajib Pajak; m. surat permohonan untuk ditetapkan sebagai Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 62 ayat (7) huruf a; -80-"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_f9f9633ee1 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_68_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-f9f9633ee1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/68/1..2"^^xsd:string ;
    kbr:hasSourceQuote "d. pihak yang dapat ditunjuk sebagai kuasa Wajib Pajak yang dilakukan pencabutan izin praktik konsultan pajak atau surat keterangan terdaftar pihak lain oleh unit pada Kementerian Keuangan yang memiliki tugas mengoordinasikan dan melaksanakan penyiapan perumusan kebijakan, pembinaan, pengembangan, pengawasan dan pelayanan informasi atas profesi keuangan"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fa8ef86598 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_38 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fa8ef86598"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kepala Kantor Pelayanan Pajak secara jabatan dapat menetapkan Wajib Pajak Nonaktif dengan menerbitkan surat penetapan Wajib Pajak Nonaktif, berdasarkan data dan/atau informasi yang menunjukkan bahwa Wajib Pajak memenuhi kriteria sebagaimana dimaksud dalam Pasal 34 ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_faacdbb6cc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-faacdbb6cc"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "9. Penduduk adalah Warga Negara Indonesia dan orang asing yang bertempat tinggal di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fb84ac75ec a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_85 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fb84ac75ec"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/85"^^xsd:string ;
    kbr:hasSourceQuote "(3) Berdasarkan hasil Pemeriksaan atau hasil penelitian administrasi sebagaimana dimaksud pada ayat (2) dilakukan penerbitan surat keputusan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fc1b9ea7ec a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_18 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fc1b9ea7ec"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak melaksanakan kewajiban untuk mendaftarkan diri sebagaimana dimaksud dalam Pasal 2, Wajib Pajak diterbitkan Nomor Pokok Wajib Pajak secara jabatan berdasarkan hasil penelitian administrasi oleh Kepala Kantor Pelayanan Pajak dan diberikan Kartu Nomor Pokok Wajib Pajak, Surat Keterangan Terdaftar dan/atau surat keterangan aktivasi Nomor Induk Kependudukan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fc67667ae5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_28 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fc67667ae5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "(2) Atas permohonan perubahan data sebagaimana dimaksud pada ayat (1), Kepala Kantor Pelayanan Pajak Lama melakukan penelitian tempat tinggal atau tempat kedudukan Wajib Pajak tidak lagi berada di wilayah kerja Kantor Pelayanan Pajak Lama."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fc8787bc02 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_52_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fc8787bc02"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/52/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(5) Permohonan pengukuhan Pengusaha Kena Pajak secara elektronik melalui Contact Center sebagaimana dimaksud pada ayat (1) huruf c, dilakukan dengan menyampaikan data permohonan yang dipersyaratkan sebagaimana tercantum dalam formulir pengukuhan Pengusaha Kena Pajak disertai peta dan foto lokasi usaha yang diunggah melalui saluran yang telah ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fcd8dbe1cd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_47_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fcd8dbe1cd"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/47/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penghapusan Nomor Pokok Wajib Pajak secara jabatan dilakukan berdasarkan hasil Pemeriksaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fd5bbc0e1b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_47_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fd5bbc0e1b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/47/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(4) Berdasarkan hasil pemeriksaan sebagaimana dimaksud pada ayat (2) atau penelitian administrasi sebagaimana dimaksud pada ayat (3) , kepada Wajib Pajak dapat diterbitkan surat penghapusan Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fdcb64cfa1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_71_4__7 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fdcb64cfa1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/71/4..7"^^xsd:string ;
    kbr:hasSourceQuote "(5) Selain dilampiri dokumen Objek Pajak sebagaimana dimaksud pada ayat (4), Wajib Pajak harus menyampaikan foto Objek Pajak dan peta batas terluar Objek Pajak yang berkoordinat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fdfcabf4fe a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_7__12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fdfcabf4fe"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/7..12"^^xsd:string ;
    kbr:hasSourceQuote "(7) Permohonan pendaftaran yang disampaikan secara langsung atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir sebagaimana dimaksud dalam Pasal 14 ayat (2) bagi selain orang pribadi yang merupakan Penduduk dilakukan dengan: a. mengisi, menandatangani, dan menyampaikan formulir pendaftaran Wajib Pajak; dan b. melampirkan dokumen yang disyaratkan sebagaimana dimaksud dalam Pasal 14."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fea854104e a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_72 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fea854104e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "(3) Atas permohonan pendaftaran Objek Pajak yang disampaikan melalui Portal Wajib Pajak: a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak diterbitkan bukti penerimaan elektronik; atau b. dalam hal permohonan tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib -72- Pajak tidak diterbitkan bukti penerimaan elektronik dan permohonan Wajib Pajak tidak diproses lebih lanjut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_febf0bbbbb a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_20 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-febf0bbbbb"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Aktivasi Akun Wajib Pajak sebagaimana dimaksud pada ayat (3) dilakukan dengan mengisi dan menyampaikan formulir aktivasi Akun Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_fed94c6df1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_24_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-fed94c6df1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/24/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Wajib Pajak harus melakukan perubahan data dalam hal data dan/atau informasi yang telah dilaporkan dalam administrasi perpajakan berbeda dengan keadaan yang sebenarnya dengan mengajukan permohonan perubahan data."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ff6308201b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_55 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ff6308201b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/55"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kepala Kantor Pelayanan Pajak dapat mengukuhkan Pengusaha Kena Pajak secara jabatan, dalam hal Pengusaha tidak melaksanakan kewajiban pelaporan usaha untuk dikukuhkan sebagai Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 48 ayat (1), ayat (3), dan ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_ffe29f4d1d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_55 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-ffe29f4d1d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/55"^^xsd:string ;
    kbr:hasSourceQuote "(5) Surat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (3) huruf a disampaikan kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_0284be45fd a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-0284be45fd"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "3. Meterai Teraan Digital adalah meterai berupa label yang penggunaannya dilakukan dengan cara dibubuhkan pada dokumen dengan menggunakan pencetak (printer) Meterai Teraan Digital."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_039c00fc6d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_20 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-039c00fc6d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak melimpahkan kewenangan dalam bentuk mandat kepada direktur yang menangani bidang teknologi informasi dan komunikasi untuk: a. melakukan penelitian dan/atau pengujian, menerbitkan dokumen dalam rangka penelitian dan/atau pengujian, dan/atau memberikan jawaban atas permohonan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 4 ayat (1); b. melakukan penelitian dan/atau pengujian, menerbitkan dokumen dalam rangka penelitian dan/atau pengujian, dan/atau memberikan jawaban atas permohonan verifikasi Printer MTD dan/atau Cartridge MTD sebagaimana dimaksud dalam Pasal 11 ayat (1); - 16 - c. melakukan pengawasan dan/atau menerbitkan dokumen dalam rangka pengawasan atas pemenuhan ketentuan mengenai kewajiban dan/atau larangan Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 16; dan d. melakukan penelitian dan/atau memberikan keputusan atas permohonan pencabutan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 18 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_03e5d7f88b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_9_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-03e5d7f88b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/9/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) harus: a. menyelesaikan perbaikan pengembangan Aplikasi MTD sesuai dengan surat permintaan perbaikan pengembangan Aplikasi MTD; dan b. menyampaikan surat pemberitahuan penyelesaian perbaikan pengembangan Aplikasi MTD kepada Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_056d2ca737 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_12 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-056d2ca737"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyelesaian permohonan verifikasi Printer MTD dan/atau Cartridge MTD sebagaimana dimaksud dalam Pasal 11 ayat (1) meliputi tahapan: a. penelitian kelengkapan dokumen permohonan; dan b. pengujian Printer MTD dan/atau Cartridge MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_069f78c197 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-069f78c197"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "6. Cartridge Meterai Teraan Digital yang selanjutnya disebut Cartridge MTD adalah wadah penyimpan tinta khusus untuk Printer MTD yang spesifikasinya ditentukan oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_106011a63e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_21_3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-106011a63e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/21/3"^^xsd:string ;
    kbr:hasSourceQuote "c. surat pernyataan pengurus dan pemilik/pemegang saham tidak pernah dan/atau tidak sedang dipidana karena melakukan tindak pidana di bidang perpajakan dan/atau teknologi informasi berdasarkan putusan pengadilan yang telah berkekuatan hukum tetap sebagaimana dimaksud dalam Pasal 4 ayat (3) huruf d; d. surat pernyataan bersedia memberitahukan perubahan susunan pengurus dan/atau kepemilikan saham sebagaimana dimaksud dalam Pasal 4 ayat (3) huruf g; e. surat pernyataan seluruh infrastruktur teknologi informasi, jaringan, anak perusahaan, kantor perwakilan, agen, dan/atau kantor cabang yang menyediakan layanan purna jual Printer MTD berada di Indonesia sebagaimana dimaksud dalam Pasal 4 ayat (3) huruf l; f. surat pernyataan kewajiban menjaga rahasia sebagaimana dimaksud dalam Pasal 4 ayat (3) huruf m; g. surat penolakan permohonan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 5 ayat (2) dan Pasal 9 ayat (8); h. surat permintaan perbaikan dan/atau perubahan rencana pengembangan Aplikasi MTD sebagaimana dimaksud dalam Pasal 7 ayat (2); i. surat persetujuan rencana pengembangan Aplikasi MTD sebagaimana dimaksud dalam Pasal 7 ayat (4); j. surat pernyataan kesanggupan menjalankan rencana pengembangan Aplikasi MTD sebagaimana dimaksud dalam Pasal 7 ayat (5); k. surat pemberitahuan penyelesaian pengembangan/perbaikan pengembangan Aplikasi MTD sebagaimana dimaksud dalam Pasal 8 ayat (3) huruf b dan Pasal 9 ayat (4) huruf b; l. surat permintaan perbaikan pengembangan Aplikasi MTD sebagaimana dimaksud dalam Pasal 9 ayat (3) dan (6); - 17 - m. keputusan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 10 ayat (1); n. surat permohonan verifikasi Printer MTD dan/atau Cartridge MTD sebagaimana dimaksud dalam Pasal 11 ayat (1); o. surat pernyataan spesifikasi Printer MTD dan/atau Cartridge MTD sebagaimana dimaksud dalam Pasal 11 ayat (5) huruf b; p. surat pernyataan tersedianya layanan purna jual Printer MTD sebagaimana dimaksud dalam Pasal 11 ayat (5) huruf c; q. surat penolakan permohonan verifikasi Printer MTD dan/atau Cartridge MTD sebagaimana dimaksud dalam Pasal 12 ayat (2) dan Pasal 13 ayat (5); r. surat persetujuan verifikasi Printer MTD dan/atau Catridge MTD sebagaimana dimaksud dalam Pasal 13 ayat"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_11a3a59ec3 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_7 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-11a3a59ec3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) harus menyampaikan perbaikan dan/atau perubahan dokumen rencana pengembangan Aplikasi MTD sebagaimana dimaksud pada ayat (2) dalam jangka waktu paling lama 10 (sepuluh) hari kerja terhitung sejak tanggal surat permintaan perbaikan dan/atau perubahan rencana pengembangan Aplikasi MTD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_253d38cd9b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-253d38cd9b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyedia Printer MTD mengajukan permohonan verifikasi Printer MTD dan/atau Cartridge MTD kepada Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_2568f705fc a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_18_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-2568f705fc"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/18/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(3) Permohonan sebagaimana dimaksud pada ayat (1) dilampiri dengan: a. dokumen pendukung yang menjadi alasan permohonan pencabutan penunjukan sebagai Penyedia Printer MTD; dan b. dokumen kesediaan Penyedia Printer MTD lain untuk menerima pengalihan pengguna."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_2be870a374 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-2be870a374"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "(2) Direktur Jenderal Pajak menyampaikan dokumen petunjuk pengembangan Aplikasi MTD kepada pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1), dalam hal hasil penelitian lapangan sebagaimana dimaksud pada ayat (1) sesuai dengan dokumen yang disampaikan sebagaimana dimaksud dalam Pasal 4 ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_2c27c6406f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_18_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-2c27c6406f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/18/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(5) Direktur Jenderal Pajak memberikan keputusan: a. menerima permohonan pencabutan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (4) huruf a dengan menetapkan keputusan pencabutan penunjukan sebagai Penyedia Printer MTD; atau b. menolak permohonan pencabutan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (4) huruf b dengan menyampaikan surat penolakan permohonan pencabutan penunjukan sebagai Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_2d2a6a39fa a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_6__7 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-2d2a6a39fa"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/6..7"^^xsd:string ;
    kbr:hasSourceQuote "b. tidak melaksanakan pemenuhan kembali ketentuan sebagaimana dimaksud dalam Pasal 15 ayat (2) dan/atau ayat (3) dan tidak mengajukan permohonan pengakhiran sanksi dalam jangka waktu sebagaimana dimaksud pada ayat (6) huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_2d5ce01215 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-2d5ce01215"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "(4) Printer MTD sebagaimana dimaksud pada ayat (2) harus terkoneksi dengan Aplikasi MTD yang telah dikembangkan oleh Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_2d8b2269d6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_19 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-2d8b2269d6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal dilakukan pencabutan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 17 ayat (8) atau Pasal 18 ayat (5) huruf a, Penyedia Printer MTD harus melaporkan pelaksanaan penghentian kegiatan secara tertulis kepada Direktur Jenderal Pajak paling lama 10 (sepuluh) hari kerja sejak tanggal pencabutan penunjukan sebagai Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_2ebc864f9e a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_4_3__4 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-2ebc864f9e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/4/3..4"^^xsd:string ;
    kbr:hasSourceQuote "(3) Permohonan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (1) dilampiri dengan: a. salinan akta pendirian badan usaha, termasuk anggaran dasar beserta perubahannya yang telah disahkan oleh instansi yang berwenang sesuai dengan ketentuan peraturan perundang-undangan; b. Surat Keterangan Fiskal; c. surat pernyataan tidak pernah dan/atau tidak sedang dipidana karena melakukan tindak pidana di bidang perpajakan dan/atau teknologi informasi berdasarkan putusan pengadilan yang telah berkekuatan hukum tetap bagi badan usaha; d. surat pernyataan tidak pernah dan/atau tidak sedang dipidana karena melakukan tindak pidana di bidang perpajakan dan/atau teknologi informasi berdasarkan putusan pengadilan yang telah berkekuatan hukum tetap bagi pengurus dan pemilik/pemegang saham; e. data kepemilikan badan usaha beserta daftar pemegang saham dan rincian besarnya kepemilikan masing-masing; f. daftar susunan pengurus dan struktur organisasi; g. surat pernyataan bersedia memberitahukan perubahan susunan pengurus dan/atau kepemilikan saham; h. dokumen perencanaan bisnis (business plan) untuk jangka waktu sekurang-kurangnya 6 (enam) tahun; i. dokumen perencanaan keberlangsungan bisnis (business continuity plan) yang paling sedikit memuat informasi mengenai prosedur dan instruksi yang harus dilaksanakan dalam keadaan darurat untuk memastikan keberlangsungan penyediaan dan penggunaan Printer MTD; j. dokumen spesifikasi Printer MTD dan Cartridge MTD yang diajukan verifikasi; k. surat dukungan dari pemegang merek Printer MTD; l. surat pernyataan seluruh infrastruktur teknologi informasi, jaringan, anak perusahaan, kantor perwakilan, agen, dan/atau kantor cabang yang menyediakan layanan purna jual Printer MTD berada di Indonesia; dan m. surat pernyataan kewajiban menjaga rahasia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_30d2bcaef5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_18_4__8 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-30d2bcaef5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/18/4..8"^^xsd:string ;
    kbr:hasSourceQuote "(7) Atas permohonan yang dianggap diterima sebagaimana dimaksud pada ayat (6), Direktur Jenderal Pajak menetapkan keputusan pencabutan penunjukan sebagai Penyedia Printer MTD dalam jangka waktu paling lama 10 (sepuluh) hari kerja sejak jangka waktu sebagaimana dimaksud pada ayat (4) berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_31b21d1780 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_19 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-31b21d1780"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(2) Laporan penghentian kegiatan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (1) dilampiri dengan: a. berita acara proses pengalihan pengguna kepada Penyedia Printer MTD lain; b. dokumen penyelesaian hak dan kewajiban kepada pihak terkait; dan c. surat pernyataan tanggung jawab pengurus yang menyatakan bahwa segala tuntutan yang timbul setelah pencabutan penunjukan sebagai Penyedia Printer MTD menjadi tanggung jawab sepenuhnya dari pengurus."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_3522f17c58 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-3522f17c58"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "(5) Permohonan verifikasi sebagaimana dimaksud pada ayat (1) dilampiri dengan: a. surat dukungan dari pemegang merek Printer MTD; b. surat pernyataan spesifikasi Printer MTD dan/atau Cartridge MTD; c. surat pernyataan tersedianya layanan purna jual Printer MTD; d. dokumen sertifikasi merek yang masih berlaku yang diterbitkan oleh kementerian yang menyelenggarakan urusan pemerintahan di bidang kekayaan intelektual untuk masing-masing Printer MTD; dan e. dokumen persetujuan perekaman (recordation) merek atau hak cipta yang masih berlaku yang diterbitkan oleh kementerian yang menyelenggarakan urusan pemerintahan di bidang kepabeanan dan cukai untuk masing-masing Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_3b726a2897 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_18_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-3b726a2897"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/18/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(4) Atas permohonan sebagaimana dimaksud pada ayat (3), Direktur Jenderal Pajak memberikan keputusan: a. menerima permohonan pencabutan penunjukan sebagai Penyedia Printer MTD dalam hal Penyedia Printer MTD memenuhi ketentuan sebagaimana dimaksud pada ayat (1); atau b. menolak permohonan pencabutan penunjukan sebagai Penyedia Printer MTD dalam hal Penyedia Printer MTD tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1), dalam jangka waktu paling lama 20 (dua puluh) hari kerja terhitung sejak tanggal diterimanya surat permohonan pencabutan penunjukan sebagai Penyedia Printer MTD diterima lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_3ee4eb5b50 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_10 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-3ee4eb5b50"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(4) Atas permohonan yang dianggap diterima sebagaimana dimaksud pada ayat (3), Direktur Jenderal Pajak menetapkan keputusan penunjukan sebagai Penyedia Printer MTD dalam jangka waktu paling lama 10 (sepuluh) hari kerja sejak jangka waktu sebagaimana dimaksud pada ayat (2) berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_4408a3f4f2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_6__7 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-4408a3f4f2"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/6..7"^^xsd:string ;
    kbr:hasSourceQuote "b. Penyedia Printer MTD wajib menginformasikan pengenaan sanksi penghentian sementara kepada pengguna layanan Penyedia Printer MTD;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_452bb0df24 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_6__7 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-452bb0df24"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/6..7"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak menetapkan keputusan pencabutan penunjukan sebagai Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_45370347bc a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-45370347bc"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Sanksi administratif berupa penghentian sementara layanan Penyedia Printer MTD sebagaimana dimaksud pada ayat (1) huruf b dikenakan dalam hal Penyedia Printer MTD: a. telah dikenai sanksi administratif berupa teguran; dan b. tidak melaksanakan pemenuhan kembali ketentuan sebagaimana dimaksud dalam Pasal 15 ayat (2) dan/atau ayat (3) dan tidak mengajukan permohonan pengakhiran sanksi dalam jangka waktu sebagaimana dimaksud pada ayat (4) huruf b."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_472d5ae383 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-472d5ae383"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "(2) Verifikasi Printer MTD dapat diajukan atas printer dengan spesifikasi: a. memiliki nomor seri; b. memiliki print area maksimal lebar 24 mm (dua puluh empat milimeter) dengan toleransi maksimal 5% (lima persen); dan c. menghasilkan cetakan dengan resolusi minimal 1.200 dpi (seribu dua ratus dots per inch)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_4ce7c4dea4 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_13 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-4ce7c4dea4"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(5) Dalam hal hasil pengujian dinyatakan tidak lulus sebagaimana dimaksud pada ayat (3) huruf b, Direktur Jenderal Pajak menerbitkan surat penolakan permohonan verifikasi Printer MTD dan/atau Cartridge MTD paling lama 3 (tiga) bulan sejak tanggal surat permohonan verifikasi Printer MTD dan/atau Cartridge MTD diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_4cf836c2db a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-4cf836c2db"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyelesaian permohonan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 4 ayat (1) meliputi tahapan: a. penelitian kelengkapan dokumen permohonan; b. penelitian lapangan keberadaan lokasi kantor, pusat data, dan jaringan layanan purna jual; c. penelitian kesesuaian dokumen rencana pengembangan Aplikasi MTD; d. pengembangan Aplikasi MTD; dan e. pengujian Aplikasi MTD yang telah dikembangkan. (2) Dalam hal tidak memenuhi ketentuan penelitian dan/atau pengujian dalam setiap tahapan sebagaimana dimaksud pada ayat (1), permohonan penunjukan sebagai Penyedia Printer MTD tidak dilanjutkan ke tahap berikutnya dan pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) diberikan surat penolakan permohonan penunjukan sebagai Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_56a83263dd a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-56a83263dd"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "1. Bea Meterai adalah pajak atas dokumen."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_56c091a785 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_7 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-56c091a785"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) harus menyampaikan surat pernyataan kesanggupan menjalankan rencana pengembangan Aplikasi MTD dalam jangka waktu paling lama 3 (tiga) hari kerja terhitung sejak tanggal surat persetujuan rencana pengembangan Aplikasi MTD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_5cdf37f09b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_10 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-5cdf37f09b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal hasil pengujian aplikasi MTD sebagaimana dimaksud dalam Pasal 9 ayat (2) dinyatakan lulus, pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) ditunjuk oleh Direktur Jenderal Pajak sebagai Penyedia Printer MTD melalui Keputusan Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_5f5ff21fb4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_6__7 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-5f5ff21fb4"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/6..7"^^xsd:string ;
    kbr:hasSourceQuote "a. Direktur Jenderal Pajak menerbitkan surat pemberitahuan penjatuhan sanksi penghentian sementara;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_60bb404b67 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-60bb404b67"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "5. Pencetak (Printer) Meterai Teraan Digital yang selanjutnya disebut Printer MTD adalah perangkat khusus untuk membubuhkan Meterai Teraan Digital yang terkoneksi dengan Sistem Meterai Teraan Digital dan spesifikasinya ditentukan oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_6522acb673 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_13 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-6522acb673"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal permohonan verifikasi Printer MTD dan/atau Cartridge MTD telah memenuhi persyaratan sebagaimana dimaksud dalam Pasal 11 ayat (5), Direktur Jenderal Pajak melakukan pengujian Printer MTD dan/atau Cartridge MTD meliputi pengujian fungsionalitas, keamanan, dan integrasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_68b509235e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_15_2__3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-68b509235e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/15/2..3"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penyedia Printer MTD wajib: a. memenuhi ketentuan dalam Pasal 4 ayat (2); b. membangun, memelihara, dan mengoperasionalkan Aplikasi MTD; c. menyediakan Aplikasi MTD untuk pengguna; d. melakukan pemeliharaan atau penyesuaian Printer MTD secara berkala untuk paling sedikit 1 (satu) kali dalam 1 (satu) tahun; e. menandatangani dan memenuhi service level agreement yang ditetapkan oleh Direktorat Jenderal Pajak; f. memiliki dokumen persetujuan perekaman (recordation) merek atau hak cipta yang masih berlaku yang diterbitkan oleh kementerian yang menyelenggarakan urusan pemerintahan di bidang kepabeanan dan cukai untuk setiap merek dan/atau seri Printer MTD; g. menyerahkan seluruh kode sumber (source code) dan dokumentasi teknis serta fungsional secara lengkap kepada Direktorat Jenderal Pajak; h. melakukan pengalihan pengguna kepada Penyedia Printer MTD lain dalam hal dilakukan pencabutan penunjukan sebagai Penyedia Printer MTD; i. menerima pengalihan pengguna dari Penyedia Printer MTD lain yang dilakukan pencabutan penunjukan sebagai Penyedia Printer MTD; j. menyediakan data dan/atau informasi terkait: 1. kepemilikan Printer MTD; dan - 12 - 2. pendaftaran, pendistribusian, dan penggunaan Meterai Teraan Digital, secara terintegrasi dengan sistem Direktorat Jenderal Pajak; k. menyediakan contact center; l. melaporkan penggunaan dan permasalahan penggunaan Printer MTD; m. menerapkan prinsip kehati-hatian; n. menjamin kerahasiaan data sesuai dengan peraturan perundang-undangan di bidang perpajakan dan ketentuan peraturan perundang-undangan mengenai pelindungan data pribadi; o. menerapkan prinsip pelindungan konsumen sesuai dengan ketentuan peraturan perundang-undangan; dan p. memberitahukan perubahan susunan pengurus dan/atau kepemilikan saham."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_6a7d90456c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-6a7d90456c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "2. Wajib Pajak adalah orang pribadi atau badan, meliputi pembayar pajak, pemotong pajak, dan pemungut pajak, yang mempunyai hak dan kewajiban perpajakan sesuai dengan ketentuan peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_6b467664a1 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_9_7__8 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-6b467664a1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/9/7..8"^^xsd:string ;
    kbr:hasSourceQuote "(7) Kegiatan sebagaimana dimaksud pada ayat (4) sampai dengan ayat (6) dilakukan secara berurutan dan dapat dilakukan berulang kali dalam jangka waktu paling lama 6 (enam) bulan sejak tanggal surat permintaan perbaikan sebagaimana dimaksud pada ayat (3). (8) Dalam hal hasil pengujian aplikasi MTD masih dinyatakan perlu perbaikan dan jangka waktu sebagaimana dimaksud pada ayat (7) terlampaui, permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) ditolak dan Direktur Jenderal Pajak menyampaikan surat penolakan permohonan penunjukan sebagai Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_724e12fc22 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_18_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-724e12fc22"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/18/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyedia Printer MTD dapat mengajukan permohonan pencabutan penunjukan sebagai Penyedia Printer MTD kepada Direktur Jenderal Pajak dalam hal: a. berniat membubarkan usaha; atau b. mengalami perubahan kondisi yang menyebabkan kriteria sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 4 ayat (2) tidak terpenuhi, dalam jangka waktu paling lama 2 (dua) bulan sebelum tanggal penghentian kegiatan sebagai Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_72f2f9e077 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_8 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-72f2f9e077"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal diperlukan, pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) dapat memperoleh asistensi pengembangan Aplikasi MTD dari Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_853faa3a9a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_9_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-853faa3a9a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/9/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak melakukan pengujian aplikasi MTD yang telah diperbaiki sebagaimana dimaksud pada ayat (4) dan menentukan hasil pengujian aplikasi MTD sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_898f13c714 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_6__7 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-898f13c714"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/6..7"^^xsd:string ;
    kbr:hasSourceQuote "c. Penyedia Printer MTD wajib memenuhi kembali ketentuan sebagaimana dimaksud dalam Pasal 15 ayat (2) dan/atau ayat (3) dan mengajukan permohonan pengakhiran sanksi disertai dengan dokumen pendukung dalam jangka waktu paling lama 20 (dua puluh) hari kerja terhitung sejak tanggal surat pemberitahuan penjatuhan sanksi sebagaimana dimaksud pada huruf a."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_93261599ca a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_18_4__8 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-93261599ca"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/18/4..8"^^xsd:string ;
    kbr:hasSourceQuote "(8) Permohonan pencabutan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (1) disampaikan secara elektronik melalui saluran tertentu yang disediakan oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_988673958d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-988673958d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "8. Aplikasi Meterai Teraan Digital yang selanjutnya disebut Aplikasi MTD adalah aplikasi yang digunakan Wajib Pajak untuk mengelola Meterai Teraan Digital."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_98ab5142c9 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-98ab5142c9"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "(6) Permohonan verifikasi Printer MTD dan/atau Cartridge MTD sebagaimana dimaksud pada ayat (1) disampaikan secara elektronik melalui saluran tertentu yang disediakan oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_9a945e1a59 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_14 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-9a945e1a59"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyedia Printer MTD dapat mengajukan permohonan verifikasi Printer MTD dan/atau Cartridge MTD dengan merek dan/atau seri yang berbeda. (2) Ketentuan verifikasi Printer MTD dan/atau Cartridge MTD sebagaimana dimaksud dalam Pasal 11 sampai dengan Pasal 13 berlaku mutatis mutandis terhadap permohonan sebagaimana dimaksud pada ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_9f39815566 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_10 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-9f39815566"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(2) Direktur Jenderal Pajak menetapkan keputusan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (1) dalam jangka waktu paling lama 18 (delapan belas) bulan sejak tanggal surat permohonan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud dalam Pasal 4 ayat (1) diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_a728324c78 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_15_2__3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-a728324c78"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/15/2..3"^^xsd:string ;
    kbr:hasSourceQuote "(3) Penyedia Printer MTD dilarang melakukan kegiatan yang dapat merugikan Direktorat Jenderal Pajak dan/atau Wajib Pajak dalam kegiatan pendistribusian dan/atau pembubuhan Meterai Teraan Digital."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_a758c3cd75 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-a758c3cd75"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "9. Surat Keterangan Fiskal adalah informasi mengenai kepatuhan Wajib Pajak selama periode tertentu untuk memenuhi persyaratan memperoleh pelayanan atau dalam rangka pelaksanaan kegiatan tertentu yang diberikan oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_a77e5af07a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_13 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-a77e5af07a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(6) Dalam hal jangka waktu sebagaimana dimaksud pada ayat (4) atau ayat (5) terlampaui dan Direktur Jenderal Pajak tidak menerbitkan: a. surat persetujuan verifikasi Printer MTD dan/atau Cartridge MTD; atau b. surat penolakan permohonan verifikasi Printer MTD dan/atau Cartridge MTD, permohonan verifikasi Printer MTD dan/atau Cartridge MTD dianggap diterima."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_a7e0de73de a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-a7e0de73de"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal berdasarkan penelitian kelengkapan dokumen permohonan penunjukan sebagai Penyedia Printer MTD telah memenuhi persyaratan sebagaimana dimaksud dalam Pasal 4 ayat (3), Direktur Jenderal Pajak melakukan penelitian lapangan keberadaan lokasi kantor, pusat data, dan jaringan layanan purna jual pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_ab5aef6b85 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_4_3__4 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-ab5aef6b85"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/4/3..4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Permohonan penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (1) disampaikan secara elektronik melalui saluran tertentu yang disediakan oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_b3b5f62e33 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_10 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-b3b5f62e33"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(5) Setiap Penyedia Printer MTD diberikan nomor identitas yang berfungsi sebagai sarana administrasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_b42aeb913c a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_4_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-b42aeb913c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/4/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pihak yang mengajukan permohonan sebagaimana dimaksud pada ayat (1) harus memenuhi kriteria sebagai berikut: a. berbadan hukum dan berkedudukan di Indonesia; b. memiliki Nomor Pokok Wajib Pajak (NPWP) dan telah dikukuhkan sebagai Pengusaha Kena Pajak (PKP); c. memiliki Surat Keterangan Fiskal yang masih berlaku; d. tidak pernah dipidana karena melakukan tindak pidana di bidang perpajakan berdasarkan putusan pengadilan yang telah mempunyai kekuatan hukum tetap dalam jangka waktu 5 (lima) tahun terakhir; e. pengurus dan pemilik/pemegang saham tidak pernah dan/atau tidak sedang dipidana karena melakukan tindak pidana di bidang perpajakan dan/atau tindak pidana di bidang teknologi informasi; f. tidak pernah dan/atau tidak sedang dipidana karena melakukan tindak pidana di bidang teknologi informasi berdasarkan putusan pengadilan yang telah berkekuatan hukum tetap; g. dimiliki oleh warga negara Indonesia dan/atau badan hukum Indonesia melalui penyertaan secara langsung dengan kepemilikan saham di atas 50% (lima puluh persen); h. memiliki perencanaan bisnis (business plan); i. memiliki perencanaan keberlangsungan bisnis (business continuity plan); - 4 - j. memiliki paling sedikit 1 (satu) Printer MTD dan 1 (satu) Cartridge MTD untuk diajukan verifikasi; k. memiliki surat dukungan dari pemegang merek Printer MTD; l. memiliki layanan purna jual Printer MTD di Indonesia; dan m. memiliki infrastruktur teknologi informasi, termasuk pusat data yang berlokasi di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_b851229e20 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-b851229e20"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam rangka penunjukan sebagai Penyedia Printer MTD sebagaimana dimaksud pada ayat (3), Direktur Jenderal Pajak menetapkan jumlah kebutuhan Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_cd3d43ba2a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_8 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-cd3d43ba2a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) melakukan pengembangan Aplikasi MTD berdasarkan rencana pengembangan Aplikasi MTD yang telah disetujui sebagaimana dimaksud dalam Pasal 7 ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_ce2b7f0dff a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-ce2b7f0dff"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(3) Atas permohonan penunjukan sebagai Penyedia Printer MTD yang diberikan surat penolakan sebagaimana dimaksud pada ayat (2), pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) dapat mengajukan kembali permohonan penunjukan sebagai Penyedia Printer MTD sesuai dengan ketentuan dalam Peraturan Direktur Jenderal ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_d2ffdd7571 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-d2ffdd7571"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pembubuhan Meterai Teraan Digital dilakukan dengan menggunakan Printer MTD dan Cartridge MTD yang telah terverifikasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_d6d95c21a7 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-d6d95c21a7"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "7. Penyedia Pencetak (Printer) Meterai Teraan Digital yang selanjutnya disebut Penyedia Printer MTD adalah pihak yang ditunjuk oleh Direktur Jenderal Pajak untuk menyediakan Printer MTD dan Cartridge MTD."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_d9bda090d1 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_12 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-d9bda090d1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal tidak memenuhi ketentuan penelitian dan/atau pengujian dalam setiap tahapan sebagaimana dimaksud pada ayat (1), permohonan verifikasi Printer MTD dan/atau Cartridge MTD tidak dilanjutkan ke tahap berikutnya dan Penyedia Printer MTD diberikan surat penolakan permohonan verifikasi Printer MTD dan/atau Cartridge MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_dcb53e0547 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-dcb53e0547"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/1..5"^^xsd:string ;
    kbr:hasSourceQuote "b. Penyedia Printer MTD wajib memenuhi kembali ketentuan sebagaimana dimaksud dalam Pasal 15 ayat (2) dan/atau ayat (3) dan mengajukan permohonan pengakhiran sanksi disertai dengan dokumen pendukung dalam jangka waktu paling lama 20 (dua puluh) hari kerja terhitung sejak tanggal surat pemberitahuan penjatuhan sanksi sebagaimana dimaksud pada huruf a."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_de187438b3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-de187438b3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(3) Direktur Jenderal Pajak dapat menunjuk Penyedia Printer MTD sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_de23fdc95c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_13 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-de23fdc95c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(7) Atas permohonan yang dianggap diterima sebagaimana dimaksud pada ayat (6), Direktur Jenderal Pajak memberikan persetujuan verifikasi Printer MTD dan/atau Cartridge MTD dalam jangka waktu paling lama 10 (sepuluh) hari kerja sejak jangka waktu sebagaimana dimaksud pada ayat (4) atau ayat (5) berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_e74ce0ae12 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-e74ce0ae12"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(2) Printer MTD dan Cartridge MTD sebagaimana dimaksud pada ayat (1) disediakan oleh Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_e8d2666503 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_13 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-e8d2666503"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(1) Atas permohonan verifikasi sebagaimana dimaksud dalam Pasal 11 ayat (1), Direktur Jenderal Pajak melakukan penelitian kelengkapan dokumen permohonan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_e9df377bc2 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-e9df377bc2"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal berdasarkan hasil pengawasan sebagaimana dimaksud dalam Pasal 16 diketahui bahwa Penyedia Printer MTD tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 15 ayat (2) dan/atau ayat (3), Penyedia Printer MTD dapat dikenai sanksi administratif berupa: a. teguran; b. penghentian sementara; atau c. pencabutan penunjukan sebagai Penyedia Printer MTD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_ea6b00203e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_8 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-ea6b00203e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "a. menyelesaikan pengembangan Aplikasi MTD; dan - 7 - b. menyampaikan surat pemberitahuan penyelesaian pengembangan Aplikasi MTD kepada Direktur Jenderal Pajak, dalam jangka waktu paling lama 6 (enam) bulan terhitung sejak tanggal surat persetujuan rencana pengembangan Aplikasi MTD sebagaimana dimaksud dalam Pasal 7 ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_eb52e220ac a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-eb52e220ac"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "(3) Pihak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 4 ayat (1) harus menyampaikan dokumen rencana pengembangan Aplikasi MTD yang dibuat berdasarkan dokumen petunjuk pengembangan Aplikasi MTD sebagaimana dimaksud pada ayat (2) kepada Direktur Jenderal Pajak dalam jangka waktu paling lama 15 (lima belas) hari kerja terhitung sejak tanggal surat penyampaian dokumen petunjuk pengembangan Aplikasi MTD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_ec02bb3578 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_18_1__6 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-ec02bb3578"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/18/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penyedia Printer MTD yang akan mengajukan permohonan pencabutan penunjukan sebagai Penyedia Printer MTD harus memastikan keberlanjutan pembubuhan Meterai Teraan Digital dengan mengalihkan pengguna kepada Penyedia Printer MTD lain."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_ec20912c56 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_17_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-ec20912c56"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/17/1..5"^^xsd:string ;
    kbr:hasSourceQuote "a. Direktur Jenderal Pajak menerbitkan surat pemberitahuan penjatuhan sanksi teguran;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_f05652600b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_1 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-f05652600b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "4. Sistem Meterai Teraan Digital adalah serangkaian perangkat dan prosedur elektronik dalam sistem atau aplikasi terintegrasi yang dimiliki oleh Direktorat Jenderal Pajak dan berfungsi membuat, mendistribusikan, dan membubuhkan Meterai Teraan Digital."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_f0e8e56ccc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-f0e8e56ccc"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "(3) Verifikasi Cartridge MTD dapat diajukan atas cartridge yang digunakan khusus untuk Printer MTD dengan spesifikasi: a. memiliki nomor seri; dan b. tinta berwarna merah dengan efek cetakan berpendar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_f8c7251e5f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_3 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-f8c7251e5f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(5) Direktur Jenderal Pajak menginformasikan jumlah kebutuhan Penyedia Printer MTD sebagaimana dimaksud pada ayat (4) dengan melakukan publikasi melalui laman Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_fb94dddf6e a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_13 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-fb94dddf6e"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal hasil pengujian dinyatakan lulus sebagaimana dimaksud pada ayat (3) huruf a, Direktur Jenderal Pajak menerbitkan surat persetujuan verifikasi Printer MTD dan/atau Cartridge MTD paling lama 3 (tiga) bulan sejak tanggal surat permohonan verifikasi Printer MTD dan/atau Cartridge MTD diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2026_11_feb9d302ff a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2026_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2026_11_BT_12 ;
    kbr:hasRuleId "R-PER-DJP-2026-11-feb9d302ff"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2026-11#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "(3) Atas permohonan verifikasi Printer MTD dan/atau Cartridge MTD yang diberikan surat penolakan sebagaimana dimaksud pada ayat (2), Penyedia Printer MTD dapat mengajukan kembali permohonan verifikasi Printer MTD dan/atau Cartridge MTD sesuai dengan ketentuan dalam Peraturan Direktur Jenderal ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2009_105_39bc2e4fa6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2009_105 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2009_105_BT_3 ;
    kbr:hasRuleId "R-PMK-2009-105-39bc2e4fa6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2009-105#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "b. Wajib Pajak harus menyerahkan daftar piutang yang nyata-nyata tidak dapat ditagih kepada Direktorat Jenderal Pajak"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2009_105_49d466a6fd a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2009_105 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2009_105_BT_4 ;
    kbr:hasRuleId "R-PMK-2009-105-49d466a6fd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2009-105#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "(1) Daftar piutang yang nyata-nyata tidak dapat ditagih yang diserahkan kepada Direktorat J ender al Pajak sebagaimana dimaksud Pasal 3 ayat (1) huruf b harus mencantumkan identitas debitur berupa nama, Nomor Pokok Wajib Pajak, alamat dan jumlah Piutang yang nyata-nyata tidak dapat ditagih."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2009_105_88c60cdf1d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2009_105 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2009_105_BT_1 ;
    kbr:hasRuleId "R-PMK-2009-105-88c60cdf1d"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2009-105#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Peraturan Menteri Keuangan ini yang dimaksud dengan: 1. Wajib Pajak adalah orang pribadi atau badan, meliputi pembayar pajak, pemotong pajak, dan pemungut pajak, yang mempunyai hak dan kewajiban perpajakan sesuai dengan ketentuan peraturan perundang- undangan perpajakan. 2. Piutang yang nyata-nyata tidak dapat ditagih adalah piutang yang timbul dari transaksi bisnis yang wajar sesuai dengan bidang usahanya, yang nyata-nyata tidak dapat ditagih meskipun telah dilakukan upaya- upaya penagihan yang maksimal atau terakhir oleh Wajib Pajak. 3. Penerbitan umum atau khusus adalah penerbitan yang meliputi: a. Penerbitan umum adalah pemuatan pengumuman pada penerbitan surat kabar / majalah a tau media massa cetak yang lazim lainnya yang berskala nasional; atau b. Penerbitan khusus adalah pemuatan pengumuman pada: 1) penerbitan Himpunan Bank-Bank Milik Negara (HIMBARA)/ Perhimpunan Bank-Bank Umum Nasional (PERBANAS); 2) penerbitan/ pengumuman khusus Bank Indonesia; dan/ a tau 3) penerbitan yang dikeluarkan oleh asosiasi yang telah terdaftar sebagai Wajib Pajak dan pihak kreditur menjadi anggotanya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2009_105_8a179ed32f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2009_105 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2009_105_BT_4 ;
    kbr:hasRuleId "R-PMK-2009-105-8a179ed32f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2009-105#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pemenuhan ketentuan sebagaimana dimaksud Pasal 3 ayat (1) huruf c dilakukan dengan cara melampirkan: a. fotokopi bukti penyerahan perkara penagihannya ke Pengadilan Negeri atau instansi pemerintah yang menangani piutang negara; atau b. fotokopi perjanjian tertulis mengenai penghapusan piutang/pembebasan utang usaha yang telah dilegalisir oleh notaris: atau c. fotokopi bukti publikasi dalam penerbitan umum atau penerbitan khusus; a tau d. surat yang berisi pengakuan dari debitur bahwa utangnya telah dihapuskan yang disetujui oleh kreditur tentang penghapusan piutang untuk jumlah utang tertentu, yang disetujui oleh kreditur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2009_105_9070663849 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2009_105 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2009_105_BT_3 ;
    kbr:hasRuleId "R-PMK-2009-105-9070663849"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2009-105#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "c. Piutang yang nyata-nyata tidak dapat ditagih tersebut telah diserahkan perkara penagihannya kepada Pengadilan Negeri atau instansi pemerintah yang menangani piutang negara, atau terdapat perjanjian tertulis mengenai penghapusan piutang/ pembebasan utang antara kreditur dan debitur atas piutang yang nyata-nyata tidak dapat ditagih tersebut, atau telah dipublikasikan dalam Menetapkan"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2009_105_dcf83239b4 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2009_105 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2009_105_BT_2 ;
    kbr:hasRuleId "R-PMK-2009-105-dcf83239b4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2009-105#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Piutang yang nyata-nyata tidak dapat ditagih sebagaimana dimaksud pada ayat (1) tidak termasuk piutang yang berasal dari transaksi bisnis dengan pihak-pihak yang memiliki hubungan istimewa dengan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2009_105_e3ce4a04e3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2009_105 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2009_105_BT_2 ;
    kbr:hasRuleId "R-PMK-2009-105-e3ce4a04e3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2009-105#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Piutang yang nyata-nyata tidak dapat ditagih yang timbul di bidang usaha bank, lembaga pembiayaan, industri, dagang dan jasa lainnya dapat dibebankan sebagai biaya dalam menghitung penghasilan kena pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

