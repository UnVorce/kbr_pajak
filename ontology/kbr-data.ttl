kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_f1b0086cab a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_135_1__9 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-f1b0086cab"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/135/1..9"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak membayar atau menyetor tepat pada waktunya sebagaimana dimaksud pada ayat (5) dan ayat (6), Wajib Pajak dikenai sanksi administratif berupa bunga sebesar 1% (satu persen) per bulan dari Pajak terutang yang tidak atau kurang dibayar atau disetor, dihitung dari tanggal jatuh tempo pembayaran sampai dengan tanggal pembayaran, untuk jangka waktu paling lama 24 (dua puluh empat) bulan serta bagian dari bulan dihitung penuh 1 (satu) bulan dan ditagih dengan menggunakan STPD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

