kbr:Aturan_R_PMK_2024_81_7fd2084667 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_29_1_b_p2 ;
    kbr:hasRuleId "R-PMK-2024-81-7fd2084667"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/29/1/b#p2"^^xsd:string ;
    kbr:hasSourceQuote "Di tahun 2030, PT Y tidak dapat menggunakan seluruh tambahan pengurangan penghasilan bruto karena harus memenuhi ketentuan batasan pemanfaatan tambahan pengurangan paling tinggi sebesar 40% dari Penghasilan Kena Pajak sebelum mendapat fasilitas. PT Y hanya berhak memanfaatkan tambahan pengurangan penghasilan bruto paling tinggi sebesar Rp120.000.000,00 (40% x Rp300.000.000,00)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_7fe54dafa1 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_69 ;
    kbr:hasRuleId "R-PMK-2024-81-7fe54dafa1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/69"^^xsd:string ;
    kbr:hasSourceQuote "b. Pengusaha Kena Pajak telah dinonaktifkan akses pembuatan Faktur Pajak dan tidak melakukan klarifikasi dalam jangka waktu 30 (tiga puluh) hari sejak penonaktifan atau klarifikasinya ditolak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_801885f1c6 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_29_1_a__c ;
    kbr:hasRuleId "R-PMK-2024-81-801885f1c6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/29/1/a..c"^^xsd:string ;
    kbr:hasSourceQuote "c. Tahun Pajak 2022: 1 Januari s.d. 31 Desember 2022 dikenai PPh atas penghasilan yang diterima atau diperolehnya baik yang berasal dari Indonesia maupun dari luar Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

