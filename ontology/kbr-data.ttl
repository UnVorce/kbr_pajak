    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_44 ;
    kbr:hasRuleId "R-PP-2009-32-ee7be93e92"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/44"^^xsd:string ;
    kbr:hasSourceQuote "Izin yang dibekukan sebagaimana dimaksud pada ayat (1) dapat diberlakukan kembali dalam hal pengusaha di Tempat Penimbunan Berikat: a. tidak terbukti melakukan kegiatan yang menyimpang dari izin yang diberikan"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

