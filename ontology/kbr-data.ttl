    kbr:hasSourceLocator "PMK-2025-105#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "(3) Jangka waktu pemberian insentif Pajak Penghasilan Pasal 21 ditanggung pemerintah sebagaimana dimaksud pada ayat (2) diberikan untuk Masa Pajak Januari 2026 sampai dengan Masa Pajak Desember 2026."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
