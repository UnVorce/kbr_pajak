    kbr:hasSourceQuote "Pembayaran Pajak Penghasilan dalam bentuk volume minyak bumi dan/ atau gas bumi sebagaimana dimaksud pada ayat (1) wajib dilakukan paling lambat pada tanggal 15 (lima belas) bulan berikutnya setelah Masa Pajak berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_374b99d830 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_296 ;
    kbr:hasRuleId "R-PMK-2024-81-374b99d830"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/296"^^xsd:string ;
    kbr:hasSourceQuote "Pemungut Pajak Pertambahan Nilai sebagaimana dimaksud dalam Pasal 291 ayat (1) wajib melaporkan Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah yang telah dipungut dan disetor paling lambat akhir bulan berikutnya setelah Masa Pajak dilakukannya pemungutan sebagaimana dimaksud pada ayat (1) dengan menggunakan Surat Pemberitahuan Masa Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_37cfe73ae2 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_19 ;
    kbr:hasRuleId "R-PMK-2024-81-37cfe73ae2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Pendaftaran Wajib Pajak orang pribadi sebagaimana dimaksud dalam Pasal 16 dilakukan dengan mengajukan permohonan yang dilaksanakan sesuai dengan ketentuan pelaksanaan hak dan pemenuhan kewajiban perpajakan sebagaimana dimaksud.dalam Pasal 4."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

