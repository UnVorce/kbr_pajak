kbr:Aturan_R_PP_2010_79_c0df11a842 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_79_BT_11 ;
    kbr:hasRuleId "R-PP-2010-79-c0df11a842"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Biaya Eksploitasi sebagaimana dimaksud pada ayat (1) hurufb terdiri atas: a. biayalangsungproduksiuntuk: 1. Minyak Bumi; dan 2. Gas Bumi. b. biaya yang terkait dengan aktifrtas pernrosesan Gas Bumi sampai dengan titik penyerahan; c. biaya utititg terdiri atas: 1. biaya perangkat produksi dan pemeliharaan peralatan; dan 2. biaya uap, air, dan listrik; d. biaya umum dan administrasi pada kegiatan Eksploitasi; dan e. biaya penyusutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_c5995e5d69 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_79_BT_1_p1 ;
    kbr:hasRuleId "R-PP-2010-79-c5995e5d69"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Minyak Bumi, Gas Bumi, Minyak dan Gas Bumi, Eksplorasi, Eksploitasi, Kontrak Kerja Sama, Wilayah Kerja, Wilayah Hukum Pertambangan Indonesia, dan Kegiatan Usaha Hulu adalah sebagaimana dimaksud dalam Undang-Undang Nomor 22 Ta}:lan 2001 tentang Minyak dan Gas Bumi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_c71bdd2ae3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_79 ;
