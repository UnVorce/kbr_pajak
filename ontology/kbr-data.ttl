    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/116"^^xsd:string ;
    kbr:hasSourceQuote "(3) Penerbitan PBG sebagaimana dimaksud pada ayat (2) diberikan untuk permohonan persetujuan: a. pembangunan baru; b. bangunan gedung yang sudah terbangun dan belum memiliki PBG dan/atau SLF; c. PBG perubahan untuk: 1. perubahan fungsi Bangunan Gedung; 2. perubahan lapis Bangunan Gedung; 3. perubahan luas Bangunan Gedung; 4. perubahan tampak Bangunan Gedung; 5. perubahan spesifikasi dan dimensi komponen pada Bangunan Gedung yang mempengaruhi aspek keselamatan dan/atau kesehatan; 6. perkuatan Bangunan Gedung terhadap tingkat kerusakan sedang dan berat; 7. perlindungan dan/atau pengembangan Bangunan Gedung cagar budaya; dan 8. perbaikan Bangunan Gedung yang terletak di kawasan cagar budaya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

