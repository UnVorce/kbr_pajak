    kbr:hasSourceQuote "Wajib Pajak PBJT yaitu orang pribadi atau Badan yang melakukan penjualan, penyerahan, dan/atau konsumsi barang dan jasa tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

