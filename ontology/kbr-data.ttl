    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_30 ;
    kbr:hasRuleId "R-PP-2009-32-ceca2c55ef"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap pemasukan barang dari Gudang Berikat ke Toko Bebas Bea, pengusaha Gudang Berikat atau pengusaha di Gudang Berikat wajib membuat faktur pajak yang dibubuhi cap Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah tidak dipungut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

