    kbr:hasSourceQuote "(2) Saat terutang PAT ditetapkan pada saat terjadinya pengambilan dan/atau pemanfaatan Air Tanah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_087e5c6ca3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_99 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-087e5c6ca3"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/99"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak untuk jenis Pajak yang dipungut berdasarkan penghitungan sendiri oleh Wajib Pajak sebagaimana dimaksud dalam Pasal 3 ayat (2) wajib mengisi SPTPD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_095a24be9c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_87 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-095a24be9c"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/87"^^xsd:string ;
    kbr:hasSourceQuote "Pemanfaatan dari penerimaan masing-masing jenis Retribusi diutamakan untuk mendanai kegiatan yang berkaitan langsung dengan penyelenggaraan pelayanan yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0a9de5a501 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_99 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0a9de5a501"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/99"^^xsd:string ;
    kbr:hasSourceQuote "Sanksi administratif berupa denda sebagaimana dimaksud pada ayat (3) tidak dikenakan jika Wajib Pajak mengalami keadaan kahar (force majeure)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0abd6ad618 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0abd6ad618"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Jasa Parkir adalah jasa penyediaan atau penyelenggaraan tempat parkir di luar badan jalan dan/atau pelayanan memarkirkan kendaraan untuk ditempatkan di area parkir, baik yang disediakan berkaitan dengan pokok usaha maupun yang disediakan sebagai suatu usaha, termasuk penyediaan tempat penitipan Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0c6e54e4ad a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_69 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0c6e54e4ad"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/69"^^xsd:string ;
    kbr:hasSourceQuote "(3) Tarif Retribusi ditinjau kembali paling lama 3 (tiga) tahun sekali."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0cc4118af4 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_87 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0cc4118af4"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/87"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai pemanfaatan penerimaan Retribusi sebagaimana dimaksud pada ayat (1) dan ayat (2) diatur dengan Peraturan Wali Kota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0cc5886a6e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_59 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0cc5886a6e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/59"^^xsd:string ;
    kbr:hasSourceQuote "(1) Saat terutang Pajak ditetapkan pada saat orang pribadi atau Badan telah memenuhi syarat subjektif dan objektif atas suatu jenis Pajak dalam 1 (satu) kurun waktu tertentu dalam masa Pajak, dalam Tahun Pajak, atau bagian Tahun Pajak sesuai dengan ketentuan peraturan perundang- undangan mengenai perpajakan Daerah. (2) Masa Pajak sebagaimana dimaksud pada ayat (1) merupakan jangka waktu yang menjadi dasar bagi Wajib Pajak untuk menghitung, menyetor, dan melaporkan Pajak yang terutang untuk jenis Pajak yang dipungut berdasarkan penghitungan sendiri Wajib Pajak atau menjadi dasar bagi Kepala Daerah untuk menetapkan Pajak terutang untuk jenis Pajak yang dipungut berdasarkan penetapan Kepala Daerah. (3) Masa Pajak yang menjadi dasar bagi Wajib Pajak untuk menghitung, menyetor, dan melaporkan Pajak yang terutang untuk jenis Pajak yang dipungut berdasarkan penghitungan sendiri Wajib Pajak sebagaimana dimaksud pada ayat (2), ditetapkan untuk jangka waktu 1 (satu) bulan kalender. (4) Tahun Pajak sebagaimana dimaksud pada ayat (1) merupakan jangka waktu yang lamanya 1 (satu) tahun kalender. (5) Ketentuan lebih lanjut mengenai masa Pajak, Tahun Pajak, dan bagian Tahun Pajak sebagaimana dimaksud pada ayat (1) diatur dalam Peraturan Wali Kota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0f01cf1934 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_99 ;
