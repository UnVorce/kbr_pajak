    kbr:hasRuleId "R-PP-2010-79-d94e6af537"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "(1) Atas penghasilan lain Kontraktor berupa ltptifi atau imbalan lain yang sejenis sebagaimana dimaksud dalam Pasal 9 ayat (a) huruf a dikenakan pqjak Penghasilan yang bersifat linal dengan tarif 20% (dua puluh persen) dari jumlah bruto."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_d9bbea6647 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_79_BT_20 ;
    kbr:hasRuleId "R-PP-2010-79-d9bbea6647"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal suatu lapangan atau wilayah kerja telah menghasilkan satu jenis hasil produksi minyak bumi atau gas bumi, sementara jenis produksi yang lainnya belum menghasilkan, biaya bersama sebagaimana dimaksud pada ayat (5) dialokasikan secara adil berdasarkan kesepakatan antara Badan Pelaksana dan kontraktor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_de49e02bd7 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_79_BT_20 ;
    kbr:hasRuleId "R-PP-2010-79-de49e02bd7"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pengembalian biaya operasi minyak bumi atau gas bumi tidak mencukupi dari hasil produksinya atau nilai penjualannya, ditentukan: a. biaya operasi gas bumi yang melebihi nilai produksinya, selisihnya dibebankan pada hasil produksi minyak bumi; b. biaya operasi minyak bumi yang melebihi nilai produksinya, selisihnya dibebankan pada nilai penjualan gas bumi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_e116865830 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_79_BT_24_1__8 ;
    kbr:hasRuleId "R-PP-2010-79-e116865830"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/24/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Kontraktor wajib memenuhi kewajiban DMO dengan menyerahkan 25% (dua puluh lima persen) bagiannya dari produksi Minyak Bumi dan/atau Gas Bumi yang dihasilkannya untuk memenuhi kebutuhan dalam negeri."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_e2687159af a kbr:Definisi ;
