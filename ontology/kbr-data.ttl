    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_146 ;
    kbr:hasRuleId "R-PMK-2024-81-2f66873a8e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/146"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal terdapat imbalan bunga sebagaimana dimaksud dalam Pasal 138 dan Pasal 139, Wajib Pajak mengajukan permohonan pemberian imbalan bunga kepada Kepala Kantor Pelayanan Pajak tempat Wajib Pajak terdaftar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_2f82e8af72 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_51_1__1 ;
    kbr:hasRuleId "R-PMK-2024-81-2f82e8af72"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/51/1..1"^^xsd:string ;
    kbr:hasSourceQuote "b. dokumen yang menunjukkan bahwa Wajib Pajak Instansi Pemerintah merupakan satuan kerja perangkat daerah provinsi dan kabupaten/kota yang bertindak selaku pengguna Anggaran Pendapatan dan Belanja Daerah yang memiliki tugas dan wewenang untuk menyusun dokumen pelaksanaan anggaran serta wajib menyelenggarakan akuntansi dan menyusun laporan keuangan dengan standar akuntansi pemerintahan sesuai dengan ketentuan peraturan perundang-undangan di bidang keuangan negara, untuk Instansi Pemerintah Daerah;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_2fb187e24a a kbr:Kewajiban ;
