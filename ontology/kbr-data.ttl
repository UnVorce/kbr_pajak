    kbr:hasSourceLocator "PMK-2023-66#BT/3/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Penggantian atau imbalan sehubungan dengan pekerjaan atau jasa dalam bentuk natura sebagaimana dimaksud pada ayat (1) merupakan penggantian atau imbalan dalam bentuk barang selain uang yang dialihkan kepemilikannya dart pemberi kepada penerima."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

