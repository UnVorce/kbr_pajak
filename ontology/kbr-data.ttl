    kbr:hasSourceQuote "(5) Dalam hal Wajib Pajak memberikan tanggapan sebagaimana dimaksud pada ayat (1) dan/atau ayat (4), Direktur Jenderal Pajak melakukan penelitian atas tanggapan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_111_501bdfc6c8 a kbr:Prosedur ;
