    kbr:hasSourceQuote "(7) Dokumen tertentu sebagaimana dimaksud dalam Pasal 62 huruf r, Pasal 63 ayat (1) huruf e, dan Pasal 63 ayat (1) huruf f paling sedikit memuat: a. nama, alamat, dan Nomor Pokok Wajib Pajak atau Nomor Induk Kependudukan pelaku usaha di kawasan ekonomi khusus; dan b. jumlah Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah yang dipungut atau dilunasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_338949976b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_38 ;
    kbr:hasRuleId "R-PER-DJP-2025-11-338949976b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-11#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "(4) Tanda tangan sebagaimana dimaksud dalam Pasal 33 huruf g dalam Faktur Pajak berupa Tanda Tangan Elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_3428762eb3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_98_1__3 ;
