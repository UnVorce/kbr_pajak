    kbr:hasSourceQuote "Wajib PKB yaitu orang pribadi atau Badan yang memiliki Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_9eed05a19a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_73 ;
