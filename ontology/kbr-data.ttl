    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_37 ;
    kbr:hasRuleId "R-UU-1997-19-330deb7722"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya ganti rugi sebagaimana dimaksud dalam ayat (1a) paling banyak Rp 5.000.000,00 (lima juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_33e28e1fa3 a kbr:Prosedur ;
