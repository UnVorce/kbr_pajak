    kbr:hasSourceQuote "2. Konsultan Pajak dan/atau Wajib Pajak yang diberikan jasa konsultasi dinyatakan tidak bersalah berdasarkan putusan pengadilan yang telah mempunyai kekuatan hukum tetap."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2014_111_6c5e45cc54 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2014_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2014_111_BT_24_2__4 ;
