kbr:Aturan_R_PMK_2024_81_9f3ccee64d a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_209 ;
    kbr:hasRuleId "R-PMK-2024-81-9f3ccee64d"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/209"^^xsd:string ;
    kbr:hasSourceQuote "Dalam rangka membagi risiko dalam masa Eksplorasi, pengalihan Partisipasi Interes dikecualikan dari pengenaan Pajak Penghasilan sebagaimana dimaksud dalam Pasal 208 ayat (2) huruf a, dalam hal memenuhi kriteria: a. tidak mengalihkan seluruh Partisipasi Interes yang dimilikinya; b. Partisipasi Interes telah dimiliki lebih dari 3 (tiga) tahun; c. di Wilayah Kerja telah dilakukan Eksplorasi dan Kontraktor Kontrak Kerja Sama Minyak dan Gas Bumi telah mengeluarkan investasi untuk melaksanakan Eksplorasi dimaksud; dan d. pengalihan Partisipasi Interes oleh Kontraktor Kontrak Kerja Sama Minyak dan Gas Bumi tidak dimaksudkan untuk memperoleh keuntungan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

