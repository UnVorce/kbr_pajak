    kbr:hasRuleId "R-PP-2022-50-06dfb84858"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "(1) Direktur Jenderal Pajak dapat menerbitkan Surat Ketetapan Pajak Kurang Bayar Tambahan berdasarkan hasil Pemeriksaan ulang terhadap: a. data baru yang mengakibatkan penambahan jumlah pajak yang tertrtang, termasuk data yang semula belum terungkap; atau b. keterangan tertulis dari Wajib Pajak atas kehendak sendiri sebagaimana diatur dalam Pasal 15 ayat (3) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_0809eab087 a kbr:Kewajiban ;
