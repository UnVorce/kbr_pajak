kbr:Aturan_R_PP_2017_34_60a37d28a3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2017_34 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2017_34_BT_2 ;
    kbr:hasRuleId "R-PP-2017-34-60a37d28a3"^^xsd:string ;
    kbr:hasSourceLocator "PP-2017-34#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Penghasilan sebagaimana dimaksud pada ayat (1) termasuk penghasilan yang diterima atau diperoleh orang pribadi atau badan pemegang hak atas tanah dari Investor terkait dengan pelaksanaan perjanjian Bangun Guna Serah, meliputi: a. penghasiian atas pembayaran berkala selama masa perjanjian Bangun Guna Serah; b. penghasilan dalam bentuk Bangunan yang diserahkan sebelum perjanjian Bangun Guna Serah berakhir; c. penghasilan dalam bentuk Bangunan yang diserahkan atau seharusnya diserahkan pada saat perjanjian Bangun Guna Serah berakhir; dan/atau d. penghasilan lain terkait perjanjian Bangun Guna Serah, termasuk pembayaran terkait bagi hasil penggunaan Bangunan dan denda perjanjian Bangun Guna Serah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

