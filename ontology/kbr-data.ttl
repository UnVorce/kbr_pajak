    kbr:hasSourceLocator "PP-2022-55#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "Penentuan kembali besarnya penghasilan yang diperoleh Wajib Pajak orang pribadi dalam negeri sehubungan dengan pekerjaan, kegiatan, atau jasa dari pemberi kerja yang memiliki hubungan istimewa dengan perusahaan di luar negeri sebagaimana dimaksud dalam Pasal 32 ayat l21 huruf e dilakukan dengan memperhatikan tingkat penghasilan yang wajar yang seharusnya diperoleh oleh Wqiib Pajak orang pribadi yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2022_55_8ba22c0438 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PP_2022_55 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_61 ;
    kbr:hasRuleId "R-PP-2022-55-8ba22c0438"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/61"^^xsd:string ;
    kbr:hasSourceQuote "(U Wajib Pajak sebagaimana dimaksud dalam Pasal 57 ayat (1) yang peredaran bmtonya pada Tahun Pajak berjalan telah melebihi Rpa.800.000.000,OO (empat miliar delapan ratus juta rupiah), atas penghasilan dari usaha tetap dikenai tarif Pajak Penghasilan sebagaimana dimaksud dalam Pasal 56 ayat (2) sampai dengan akhir Tahun Pajak bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2022_55_8f19a1c03e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_55 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_30 ;
    kbr:hasRuleId "R-PP-2022-55-8f19a1c03e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Pemberi kerja atau pemberi penggantian atau imbalan dalam bentuk natura dan/atau kenikmatan wajib melakukan pemotongan Pajak Penghasilan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

