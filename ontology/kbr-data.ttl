    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_143 ;
    kbr:hasRuleId "R-PMK-2024-81-68e492bda6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/143"^^xsd:string ;
    kbr:hasSourceQuote "Imbalan bunga atas kelebihan pembayaran pajak karena pengajuan keberatan, permohonan banding, atau permohonan peninjauan kembali yang terkait dengan Surat Pemberitahuan yang menyatakan lebih bayar sebagaimana dimaksud dalam Pasal 138 ayat (1) huruf d diberikan dengan tarif bunga per bulan yang ditetapkan oleh Menteri, dari jumlah kelebihan pembayaran pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

