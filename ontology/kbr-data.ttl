    kbr:hasRuleId "R-UU-1997-19-d62eb39f34"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam hal Surat Paksa sudah diterbitkan tetapi belum diberitahukan kepada Penanggung Pajak yang bersangkutan, Surat Paksa dimaksud dinyatakan batal demi hukum;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_d684cf156b a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_28 ;
    kbr:hasRuleId "R-UU-1997-19-d684cf156b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penjualan secara lelang, biaya penagihan pajak sebagaimana dimaksud dalam ayat (1) ditambah 1% (satu persen) dari pokok lelang."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_d6f1cb79ff a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_12 ;
    kbr:hasRuleId "R-UU-1997-19-d6f1cb79ff"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Penyitaan dilaksanakan oleh Jurusita Pajak dengan disaksikan oleh sekurang-kurangnya 2 (dua) orang yang telah dewasa, penduduk Indonesia, dikenal oleh Jurusita Pajak, dan dapat dipercaya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_d763dd927e a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_11 ;
    kbr:hasRuleId "R-UU-1997-19-d763dd927e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Pelaksanaan Surat Paksa tidak dapat dilanjutkan dengan penyitaan sebelum lewat waktu 2 (dua) kali 24 (dua puluh empat) jam setelah Surat Paksa diberitahukan sebagaimana dimaksud dalam Pasal 10."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_d769e8bc9b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_14 ;
    kbr:hasRuleId "R-UU-1997-19-d769e8bc9b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "Hak lainnya yang dapat disita selain sebagaimana dimaksud dalam ayat (1) diatur dengan Peraturan Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_d79b117c40 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_40 ;
    kbr:hasRuleId "R-UU-1997-19-d79b117c40"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "Apabila setelah pelaksanaan lelang Wajib Pajak memperoleh keputusan keberatan atau putusan banding yang mengakibatkan utang pajak menjadi berkurang atau nihil sehingga menimbulkan kelebihan pembayaran pajak, Wajib Pajak tidak dapat meminta atau tidak berhak menuntut pengembalian barang yang telah dilelang."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_d8fc8896e1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_10_1__6 ;
    kbr:hasRuleId "R-UU-1997-19-d8fc8896e1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/10/1..6"^^xsd:string ;
    kbr:hasSourceQuote "d. para ahli waris, apabila Wajib Pajak telah meninggal dunia dan harta warisan telah dibagi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_d9e5657875 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_19 ;
    kbr:hasRuleId "R-UU-1997-19-d9e5657875"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap barang yang telah disita sebagaimana dimaksud dalam ayat (1), Jurusita Pajak menyampaikan Surat Paksa kepada Pengadilan Negeri atau instansi lain yang berwenang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_e1828b5204 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_16 ;
    kbr:hasRuleId "R-UU-1997-19-e1828b5204"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Barang yang telah disita dititipkan kepada Penanggung Pajak, kecuali apabila menurut Jurusita Pajak barang dimaksud perlu disimpan di kantor Pejabat atau di tempat lain."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_e19098aac1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_28 ;
    kbr:hasRuleId "R-UU-1997-19-e19098aac1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal hasil lelang sudah mencapai jumlah yang cukup untuk melunasi biaya penagihan pajak dan utang pajak, pelaksanaan lelang dihentikan oleh pejabat walaupun barang yang akan dilelang masih ada."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_e5765927d1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_39 ;
    kbr:hasRuleId "R-UU-1997-19-e5765927d1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pejabat karena jabatan dapat membetulkan Surat Teguran atau Surat Peringatan atau surat lain yang sejenis, Surat Perintah Penagihan Seketika dan Sekaligus, Surat Paksa, Surat Perintah Melaksanakan Penyitaan, Surat Perintah Penyanderaan, Pengumuman Lelang dan Surat Penentuan Harga Limit yang dalam penerbitannya terdapat kesalahan atau kekeliruan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_e6ef0e4ee1 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_39 ;
    kbr:hasRuleId "R-UU-1997-19-e6ef0e4ee1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penanggung Pajak dapat mengajukan permohonan pembetulan atau penggantian kepada Pejabat terhadap Surat Teguran atau Surat Peringatan atau surat lain yang sejenis, Surat Perintah Penagihan Seketika dan Sekaligus, Surat Paksa, Surat Perintah Melaksanakan Penyitaan, Surat Perintah Penyanderaan, Pengumuman Lelang dan Surat Penentuan Harga Limit yang dalam penerbitannya terdapat kesalahan atau kekeliruan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_e7a498862d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_33 ;
    kbr:hasRuleId "R-UU-1997-19-e7a498862d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Penyanderaan hanya dapat dilakukan Penanggung Pajak yang mempunyai utang pajak sekurang-kurangnya sebesar Rp.100.000.000,00 (seratus juta rupiah) dan diragukan itikad baiknya dalam melunasi utang pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_e91b7a1d84 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_33 ;
    kbr:hasRuleId "R-UU-1997-19-e91b7a1d84"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Surat Perintah Penyanderaan memuat sekurang-kurangnya: a. identitas Penanggung Pajak; b. alasan penyanderaan; c. izin penyanderaan; d. lamanya penyanderaan; dan e. tempat penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_f2278b740d a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_13 ;
    kbr:hasRuleId "R-UU-1997-19-f2278b740d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "Pengajuan keberatan oleh Wajib Pajak tidak mengakibatkan penundaan pelaksanaan penyitaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_fa701487bb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1997-19-fa701487bb"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "10. Surat Teguran, Surat Peringatan atau surat lain yang sejenis adalah surat yang diterbitkan oleh Pejabat untuk menegur atau memperingatkan kepada Wajib Pajak untuk melunasi utang pajaknya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_fcf34f94ae a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_37 ;
    kbr:hasRuleId "R-UU-1997-19-fcf34f94ae"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Gugatan Penanggung Pajak sebagaimana dimaksud dalam ayat (1) diajukan dalam jangka waktu 14 (empat belas) hari sejak Surat Paksa, Surat Perintah Melaksanakan Penyitaan, atau Pengumuman Lelang dilaksanakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_ffa41f792e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1997-19-ffa41f792e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "4. Badan adalah sekumpulan orang dan atau modal yang merupakan kesatuan baik yang melakukan usaha maupun yang tidak melakukan usaha yang meliputi perseroan terbatas, perseroan komanditer, perseroan lainnya, badan usaha milik Negara atau Daerah dengan nama dan dalam bentuk apapun, firma, kongsi, koperasi, dana pensiun, persekutuan, perkumpulan, yayasan, organisasi massa, organisasi sosial politik, atau organisasi yang sejenis, lembaga, bentuk usaha tetap, dan bentuk badan lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_004d6bbd75 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_48 ;
    kbr:hasRuleId "R-UU-2002-14-004d6bbd75"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Gugatan, Majelis/Hakim Tunggal sudah memulai sidang dalam jangka waktu 3 (tiga) bulan sejak tanggal diterima Surat Gugatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_01dde04695 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-01dde04695"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "6. Banding adalah upaya hukum yang dapat dilakukan oleh Wajib Pajak atau penanggung Pajak terhadap suatu keputusan yang dapat diajukan Banding, berdasarkan peraturan perundang-undangan perpajakaan yang berlaku."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_029a3e22aa a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_37 ;
    kbr:hasRuleId "R-UU-2002-14-029a3e22aa"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Apabila selama proses Banding, pemohon Banding meninggal dunia, Banding dapat dilanjutkan oleh ahli warisnya, kuasa hukum dari ahli warisnya, atau pengampunya dalam hal pemohon Banding pailit."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_053bc36f14 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-053bc36f14"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "14. Hakim Tunggal adalah Hakim yang ditunjuk oleh Ketua untuk memeriksa dan memutus Sengketa Pajak dengan acara cepat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_06906ec5dd a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_82 ;
    kbr:hasRuleId "R-UU-2002-14-06906ec5dd"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "Putusan/penetapan dengan acara cepat terhadap kekeliruan sebagaimana dimaksud dalam Pasal 66 ayat (1) huruf c berupa membetulkan kesalahan tulis dan/atau kesalahan hitung, diambil dalam jangka waktu 30 (tiga puluh) hari sejak kekeliruan dimaksud diketahui atau sejak permohonan salah satu pihak diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_0bc585489f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_77 ;
    kbr:hasRuleId "R-UU-2002-14-0bc585489f"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "Putusan Pengadilan Pajak merupakan putusan akhir dan mempunyai kekuatan hukum tetap."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_0c5f91fde6 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_81 ;
    kbr:hasRuleId "R-UU-2002-14-0c5f91fde6"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "Putusan pemeriksaan dengan acara biasa atas Banding diambil dalam jangka waktu 12 (dua belas) bulan sejak Surat Banding diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_0ce93a7591 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_63 ;
    kbr:hasRuleId "R-UU-2002-14-0ce93a7591"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/63"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal saksi yang akan didengar tidak dapat hadir di persidangan karena halangan yang dapat dibenarkan oleh hukum, Majelis dapat datang ke tempat tinggal saksi untuk mengambil sumpah atau janji dan mendengar keterangan saksi dimaksud tanpa dihadiri oleh terbanding atau tergugat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_0fa4a991b5 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_51 ;
    kbr:hasRuleId "R-UU-2002-14-0fa4a991b5"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "sengketa dimaksud disidangkan kembali dalam jangka waktu 3 (tiga) bulan terhitung sejak diketahuinya hubungan dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_156a312134 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_55 ;
    kbr:hasRuleId "R-UU-2002-14-156a312134"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/55"^^xsd:string ;
    kbr:hasSourceQuote "Saksi yang diperintahkan oleh Hakim Ketua sebagaimana dimaksud dalam ayat (1) wajib datang di persidangan dan tidak diwakilkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_1b104c5d80 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_14 ;
    kbr:hasRuleId "R-UU-2002-14-1b104c5d80"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "Ketua, Wakil Ketua, dan Hakim diberhentikan tidak dengan hormat dari jabatannya oleh Presiden atas usul Menteri, setelah mendapat persetujuan Ketua Mahkamah Agung dengan alasan: a. dipidana karena bersalah melakukan tindak pidana kejahatan; b. melakukan perbuatan tercela; c. terus menerus melalaikan kewajiban dalam menjalankan tugas pekerjaannya; d. melanggar sumpah/janji jabatan; atau e. melanggar larangan sebagaimana dimaksud dalam Pasal 12."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_1dcec8acfa a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-1dcec8acfa"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "13. Ketua, Wakil Ketua, dan Hakim adalah Ketua, Wakil Ketua, dan Hakim pada Pengadilan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_219f97dac5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_69 ;
    kbr:hasRuleId "R-UU-2002-14-219f97dac5"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/69"^^xsd:string ;
    kbr:hasSourceQuote "Alat bukti dapat berupa: a. surat atau tulisan; b. keterangan ahli; c. keterangan para saksi; d. pengakuan para pihak; dan/atau e. pengetahuan Hakim"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2299fa5e3b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-2299fa5e3b"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "8. Surat Uraian Banding adalah surat terbanding kepada Pengadilan Pajak yang berisi jawaban atas alasan Banding yang diajukan oleh pemohon Banding."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2596e819f3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_41 ;
    kbr:hasRuleId "R-UU-2002-14-2596e819f3"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/41"^^xsd:string ;
    kbr:hasSourceQuote "(1) Gugatan dapat diajukan oleh penggugat, ahli warisnya, seorang pengurus, atau kuasa hukumnya dengan disertai alasan-alasan yang jelas, mencantumkan tanggal diterima, pelaksanaan penagihan, atau Keputusan yang digugat dan dilampiri salinan dokumen yang digugat. (2) Apabila selama proses Gugatan, penggugat meninggal dunia, Gugatan dapat dilanjutkan oleh ahli warisnya, kuasa hukum dari ahli warisnya, atau pengampunya dalam hal penggugat pailit. (3) Apabila selama proses Gugatan, penggugat melakukan penggabungan, peleburan, pemecahan/pemekaran usaha, atau likuidasi, permohonan dimaksud dapat dilanjutkan oleh pihak yang menerima pertanggungjawaban karena penggabungan, peleburan, pemecahan/pemekaran usaha, atau likuidasi dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_26297e472a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-26297e472a"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "10. Surat Bantahan adalah surat dari pemohon Banding atau penggugat kepada Pengadilan Pajak yang berisi bantahan atas surat uraian Banding atau Surat Tanggapan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_27bb03504f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-27bb03504f"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "15. Hakim Anggota adalah Hakim dalam suatu Majelis yang ditunjuk oleh Ketua untuk menjadi anggota dalam Majelis."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_28af9c56f9 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_88 ;
    kbr:hasRuleId "R-UU-2002-14-28af9c56f9"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/88"^^xsd:string ;
    kbr:hasSourceQuote "(1) Salinan putusan atau salinan penetapan Pengadilan Pajak dikirim kepada para pihak dengan surat oleh Sekretaris dalam jangka waktu 30 (tiga puluh) hari sejak tanggal putusan Pengadilan Pajak diucapkan, atau dalam jangka waktu 7 (tujuh) hari sejak tanggal putusan sela diucapkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2a8bf0ea1d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_91 ;
    kbr:hasRuleId "R-UU-2002-14-2a8bf0ea1d"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "Permohonan peninjauan kembali hanya dapat diajukan berdasarkan alasan-alasan sebagai berikut: a. Apabila putusan Pengadilan Pajak didasarkan pada suatu kebohongan atau tipu muslihat pihak lawan yang diketahui setelah perkaranya diputus atau didasarkan pada bukti-bukti yang kemudian oleh hakim pidana dinyatakan palsu; b. Apabila terdapat bukti tertulis baru yang penting dan bersifat menentukan, yang apabila diketahui pada tahap persidangan di Pengadilan Pajak akan menghasilkan putusan yang berbeda; c. Apabila telah dikabulkan suatu hal yang tidak dituntut atau lebih dari pada yang dituntut, kecuali yang diputus berdasarkan Pasal 80 ayat (1) huruf b dan huruf c; d. Apabila mengenai suatu bagian dari tuntutan belum diputus tanpa dipertimbangkan sebab-sebabnya; atau e. Apabila terdapat suatu putusan yang nyata-nyata tidak sesuai dengan ketentuan peraturan perundang-undangan yang berlaku."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2b5039f27c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_9 ;
    kbr:hasRuleId "R-UU-2002-14-2b5039f27c"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Tata cara penunjukan Hakim Ad Hoc pada Pengadilan Pajak sebagaimana dimaksud dalam ayat (2) diatur dengan Keputusan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2bcf522a8d a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_92 ;
    kbr:hasRuleId "R-UU-2002-14-2bcf522a8d"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/92"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pengajuan permohonan peninjauan kembali berdasarkan alasan sebagaimana dimaksud dalam Pasal 91 huruf b dilakukan dalam jangka waktu paling lambat 3 (tiga) bulan terhitung sejak ditemukan surat-surat bukti yang hari dan tanggal ditemukannya harus dinyatakan di bawah sumpah dan disahkan oleh pejabat yang berwenang."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2c2a2d6c08 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_72 ;
    kbr:hasRuleId "R-UU-2002-14-2c2a2d6c08"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "Seorang ahli dalam persidangan harus memberi keterangan baik tertulis maupun lisan, yang dikuatkan dengan sumpah atau janji mengenai hal sebenarnya menurut pengalaman dan pengetahuannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2ca68f7477 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_57 ;
    kbr:hasRuleId "R-UU-2002-14-2ca68f7477"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "(2) Apabila dipandang perlu, Hakim Ketua dapat meminta pihak sebagaimana dimaksud dalam ayat (1) huruf a, huruf b, dan huruf c untuk didengar keterangannya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_2e61f87fe5 a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_9 ;
    kbr:hasRuleId "R-UU-2002-14-2e61f87fe5"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "(1) Untuk dapat diangkat menjadi Hakim, setiap calon harus memenuhi syarat-syarat sebagai berikut: a. warga negara Indonesia; b. berumur paling rendah 45 (empat puluh lima) tahun; c. bertakwa kepada Tuhan Yang Maha Esa; d. setia kepada Pancasila dan Undang-Undang Dasar 1945; e. tidak pernah terlibat dalam kegiatan yang mengkhianati Negara Kesatuan Republik Indonesia yang berdasarkan Pancasila dan Undang-Undang Dasar 1945 atau terlibat organisasi terlarang; f. mempunyai keahlian di bidang perpajakan dan berijazah sarjana hukum atau sarjana lain; g. berwibawa... g. berwibawa, jujur, adil, dan berkelakuan tidak tercela; h. tidak pernah dipidana karena melakukan tindak pidana kejahatan; dan i. sehat jasmani dan rohani."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_30087aa9a9 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_34 ;
    kbr:hasRuleId "R-UU-2002-14-30087aa9a9"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal kuasa hukum yang mendampingi atau mewakili pemohon Banding atau penggugat adalah keluarga sedarah atau semenda sampai dengan derajat kedua, pegawai, atau pengampu, persyaratan sebagaimana dimaksud dalam ayat (2) tidak diperlukan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:merujukSEMA kbr:SEMA_2012_7_TUN_6_8 ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_3407b50b09 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_12 ;
    kbr:hasRuleId "R-UU-2002-14-3407b50b09"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "(1) Hakim tidak boleh merangkap menjadi: a. pelaksana putusan Pengadilan Pajak; b. wali, pengampu, atau pejabat yang berkaitan dengan suatu Sengketa Pajak yang akan atau sedang diperiksa olehnya; c. penasehat hukum; d. konsultan Pajak; e. akuntan publik; dan/atau f. pengusaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_34110d1082 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_84 ;
    kbr:hasRuleId "R-UU-2002-14-34110d1082"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "(6) Apabila Hakim Anggota berhalangan menandatangani, putusan ditandatangani oleh Hakim Ketua dengan menyatakan alasan berhalangannya Hakim Anggota dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_36d37d730c a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_45 ;
    kbr:hasRuleId "R-UU-2002-14-36d37d730c"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/45"^^xsd:string ;
    kbr:hasSourceQuote "Pemohon Banding atau penggugat dapat menyerahkan Surat Bantahan kepada Pengadilan Pajak dalam jangka waktu 30 (tiga puluh) hari sejak tanggal diterima salinan Surat Uraian Banding atau Surat Tanggapan sebagaimana dimaksud dalam ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_38583cf345 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_40 ;
    kbr:hasRuleId "R-UU-2002-14-38583cf345"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "(4) Jangka waktu sebagaimana dimaksud dalam ayat (2) dan ayat (3) tidak mengikat apabila jangka waktu dimaksud tidak dapat dipenuhi karena keadaan di luar kekuasaan penggugat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_39f824fd2c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-39f824fd2c"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "18. Panitera, Wakil Panitera, dan Panitera Pengganti adalah Sekretaris, Wakil Sekretaris, dan Sekretaris Pengganti Pengadilan Pajak yang melaksanakan fungsi kepaniteraan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_3ab80b97bd a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_52 ;
    kbr:hasRuleId "R-UU-2002-14-3ab80b97bd"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/52"^^xsd:string ;
    kbr:hasSourceQuote "Hakim Ketua, Hakim Anggota, Panitera, Wakil Panitera, atau Panitera Pengganti sebagaimana dimaksud dalam ayat (1) harus diganti dan apabila tidak diganti atau tidak mengundurkan diri sedangkan sengketa telah diputus, putusan dimaksud tidak sah dan Ketua memerintahkan sengketa dimaksud segera disidangkan kembali dengan susunan Majelis dan Panitera, Wakil Panitera, atau Panitera Pengganti yang berbeda, kecuali putusan dimaksud telah melampaui jangka waktu 1 (satu) tahun."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_3ca1fdf019 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_94 ;
    kbr:hasRuleId "R-UU-2002-14-3ca1fdf019"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/94"^^xsd:string ;
    kbr:hasSourceQuote "3. Berdasarkan ketentuan sebagaimana dimaksud dalam angka 2, Ketua, Wakil Ketua, dan Anggota Badan Penyelesaian Sengketa Pajak, menjadi Ketua, Wakil Ketua, dan Hakim pada Pengadilan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_3caad8056c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_81 ;
    kbr:hasRuleId "R-UU-2002-14-3caad8056c"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Gugatan yang diajukan selain atas keputusan pelaksanaan penagihan Pajak, tidak diputus dalam jangka waktu sebagaimana dimaksud dalam ayat (2), Pengadilan Pajak wajib mengambil putusan melalui pemeriksaan dengan acara cepat dalam jangka waktu 1 (satu) bulan sejak jangka waktu 6 (enam) bulan dimaksud dilampaui."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_3cd0cd3e31 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_95 ;
    kbr:hasRuleId "R-UU-2002-14-3cd0cd3e31"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Perkara Sengketa Pajak yang diperiksa sebagaimana dimaksud dalam ayat (1) huruf a dapat diajukan peninjauan kembali berdasarkan Undang-undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_3d0d93b21d a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_43 ;
    kbr:hasRuleId "R-UU-2002-14-3d0d93b21d"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/43"^^xsd:string ;
    kbr:hasSourceQuote "(1) Gugatan tidak menunda atau menghalangi dilaksanakannya penagihan Pajak atau kewajiban perpajakan. (2) Penggugat dapat mengajukan permohonan agar tindak lanjut pelaksanaan penagihan Pajak sebagaimana dimaksud dalam ayat (1) ditunda selama pemeriksaan Sengketa Pajak sedang berjalan, sampai ada putusan Pengadilan Pajak. (3) Permohonan sebagaimana dimaksud dalam ayat (2) dapat diajukan sekaligus dalam Gugatan dan dapat diputus terlebih dahulu dari pokok sengketanya. (4) Permohonan penundaan sebagaimana dimaksud dalam ayat (2) dapat dikabulkan hanya apabila terdapat keadaan yang sangat mendesak yang mengakibatkan kepentingan penggugat sangat dirugikan jika pelaksanaan penagihan Pajak yang digugat itu dilaksanakan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_4043c4b7a6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-4043c4b7a6"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "7. Gugatan adalah upaya hukum yang dapat dilakukan oleh Wajib Pajak atau penanggung Pajak terhadap pelaksanaan penagihan Pajak atau terhadap keputusan yang dapat diajukan Gugatan berdasarkan peraturan perundang-undangan perpajakan yang berlaku."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_41a43e7e1f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_94 ;
    kbr:hasRuleId "R-UU-2002-14-41a43e7e1f"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/94"^^xsd:string ;
    kbr:hasSourceQuote "4. Sekretaris Sidang pada Badan Penyelesaian Sengketa Pajak menjadi Panitera pada Pengadilan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_424f54c447 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_55 ;
    kbr:hasRuleId "R-UU-2002-14-424f54c447"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/55"^^xsd:string ;
    kbr:hasSourceQuote "Apabila saksi tidak datang tanpa alasan yang dapat dipertanggungjawabkan meskipun telah dipanggil dengan patut, dan Majelis mempunyai alasan yang cukup untuk menyangka bahwa saksi sengaja tidak datang, serta Majelis tidak dapat mengambil putusan tanpa keterangan dari saksi dimaksud, Hakim Ketua dapat meminta bantuan polisi untuk membawa saksi ke persidangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_446785a7ff a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_37 ;
    kbr:hasRuleId "R-UU-2002-14-446785a7ff"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Banding dapat diajukan oleh Wajib Pajak, ahli warisnya, seorang pengurus, atau kuasa hukumnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_46d2854239 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_10 ;
    kbr:hasRuleId "R-UU-2002-14-46d2854239"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(2) Ketua dan Wakil Ketua mengucapkan sumpah atau janji di hadapan Ketua Mahkamah Agung."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_49e478f564 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_42 ;
    kbr:hasRuleId "R-UU-2002-14-49e478f564"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "Gugatan yang telah dicabut melalui penetapan atau putusan sebagaimana dimaksud dalam ayat (2) tidak dapat diajukan kembali."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_4c424a28cf a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_20 ;
    kbr:hasRuleId "R-UU-2002-14-4c424a28cf"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Pelaksanaan penangkapan atau penahanan sebagaimana dimaksud dalam ayat (1) paling lambat dalam waktu 2 (dua) kali 24 (dua puluh empat) jam harus sudah dilaporkan kepada Ketua Mahkamah Agung."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_4d9dfbcefd a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_93 ;
    kbr:hasRuleId "R-UU-2002-14-4d9dfbcefd"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/93"^^xsd:string ;
    kbr:hasSourceQuote "b. dalam jangka waktu 1 (satu) bulan sejak permohonan peninjauan kembali diterima oleh Mahkamah Agung telah mengambil putusan, dalam hal Pengadilan Pajak mengambil putusan melalui pemeriksaan acara cepat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_4e8a76cadc a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_10 ;
    kbr:hasRuleId "R-UU-2002-14-4e8a76cadc"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(3) Hakim mengucapkan sumpah atau janji di hadapan Ketua."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_50b749c2a5 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_81 ;
    kbr:hasRuleId "R-UU-2002-14-50b749c2a5"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "Putusan pemeriksaan dengan acara biasa atas Gugatan diambil dalam jangka waktu 6 (enam) bulan sejak Surat Gugatan diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_51b42c0335 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_52 ;
    kbr:hasRuleId "R-UU-2002-14-51b42c0335"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/52"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal kepentingan langsung atau tidak langsung sebagaimana dimaksud dalam ayat (1) diketahui sebelum melewati jangka waktu 1 (satu) tahun setelah sengketa diputus sebagaimana dimaksud dalam ayat (4), sengketa dimaksud disidangkan kembali dalam jangka waktu 3 (tiga) bulan terhitung sejak diketahuinya kepentingan dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_54f2938839 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-54f2938839"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "2. Pajak adalah semua jenis Pajak yang dipungut oleh Pemerintah Pusat, termasuk Bea Masuk dan Cukai, dan Pajak yang dipungut oleh Pemerintah Daerah, berdasarkan peraturan perundang-undangan yang berlaku."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_56bd7ab7d1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_52 ;
    kbr:hasRuleId "R-UU-2002-14-56bd7ab7d1"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/52"^^xsd:string ;
    kbr:hasSourceQuote "Hakim Ketua, Hakim Anggota, Panitera, Wakil Panitera, atau Panitera Pengganti wajib mengundurkan diri dari suatu persidangan apabila berkepentingan langsung atau tidak langsung atas satu sengketa yang ditanganinya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_591c4e2b43 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_40 ;
    kbr:hasRuleId "R-UU-2002-14-591c4e2b43"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "(5) Perpanjangan jangka waktu sebagaimana dimaksud dalam ayat (4) adalah 14 (empat belas) hari terhitung sejak berakhirnya keadaan di luar kekuasaan penggugat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_59bb12a30d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_38 ;
    kbr:hasRuleId "R-UU-2002-14-59bb12a30d"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Pemohon Banding dapat melengkapi Surat Bandingnya untuk memenuhi ketentuan yang berlaku sepanjang masih dalam jangka waktu sebagaimana dimaksud dalam Pasal 35 ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_59c75ab2a2 a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_34 ;
    kbr:hasRuleId "R-UU-2002-14-59c75ab2a2"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Untuk menjadi kuasa hukum harus dipenuhi syarat-syarat sebagai berikut: a. Warga Negara Indonesia; b. mempunyai pengetahuan yang luas dan keahlian tentang peraturan perundang-undangan perpajakan; c. persyaratan lain yang ditetapkan oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:merujukSEMA kbr:SEMA_2012_7_TUN_6_8 ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_5b67101159 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_62 ;
    kbr:hasRuleId "R-UU-2002-14-5b67101159"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/62"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pemohon Banding atau penggugat atau saksi, ternyata bisu dan/atau tuli tetapi dapat menulis, Hakim Ketua dapat memerintahkan Panitera menuliskan pertanyaan atau teguran kepada pemohon Banding atau penggugat atau saksi, dan memerintahkan menyampaikan tulisan itu kepada pemohon Banding atau penggugat atau saksi dimaksud, agar ia menuliskan jawabannya, kemudian segala pertanyaan dan jawaban harus dibacakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_5c921c8471 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_83 ;
    kbr:hasRuleId "R-UU-2002-14-5c921c8471"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/83"^^xsd:string ;
    kbr:hasSourceQuote "(1) Putusan Pengadilan Pajak harus diucapkan dalam sidang terbuka untuk umum. (2) Tidak dipenuhinya ketentuan sebagaimana dimaksud dalam ayat (1), putusan Pengadilan Pajak tidak sah dan tidak mempunyai kekuatan hukum dan karena itu putusan dimaksud harus diucapkan kembali dalam sidang terbuka untuk umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_60c0128df4 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_56 ;
    kbr:hasRuleId "R-UU-2002-14-60c0128df4"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/56"^^xsd:string ;
    kbr:hasSourceQuote "(1) Saksi dipanggil ke persidangan seorang demi seorang. (2) Hakim Ketua menanyakan kepada saksi nama lengkap, tempat lahir, umur atau tanggal lahir, jenis kelamin, kewarganegaraan, tempat tinggal, agama, pekerjaan, derajat hubungan keluarga, dan hubungan kerja dengan pemohon Banding/penggugat atau dengan terbanding/tergugat. (3) Sebelum memberi keterangan, saksi wajib mengucapkan sumpah atau janji menurut agama atau kepercayaannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_6261850ff9 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_59 ;
    kbr:hasRuleId "R-UU-2002-14-6261850ff9"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/59"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang karena pekerjaan atau jabatannya wajib merahasiakan segala sesuatu sehubungan dengan pekerjaan atau jabatannya, untuk keperluan persidangan kewajiban merahasiakan dimaksud ditiadakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_6272201493 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_93 ;
    kbr:hasRuleId "R-UU-2002-14-6272201493"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/93"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam jangka waktu 6 (enam) bulan sejak permohonan peninjauan kembali diterima oleh Mahkamah Agung telah mengambil putusan, dalam hal Pengadilan Pajak mengambil putusan melalui pemeriksaan acara biasa;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_65e26a3504 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_8 ;
    kbr:hasRuleId "R-UU-2002-14-65e26a3504"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(4) Ketua, Wakil Ketua, dan Hakim adalah pejabat negara yang melaksanakan tugas kekuasaan kehakiman di bidang Sengketa Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_APPROVED"^^xsd:string ;
    kbr:terdampakPutusanMK kbr:MK_2016_6_PUU_XIV,
        kbr:MK_2020_10_PUU_XVIII ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_65ec29c624 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_37 ;
    kbr:hasRuleId "R-UU-2002-14-65ec29c624"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Apabila selama proses Banding pemohon Banding melakukan penggabungan, peleburan, pemecahan/pemekaran usaha, atau likuidasi, permohonan dimaksud dapat dilanjutkan oleh pihak yang menerima pertanggungjawaban karena penggabungan, peleburan, pemecahan/pemekaran usaha, atau likuidasi dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_661910e8a3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_13 ;
    kbr:hasRuleId "R-UU-2002-14-661910e8a3"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(1) Ketua, Wakil Ketua, dan Hakim diberhentikan dengan hormat dari jabatannya oleh Presiden atas usul Menteri setelah mendapat persetujuan Ketua Mahkamah Agung karena : a. permintaan sendiri; b. sakit jasmani dan rohani terus menerus; c. telah berumur 65 (enam puluh lima) tahun; atau d. ternyata tidak cakap dalam menjalankan tugas. (2) Ketua, Wakil Ketua, dan Hakim diberhentikan dengan hormat dari jabatannya oleh Presiden atas usul Menteri setelah mendapat persetujuan Ketua Mahkamah Agung karena tenaganya dibutuhkan oleh negara untuk menjalankan tugas negara lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:terdampakPutusanMK kbr:MK_2016_6_PUU_XIV ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_67c5a614cf a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-67c5a614cf"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "4. Keputusan adalah suatu penetapan tertulis di bidang perpajakan yang dikeluarkan oleh pejabat yang berwenang berdasarkan peraturan perundang-undangan perpajakan dan dalam rangka pelaksanaan Undang-undang Penagihan Pajak dengan Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_684164b0d8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_77 ;
    kbr:hasRuleId "R-UU-2002-14-684164b0d8"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "Pengadilan Pajak dapat mengeluarkan putusan sela atas Gugatan berkenaan dengan permohonan sebagaimana dimaksud dalam Pasal 43 ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_691f200a84 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_19 ;
    kbr:hasRuleId "R-UU-2002-14-691f200a84"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(2) Apabila tuntutan pidana terhadap Ketua, Wakil Ketua, atau Hakim sebagaimana dimaksud dalam Pasal 18 ayat (2) tidak terbukti berdasarkan putusan pengadilan yang telah memperoleh kekuatan hukum tetap, Ketua, Wakil Ketua, atau Hakim dimaksud dikembalikan ke jabatan semula."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_6c40be88ea a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_84 ;
    kbr:hasRuleId "R-UU-2002-14-6c40be88ea"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "(5) Apabila Hakim Ketua atau Hakim Tunggal yang menyidangkan berhalangan menandatangani, putusan ditandatangani oleh Ketua dengan menyatakan alasan berhalangannya Hakim Ketua atau Hakim Tunggal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_6f603c74f9 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_72 ;
    kbr:hasRuleId "R-UU-2002-14-6f603c74f9"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "Atas permintaan kedua belah pihak atau salah satu pihak atau karena jabatannya, Hakim Ketua atau Hakim Tunggal dapat menunjuk seorang atau beberapa orang ahli."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_70646c5966 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_52 ;
    kbr:hasRuleId "R-UU-2002-14-70646c5966"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/52"^^xsd:string ;
    kbr:hasSourceQuote "Pengunduran diri sebagaimana dimaksud dalam ayat (1) dapat dilakukan atas permintaan salah satu atau pihak-pihak yang bersengketa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_72b731c5fe a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_79 ;
    kbr:hasRuleId "R-UU-2002-14-72b731c5fe"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/79"^^xsd:string ;
    kbr:hasSourceQuote "Apabila Majelis di dalam mengambil putusan dengan cara musyawarah tidak dapat dicapai kesepakatan sehingga putusan diambil dengan suara terbanyak, pendapat Hakim Anggota yang tidak sepakat dengan putusan tersebut dinyatakan dalam putusan Pengadilan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_72d7b67253 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_84 ;
    kbr:hasRuleId "R-UU-2002-14-72d7b67253"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "(2) Tidak dipenuhinya salah satu ketentuan sebagaimana dimaksud dalam ayat (1) menyebabkan putusan dimaksud tidak sah dan Ketua memerintahkan sengketa dimaksud segera disidangkan kembali dengan acara cepat, kecuali putusan dimaksud telah melampaui jangka waktu 1 (satu) tahun."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_72d94d0122 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_66 ;
    kbr:hasRuleId "R-UU-2002-14-72d94d0122"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pemeriksaan dengan acara cepat dilakukan terhadap: a. Sengketa Pajak tertentu; b. Gugatan yang tidak diputus dalam jangka waktu sebagaimana dimaksud dalam Pasal 81 ayat (2); c. tidak dipenuhinya salah satu ketentuan sebagaimana dimaksud dalam Pasal 84 ayat (1) atau kesalahan tulis dan/atau kesalahan hitung, dalam putusan Pengadilan Pajak; d. sengketa yang berdasarkan pertimbangan hukum bukan merupakan wewenang Pengadilan Pajak. (2) Sengketa Pajak tertentu sebagaimana dimaksud dalam ayat (1) huruf a adalah Sengketa Pajak yang Banding atau Gugatannya tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 35 ayat (1) dan ayat (2), Pasal 36 ayat (1) dan ayat (4), Pasal 37 ayat (1), Pasal 40 ayat (1) dan/atau ayat (6)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:merujukSEMA kbr:SEMA_2020_10_TUN_4 ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_72dba2d608 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_63 ;
    kbr:hasRuleId "R-UU-2002-14-72dba2d608"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/63"^^xsd:string ;
    kbr:hasSourceQuote "(1) Saksi diambil sumpah atau janji dan didengar keterangannya dalam persidangan dengan dihadiri oleh terbanding atau tergugat. (2) Apabila terbanding atau tergugat telah dipanggil secara patut, tetapi tidak dapat datang tanpa alasan yang dapat dipertanggungjawabkan, saksi diambil sumpah atau janji dan didengar keterangannya tanpa dihadiri oleh terbanding atau tergugat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_73c1d7c270 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_62 ;
    kbr:hasRuleId "R-UU-2002-14-73c1d7c270"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/62"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pemohon Banding atau penggugat atau saksi, ternyata bisu dan/atau tuli serta tidak dapat menulis, Hakim Ketua menunjuk orang yang pandai bergaul dengan pemohon Banding atau penggugat atau saksi, sebagai ahli alih bahasa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_7477b73194 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_84 ;
    kbr:hasRuleId "R-UU-2002-14-7477b73194"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "(3) Ringkasan sebagaimana dimaksud dalam ayat (1) huruf e tidak diperlukan dalam hal putusan Pengadilan Pajak diambil terhadap Sengketa Pajak sebagaimana dimaksud dalam Pasal 66 ayat (1) huruf c, huruf d, dan Pasal 66 ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_7492c29ee5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-7492c29ee5"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "16. Hakim Ketua adalah Hakim Anggota yang ditunjuk oleh Ketua untuk memimpin sidang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_78cd5c129c a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_82 ;
    kbr:hasRuleId "R-UU-2002-14-78cd5c129c"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "(1) Putusan pemeriksaan dengan acara cepat terhadap Sengketa Pajak tertentu sebagaimana dimaksud dalam Pasal 66 ayat (2), dinyatakan tidak dapat diterima, diambil dalam jangka waktu sebagai berikut : a. 30 (tiga puluh) hari sejak batas waktu pengajuan Banding atau Gugatan dilampaui; b. 30... b. 30 (tiga puluh) hari sejak Banding atau Gugatan diterima dalam hal diajukan setelah batas waktu pengajuan dilampaui."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_7a791f1c32 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_42 ;
    kbr:hasRuleId "R-UU-2002-14-7a791f1c32"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "(1) Terhadap Gugatan sebagaimana dimaksud dalam Pasal 40 ayat (1), dapat diajukan surat pernyataan pencabutan kepada Pengadilan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_7b0a87093f a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_82 ;
    kbr:hasRuleId "R-UU-2002-14-7b0a87093f"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "Putusan dengan acara cepat terhadap sengketa yang didasarkan pertimbangan hukum bukan merupakan wewenang Pengadilan Pajak sebagaimana dimaksud dalam Pasal 66 ayat (1) huruf d, berupa tidak dapat diterima, diambil dalam jangka waktu 30 (tiga puluh) hari sejak Surat Banding atau Surat Gugatan diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_7b9d9945b8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_84 ;
    kbr:hasRuleId "R-UU-2002-14-7b9d9945b8"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "(4) Putusan Pengadilan Pajak harus ditandatangani oleh Hakim yang memutus dan Panitera."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_7d539e9038 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-7d539e9038"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "11. Tanggal dikirim adalah tanggal stempel pos pengiriman, tanggal faksimile, atau dalam hal disampaikan secara langsung adalah tanggal pada saat surat, keputusan, atau putusan disampaikan secara langsung."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_7ee76f6b6e a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_40 ;
    kbr:hasRuleId "R-UU-2002-14-7ee76f6b6e"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "(2) Jangka waktu untuk mengajukan Gugatan terhadap pelaksanaan penagihan Pajak adalah 14 (empat belas) hari sejak tanggal pelaksanaan penagihan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_80416e3643 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_88 ;
    kbr:hasRuleId "R-UU-2002-14-80416e3643"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/88"^^xsd:string ;
    kbr:hasSourceQuote "(2) Putusan Pengadilan Pajak harus dilaksanakan oleh Pejabat yang berwenang dalam jangka waktu 30 (tiga puluh) hari terhitung sejak tanggal diterima putusan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_8076c7d831 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_85 ;
    kbr:hasRuleId "R-UU-2002-14-8076c7d831"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/85"^^xsd:string ;
    kbr:hasSourceQuote "Pada setiap pemeriksaan, Panitera harus membuat Berita Acara Sidang yang memuat segala sesuatu yang terjadi dalam persidangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_80a70bb0c5 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_81 ;
    kbr:hasRuleId "R-UU-2002-14-80a70bb0c5"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal-hal khusus, jangka waktu sebagaimana dimaksud dalam ayat (1) diperpanjang paling lama 3 (tiga) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_826349553f a kbr:Prosedur ;
