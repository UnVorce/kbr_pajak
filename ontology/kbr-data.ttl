kbr:Aturan_R_PMK_2024_81_e2981e812b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_464 ;
    kbr:hasRuleId "R-PMK-2024-81-e2981e812b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/464"^^xsd:string ;
    kbr:hasSourceQuote "Pelaksanaan hak dan pemenuhan kewajiban perpajakan Wajib Pajak atas satu atau lebih tempat kegiatan usaha sejak: a. Masa Pajak Januari 2025; dan b. Tahun Pajak 2025 untuk jenis pajak Pajak Bumi dan Bangunan, dilakukan secara terpusat menggunakan N omor Pokok Wajib Pajak yang terdaftar sesuai tempat tinggal atau tempat kedudukan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e2c8d728a5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_29_23_c ;
    kbr:hasRuleId "R-PMK-2024-81-e2c8d728a5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/29/23/c"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penyerahan Barang Kena Pajak tidak berwujud dan/atau Jasa Kena Pajak dilakukan dengan menggunakan mata uang selain Rupiah maka: 1. hanya Dasar Pengenaan Pajak sebagaimana dimaksud pada angka (6), yang harus dikonversikan ke dalam mata uang Rupiah dengan menggunakan kurs yang ditetapkan dalam Keputusan Menteri Keuangan mengenai nilai kurs sebagai dasar pelunasan bea masuk, pajak, bea keluar, dan pajak penghasilan, yang berlaku pada saat pemberitahuan ekspor Barang Kena Pajak tidak berwujud dan/ atau Jasa Kena Pajak seharusnya dibuat;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e2f5315f31 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_283 ;
    kbr:hasRuleId "R-PMK-2024-81-e2f5315f31"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/283"^^xsd:string ;
    kbr:hasSourceQuote "Saat Ekspor Jasa Kena Pajak sebagaimana dimaksud pada ayat (1) yaitu pada saat Penggantian atas jasa yang diekspor tersebut dicatat atau diakui sebagai piutang atau penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e31dab6fe6 a kbr:Definisi ;
