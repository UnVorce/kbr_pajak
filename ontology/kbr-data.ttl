    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_71_p1 ;
    kbr:hasRuleId "R-PP-2022-50-f44c857d83"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/71#p1"^^xsd:string ;
    kbr:hasSourceQuote "1. terhadap Surat Ketetapan Pajak yang diterbitkan sejak tanggal 29 Oktober 2021 yang memuat sanksi administratif berupa bunga sebagaimana diatur dalam Pasal 13 ayat (3b) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan berlaku ketentuan dalam hal penghitungan sanksi administratifnya dimulai: a. sebelum tanggal 29 Oktober 2021, pengenaan sanksi administratifnya dihitung menggunakan tarif bunga sesuai dengan Keputusan Menteri mengenai penghitungan tarif bunga sebagai dasar penghitungan sanksi administratif berupa bunga dan pemberian imbalan bunga yang berlaku sejak tanggal 29 Oktober 2021 sampai dengan 31 Oktober 2021;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

