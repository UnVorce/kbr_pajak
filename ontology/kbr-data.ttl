    kbr:hasSourceLocator "PMK-2024-136#BT/47/12..15"^^xsd:string ;
    kbr:hasSourceQuote "(15) Laba bersih dari negara atau yurisdiksi sebagaimana dimaksud pada ayat (13) merupakan jumlah Laba GloBE Bersih dari negara atau yurisdiksi yang ditentukan untuk setiap Tahun Pajak yang sesuai dengan deemed distribution tax recapture account pada negara atau yurisdiksi tempat Entitas Konstituen sebagaimana dimaksud pada ayat (12)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
