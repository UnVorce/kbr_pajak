    kbr:hasSourceLocator "PMK-2024-136#BT/53/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Pajak tambahan berdasarkan DMTT dialokasikan kepada Entitas Konstituen di Indonesia yang mempunyai Tarif Pajak Efektif kurang dari 15% (lima belas persen)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
