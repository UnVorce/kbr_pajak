    kbr:hasSourceQuote "Pajak Pertambahan Nilai yang dipungut sebagaimana dimaksud dalam Pasal 33 huruf d dan Pajak Penjualan atas Barang Mewah yang dipungut sebagaimana dimaksud dalam Pasal 33 huruf e dihitung dalam satuan mata uang rupiah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_f102d2fcde a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_11_BT_1_p7 ;
    kbr:hasRuleId "R-PER-DJP-2025-11-f102d2fcde"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-11#BT/1#p7"^^xsd:string ;
    kbr:hasSourceQuote "Perekaman Surat Pemberitahuan adalah serangkaian kegiatan yang dilakukan untuk memasukkan semua unsur Surat Pemberitahuan ke dalam basis data perpajakan dengan cara antara lain merekam, mengunggah (upload), dan/atau memindai (scan)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
