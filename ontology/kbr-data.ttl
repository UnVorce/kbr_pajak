    kbr:hasRuleId "R-PMK-2025-112-bed11dbea3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-112#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal permohonan penerbitan Surat Keterangan Domisili Wajib Pajak Dalam Negeri sebagaimana dimaksud dalam Pasal 4 ayat (4) tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 4 ayat (2), ayat (3), dan ayat (5), permohonan penerbitan Surat Keterangan Domisili Wajib Pajak Dalam Negeri tersebut tidak dapat diproses."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

