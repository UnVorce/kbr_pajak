    kbr:hasSourceLocator "PP-2017-53#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya pajak penghasilan yang terutang bagi Kontraktor, dihitung berdasarkan penghasilan kena pajak sebagaimana dimaksud pada ayat (3) dikalikan dengan tarif pajak yang ditentukan sesuai dengan ketentuan perundang-undangan di bidang pajak"^^xsd:string ;
