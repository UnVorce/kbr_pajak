    kbr:hasSourceQuote "Apabila pinjaman yang diterima oleh Wajib Pajak berbentuk perseroan terbatas dari pemegang sahamnya tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1), atas pinjaman tersebut terutang bunga dengan tingkat suku bunga wajar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
