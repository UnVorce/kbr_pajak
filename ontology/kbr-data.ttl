kbr:Aturan_R_PMK_2021_96_eb75c6f406 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2021_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2021_96_BT_10_1__4 ;
    kbr:hasRuleId "R-PMK-2021-96-eb75c6f406"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2021-96#BT/10/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Wajib Pajak yang menerima penyerahan Barang Kena Pajak yang tergolong mewah sebagaimana dimaksud dalam Pasal 4 ayat (2) dan ayat (3) harus menyerahkan SKB PPnBM atas perolehan Barang Kena Pajak yang tergolong mewah tersebut kepada Pengusaha Kena Pajak yang melakukan penyerahan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

