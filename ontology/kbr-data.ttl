    kbr:hasRuleId "R-UU-1983-8-8d35bcf6ba"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9A"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Masukan atas perolehan Barang Kena Pajak dan/atau Jasa Kena Pajak, impor Barang Kena Pajak, serta pemanfaatan Barang Kena Pajak Tidak Berwujud dan/atau pemanfaatan Jasa Kena Pajak dari luar Daerah Pabean di dalam Daerah Pabean, yang berhubungan dengan penyerahan oleh Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (1) tidak dapat dikreditkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_8e862fbe0e a kbr:Kewajiban ;
