    kbr:hasSourceQuote "k. rapat umum pemegang saham atau dividen interim sebagaimana dimaksud dalam huruf j termasuk rapat sejenis dan mekanisme pembagian dividen sejenis;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
