    kbr:hasSourceQuote "a. 10% (sepuluh persen) dikali 11/12 (sebelas per dua belas) dari tarif Pajak Pertambahan Nilai sebagaimana diatur dalam Pasal  7 ayat (1) huruf b Undang-Undang Pajak Pertambahan Nilai dikalikan dengan Harga - 22 - Jual, untuk penyerahan Emas Perhiasan hasil produksi sendiri kepada: 1. Pabrikan Emas Perhiasan lainnya; dan/atau 2. Pedagang Emas Perhiasan"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
