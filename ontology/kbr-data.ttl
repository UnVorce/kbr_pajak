    kbr:hasRuleId "R-UU-1985-12-77484b4c1c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Pajak yang terhutang berdasarkan Surat Ketetapan Pajak sebagaimana dimaksud dalam Pasal 10 ayat (3) dan ayat (4) harus dilunasi selambat-lambatnya 1 (satu) bulan sejak tanggal diterimanya Surat Ketetapan Pajak oleh wajib pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_7a20655c5f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_15 ;
    kbr:hasRuleId "R-UU-1985-12-7a20655c5f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "(1) Wajib pajak dapat mengajukan keberatan pada Direktur Jenderal Pajak atas: a. Surat Pemberitahuan Pajak Terhutang; b. Surat Ketetapan Pajak. (2) Keberatan diajukan secara tertulis dalam bahasa Indonesia dengan menyatakan alasan secara jelas. (3) Keberatan harus diajukan dalam jangka waktu 3 (tiga) bulan sejak tanggal diterimanya surat sebagaina dimaksud dalam ayat (1) oleh wajib pajak, kecuali apabila wajib pajak dapat menunjukkan bahwa jangka waktu itu tidak dapat dipenuhi karena keadaan di luar kekuasaannya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_7a9f4f2fda a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_16 ;
    kbr:hasRuleId "R-UU-1985-12-7a9f4f2fda"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "(5) Apabila jangka waktu sebagaimana dimaksud dalam ayat (1) telah lewat dan Direktur Jenderal Pajak tidak memberikan suatu keputusan, maka keberatan yang diajukan tersebut dianggap diterima."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_7c64d17fea a kbr:AturanTarif ;
