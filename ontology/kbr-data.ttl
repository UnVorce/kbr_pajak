    kbr:hasSourceLocator "PMK-2023-96#BT/61/1..7"^^xsd:string ;
    kbr:hasSourceQuote "Barang Kiriman yang telah diberitahukan untuk diekspor dan telah mendapatkan persetujuan ekspor dapat dibatalkan ekspornya, kecuali Barang Kiriman ekspor ditegah oleh unit pengawasan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_8f3aca81a6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_28 ;
    kbr:hasRuleId "R-PMK-2023-96-8f3aca81a6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penetapan tarif sebagaimana dimaksud pada ayat (1) mengakibatkan kekurangan pembayaran bea masuk, Importir wajib melunasi bea masuk yang kurang dibayar sesuai dengan penetapan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_8fbc1dad86 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_59 ;
    kbr:hasRuleId "R-PMK-2023-96-8fbc1dad86"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/59"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal jangka waktu sebagaimana dimaksud dalam Pasal 58 ayat (2), ayat (3), dan ayat (4) telah terlewati, Penyelenggara Pos berdasarkan surat kuasa dari Eksportir dapat mengajukan permohonan perubahan atas kesalahan data CN dan/atau pemberitahuan konsolidasi barang kiriman (PKBK) kepada Kepala Kantor Pabean pemuatan ekspor melalui SKP."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_9074a35844 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
