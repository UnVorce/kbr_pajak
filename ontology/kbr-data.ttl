    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_3b7decf290 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_62 ;
    kbr:hasRuleId "R-UU-1995-10-3b7decf290"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/62"^^xsd:string ;
    kbr:hasSourceQuote "Tindakan penangguhan pengeluaran barang impor atau ekspor dapat pula dilakukan karena jabatan oleh Pejabat Bea dan Cukai apabila terdapat bukti yang cukup bahwa barang tersebut merupakan atau berasal dari hasil pelanggaran merek atau hak cipta."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_3d18b24411 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_13 ;
    kbr:hasRuleId "R-UU-1995-10-3d18b24411"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(1) Bea masuk dapat dikenakan berdasarkan tarif yang besarnya berbeda dengan yang dimaksud dalam Pasal 12 ayat (1) terhadap: a. barang . . . a. barang impor yang dikenakan tarif bea masuk berdasarkan perjanjian atau kesepakatan internasional; atau b. barang impor bawaan penumpang, awak sarana pengangkut, pelintas batas, atau barang kiriman melalui pos atau jasa titipan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_3da0cf6c7b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_27 ;
    kbr:hasRuleId "R-UU-1995-10-3da0cf6c7b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "b. impor barang sebagaimana dimaksud dalam Pasal 25 dan Pasal 26;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_3df2503dd2 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_110 ;
    kbr:hasRuleId "R-UU-1995-10-3df2503dd2"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/110"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pidana denda tidak dibayar oleh terpidana, sebagai gantinya diambil dari kekayaan dan/atau pendapatan terpidana."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_3e31f8d118 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_91 ;
    kbr:hasRuleId "R-UU-1995-10-3e31f8d118"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "Pengangkut atas permintaan Pejabat Bea dan Cukai wajib menunjukkan semua dokumen pengangkutan serta Pemberitahuan Pabean yang diwajibkan menurut Undang-undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_3f9506fd12 a kbr:Kewajiban ;
