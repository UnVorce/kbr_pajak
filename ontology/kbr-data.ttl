    kbr:hasRuleId "R-PP-2022-50-7cb086333d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/68"^^xsd:string ;
    kbr:hasSourceQuote "Menteri yang menyelenggarakan urusan pemerintahan dalam negeri memberikan Data Kependudukan dan Data Balikan dari Pengguna pada basis Data Kependudr.lkan kepada Menteri untuk diintegrasikan dengan basis data perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

