    kbr:hasSourceQuote "(1) Penentuan natura dan/atau kenikmatan dengan jenis dan/atau batasan tertentu sebagaimana dimaksud dalam Pasal 4 huruf e didasarkan pada: a . jenis natura dan batasan tertentu dart natura berupa kriteria penerima dan/a tau nilai dart natura; dan b . jenis kenikmatan dan batasan tertentu dart kenikmatan berupa kriteria penerima, nilai, dan/atau fungsi dart kenikmatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

