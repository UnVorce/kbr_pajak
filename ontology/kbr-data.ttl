    kbr:hasSourceQuote "( 1) Penghasilan Anggota se bagaimana dimaksud dalam Pasal 8 ayat (4) dan Pasal 9 ayat (4) tidak dipotong dan/ atau dipungut Pajak Penghasilan oleh KSO."^^xsd:string ;
