kbr:Aturan_R_PMK_2023_172_b51dc33218 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_1_p1 ;
    kbr:hasRuleId "R-PMK-2023-172-b51dc33218"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Peraturan Menteri ini yang dimaksud dengan: 1. Undang-Undang tentang Pajak Penghasilan adalah Undang-Undang Nomor 7 Tahun 1983 tentang Pajak Penghasilan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 7 Tahun 2021 tentang Harmonisasi Peraturan Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2023_172_b580f458a3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_37 ;
    kbr:hasRuleId "R-PMK-2023-172-b580f458a3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "(5) Penambahan dan/ a tau pengembalian kas atau setara kas sebesar selisih sebagaimana ayat (4) huruf a dilakukan sebelum terbitnya surat ketetapan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
