    kbr:hasSourceQuote "c) 0,3% (nol koma tiga persen) dari penjualan tidak termasuk Pajak Pertambahan Nilai untuk penjualan kepada pihak selain se bagaimana dimaksud dalam huruf a) dan huruf b);"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

