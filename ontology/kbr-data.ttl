    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_57_2__5 ;
    kbr:hasRuleId "R-PMK-2023-172-ef2fe46006"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/57/2..5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal pemberitahuan permohonan Kesepakatan Harga Transfer Bilateral atau Multilateral kepada Pejabat Berwenang Mitra Persetujuan Penghindaran Pajak Berganda tidak mendapatkan jawaban tertulis dalam jangka waktu 8 (delapan) bulan sejak tanggal pemberitahuan tertulis sebagaimana dimaksud pada ayat (2), Direktur Jenderal Pajak menerbitkan pemberitahuan tertulis penghentian proses Kesepakatan Harga Transfer kepada: a. Wajib Pajak yang menyampaikan permohonan Kesepakatan Harga Transfer; dan - 63 - b. Pejabat Berwenang Mitra Persetujuan Penghindaran Pajak Berganda."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
