    kbr:hasSourceQuote "Pembaruan Sistem Administrasi Perpajakan di bidang organisasi sebagaimana dimaksud dalam Pasal 2 ayat (2) huruf a dilaksanakan untuk mewujudkan Direlrtorat Jendera.l Pajak yang paling sesuai dengan memperhatikan cakupan geografis, karakteristik organisasi, ekonomi, kearifan loka1, potensi penerimaan dan rentang kendali yang memadai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

