    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/6/7..10"^^xsd:string ;
    kbr:hasSourceQuote "Dasar pengenaan PKB untuk selain Kendaraan Bermotor baru ditetapkan dengan Peraturan Gubernur, berpedoman pada peraturan menteri yang menyelenggarakan urusan pemerintahan dalam negeri dengan memperhatikan penyusutan dan/atau penyesuaian NJKB dan bobot sebagaimana dimaksud pada ayat (1) huruf b."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

