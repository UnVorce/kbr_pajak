kbr:Aturan_R_PMK_2020_237_cc430f7e71 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2020_237 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_237_BT_44_7__10 ;
    kbr:hasRuleId "R-PMK-2020-237-cc430f7e71"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-237#BT/44/7..10"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal barang yang ditimbun oleh Pelaku Usaha Pusat Logistik melewati jangka waktu timbun sebagaimana dimaksud pada ayat (6) dan ayat (7), barang tersebut hams: a. diekspor kembali dengan memenuhi ketentuan peraturan perundang-undangan di bidang ekspor; b. dikeluarkan ke Pelaku Usaha Pengolahan di KEK, TPB, dan/ atau Kawasan Bebas; atau c. dikeluarkan ke TLDDP dengan dilunasi bea masuk, cukai, dan/atau PDRI serta memenuhi ketentuan peraturan perundang-undangan pengeluaran barang dart Pelaku Logistik ke TLDDP."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

