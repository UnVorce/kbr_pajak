    kbr:hasSourceQuote "Walikota atas permohonan Wajib Pajak atau karena jabatannya dapat membatalkan SPPT, SKPD/SKPDKB/SKPDKBT dan/atau STPD yang berdasarkan peraturan perundang-undangan dibidang perpajakan yang seharusnya tidak diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

