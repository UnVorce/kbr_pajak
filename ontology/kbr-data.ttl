    kbr:hasSourceQuote "Perolehan Hak atas Tanah dan/atau Bangunan adalah perbuatan atau peristiwa hukum yang mengakibatkan diperolehnya hak atas tanah dan/ atau Bangunan oleh orang pribadi atau Badan."^^xsd:string ;
