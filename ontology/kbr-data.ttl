    kbr:hasRuleId "R-PMK-2025-37-df4d64485b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-37#BT/6/7..10"^^xsd:string ;
    kbr:hasSourceQuote "Pedagang Dalam Negeri sebagaimana dimaksud pada ayat (1) bertanggung jawab atas kebenaran informasi yang harus disampaikan sebagaimana dimaksud pada ayat (1), ayat (2), ayat (3), dan/atau ayat (6)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2025_37_eb74271057 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2025_37 ;
