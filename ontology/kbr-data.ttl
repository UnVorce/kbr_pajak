    kbr:hasRuleId "R-PMK-2019-35-636622a5d7"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-35#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Orang Pribadi Asing atau Badan Asing tidak dapat dianggap mempunyai bentuk usaha tetap di Indonesia apabila Orang Pribadi Asing atau Badan Asing tersebut dalam menjalankan usaha atau melakukan kegiatan di Indonesia menggunakan agen, broker atau perantara yang mempunyai kedudukan bebas, asalkan agen, broker atau perantara tersebut dalam kenyataannya bertindak sepenuhnya dalam rangka menjalankan perusahaannya"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2019_35_649a8f8bb4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_35 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_35_BT_9 ;
    kbr:hasRuleId "R-PMK-2019-35-649a8f8bb4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-35#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal agen yang berkedudukan tidak bebas hanya melakukan kegiatan yang bersifat persiapan (preparatory) atau penunjang (auxiliary) se bagaimana dimaksud dalam Pasal 6 ayat ( 1) maka agen yang berkedudukan tidak bebas tersebut bukan merupakan bentuk usaha tetap sebagaimana dimaksud dalam Pasal 4 ayat (2) huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2019_35_684573be47 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_35 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_35_BT_4 ;
    kbr:hasRuleId "R-PMK-2019-35-684573be47"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-35#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "(2) Bentuk usaha sebagai berikut merupakan bentuk usaha tetap meskipun tidak memenuhi kriteria sebagaimana a. proyek konstruksi, instalasi, atau proyek perakitan; b. pemberian jasa dalam bentuk apa pun oleh pegawai c. orang atau badan yang bertindak selaku agen yang d. agen atau pegawai dari perusahaan asurans1 yang"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

