    kbr:hasSourceLocator "PMK-2025-15#BT/19/3..7"^^xsd:string ;
    kbr:hasSourceQuote "(3) Surat permohonan pembahasan dengan Tim Quality Assurance Pemeriksaan sebagaimana dimaksud pada ayat (2) harus disampaikan dalam jangka waktu paling lama 3 (tiga) hari kerja terhitung sejak penandatanganan risalah pembahasan sebagaimana dimaksud dalam Pasal 18 ayat (7) dan ditembuskan kepada pejabat pada Unit Pelaksana Pemeriksaan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_f600081346 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_1_p4 ;
    kbr:hasRuleId "R-PMK-2025-15-f600081346"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/1#p4"^^xsd:string ;
    kbr:hasSourceQuote "Surat Ketetapan Pajak adalah surat ketetapan yang meliputi surat ketetapan pajak kurang bayar, surat ketetapan pajak kurang bayar tambahan, surat ketetapan pajak nihil, atau surat ketetapan pajak lebih bayar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_f60b33cb46 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
