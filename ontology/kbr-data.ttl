    kbr:hasSourceQuote "Wajib Pajak yang karena kealpaannya mengisi SPTPD dengan tidak benar atau tidak lengkap atau melampirkan keterangan yang tidak benar atau tidak menyampaikan, sehingga merugikan Keuangan Daerah, diancam dengan pidana sesuai ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

