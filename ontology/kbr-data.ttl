    kbr:hasSourceQuote "(4) Apabila dalam jangka waktu sebagaimana dimaksud pada ayat (2) Menteri tidak memberikan keputusan, permohonan yang bersangkutan dianggap diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_163da2eff7 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
