    kbr:hasSourceLocator "PP-2010-94#BT/24"^^xsd:string ;
    kbr:hasSourceQuote "(1) Persetujuan Penghindaran Pajak Berganda hanya berlaku bagi orang pribadi atau badan yang merupakan Subjek Pajak: a. dalam negeri dari Indonesia; dan/atau b. dari negara mitra persetujuan penghindaran pajak berganda, yang dibuktikan dengan Surat Keterangan Domisili."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
