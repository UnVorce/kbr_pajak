    kbr:hasRuleId "R-PMK-2019-186-e613590413"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/24"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal tidak terdapat harga jual rata-rata batuan sebagaimana dimaksud dalam Pasal22 ayat (4), hargajual batuan menggunakan Harga Patokan Batuan rata-rata dalam tahun terakhir sebelum Tahun Pajak PBB terutang."^^xsd:string ;
