kbr:Aturan_R_UU_2020_10_2462af42e0 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2020_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2020_10_BT_17 ;
