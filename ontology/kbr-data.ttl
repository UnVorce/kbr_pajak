kbr:Aturan_R_PMK_2023_61_002c8a70fc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_83_4__8 ;
    kbr:hasRuleId "R-PMK-2023-61-002c8a70fc"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/83/4..8"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pemberian Bantuan Penagihan Pajak sebagaimana dimaksud pada ayat (3) huruf e berupa pemberitahuan Surat Paksa, Penyitaan, penjualan Barang sitaan, Pencegahan, dan/atau Penyanderaan, Negara Mitra atau Yurisdiksi Mitra harus melampirkan dokumen yang dapat dipersamakan dengan berita acara pemberitahuan Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_0033317931 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_1_p1 ;
    kbr:hasRuleId "R-PMK-2023-61-0033317931"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "5. Penanggung Pajak adalah orang pribadi atau Badan yang bertanggung jawab atas pembayaran Pajak, termasuk wakil yang menjalankan hak dan memenuhi kewajiban Wajib Pajak sesuai dengan ketentuan peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_006c73df6a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_75 ;
    kbr:hasRuleId "R-PMK-2023-61-006c73df6a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "(2) Kepala tempat Penyanderaan segera memberitahukan kepada Pejabat dan keluarga dari Penanggung Pajak yang disandera disertai berita acara kematian."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_0083ad4786 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_1_p3 ;
    kbr:hasRuleId "R-PMK-2023-61-0083ad4786"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Nilai Klaim Pajak adalah nilai uang yang dimintakan Bantuan Penagihan Pajak oleh Negara Mitra atau Yurisdiksi Mitra yang memuat antara lain nilai pokok Pajak yang masih harus dibayar, sanksi administrasi, dan biaya penagihan yang dikenakan oleh Negara Mitra atau Yurisdiksi Mitra."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_009abf90a2 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_67_1__8 ;
    kbr:hasRuleId "R-PMK-2023-61-009abf90a2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/67/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Penanggung Pajak yang disandera menolak menandatangani berita acara pelaksanaan Penyanderaan sebagaimana dimaksud pada ayat (7) huruf a, Jurusita Pajak mencatat dalam berita acara yang menyatakan penolakan penandatangan berita acara pelaksanaan Penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_00d0dd0cde a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_77 ;
    kbr:hasRuleId "R-PMK-2023-61-00d0dd0cde"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "(5) Berdasarkan permohonan sebagaimana dimaksud pada ayat (1), Pejabat yang menerbitkan surat perintah Penyanderaan, melaksanakan: a. rehabilitasi nama baik Penanggung Pajak; dan b. pemberian ganti rugi kepada Penanggung Pajak, paling lambat 30 (tiga puluh) Hari sejak diterimanya permohonan secara lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_016495e289 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_113_5 ;
    kbr:hasRuleId "R-PMK-2023-61-016495e289"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/113/5"^^xsd:string ;
    kbr:hasSourceQuote "b. Pasal  74 ayat (3) sampai dengan ayat (7) berlaku secara mutatis mutandis terhadap pelepasan sandera dalam hal Penanggung Pajak atas Klaim Pajak memenuhi persyaratan sebagaimana dimaksud pada ayat (2)"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

