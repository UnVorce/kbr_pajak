    kbr:diaturDalam kbr:Reg_PMK_2019_35 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_35_BT_4 ;
    kbr:hasRuleId "R-PMK-2019-35-a71edd519a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-35#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "(3) Pengertian usaha atau kegiatan sebagaimana dimaksud pada ayat (1) mencakup segala hal yang dilakukan untuk mendapatkan, menagih, atau memelihara penghasilan. berupa: d. gedung kantor; e. pabrik; f. bengkel; g. gudang; kehutanan; dan melalui internet."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

