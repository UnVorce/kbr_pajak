    kbr:hasSourceLocator "PMK-2023-61#BT/52/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Setelah menyampaikan permintaan pencabutan blokir sebagaimana dimaksud pada ayat (3), Pejabat melakukan penjualan surat berharga milik Penanggung Pajak di bursa efek sesuai dengan ketentuan peraturan perundang- undangan di bidang pasar modal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

