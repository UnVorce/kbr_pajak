kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_59fb2dbe45 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_88 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-59fb2dbe45"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/88"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pemungutan Pajak dan Retribusi dilaksanakan sesuai dengan ketentuan umum dan tata cara pemungutan Pajak dan Retribusi. (2) Ketentuan umum dan tata cara pemungutan Pajak dan Retribusi sebagaimana dimaksud pada ayat (1) meliputi pengaturan mengenai: a. pendaftaran dan pendataan; b. penetapan besaran Pajak dan Retribusi terutang; c. pembayaran dan penyetoran; d. pelaporan; e. pengurangan, pembetulan, dan pembatalan ketetapan; f. pemeriksaan Pajak; g. penagihan Pajak dan Retribusi; h. keberatan; i. gugatan; j. penghapusan piutang Pajak dan Retribusi oleh Kepala Daerah; dan k. pengaturan lain yang berkaitan dengan tata cara pemungutan Pajak dan Retribusi. (3) Ketentuan umum dan tata cara pemungutan Pajak dan Retribusi sebagaimana dimaksud pada ayat (2) diatur dengan Peraturan Wali Kota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_5a66face57 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
