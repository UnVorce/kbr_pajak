    kbr:hasSourceQuote "(4) Kegiatan audit perpajakan dan pemeriksaan sewaktu- waktu sebagaimana dimaksud pada ayat (1) huruf c dan huruf d dilakukan dengan menguji tingkat kepatuhan Badan Usaha dan/atau Pelaku Usaha di KEK terhadap peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
