kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_eb3d50a6cd a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_168 ;
