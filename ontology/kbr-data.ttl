    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_11_3__5 ;
    kbr:hasRuleId "R-PMK-2020-130-6d61180f4f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/11/3..5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Pemberian fasilitas pengurangan Pajak Penghasilan yang dilaksanakan oleh Kepala Badan Koordinasi Penanaman Modal sebagaimana dimaksud pada ayat (1) dilaporkan per triwulan."^^xsd:string ;
