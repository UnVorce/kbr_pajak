    kbr:diaturDalamPasal kbr:Pasal_PP_2021_41_BT_42 ;
    kbr:hasRuleId "R-PP-2021-41-9db68e3cee"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "pengusaha sebagaimana dimaksud pada ayat (1) wajib menyerahkan laporan keuangan, buku, catatan, dan dokumen yang menjadi bukti dasar pembukuan, surat yang berkaitan dengan kegiatan usaha termasuk data elektronik, serta surat yang berkaitan dengan kegiatan di bidang kepabeanan untuk kepentingan audit kepabeanan dan/atau kegiatan di bidang cukai untuk kepentingan audit cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

