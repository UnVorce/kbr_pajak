    kbr:hasSourceLocator "PMK-2023-72#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal di kemudian hari terdapat data dan/atau informasi yang berbeda dengan kenyataan di lapangan terhadap keputusan persetujuan atas: a. saat mulainya penyusutan; atau b. persetujuan penundaan pembebanan kerugian atas pengalihan atau penarikan harta yang mendapatkan penggantian asuransi untuk dibukukan sebagai beban masa kemudian, Kepala Kantor Pelayanan Pajak menerbitkan keputusan yang membetulkan keputusan sebelumnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

