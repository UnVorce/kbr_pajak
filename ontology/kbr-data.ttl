    kbr:hasSourceQuote "Permohonan sebagaimana dimaksud pada ayat (4) dan ayat (7) disusun dengan menggunakan contoh format sebagaimana tercantum dalam Lampiran Huruf C yang merupakan bagian tidak terpisahkan dari Peraturan Menteri ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
