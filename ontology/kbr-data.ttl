    kbr:hasSourceQuote "a. menerbitkan SKB PPnBM yang berlaku untuk setiap impor atau penyerahan, dalam hal permohonan Wajib Pajak telah dilengkapi informasi sebagaimana dimaksud dalam Pasal  6 ayat (2), dokumen yang sesuai dengan kegiatan usaha sebagaimana dimaksud dalam Pasal 6 ayat (4), dan memenuhi ketentuan sebagaimana dimaksud dalam Pasal 6 ayat (5)"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

