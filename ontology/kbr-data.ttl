    kbr:hasRuleId "R-PMK-2023-172-33c9bd61ad"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/2/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Keadaan ketergantungan atau keterikatan antara satu pihak dan pihak lainnya sebagaimana dimaksud pada ayat (2) merupakan keadaan satu atau lebih pihak: a. mengendalikan pihak yang lain; atau b. tidak berdiri bebas, dalam menjalankan usaha atau melakukan kegiatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

