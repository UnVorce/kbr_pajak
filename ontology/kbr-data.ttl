kbr:Aturan_R_PMK_2019_186_521cd95580 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_22_1__6 ;
    kbr:hasRuleId "R-PMK-2019-186-521cd95580"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/22/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Hasil produksi mineral atau batubara sebagaimana dimaksud pada ayat (2) merupakan jumlah mineral atau batubara yang dihasilkan dalam tahun terakhir sebelum Tahun Pajak PBB terutang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_524c9e4a46 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_31 ;
    kbr:hasRuleId "R-PMK-2019-186-524c9e4a46"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal harga jual mineral atau batubara sebagaimana dimaksud dalam Pasal 22 ayat (4) menggunakan satuan mata uang selain mata uang Rupiah, harga jual mineral atau batubara harus dikonversi dalam satuan mata uang Rupiah berdasarkan kurs mata uang pada tanggal 1 Januari Tahun Pajak PBB terutang sebagaimana ditetapkan dalam Keputusan Menteri Keuangan mengenai penetapan nilai kurs pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_5654165c81 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_16 ;
    kbr:hasRuleId "R-PMK-2019-186-5654165c81"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pendapatan bersih hasil hutan sebagaimana dimaksud dalam Pasal 15 ayat (2) huruf a merupakan pendapatan kotor hasil hutan dikurangi Biaya Produksi Perhutanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_567bdc0173 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_34 ;
    kbr:hasRuleId "R-PMK-2019-186-567bdc0173"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pendapatan bersih sebagaimana dimaksud dalam Pasal 33 ayat (1) dan ayat (2) ditentukan sebesar pendapatan kotor dikurangi biaya produksi, dalam tahun terakhir sebelum Tahun Pajak PBB terutang. (2) Pendapatan kotor sebagaimana dimaksud pada ayat (1) merupakan hasil perkalian jumlah produksi per jenis ikan dalam tahun terakhir sebelum Tahun Pajak PBB terutang dengan hargajual rata-rata per jenis ikan per satuan berat tertentu. (3) Biaya produksi sebagaimana dimaksud pada ayat (1) merupakan hasil perkalian pendapatan kotor sebagaimana dimaksud pada ayat (2) dengan Rasia Biaya Produksi. (4) Jenis ikan sebagaimana dimaksud pada ayat (2) mengacu pada ketentuan yang diatur oleh kementerian yang DISTRIBUSI II -42- menyelenggarakan urusan pemerintahan di bidang kelautan dan perikanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_5682b7a096 a kbr:Definisi ;
