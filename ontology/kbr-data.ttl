    kbr:hasSourceLocator "PMK-2024-81#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "Surat Pemberitahuan Pajak Terutang dan/ atau Surat Ketetapan Pajak Pajak Bumi dan Bangunan sebagaimana dimaksud pada ayat (1) dan ayat (2) diterbitkan dalam jangka waktu paling lama 5 (lima) tahun setelah saat berakhirnya Tahun Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
