kbr:Aturan_R_PMK_2024_81_41a4713e20 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_437_1__3 ;
    kbr:hasRuleId "R-PMK-2024-81-41a4713e20"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/437/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Untuk mendapatkan tambahan pengurangan Penghasilan Bruto sebagaimana dimaksud dalam Pasal 432 ayat (2) huruf b, Wajib Pajak harus mengajukan permohonan melalui Sistem Online Single Submission dengan: a. mengunggah proposal kegiatan Penelitian dan Pengembangan; dan b. memenuhi persyaratan untuk diberikan Surat Keterangan Fiskal sesuai dengan ketentuan yang mengatur mengenai tata cara pemberian Surat Keterangan Fiskal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

