    kbr:hasSourceQuote "Dalam hal permohonan Kesepakatan Harga Transfer diajukan oleh Wajib Pajak yang usahanya terdampak negatif bencana nasional yang ditetapkan oleh Pemerintah Pusat, tingkat laba dalam proyeksi laporan keuangan sebagaimana dimaksud pada ayat (4) merupakan tingkat laba hasil penyesuaian pada kondisi normal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

