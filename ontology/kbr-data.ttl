    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_111_e277476f32 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2025_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_111_BT_15 ;
