    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-56f0fb481d"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/71"^^xsd:string ;
    kbr:hasSourceQuote "Prinsip dan sasaran dalam penetapan tarif retribusi ditetapkan dengan memperhatikan biaya penyediaan jasa yang bersangkutan, kemampuan masyarakat, aspek keadilan dan efektivitas pengendalian atas pelayanan tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_5709d3beb9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_22 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-5709d3beb9"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jasa Perhotelan sebagaimana dimaksud dalam Pasal 19 huruf c meliputi jasa penyediaan akomodasi dan fasilitas penunjangnya, serta penyewaan ruang rapat/pertemuan pada penyedia jasa perhotelan seperti: a. hotel; b. hostel; c. vila; d. pondok wisata; e. motel; f. losmen; g. wisma pariwisata; h. pesanggrahan; i. rumah penginapan / guest house / bungalow / resort / cottage; j. tempat tinggal pribadi yang difungsikan sebagai hotel; dan k. glamping. (2) Dikecualikan dari Jasa Perhotelan sebagaimana dimaksud pada ayat (1) meliputi: a. jasa tempat tinggal asrama yang diselenggarakan oleh Pemerintah atau Pemerintah Daerah; b. jasa tempat tinggal di rumah sakit, asrama perawat, panti jompo, panti asuhan, dan panti sosial lainnya yang sejenis; c. jasa tempat tinggal di pusat pendidikan atau kegiatan keagamaan; d. jasa biro perjalanan atau perjalanan wisata; dan e. jasa persewaan ruangan untuk diusahakan di hotel."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_575d46e8bc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_66 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-575d46e8bc"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "(2) Selain dihitung berdasarkan jenis kendaraan dan frekuensi pemanfaatan sebagaimana dimaksud pada ayat (1), tingkat penggunaan jasa parkir di Tepi Jalan Umum pada lokasi tertentu dikenakan tarif berdasarkan zona."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_578a6d7828 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_36 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-578a6d7828"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "Masa Pajak Reklame insidentil dan Reklame yang bersifat khusus ditetapkan berdasarkan jangka waktu lamanya penyelenggaraan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_58eb59b5db a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_3 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-58eb59b5db"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jenis Pajak sebagaimana dimaksud dalam Pasal 2 yang dipungut berdasarkan penetapan Walikota terdiri atas : a. PBB-P2; b. Pajak Reklame; c. PAT; d. Opsen PKB; dan e. Opsen BBNKB."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_593ff7db83 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_34 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-593ff7db83"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Besaran pokok Pajak Reklame yang terutang dihitung dengan cara mengalikan dasar pengenaan Pajak Reklame sebagaimana dimaksud dalam Pasal 32 ayat (1) dengan tarif Pajak Reklame sebagaimana dimaksud dalam Pasal 33."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_59d6adf96a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_1_p4 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-59d6adf96a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/1#p4"^^xsd:string ;
    kbr:hasSourceQuote "Surat Ketetapan Pajak Daerah yang selanjutnya disingkat SKPD adalah surat ketetapan pajak yang menentukan besarnya jumlah pokok pajak yang terutang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_59f9fd91eb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_1_p2 ;
