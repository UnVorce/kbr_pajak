    kbr:hasSourceQuote "Ketentuan sebagaimana dimaksud dalam ayat (1) tidak berlaku terhadap orang pribadi Subjek Pajak dalam negeri yang seluruh penghasilannya dalam 1 (satu) tahun pajak termasuk bunga dan diskonto tidak melebihi Penghasilan Tidak Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

