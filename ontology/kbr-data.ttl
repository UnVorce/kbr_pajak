    kbr:hasSourceLocator "PP-2010-79#BT/25/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Atas penghasilan kena pajak sebagaimana dimaksud pada ayat (1) setelah dikurangi pajak penghasilan sebagaimana dimaksud pada ayat (3) atau ayat (4), terutang pajak penghasilan sesuai ketentuan peraturan perundang- undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
