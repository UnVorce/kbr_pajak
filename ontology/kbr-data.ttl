    kbr:hasSourceLocator "PMK-2024-81#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal jangka waktu 30 (tiga puluh) hari sebagaimana dimaksud dalam Pasal 81 ayat (1) tidak dapat dipenuhi, Wajib Pajak dapat menyampaikan surat pemberitahuan penundaan penyampaian Surat Pemberitahuan Objek Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
