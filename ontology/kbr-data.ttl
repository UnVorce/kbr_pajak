    kbr:hasSourceLocator "PMK-2020-237#BT/46/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Badan Usaha atau Pelaku Usaha di KEK, atau importir atau eksportir di dalam Daerah Pabean sebagaimana dimaksud dalam Pasal 44 ayat (10) huruf a dan huruf c, Badan Usaha atau Pelaku Usaha di KEK atau importir atau eksportir di dalam Daerah Pabean wajib: a) melunasi bea masuk, cukai, dan/atau PDRI, dan/atau b) memungut Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah sebagaimana dimaksud dalam Pasal 24 ayat (1)"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

