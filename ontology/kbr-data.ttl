    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_261 ;
    kbr:hasRuleId "R-PMK-2024-81-be3e748f62"^^xsd:string ;
