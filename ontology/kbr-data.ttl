kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_ad3cd8bb24 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
