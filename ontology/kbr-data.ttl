    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Penyerahan Kendaraan Bermotor adalah pengalihan hak milik Kendaraan Bermotor sebagai akibat perjanjian dua pihak atau perbuatan sepihak atau keadaan yang terjadi karena jual beli, tukar menukar, hibah termasuk hibah wasiat dan hadiah, warisan, atau pemasukan ke dalam Badan usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

