    kbr:hasSourceQuote "a. 50% (lima puluh persen) dari Pajak Penghasilan badan terutang selama 2 (dua) tahun pajak berikutnya untuk nilai penanaman modal baru sebagaimana dimaksud pada ayat (3) huruf a;"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
