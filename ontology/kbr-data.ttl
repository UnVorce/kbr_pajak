kbr:Aturan_R_PMK_2025_111_e1db0ae6ea a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2025_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_111_BT_16_7__12 ;
    kbr:hasRuleId "R-PMK-2025-111-e1db0ae6ea"^^xsd:string ;
