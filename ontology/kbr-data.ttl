    kbr:hasRuleId "R-PMK-2024-81-7f7fc9c9d9"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/326"^^xsd:string ;
    kbr:hasSourceQuote "Kolom Nomor Objek Pajak pada Surat Setoran Pajak atau sarana administrasi lain sebagaimana dimaksud pada ayat (1) diisi dengan nomor objek pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
