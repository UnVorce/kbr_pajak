    kbr:hasSourceQuote "NJOP bumi sebagaimana dimaksud dalam Pasal 11 untuk Permukaan Bumi Onshore sebagaimana dimaksud pada ayat (1) merupakan penjumlahan NJOP bumi untuk Areal Belum Produktif Pertambangan untuk Pengusahaan Panas Bumi, Areal Produktif Pertambangan untuk Pengusahaan Panas Bumi, Areal Tidak Produktif Pertambangan untuk Pengusahaan Panas Bumi, Areal Pengaman Pertambangan untuk Pengusahaan Panas Bumi, dan Areal Emplasemen Pertambangan untuk Pengusahaan Panas Bumi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_cb0753e979 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_6_2__6 ;
    kbr:hasRuleId "R-PMK-2019-186-cb0753e979"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2019-186#BT/6/2..6"^^xsd:string ;
    kbr:hasSourceQuote "Permukaan Bumi Onshore dan/ atau Permukaan Bumi Offshore sebagaimana dimaksud pada ayat (1) huruf a dan huruf b meliputi areal permukaan bumi di dalam kawasan sebagaimana dimaksud pada ayat (2), yang telah dimiliki oleh Subjek Pajak atau Wajib Pajak dengan suatu hak atas tanah dan/ a tau diperoleh manfaatnya oleh Subjek Pajak atau Wajib Pajak dan digunakan untuk pengusahaan panas bumi termasuk fasilitas dan penunjangnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

