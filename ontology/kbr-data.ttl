    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/54"^^xsd:string ;
    kbr:hasSourceQuote "Tingkat penggunaan jasa atas pelayanan Jasa Umum dalam pelayanan kesehatan sebagaimana dimaksud pada ayat (1) diukur berdasarkan jenis layanan, frekuensi layanan, dan/atau jangka waktu layanan, yang meliputi jasa penyediaan sarana, jasa pelayanan medik, jasa pelayanan non medik, pemakaian bahan dan penyediaan prasarana."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

