    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_69_1__6 ;
    kbr:hasRuleId "R-PP-2022-50-4536f0cac3"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/69/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak pemungut Pajak Karbon sebagaimana dimaksud pada ayat (1) wajib menyampaikan Surat Pemberitahuan Masa untuk melaporkan penghitungan dan/atau pembayaran Pajak Karbon."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_467bcbba2e a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_61 ;
    kbr:hasRuleId "R-PP-2022-50-467bcbba2e"^^xsd:string ;
