kbr:Aturan_R_UU_1983_8_4d5d19a838 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_16A ;
    kbr:hasRuleId "R-UU-1983-8-4d5d19a838"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/16A"^^xsd:string ;
    kbr:hasSourceQuote "(2) Tata cara pemungutan, penyetoran, dan pelaporan pajak oleh Pemungut Pajak Pertambahan Nilai sebagaimana dimaksud dalam ayat (1), diatur dengan Keputusan Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_53ca653965 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_6__6d ;
    kbr:hasRuleId "R-UU-1983-8-53ca653965"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/6..6d"^^xsd:string ;
    kbr:hasSourceQuote "a. penyerahan yang terutang pajak dan Pajak Masukan yang berkenaan dengan penyerahannya dapat dikreditkan; dan b. penyerahan yang terutang pajak dan Pajak Masukan yang berkenaan dengan penyerahannya tidak dapat dikreditkan dan/atau penyerahan yang tidak terutang pajak, sedangkan Pajak Masukan sehubungan dengan penyerahan yang terutang pajak sebagaimana dimaksud dalam huruf a tidak dapat diketahui dengan pasti, jumlah Pajak Masukan yang dapat dikreditkan dihitung dengan menggunakan pedoman pengkreditan Pajak Masukan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_5890a2a8a5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1983-8-5890a2a8a5"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Penyerahan Barang Kena Pajak adalah setiap kegiatan penyerahan Barang Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_594af60ab3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_1_p2 ;
    kbr:hasRuleId "R-UU-1983-8-594af60ab3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "21. Pembeli adalah orang pribadi atau badan yang menerima atau seharusnya menerima penyerahan Barang Kena Pajak dan yang membayar atau seharusnya membayar harga Barang Kena Pajak tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_5d516a6574 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_16F ;
    kbr:hasRuleId "R-UU-1983-8-5d516a6574"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/16F"^^xsd:string ;
    kbr:hasSourceQuote "Pembeli Barang Kena Pajak atau penerima Jasa Kena Pajak bertanggung jawab secara renteng atas pembayaran pajak, sepanjang tidak dapat menunjukkan bukti bahwa pajak telah dibayar"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_5dc5ae87b6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_13 ;
    kbr:hasRuleId "R-UU-1983-8-5dc5ae87b6"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/13"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal tedadi pengalihan Barang Kena Pajak dalam rangka penggabungan, peleburan, pemekaran, pemecahan, dan pengambilalihan usaha, Pajak Masukan atas Barang Kena Pajak yang dialihkan yang belum dikreditkan oleh Pengusaha Kena Pajak yang mengalihkan dapat dikreditkan oleh Pengusaha Kena Pajak yang menerima pengalihan sepanjang Faktur Pajaknya diterima setelah terjadinya pengalihan dan Pajak Masukan tersebut belum dibebankan sebagai biaya atau dikapitalisasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_5dd6781f5f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_1__4a ;
    kbr:hasRuleId "R-UU-1983-8-5dd6781f5f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/1..4a"^^xsd:string ;
    kbr:hasSourceQuote "Bagi Pengusaha Kena Pajak yang belum melakukan penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak dan/atau ekspor Barang Kena Pajak dan/atau Jasa Kena Pajak, Pajak Masukan atas perolehan Barang Kena Pajak dan/atau Jasa Kena Pajak, impor Barang Kena Pajak, serta pemanfaatan Barang Kena Pajak Tidak Berwujud dan/atau pemanfaatan Jasa Kena Pajak dari luar Daerah Pabean di dalam Daerah Pabean dapat dikreditkan sepanjang memenuhi ketentuan pengkreditan sesuai dengan Undang- Undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_5ff316f6a4 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_8__10 ;
    kbr:hasRuleId "R-UU-1983-8-5ff316f6a4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/8..10"^^xsd:string ;
    kbr:hasSourceQuote "(8) Pengkreditan Pajak Masukan sebagaimana dimaksud pada ayat (2) tidak dapat diberlakukan bagi pengeluaran untuk: a. dihapus; b. perolehan Barang Kena Pajak atau Jasa Kena Pajak yang tidak mempunyai hubungan langsung dengan kegiatan usaha; c. dihapus... c. dihapus; d. dihapus; e. dihapus; f. perolehan Barang Kena Pajak atau Jasa Kena Pajak yang Faktur Pajaknya tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 13 ayat (5) atau ayat (9) atau tidak mencantumkan nama, alamat, dan Nomor Pokok Wajib Pajak pembeli Barang Kena Pajak atau penerima Jasa Kena Pajak; g. pemanfaatan Barang Kena Pajak Tidak Berwujud atau pemanfaatan Jasa Kena Pajak dari luar Daerah Pabean di dalam Daerah Pabean yang Faktur Pajaknya tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 13 ayat (6);"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_6047f3ae43 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_1__4a ;
    kbr:hasRuleId "R-UU-1983-8-6047f3ae43"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/1..4a"^^xsd:string ;
    kbr:hasSourceQuote "Apabila dalam suatu Masa Pajak, Pajak Masukan yang dapat dikreditkan lebih besar daripada Pajak Keluaran, selisihnya merupakan kelebihan pajak yang dikompensasikan ke Masa Pajak berikutnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_63ecbfb479 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_3A ;
    kbr:hasRuleId "R-UU-1983-8-63ecbfb479"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/3A"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha yang melakukan penyerahan sebagaimana dimaksud dalam Pasal 4 ayat (1) huruf a, huruf c, huruf f, huruf g, dan huruf h, kecuali pengusaha kecil yang batasannya ditetapkan oleh Menteri Keuangan, wajib melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan wajib memungut, menyetor, dan melaporkan Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah yang terutang."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_64adef26dc a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_9_4c__5 ;
    kbr:hasRuleId "R-UU-1983-8-64adef26dc"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/9/4c..5"^^xsd:string ;
    kbr:hasSourceQuote "Drrektur Jenderal Pajak dapat melakukan pemeriksaan terhadap Pengusaha Kena Pajak sebagaimana. dimaksud pada ayat (4c) dan menerbitkan surat ketetapan pajak setelah melakukan pengembalian pendahuluan kelebihan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_65f8834d74 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1983-8-65f8834d74"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Jasa Kena Pajak adalah jasa yang dikenai pajak berdasarkan Undang-Undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_66201f264f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_3A ;
    kbr:hasRuleId "R-UU-1983-8-66201f264f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/3A"^^xsd:string ;
    kbr:hasSourceQuote "Orang pribadi atau badan yang memanfaatkan Barang Kena Pajak Tidak Berwujud dari luar Daerah Pabean sebagaimana dimaksud dalam Pasal 4 ayat (1) huruf d dan/atau yang memanfaatkan Jasa Kena Pajak dari luar Daerah Pabean sebagaimana dimaksud dalam Pasal 4 ayat (1) huruf e wajib memungut, menyetor, dan melaporkan Pajak Pertambahan Nilai yang terutang yang penghitungan dan tata caranya diatur dengan Peraturan Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_68b061b6df a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_15A ;
    kbr:hasRuleId "R-UU-1983-8-68b061b6df"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-8#BT/15A"^^xsd:string ;
    kbr:hasSourceQuote "Surat Pemberitahuan Masa Pajak Pertambahan Nilai disampaikan paling lama akhir bulan berikutnya setelah berakhirnya Masa Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_UU_1983_8_6b1635979a a kbr:Larangan ;
