    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Alat Berat adalah alat yang diciptakan untuk membantu pekerjaan konstruksi dan pekerjaan teknik sipil lainnya yang sifatnya berat apabila dikerjakan oleh tenaga manusia, beroperasi menggunakan motor dengan atau tanpa roda, tidak melekat secara permanen serta beroperasi pada area tertentu, termasuk tetapi tidak terbatas pada area konstruksi, perkebunan, kehutanan, dan pertambangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_d58250bb38 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_11 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-d58250bb38"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Termasuk penyerahan Kendaraan Bermotor sebagaimana dimaksud pada ayat (1) adalah pemasukan Kendaraan Bermotor dari luar negeri untuk dipakai secara tetap di Indonesia, kecuali: a. untuk diperdagangkan; b. untuk dikeluarkan kembali dari wilayah kepabeanan Indonesia; dan c. digunakan untuk pameran, objek penelitian, contoh, dan kegiatan olahraga bertaraf internasional."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_d63a79b0f6 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_75 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-d63a79b0f6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dikecualikan dari pengenaan Retribusi atas pelayanan sebagaimana dimaksud pada ayat (1) adalah penggunaan tenaga kerja asing oleh instansi pemerintah pusat, perwakilan negara asing, badan internasional, lembaga sosial, lembaga keagamaan, dan jabatan tertentu di lembaga pendidikan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_d7213ad994 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_7 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-d7213ad994"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Tarif PKB atas kepemilikan dan/atau penguasaan Kendaraan Bermotor yang digunakan untuk angkutan umum, angkutan karyawan, dan angkutan sekolah ambulans, pemadam kebakaran, sosial keagamaan, lembaga sosial dan keagamaan serta Tarif PKB atas kepemilikan dan/atau penguasaan Kendaraan Bermotor Instansi Pemerintah ditetapkan sebesar 0,5% (nol koma lima persen)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_d7da6579de a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
