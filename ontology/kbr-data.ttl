    kbr:hasSourceQuote "KSO sebagaimana dimaksud dalam Pasal 3 ayat (1) wajib melakukan pemotongan dan/atau pemungutan Pajak Penghasilan sesuai dengan ketentuan peraturan perundang- undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

