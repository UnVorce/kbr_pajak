    kbr:hasSourceLocator "PP-2022-50#BT/37/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak dalam jangka waktu paling lama 6 (enam) bulan terhitung sejak tanggal surat permohonan pembetulan diterima, harus memberi keputusan atas permohonan pembetulan yang diajukan Wajib Pajak sebagaimana dimaksud pada ayat (1)."^^xsd:string ;
