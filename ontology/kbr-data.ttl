    kbr:hasSourceQuote "Indikator harga sebagaimana dimaksud pada ayat (4) dapat berupa harga transaksi, laba kotor, atau laba operasi bersih berdasarkan nilai absolut atau nilai rasio tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
