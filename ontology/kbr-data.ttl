    kbr:hasSourceQuote "(3) Dalam hal hasil penelitian formal sebagaimana dimaksud pada ayat ( 1) tidak terpenuhi, Surat Pemberitahuan Objek Pajak dianggap tidak disampaikan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

