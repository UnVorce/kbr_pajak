kbr:Aturan_R_PMK_2024_81_af591542ec a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_329 ;
    kbr:hasRuleId "R-PMK-2024-81-af591542ec"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/329"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal orang pribadi atau Badan yang melakukan kegiatan membangun sendiri: a. tidak melakukan kewajiban penyetoran Pajak Pertambahan Nilai sebagaimana dimaksud dalam Pasal 326 ayat (1) dan/atau kewajiban pelaporan sebagaimana dimaksud dalam Pasal 328 ayat (1); atau b. telah melakukan penyetoran atau pelaporan Pajak Pertambahan Nilai atas kegiatan membangun sendiri namun berdasarkan data yang dimiliki dan diperoleh oleh Direktorat Jenderal Pajak masih terdapat Pajak Pertambahan Nilai yang kurang dibayar dan/ atau dilaporkan, Kepala Kantor Pelayanan Pajak yang wilayah kerjanya meliputi tempat tinggal atau tempat kedudukan Wajib Pajak orang pribadi atau Badan yang melakukan kegiatan membangun sendiri, dapat menyampaikan imbauan secara tertulis kepada orang pribadi atau Badan untuk memenuhi kewajiban perpajakan tersebut dan menindaklanjuti sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_af870d2961 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_378_1__6 ;
    kbr:hasRuleId "R-PMK-2024-81-af870d2961"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/378/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Pecloman pengkreclitan Pajak Masukan sebagaimana climaksucl pacla ayat (4) cliberlakukan untuk Masa Pajak sebelum Pengusaha clikukuhkan sebagai Pengusaha Kena Pajak, yang clilakukan melalui: a. penyampaian Surat Pemberitahuan Masa Pajak Pertambahan Nilai; clan/ atau b. penetapan kewajiban Pajak Pertambahan Nilai melalui Pemeriksaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_afa40ba17d a kbr:Prosedur ;
