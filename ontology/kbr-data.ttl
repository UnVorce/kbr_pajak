    kbr:hasSourceQuote "(2) Saat terutang BBNKB ditetapkan pada saat terjadinya penyerahan pertama Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_e1f2c968da a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_95 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-e1f2c968da"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Peraturan pelaksanaan dari Peraturan Daerah ini ditetapkan paling lama 2 (dua) tahun sejak tanggal diundangkannya Peraturan Daerah ini."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_e4526423da a kbr:Definisi ;
