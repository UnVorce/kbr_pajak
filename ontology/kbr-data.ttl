    kbr:hasSourceQuote "Tanggal berita acara serah terima sebagaimana dimaksud pada ayat (1) dinyatakan sebagai bukti tanggal pembayaran Pajak Penghasilan dalam bentuk volume minyak bumi dan/ atau gas bumi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

