    kbr:hasSourceQuote "Ketentuan mengenai pelaksanaan pemanfaatan barang milik daerah yang telah dilaksanakan berdasarkan perjanjian masih tetap berlaku sampai berakhirnya masa perjanjian."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_b1cd3b6cad a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_90 ;
