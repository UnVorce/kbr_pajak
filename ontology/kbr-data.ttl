kbr:Aturan_R_UU_1983_6_e815b739a1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_17D ;
    kbr:hasRuleId "R-UU-1983-6-e815b739a1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/17D"^^xsd:string ;
    kbr:hasSourceQuote "(2) Wajib Pajak sebagaimana dimaksud pada ayat (1) yang dapat diberikan pengembalian pendahuluan kelebihan pembayaran pajak adalah: a. Wajib Pajak orang pribadi yang tidak menjalankan usaha atau pekerjaan bebas; b. Wajib Pajak orang pribadi yang menjalankan usaha atau pekerjaan bebas dengan jumlah peredaran usaha dan jumlah lebih bayar sampai dengan jumlah tertentu; c. Wajib Pajak badan dengan jumlah peredaran usaha dan jumlah lebih bayar sampai dengan jumlah tertentu; atau d. Pengusaha Kena Pajak yang menyampaikan Surat Pemberitahuan Masa Pajak Pertambahan Nilai dengan jumlah penyerahan dan jumlah lebih bayar sampai dengan jumlah tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_e98803ead1 a kbr:Definisi ;
