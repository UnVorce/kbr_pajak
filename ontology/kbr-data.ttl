    kbr:hasSourceQuote "b. konsumsi Tenaga Listrik dari sumber lain oleh selain industri, pertambangan minyak bumi dan gas alam sebagaimana dimaksud pada huruf a, ditetapkan sebesar 2,4% (dua koma empat persen);"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_APPROVED"^^xsd:string ;
    kbr:terdampakPutusanMK kbr:MK_2024_19_PUU_XXII ;
