    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/7/7..10"^^xsd:string ;
    kbr:hasSourceQuote "(8) Dasar pengenaan PKB sebagaimana dimaksud pada ayat (1) dan ayat (2), untuk Kendaraan Bermotor baru dikenakan sesuai dengan peraturan menteri yang menyelenggarakan urusan pemerintahan dalam negeri setelah mendapat pertimbangan dari menteri yang menyelenggarakan urusan pemerintahan dibidang keuangan negara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

