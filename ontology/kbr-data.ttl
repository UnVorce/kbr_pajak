    kbr:hasSourceQuote "Opsen PKB yang menjadi hak Pemerintah Daerah Kabupaten/Kota dikenakan terhadap PKB terutang sebagaimana dimaksud dalam Pasal 8 ayat (1)."^^xsd:string ;
