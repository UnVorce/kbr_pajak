    kbr:hasSourceLocator "PMK-2025-15#BT/23/3..10"^^xsd:string ;
    kbr:hasSourceQuote "2. Wajib Pajak atau tersangka melakukan pelunasan sebagaimana diatur dalam Pasal 44B ayat (1) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
