kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_df4e9142a9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_10 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-df4e9142a9"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "Kendaraan Bermotor yang dikecualikan dari objek BBNKB sebagaimana dimaksud pada ayat (1) yaitu penyerahan atas: a. kereta api; b. Kendaraan Bermotor yang semata-mata digunakan untuk keperluan pertahanan dan keamanan negara; c. Kendaraan Bermotor kedutaan, konsulat, perwakilan negara asing dengan asas timbal balik, dan lembaga internasional yang memperoleh fasilitas pembebasan pajak dari Pemerintah; d. Kendaraan Bermotor berbasis Energi Terbarukan; dan e. Kendaraan bermotor yang dimiliki dan/atau dikuasai oleh pabrikan atau importir yang semata-mata disediakan untuk keperluan pameran dan tidak untuk dijual."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_e01751c2a5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_19 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-e01751c2a5"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(3) Wilayah pemungutan PAB yang terutang merupakan wilayah Provinsi DKI Jakarta tempat penguasaan Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_e01e381f97 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_95 ;
    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-e01e381f97"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan umum dan tata cara pemungutan Pajak dan Retribusi sebagaimana dimaksud pada ayat (1) meliputi pengaturan mengenai: a. pendaftaran dan pendataan; b. penetapan besaran Pajak dan Retribusi terutang; c. pembayaran dan penyetoran; d. pelaporan; e. pengurangan, pembetulan, dan pembatalan ketetapan; f. pemeriksaan Pajak; g. penagihan Pajak dan Retribusi; h. keberatan; i. gugatan; j. penghapusan piutang Pajak dan Retribusi oleh Gubernur; dan k. pengaturan lain yang berkaitan dengan tata cara pemungutan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_e0a00e72e9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_16 ;
