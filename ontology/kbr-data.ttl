    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/172"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal permohonan banding ditolak atau dikabulkan sebagian, Wajib Pajak dikenai sanksi administratif berupa denda sebesar 60% (enam puluh persen) dari jumlah Pajak berdasarkan Putusan Banding dikurangi dengan Pajak yang telah dibayar sebelum mengajukan keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

