    kbr:hasSourceLocator "PMK-2024-81#BT/45"^^xsd:string ;
    kbr:hasSourceQuote "(3) Permohonan penetapan Wajib Pajak Nonaktif sebagaimana dimaksud pada ayat (1) dilakukan sesuai dengan ketentuan pelaksanaan hak dan pemenuhan kewajiban perpajakan sebagaimana dimaksud dalam Pasal 4, serta dilampiri dengan dokumen yang menunjukkan bahwa Wajib Pajak Badan memenuhi kriteria Wajib Pajak Nonaktif."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

