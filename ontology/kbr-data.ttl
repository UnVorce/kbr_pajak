    kbr:hasSourceQuote "Dokumen Penentuan Harga Transfer sebagaimana dimaksud dalam Pasal 16 ayat (2) huruf a dan huruf b wajib dibuat ikhtisar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

