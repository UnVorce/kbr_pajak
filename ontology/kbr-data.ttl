kbr:Aturan_R_PP_2009_32_01acd513d5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_1 ;
    kbr:hasRuleId "R-PP-2009-32-01acd513d5"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Kawasan Daur Ulang Berikat adalah Tempat Penimbunan Berikat untuk menimbun barang impor dalam jangka waktu tertentu yang di dalamnya dilakukan kegiatan daur ulang limbah asal impor dan/atau asal Daerah Pabean sehingga menjadi produk yang mempunyai nilai tambah serta nilai ekonomi yang lebih tinggi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_038c39d8e8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_38 ;
    kbr:hasRuleId "R-PP-2009-32-038c39d8e8"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Atas penyerahan barang dari Kawasan Daur Ulang Berikat ke tempat lain dalam daerah pabean, pengusaha Kawasan Daur Ulang Berikat dan pengusaha di Kawasan Daur Ulang Berikat wajib membuat faktur pajak dan memungut Pajak Pertambahan Nilai sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_03d8cdaa5e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_24_1__9 ;
    kbr:hasRuleId "R-PP-2009-32-03d8cdaa5e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/24/1..9"^^xsd:string ;
    kbr:hasSourceQuote "(8) Atas penyerahan barang dari Tempat Penyelenggaraan Pameran Berikat ke tempat lain dalam daerah pabean, pengusaha Tempat Penyelenggaraan Pameran Berikat atau pengusaha di Tempat Penyelenggaraan Pameran Berikat wajib membuat faktur pajak dan memungut Pajak Pertambahan Nilai sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_04209d6f4d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42 ;
    kbr:hasRuleId "R-PP-2009-32-04209d6f4d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Kawasan Daur Ulang Berikat dan pengusaha di Kawasan Daur Ulang Berikat harus mengolah bahan baku berupa limbah non bahan berbahaya dan beracun (B3) yang dimasukkan ke Kawasan Daur Ulang Berikat yang dikelolanya dalam waktu paling lama 3 (tiga) bulan sejak tanggal pemasukan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_04e657062f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_20 ;
    kbr:hasRuleId "R-PP-2009-32-04e657062f"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Kawasan Berikat atau pengusaha di Kawasan Berikat dapat mengeluarkan sisa hasil produksi dari proses produksi di Kawasan Berikat ke tempat lain dalam daerah pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_07aef21d03 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_20 ;
    kbr:hasRuleId "R-PP-2009-32-07aef21d03"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Sisa hasil produksi sebagaimana dimaksud pada ayat (1) yang berupa limbah bahan berbahaya dan beracun dapat dikeluarkan dari Kawasan Berikat untuk didaur ulang atau dimusnahkan yang dilakukan sesuai dengan ketentuan peraturan perundangan-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_0d352883b8 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_37 ;
    kbr:hasRuleId "R-PP-2009-32-0d352883b8"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Kawasan Daur Ulang Berikat atau pengusaha di Kawasan Daur Ulang Berikat merangkap sebagai penyelenggara di Kawasan Daur Ulang Berikat sebagaimana dimaksud pada ayat (5) harus berbadan hukum Indonesia dan berkedudukan di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

