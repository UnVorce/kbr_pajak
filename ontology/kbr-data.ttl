    kbr:hasSourceQuote "(4) Penyebutan Bagian Tahun Pajak dalam Surat Pemberitahuan Tahunan Pajak Penghasilan untuk Bagian Tahun Pajak sebagaimana dimaksud pada ayat (3) huruf b, berlaku ketentuan sebagai berikut: a. menggunakan tahun kalender, dalam hal Bagian Tahun Pajak meliputi 1 (satu) tahun kalender; b. menggunakan tahun kalender yang di dalamnya memuat jumlah bulan yang lebih banyak, dalam hal"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

