    kbr:hasSourceQuote "10. Meterai Teraan adalah Meterai berupa label yang penggunaannya dilakukan dengan cara dibubuhkan pada Dokumen dengan menggunakan mesin teraan Meterai digital."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
