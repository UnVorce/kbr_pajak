    kbr:diaturDalam kbr:Reg_PMK_2014_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2014_111_BT_27 ;
    kbr:hasRuleId "R-PMK-2014-111-75f2605b30"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2014-111#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "(2) Teguran tertulis sebagaimana dimaksud pada ayat ( 1) huruf a diberikan setelah mempertimbangkan usulan dari Asosiasi Konsultan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

