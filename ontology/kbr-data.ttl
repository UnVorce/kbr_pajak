    kbr:hasRuleId "R-PMK-2024-79-30dcb53da4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "21. Menteri adalah menteri yang menyelenggarakan urusan pemerintahan di bidang keuangan negara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
