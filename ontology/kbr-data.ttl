    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2024-79-47da3fea93"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "19. Surat Pemberitahuan Tahunan adalah Surat Pemberitahuan untuk suatu tahun pajak atau bagian tahun pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_79_53c785c422 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_9 ;
    kbr:hasRuleId "R-PMK-2024-79-53c785c422"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Biaya untuk mendapatkan, menagih, dan memelihara penghasilan sebagaimana dimaksud pada ayat (1) meliputi biaya yang dikeluarkan dan dibebankan sebagai biaya oleh KSO termasuk biaya yang dikeluarkan sesuai dengan kontribusi Anggota kepada KSO."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_79_5c849661db a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2024-79-5c849661db"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "15. Kerja Sama Operasi yang selanjutnya disingkat KSO adalah Badan yang berbentuk pengaturan bersama antaranggota kerja sama operasi yang mengatur bahwa anggota kerja sama operasi memiliki pengendalian bersama atau memiliki hak atas aset, dan kewajiban terhadap liabilitas, dengan nama dan dalam bentuk apa pun."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_79_61ad0589d2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_15 ;
    kbr:hasRuleId "R-PMK-2024-79-61ad0589d2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penghasilan sebagaimana dimaksud dalam Pasal 9 ayat (4) merupakan penghasilan yang diterima a tau diperoleh dari pengalihan hak atas tanah dan/ atau bangunan atau perjanjian pengikatan jual beli atas tan/ - 11 - dan/ a tau bangunan beserta perubahannya, Pajak Penghasilan yang disetor sendiri se bagaimana dimaksud dalam Pasal 13 ayat (2) hurufb merupakan pelunasan atas Pajak Penghasilan Anggota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_79_6c243dc196 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_11 ;
    kbr:hasRuleId "R-PMK-2024-79-6c243dc196"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penghasilan KSO setelah dikurangi biaya untuk mendapatkan, menagih, dan memelihara penghasilan didapat kerugian, kerugian tersebut hanya dapat dikompensasikan oleh KSO dan tidak dapat dikompensasikan dengan penghasilan Anggota, termasuk kerugian saat KSO telah berakhir atau dibubarkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

