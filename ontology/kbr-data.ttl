    kbr:hasSourceQuote "(1) Jenis Pajak yang dipungut oleh Pemerintah Provinsi DKI Jakarta terdiri atas: a. PKB; b. BBNKB; c. PAB; d. PBBKB; e. Pajak Rokok; f. PBB-P2; g. BPHTB; h. PBJT atas: 1. Makanan dan/atau Minuman; 2. Tenaga Listrik; 3. Jasa Perhotelan; 4. Jasa Parkir; dan 5. Jasa Kesenian dan Hiburan; i. Pajak Reklame; dan j. PAT."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_ebb7f01cb7 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_DKI_JAKARTA_2024_1_BT_100_1__8 ;
