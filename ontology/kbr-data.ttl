    kbr:hasSourceQuote "Dalam hal Retribusi dipungut atas pelayanan yang diberikan oleh BLUD, pembayaran Retribusi oleh Wajib Retribusi disetorkan ke Rekening Kas BLUD sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_cd26168348 a kbr:Kewajiban ;
