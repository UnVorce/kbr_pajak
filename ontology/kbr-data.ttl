    kbr:hasSourceQuote "Pajak Bahan Bakar Kendaraan Bermotor yang selanjutnya disingkat PBBKB adalah Pajak atas penggunaan bahan bakar Kendaraan Bermotor dan Alat Berat."^^xsd:string ;
