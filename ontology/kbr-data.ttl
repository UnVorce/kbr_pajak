    kbr:hasSourceQuote "Dikecualikan dari objek Retribusi Jasa Umum sebagaimana dimaksud pada ayat (1) yaitu pelayanan jasa yang dilakukan oleh Pemerintah, badan usaha milik negara, badan usaha milik daerah, dan pihak swasta."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

