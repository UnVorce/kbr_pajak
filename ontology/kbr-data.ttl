    kbr:hasRuleId "R-UU-1995-10-163da2eff7"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan dan tata cara tentang : a. bentuk, isi, dan keabsahan Pemberitahuan Pabean dan buku catatan pabean; b. penyerahan dan pendaftaran Pemberitahuan Pabean; c. penelitian, perubahan, penambahan, dan pembatalan Pemberitahuan Pabean dan buku catatan pabean; d. pendistribusian dan penatausahaan Pemberitahuan Pabean dan buku catatan pabean; e. penggunaan dokumen pelengkap pabean; diatur oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_168d744a19 a kbr:Kewajiban ;
