    kbr:hasSourceLocator "PP-2022-50#BT/6/3..5"^^xsd:string ;
    kbr:hasSourceQuote "a. paling lama 3 (tiga) bulan setelah menerima Surat Ketetapan Pajak, Surat Keputusan Keberatan, Surat Keputusan Pengurangan Ketetapan Pajak, Surat Keputusan Pembatalan Ketetapan Pajak, Surat Keputusan Pembetulan, Surat Keputusan Persetujuan Bersama, Putusan Banding, atau Putusan Peninjauan Kembali"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

