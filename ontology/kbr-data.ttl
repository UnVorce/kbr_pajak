    kbr:hasSourceQuote "tarif yang lebih rendah dapat diterapkan sepanjang wajib pajak badan luar negeri memenuhi ketentuan persentase dan periode minimum kepemilikan saham sebagaimana dimaksud dalam Pasal 1 8 ayat (3) huruf b."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

