    kbr:hasSourceLocator "PP-2022-49#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Jasa angkutan u.mum penyeberangan sebagaimana dimaksud pada ayat (1) huruf c merupakan kegiatan pemindahan orang dan/atau barang dari suatu tempat ke tempat lain dengan menggunakan kapal yang berfungsi sebagai jembatan yang menghubungkan jaringan jalan dan/atau jaringan jalur kereta api yang dipisahkan oleh perairan, dengan dipungut bayaran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

