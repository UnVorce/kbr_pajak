    kbr:hasSourceLocator "PMK-2023-172#BT/40/5..11"^^xsd:string ;
    kbr:hasSourceQuote "Penyesuaian keterkaitan melalui pembetulan surat ketetapan pajak sebagaimana dimaksud pada ayat (4) huruf c dilakukan secara jabatan oleh Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
