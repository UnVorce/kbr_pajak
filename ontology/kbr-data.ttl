kbr:Aturan_R_PMK_2024_81_098815fab3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_424 ;
    kbr:hasRuleId "R-PMK-2024-81-098815fab3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/424"^^xsd:string ;
    kbr:hasSourceQuote "Fasilitas Pajak Penghasilan sebagaimana dimaksud dalam Pasal 423 ayat (1) diberikan atas aktiva tetap berwujud termasuk tanah, dengan ketentuan sebagai berikut: a. diperoleh Wajib Pajak dalam keadaan baru, kecuali merupakan relokasi secara keseluruhan sebagai satu paket Penanaman Modal dari negara lain; b. tercantum dalam izin prinsip, izin investasi, pendaftaran Penanaman Modal, yang telah diterbitkan oleh Badan Koordinasi Penanaman Modal/Dinas Penanaman Modal dan Pelayanan Terpadu Satu Pintu Provinsi/Dinas Penanaman Modal dan Pelayanan Terpadu Satu Pintu Kabupaten/Kota atau Perizinan Berusaha yang diterbitkan oleh Lembaga Online Single Submission yang menjadi dasar pemberian fasilitas Pajak Penghasilan; dan c. dimiliki dan digunakan untuk Kegiatan Usaha Utama."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

