    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_7 ;
    kbr:hasRuleId "R-PMK-2023-96-8d6731ed95"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "(7) Penyerahan jaminan perusahaan sebagaimana dimaksud pada ayat (1) dan pengembalian jaminan sebagaimana dimaksud pada ayat (5), dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan mengena1 jaminan dalam rangka kepabeanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_8dcdd83e16 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_12 ;
    kbr:hasRuleId "R-PMK-2023-96-8dcdd83e16"^^xsd:string ;
