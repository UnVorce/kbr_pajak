    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/74"^^xsd:string ;
    kbr:hasSourceQuote "(5) Peraturan Walikota sebagaimana dimaksud pada ayat (4) disampaikan kepada Menteri yang menyelenggarakan urusan pemerintahan bidang keuangan negara, menteri yang menyelenggarakan Urusan Pemerintahan dalam negeri, dan DPRD paling lambat 7 (tujuh) hari kerja sejak Peraturan Wali Kota ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
