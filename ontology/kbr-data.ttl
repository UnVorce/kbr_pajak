kbr:Aturan_R_PMK_2023_172_713d739530 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_53_10 ;
    kbr:hasRuleId "R-PMK-2023-172-713d739530"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/53/10"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Surat Keputusan Persetujuan Bersama: a. terbit sebelum surat ketetapan pajak; dan b. menyebabkan kelebihan atas pemotongan dan/ atau pemungutan pajak penghasilan yang terutang, wajib pajak dalam negeri Mitra Persetujuan Penghindaran Pajak Berganda dapat menyampaikan permohonan pengembalian atas kelebihan pembayaran pajak yang seharusnya tidak terutang sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

