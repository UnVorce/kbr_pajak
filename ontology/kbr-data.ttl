    kbr:hasSourceLocator "PER-DJP-2025-11#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "(5) Surat Pemberitahuan Masa Bea Meterai sebagaimana dimaksud pada ayat (1): a. dibuat sesuai contoh format; dan b. diisi sesuai petunjuk pengisian, sebagaimana tercantum dalam Lampiran huruf F yang merupakan bagian tidak terpisahkan dari Peraturan Direktur Jenderal ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

