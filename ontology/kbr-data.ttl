    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_108_1__4 ;
    kbr:hasRuleId "R-PMK-2023-61-558011eeb9"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/108/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Setelah menyampaikan permintaan pencabutan blokir sebagaimana dimaksud pada ayat (3), Pejabat melakukan penjualan surat berharga milik Penanggung Pajak atas Klaim Pajak di bursa efek sesuai dengan ketentuan peraturan perundang-undangan di bidang pasar modal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_56314d968f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_117 ;
    kbr:hasRuleId "R-PMK-2023-61-56314d968f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/117"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Nilai Klaim Pajak dapat tertagih, Biaya Penagihan Pajak ditanggung oleh Negara Mitra atau Yurisdiksi Mitra yang meminta Bantuan Penagihan Pajak."^^xsd:string ;
