    kbr:hasSourceLocator "PMK-2023-61#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "(2) Berdasarkan permohonan izin perpanjangan jangka waktu Penyanderaan sebagaimana dimaksud pada ayat (1), Menteri menerbitkan izin perpanjangan jangka waktu Penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
