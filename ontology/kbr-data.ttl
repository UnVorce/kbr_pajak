    kbr:hasSourceQuote "Jumlah kekurangan Pajak yang terutang dalam SKPDKBT sebagaimana dimaksud dalam Pasal 151 ayat (3) dikenakan sanksi administratif berupa kenaikan sebesar 100% (seratus persen) dari jumlah kekurangan Pajak yang terutang dalam SKPDKBT."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
