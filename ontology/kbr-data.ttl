    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Air Permukaan, yang selanjutnya disingkat PAP adalah Pajak atas pengambilan dan/ atau pemanfaatan Air Permukaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_fc608b166b a kbr:Definisi ;
