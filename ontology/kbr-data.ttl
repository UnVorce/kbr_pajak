kbr:Aturan_R_PMK_2023_72_4517d13351 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_72 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_72_BT_15 ;
