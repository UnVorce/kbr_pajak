    kbr:hasRuleId "R-PERDA-PROV-DKI-JAKARTA-2024-1-efdbdab156"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "Struktur dan besaran tarif Retribusi sebagaimana dimaksud pada ayat (1) tercantum dalam Lampiran yang merupakan bagian tidak terpisahkan dari Peraturan Daerah ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_efdbe5ac10 a kbr:Definisi ;
