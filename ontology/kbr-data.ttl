kbr:Aturan_R_UU_1983_7_4ffd517d3b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_2_1__3 ;
    kbr:hasRuleId "R-UU-1983-7-4ffd517d3b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/2/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Bentuk usaha tetap merupakan subjek pajak yang perlakuan perpajakannya dipersamakan dengan subjek pajak badan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_50ff64d34e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_5 ;
    kbr:hasRuleId "R-UU-1983-7-50ff64d34e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "Yang menjadi Objek Pajak bentuk usaha tetap adalah: a. penghasilan dari usaha atau kegiatan bentuk usaha tetap tersebut dan dari harta yang dimiliki atau dikuasai; b. penghasilan kantor pusat dari usaha atau kegiatan, penjualan barang, atau pemberian jasa di Indonesia yang sejenis dengan yang dijalankan atau yang dilakukan oleh bentuk usaha tetap di Indonesia; c. penghasilan sebagaimana tersebut dalam Pasal 26 yang diterima atau diperoleh kantor pusat, sepanjang terdapat hubungan efektif antara bentuk usaha tetap dengan harta atau kegiatan yang memberikan penghasilan dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_5175b22e6a a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_26_1__2a ;
    kbr:hasRuleId "R-UU-1983-7-5175b22e6a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/26/1..2a"^^xsd:string ;
    kbr:hasSourceQuote "Atas penghasilan dari penjualan atau pengalihan harta di Indonesia, kecuali yang diatur dalam Pasal 4 ayat(21,yangditerima atau diperoleh Wajib Pajak luar negeri selain bentuk usaha tetap di Indonesia, dan premi asuransi yang dibayarkan kepada perusahaan asuransi luar negeri dipotong pajak 2Ooh (dua puluh persen) dari perkiraan penghasilan neto."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_521922d59c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_8 ;
    kbr:hasRuleId "R-UU-1983-7-521922d59c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Seluruh penghasilan atau kerugian bagi wanita yang telah kawin pada awal tahun pajak atau pada awal bagian tahun pajak, begitu pula kerugiannya yang berasal dari tahun-tahun sebelumnya yang belum dikompensasikan sebagaimana dimaksud dalam Pasal 6 ayat (2) dianggap sebagai penghasilan atau kerugian suaminya, kecuali penghasilan tersebut semata-mata diterima atau diperoleh dari 1 (satu) pemberi kerja yang telah dipotong pajak berdasarkan ketentuan Pasal 21 dan pekerjaan tersebut tidak ada hubungannya dengan usaha atau pekerjaan bebas suami atau anggota keluarga lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_52d574ff34 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_2_1__3 ;
    kbr:hasRuleId "R-UU-1983-7-52d574ff34"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/2/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Subjek pajak dibedakan menjadi subjek pajak dalam negeri dan subjek pajak luar negeri."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_54ec8372e5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_24_5__6 ;
