    kbr:hasSourceQuote "Utang Pajak sebagaimana tercantum dalam SPPT, SKPD, SKPDKB, SKPDKBT, STPD, Surat Keputusan Pembetulan, Surat Keputusan Keberatan, dan Putusan Banding merupakan dasar Penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

