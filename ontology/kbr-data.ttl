kbr:Aturan_R_PMK_2023_41_6d2f5a6b09 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_41_BT_2 ;
    kbr:hasRuleId "R-PMK-2023-41-6d2f5a6b09"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-41#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Agunan sebagaimana dimaksud pada ayat (1) merupakan Agunan yang diambil alih oleh Kreditur untuk penyelesaian Kredit, Pembiayaan Berdasarkan Prinsip Syariah, atau Pinjaman atas Dasar Hukum Gadai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

