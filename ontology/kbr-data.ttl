    kbr:hasRuleId "R-PP-2010-94-edab1b6ca6"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Fasilitas perpajakan dengan jangka waktu yang terbatas yang diperoleh Wajib Pajak sebelum tanggal 1 Januari 2009 tetap berlaku sampai dengan berakhirnya jangka waktu fasilitas perpajakan tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_f233778539 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_16 ;
    kbr:hasRuleId "R-PP-2010-94-f233778539"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pemotongan Pajak Penghasilan Pasal 23 Undang- Undang Pajak Penghasilan atau Pasal 26 Undang-Undang Pajak Penghasilan berdasarkan ketentuan sebagaimana dimaksud dalam Pasal 15 dilakukan pada tahun pajak yang berbeda dengan tahun pajak pengakuan penghasilan, maka atas Pajak Penghasilan yang telah dipotong tersebut dapat dikreditkan pada tahun pajak dilakukan pemotongan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

