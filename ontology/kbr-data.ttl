    kbr:hasSourceQuote "Berita acara Pemblokiran atau dokumen yang dipersamakan sebagaimana dimaksud pada ayat (1) disampaikan kepada Pejabat, Otoritas Jasa Keuangan, dan Penanggung Pajak segera setelah dilaksanakan Pemblokiran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

