    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/74"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai administrasi dan tata cara pemberian insentif fiskal diatur dalam Peraturan Gubernur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_c730740bfd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_73 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-c730740bfd"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/73"^^xsd:string ;
    kbr:hasSourceQuote "Gubernur atau Pejabat yang ditunjuk memerintahkan jurusita Pajak/Retribusi untuk melakukan Penagihan Pajak dan Retribusi sesuai ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_c74fff00dc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_7_7__10 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-c74fff00dc"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/7/7..10"^^xsd:string ;
    kbr:hasSourceQuote "(7) Bobot sebagaimana dimaksud pada ayat (6), dihitung berdasarkan faktor-faktor: a. tekanan gandar yang dibedakan atas dasar jumlah sumbu/as, roda, dan berat Kendaraan Bermotor; b. jenis BBKB yang dibedakan menurut bahan bakar bensin, diesel, atau jenis bahan bakar lainnya selain bahan bakar berbasis energi terbarukan; dan c. jenis, penggunaan, tahun pembuatan, dan ciri-ciri mesin Kendaraan Bermotor yang dibedakan berdasarkan isi silinder."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_c96af214f9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_69 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-c96af214f9"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/69"^^xsd:string ;
    kbr:hasSourceQuote "Sinergi sebagaimana dimaksud pada ayat (1), berupa sinergi pendanaan untuk biaya yang muncul dalam pemungutan PKB, Opsen PKB, BBNKB, dan Opsen BBNKB, atau bentuk sinergi lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_cab11722d6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_28 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-cab11722d6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "(1) Subjek PAP yaitu orang pribadi atau Badan yang melakukan pengambilan dan/atau pemanfaatan Air Permukaan. (2) Wajib PAP yaitu orang pribadi atau Badan yang melakukan pengambilan dan/atau pemanfaatan Air Permukaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_cfcce0b5c1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_27 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-cfcce0b5c1"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "(1) Objek PAP yaitu pengambilan dan/atau pemanfaatan Air Permukaan. (2) Objek PAP sebagaimana dimaksud pada ayat (1), dikecualikan untuk: a. keperluan dasar rumah tangga; b. pengairan pertanian rakyat; c. perikanan rakyat; d. keperluan keagamaan; dan e. kegiatan yang mengambil dan memanfaatkan air laut baik yang berada di lautan dan/atau di daratan (air payau)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d0091beacc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d0091beacc"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Tahun Pajak adalah jangka waktu yang lamanya 1 (satu) tahun kalender kecuali bila Wajib Pajak menggunakan tahun buku yang tidak sama dengan tahun kalender."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d0a5ea1d09 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_74 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d0a5ea1d09"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/74"^^xsd:string ;
    kbr:hasSourceQuote "Insentif fiskal sebagaimana dimaksud pada ayat (1), berupa pengurangan, keringanan, dan pembebasan atau penghapusan atas pokok Pajak, pokok Retribusi, dan/atau sanksinya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d1bfafe28e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_6 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d1bfafe28e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "Subjek PKB yaitu orang pribadi atau Badan yang memiliki dan/atau menguasai Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d4029ed765 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_18 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d4029ed765"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "(5) Dasar pengenaan PAB sebagaimana dimaksud pada ayat (1), ditinjau kembali paling lama setiap 3 (tiga) tahun dengan memperhatikan indeks harga dan perkembangan perekonomian."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d63103acc1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_15 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d63103acc1"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "(3) Wilayah pemungutan BBNKB yang terutang merupakan wilayah Provinsi tempat Kendaraan Bermotor terdaftar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d75606039f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_29 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d75606039f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "(4) Bobot Air Permukaan sebagaimana dimaksud pada ayat (2), dinyatakan dalam koefisien yang didasarkan paling sedikit atas faktor-faktor: a. lokasi pengambilan air; b. volume air; dan c. kewenangan pengelolaan sumber daya air."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d85354964b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_75 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d85354964b"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "Kondisi Wajib Pajak atau Wajib Retribusi sebagaimana dimaksud pada ayat (1), paling sedikit berupa kemampuan membayar Wajib Pajak atau Wajib Retribusi atau tingkat likuiditas Wajib Pajak atau Wajib Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_d9cf7e0ca9 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_21 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-d9cf7e0ca9"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai tata cara pelaksanaan pengembalian Pajak sebagaimana dimaksud pada ayat (4), diatur dalam Peraturan Gubernur."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_db1f6fa0d1 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_73 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-db1f6fa0d1"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/73"^^xsd:string ;
    kbr:hasSourceQuote "Piutang Pajak dan Retribusi yang tidak mungkin ditagih lagi karena hak untuk melakukan penagihan sudah kedaluwarsa dapat dihapuskan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_dd9dc17e6c a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_83 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-dd9dc17e6c"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/83"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi yang tidak melaksanakan kewajibannya sebagaimana dimaksud dalam Pasal 70 ayat (1), sehingga merugikan keuangan daerah Provinsi, diancam dengan pidana kurungan paling lama 3 (tiga) bulan atau pidana denda paling banyak 3 (tiga) kali dari jumlah Retribusi terutang yang tidak atau kurang dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_deea071188 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_57 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-deea071188"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "(5) Pelaksanaan pemanfaatan barang milik daerah sebagaimana dimaksud pada ayat (2), sesuai dengan ketentuan peraturan perundang-undangan yang mengatur mengenai pengelolaan barang milik daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_e031efa3f1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_78 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-e031efa3f1"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "(3) Ketentuan lebih lanjut mengenai tata cara pemberian dan pemanfaatan insentif sebagaimana dimaksud pada ayat (1), diatur dengan Peraturan Gubernur berpedoman pada peraturan perundang- undangan yang berlaku."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_e0545c4ff8 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_15 ;
