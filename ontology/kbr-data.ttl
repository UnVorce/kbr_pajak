kbr:Aturan_R_PMK_2023_172_f928dd61be a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_56_6__12 ;
    kbr:hasRuleId "R-PMK-2023-172-f928dd61be"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/56/6..12"^^xsd:string ;
    kbr:hasSourceQuote "Penyampaian permohonan Kesepakatan Harga Transfer sebagaimana dimaksud pada ayat (3) dapat dilakukan: a. secaralangsung; atau b. secara elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
