    kbr:hasSourceQuote "(3) Wilayah pemungutan PAB yang terutang merupakan wilayah Provinsi tempat Penguasaan Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

