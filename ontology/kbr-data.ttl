kbr:Aturan_R_UU_1995_11_006c295cbb a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_31 ;
    kbr:hasRuleId "R-UU-1995-11-006c295cbb"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "Di dalam tempat penyimpanan dilarang: a. menyimpan barang kena cukai yang telah dilunasi cukainya atau yang mendapatkan pembebasan cukai; b. menyimpan barang selain barang kena cukai yang ditetapkan dalam surat izin bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_0494b2b154 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_65 ;
    kbr:hasRuleId "R-UU-1995-11-0494b2b154"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/65"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha pabrik, pengusaha tempat penyimpanan, importir barang kena cukai, penyalur, pengusaha tempat penjualan eceran, atau pengguna barang kena cukai yang mendapat fasilitas pembebasan cukai sebagaimana dimaksud dalam Pasal  9, bertanggung jawab atas perbuatan orang yang dipekerjakan atau yang ditunjuk sebagai wakil atau sebagai kuasa yang berhubungan dengan pekerjaan mereka dalam rangka pelaksanaan undang- undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_05e72e7a37 a kbr:Kewajiban ;
