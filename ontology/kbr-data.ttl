kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_3a93d90311 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_156 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-3a93d90311"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/156"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat sebagaimana dimaksud pada ayat (1) berwenang: a. mengangkat dan memberhentikan Jurusita Pajak; b. menerbitkan: 1. surat teguran; 2. surat perintah penagihan seketika dan sekaligus; 3. surat paksa; 4. surat perintah melaksanakan penyitaan; 5. surat perintah penyanderaan; 6. surat pencabutan sita; 7. pengumuman lelang; 8. surat penentuan harga limit; 9. pembatalan lelang; dan/atau 10. surat lain yang diperlukan untuk pelaksanaan Penagihan Pajak. c. melakukan pemasangan stiker peringatan pembayaran Pajak Daerah;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_3af4083e3a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_165_1__8 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-3af4083e3a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/165/1..8"^^xsd:string ;
    kbr:hasSourceQuote "(4) Keadaan kahar sebagaimana dimaksud pada ayat (3) meliputi : a. bencana alam; b. kebakaran; c. kerusuhan massal atau huru-hara; d. wabah penyakit; dan/atau e. keadaan di luar kemampuan Wajib Pajak berdasarkan penilaian objektif Walikota yang menyebabkan Wajib Pajak tidak dapat memenuhi batas waktu pengajuan keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_3bca86b988 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_167 ;
