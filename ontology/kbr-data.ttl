    kbr:hasSourceLocator "PP-2021-40#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "(6) Dalam hal Badan Usaha telah menguasai atau mendapatkan alokasi lahan dari Badan Pengusahaan KPBPB, pengusulan oleh Badan Pengusahaan KPBPB sebagaimana dimaksud pada ayat (5) huruf a, perlu mendapat pertimbangan dari Badan Usaha yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
