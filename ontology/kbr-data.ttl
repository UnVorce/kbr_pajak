    kbr:hasSourceQuote "Dasar pengenaan PKB, khusus untuk Kendaraan Bermotor di air, ditetapkan hanya berdasarkan NJKB."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
