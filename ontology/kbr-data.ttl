    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/68"^^xsd:string ;
    kbr:hasSourceQuote "Sanksi administratif berupa denda sebagaimana dimaksud pada ayat (3), tidak dikenakan jika Wajib Pajak mengalami keadaan kahar (force majeure)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

