    kbr:hasSourceQuote "Bentuk usaha tetap sebagaimana dimaksud pada ayat (1) harus menyampaikan seluruh data dan/ atau informasi terkait transaksi yang dilakukan oleh Pihak Afiliasi di luar negeri yang terkait dengan usaha atau kegiatan bentuk usaha tetap."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2023_172_40cea3db36 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_1_p3 ;
    kbr:hasRuleId "R-PMK-2023-172-40cea3db36"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Periode Kesepakatan Harga Transfer adalah tahun pajak yang dicakup di dalam Kesepakatan Harga Transfer sesuai permohonan Wajib Pajak dalam negeri atau sesuai Persetujuan Bersama paling lama 5 (lima) tahun pajak setelah tahun pajak diajukannya permohonan Kesepakatan Harga Transfer."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2023_172_4448a8838c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_43_6__8 ;
    kbr:hasRuleId "R-PMK-2023-172-4448a8838c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/43/6..8"^^xsd:string ;
    kbr:hasSourceQuote "b. surat penolakan usulan permintaan pelaksanaan Prosedur Persetujuan Bersama kepada Wajib Pajak dalam negeri yang mencantumkan hal-hal yang menjadi dasar penolakan, dalam hal usulan permintaan pelaksanaan Prosedur Persetujuan Bersama tidak memenuhi persyaratan dan/atau tidak memenuhi kesesuaian materi, dalam batas waktu paling lama 1 (satu) bulan sejak tanggal diterimanya usulan permintaan pelaksanaan Prosedur Persetujuan Bersama."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

