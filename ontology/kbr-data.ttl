    kbr:hasSourceLocator "UU-1995-11#BT/I/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Barang-barang sebagaimana dimaksud pada ayat (1) dinyatakan sebagai Barang Kena Cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_f675f7da46 a kbr:Prosedur ;
