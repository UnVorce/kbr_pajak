    kbr:hasSourceQuote "(3) Berdasarkan pemberitahuan sebagaimana dimaksud pada ayat (1), Direktur Jenderal Pajak melakukan penyesuaian informasi yang tercantum dalam Klaim Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
