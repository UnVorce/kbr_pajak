    kbr:hasSourceQuote "(1) Pejabat pegawai negeri sipil tertentu di lingkungan Pemerintah Provinsi diberi wewenang khusus sebagai penyidik untuk melakukan penyidikan tindak pidana di bidang Pajak dan Retribusi, sebagaimana dimaksud dalam Undang-Undang mengenai Hukum Acara Pidana."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
