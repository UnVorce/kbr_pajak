    kbr:hasSourceLocator "PMK-2024-136#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "6. Entitas Konstituen adalah setiap Entitas yang termasuk dalam grup dan setiap bentuk usaha tetap dari Entitas Utama (Main Entity) yang berada dalam cakupan setiap Entitas yang termasuk dalam grup."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_a4564e1a2d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
