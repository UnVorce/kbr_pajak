    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_60 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-55f61b5736"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "a. menerima permohonan pencabutan pengukuhan Pengusaha Kena Pajak dengan menerbitkan surat pencabutan pengukuhan Pengusaha Kena Pajak, dalam hal Pengusaha tidak lagi memenuhi ketentuan sebagai Pengusaha Kena Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

