    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_252 ;
    kbr:hasRuleId "R-PMK-2024-81-7eb71a2fe9"^^xsd:string ;
