    kbr:hasSourceQuote "Pemungutan Retribusi sebagaimana dimaksud pada ayat (1) pada Satuan Kerja Perangkat Daerah/Unit Kerja pada Perangkat Daerah pemungut harus terintegrasi dengan sistem informasi Retribusi Provinsi DKI Jakarta."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
