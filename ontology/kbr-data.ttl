    kbr:diaturDalam kbr:Reg_PMK_2023_143 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_143_BT_6 ;
    kbr:hasRuleId "R-PMK-2023-143-e3aa28e8bf"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal hasil penelitian atas SPPR dengan BPN telah sesuai, Pejabat Bea dan Cukai melanjutkan proses pelayanan CK-1."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

