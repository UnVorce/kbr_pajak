    kbr:hasRuleId "R-PER-DJP-2025-7-241efeb9c4"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/73"^^xsd:string ;
    kbr:hasSourceQuote "a. mengisi dan menandatangani formulir permohonan pendaftaran objek pajak Pajak Bumi dan Bangunan; dan b. melampirkan dokumen sebagaimana dimaksud dalam Pasal 71 ayat (4) dan ayat (5)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_24d5664797 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_48 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-24d5664797"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan kewajiban sebagaimana dimaksud pada ayat (1) tidak berlaku bagi pengusaha kecil yang batasannya ditetapkan oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_25ac19a842 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_21 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-25ac19a842"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "Kode Otorisasi sebagaimana dimaksud dalam Pasal 20 ayat (5) huruf b memiliki masa berlaku selama 2 (dua) tahun sejak tanggal Kode Otorisasi diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_272dc8f176 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_59 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-272dc8f176"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/59"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak diterbitkan bukti penerimaan surat;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_27c09d3eb5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_44_4__8 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-27c09d3eb5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/44/4..8"^^xsd:string ;
    kbr:hasSourceQuote "Permohonan penghapusan Nomor Pokok Wajib Pajak sebagaimana dimaksud pada ayat (1) dilakukan secara elektronik melalui: a. Portal Wajib Pajak; b. laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak; dan/atau c. Contact Center."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_27d2b87259 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_29 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-27d2b87259"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak Baru menyampaikan surat pindah sebagaimana dimaksud pada ayat (1) kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_27f4347c9f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_45 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-27f4347c9f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/45"^^xsd:string ;
    kbr:hasSourceQuote "dilakukan dengan menyampaikan data pendukung sebagaimana dimaksud dalam Pasal 44 ayat (9)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_29d2469ee6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_15_9__12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-29d2469ee6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/15/9..12"^^xsd:string ;
    kbr:hasSourceQuote "surat penolakan pendaftaran Wajib Pajak, dalam hal permohonan tidak memenuhi persyaratan penerbitan Nomor Pokok Wajib Pajak atau Wajib Pajak sebelumnya telah terdaftar sebagai Wajib Pajak dalam administrasi Direktorat Jenderal Pajak, paling lama 1 (satu) hari kerja setelah bukti penerimaan elektronik sebagaimana dimaksud pada ayat (9) huruf a diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_2a45a70567 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_51_6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-2a45a70567"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/51/6"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Badan yang menggunakan Kantor Virtual sebagai tempat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (1) huruf b harus memenuhi persyaratan sebagai berikut: a. tidak memiliki tempat kegiatan usaha lain di luar kawasan perdagangan bebas dan pelabuhan bebas yang berada selain di Kantor Virtual; b. memiliki kontrak, perjanjian, atau dokumen sejenis sebagaimana dimaksud pada ayat (4) huruf a dengan durasi kontrak penggunaan Kantor Virtual minimal 1 (satu) tahun terhitung dari pengajuan permohonan Pengusaha Kena Pajak diajukan; dan c. tempat kedudukan dan/atau tempat kegiatan usaha yang berada di kawasan perdagangan bebas dan pelabuhan bebas telah diuji dan dibuktikan secara nyata memiliki kegiatan usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_2b63e950e3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_79 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-2b63e950e3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/79"^^xsd:string ;
    kbr:hasSourceQuote "a. Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan dan surat pemberitahuan perubahan data objek pajak Pajak Bumi dan Bangunan dalam hal permohonan perubahan data Objek Pajak telah memenuhi persyaratan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_2b8401d171 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_35 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-2b8401d171"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/35"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1) atau ayat (2), -37- kepada Wajib Pajak diterbitkan bukti penerimaan elektronik;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_2d0423df38 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_19 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-2d0423df38"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(1) Laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak sebagaimana dimaksud dalam Pasal 14 ayat (1) huruf b meliputi: a. sistem administrasi badan hukum dan sistem administrasi badan usaha; b. online single submission; dan c. laman atau aplikasi lain yang ditetapkan Direktur Jenderal Pajak sebagai saluran pendaftaran tertentu sebagai tempat pendaftaran Wajib Pajak. (2) Pendaftaran melalui sistem administrasi badan hukum dan sistem administrasi badan usaha sebagaimana dimaksud pada ayat (1) huruf a dapat diajukan oleh Wajib Pajak Badan melalui notaris. (3) Notaris sebagaimana dimaksud pada ayat (2) merupakan notaris yang membuat akta pendirian Badan tersebut dan telah diberikan hak akses pada sistem administrasi badan hukum atau sistem administrasi badan usaha. (4) Selain melalui laman atau aplikasi lain sebagaimana dimaksud pada ayat (1), Wajib Pajak dapat melakukan pendaftaran melalui tempat pendaftaran tertentu sebagaimana dimaksud dalam Pasal 11 ayat (3) huruf b, yaitu: a. layanan perpajakan di layanan terpadu satu pintu; b. layanan di luar kantor; dan c. tempat pendaftaran tertentu lainnya sebagai tempat pendaftaran Wajib Pajak yang ditetapkan Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_2f407bac7d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_14_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-2f407bac7d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/14/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(3) Permohonan pendaftaran untuk Wajib Pajak orang pribadi yang merupakan Penduduk tidak perlu dilampiri dokumen persyaratan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_2f56654dfb a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_31 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-2f56654dfb"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak lagi melakukan kegiatan usaha di tempat kegiatan usaha sebagaimana dimaksud pada ayat (1), Wajib Pajak harus melakukan penghapusan Nomor Identitas Tempat Kegiatan Usaha yang telah terdaftar dalam sistem administrasi Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_2ff529cde0 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_60 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-2ff529cde0"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "Atas permohonan pencabutan pengukuhan Pengusaha Kena Pajak yang telah diberikan bukti penerimaan elektronik atau bukti penerimaan surat, Kepala Kantor Pelayanan Pajak melakukan Pemeriksaan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan yang mengatur mengenai tata cara Pemeriksaan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_329b9debab a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_54_8__9 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-329b9debab"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/54/8..9"^^xsd:string ;
    kbr:hasSourceQuote "(8) Tanggal pengukuhan yang tercantum dalam surat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (5) huruf a dan ayat (6) yang merupakan tanggal dimulainya kewajiban sebagai Pengusaha Kena Pajak yaitu sesuai dengan ketentuan sebagaimana diatur dalam Peraturan Menteri mengenai kewajiban pelaporan usaha untuk dikukuhkan sebagai Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3519a9513f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_61 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3519a9513f"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/61"^^xsd:string ;
    kbr:hasSourceQuote "Selain dilakukan berdasarkan hasil Pemeriksaan, Kepala Kantor Pelayanan Pajak juga dapat melakukan pencabutan pengukuhan Pengusaha Kena Pajak secara jabatan berdasarkan hasil penelitian administrasi terhadap: a. Pengusaha Kena Pajak dengan status Wajib Pajak Nonaktif; b. Pengusaha Kena Pajak telah dinonaktifkan akses pembuatan faktur pajak dan tidak melakukan klarifikasi dalam jangka waktu 30 (tiga puluh) hari sejak penonaktifan atau klarifikasinya ditolak; c. Pengusaha Kena Pajak menyalahgunakan atau menggunakan tanpa hak pengukuhan Pengusaha Kena Pajak yang telah mendapatkan putusan pengadilan yang berkekuatan hukum tetap; d. Pengusaha Kena Pajak yang berdasarkan hasil penelitian lapangan menunjukkan bahwa alamat tempat tinggal, tempat kedudukan, dan/atau tempat -60- kegiatan usaha tidak sesuai dengan keadaan yang sebenarnya; e. Pengusaha Kena Pajak orang pribadi yang telah meninggal dunia dan tidak meninggalkan warisan; dan/atau f. Pengusaha Kena Pajak bentuk usaha tetap yang telah menghentikan kegiatan usaha di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3560970b56 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_63_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3560970b56"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/63/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Atas permohonan penambahan status Wajib Pajak yang telah diterbitkan bukti penerimaan elektronik atau bukti penerimaan surat, Kepala Kantor Pelayanan Pajak tempat Wajib Pajak terdaftar melakukan penelitian administrasi atas permohonan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_357756f1e3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_69_3__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-357756f1e3"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/69/3..4"^^xsd:string ;
    kbr:hasSourceQuote "(3) Berdasarkan penelitian administrasi sebagaimana dimaksud pada ayat (1), Kepala Kantor Pelayanan Pajak menerbitkan keputusan berupa: a. surat penolakan pencabutan penetapan Pengusaha Kena Pajak Toko Retail untuk pencabutan penetapan atas penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf a; b. surat penolakan pencabutan penetapan Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan untuk pencabutan penetapan penambahan status Wajib -69- Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf b; c. surat penolakan pencabutan penetapan Pemungut Bea Meterai untuk pencabutan penetapan penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf c; dan d. surat penolakan pencabutan penetapan atau keterangan lainnya untuk pencabutan penetapan penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf e, dalam hal permohonan tidak memenuhi ketentuan perubahan atas status Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_36b7acf0d0 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_62_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-36b7acf0d0"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/62/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan mengenai persyaratan pemenuhan status Wajib Pajak sebagaimana dimaksud pada ayat (2) huruf a sampai dengan huruf e dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_379f6bba67 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_60 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-379f6bba67"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "Keputusan sebagaimana dimaksud pada ayat (2) disampaikan kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_37dbe2726a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_36 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-37dbe2726a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "a. dalam hal permohonan memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak diterbitkan bukti penerimaan surat;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_38ce2c175a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-38ce2c175a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Selain digunakan dalam administrasi pelaksanaan hak dan/atau pemenuhan kewajiban perpajakan sebagaimana dimaksud pada ayat (1), Nomor Pokok Wajib Pajak juga dapat digunakan dalam pelaksanaan administrasi pihak lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3a7749d3f1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_82 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3a7749d3f1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "b. dalam hal permohonan tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1), kepada Wajib Pajak tidak diterbitkan bukti penerimaan elektronik -77- dan permohonan Wajib Pajak tidak diproses lebih lanjut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3b1735813b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_7 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3b1735813b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Nomor identitas perpajakan berupa Nomor Induk Kependudukan sebagaimana dimaksud pada ayat (2) huruf a dapat digunakan secara langsung tanpa harus melalui permohonan atau secara jabatan sepanjang memenuhi ketentuan: a. dapat divalidasi sistem administrasi Direktorat Jenderal Pajak; dan b. belum diaktivasi sebagai Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3b7482cc7a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_85 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3b7482cc7a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/85"^^xsd:string ;
    kbr:hasSourceQuote "(1) Kepala Kantor Pelayanan Pajak dapat melakukan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan terhadap Objek Pajak yang sudah tidak memenuhi persyaratan subjektif sesuai dengan ketentuan peraturan perundang-undangan di bidang Pajak Bumi dan Bangunan secara jabatan, berdasarkan data dan/atau informasi yang dimiliki atau diperoleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3bf4e03af7 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_68_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3bf4e03af7"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/68/1..2"^^xsd:string ;
    kbr:hasSourceQuote "b. Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan sebagaimana diatur dalam Peraturan Menteri mengenai pedoman penghitungan pengkreditan pajak masukan bagi Pengusaha Kena Pajak yang mempunyai peredaran usaha tidak melebihi jumlah tertentu, mempunyai peredaran usaha sampai dengan suatu bulan dalam tahun buku melebihi Rp1.800.000.000,00 (satu miliar delapan ratus juta rupiah)"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3c36767a29 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_20 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3c36767a29"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Orang pribadi atau Badan yang menggunakan nomor identitas perpajakan sebagaimana dimaksud dalam Pasal 9 juga dapat melakukan aktivasi Akun Wajib Pajak, kecuali anak yang belum dewasa sebagaimana dimaksud dalam Pasal 9 huruf f."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3cc276c159 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_36 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3cc276c159"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan penetapan Wajib Pajak Nonaktif secara langsung atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir sebagaimana dimaksud dalam Pasal 34 ayat (5) dilakukan Wajib Pajak dengan: a. mengisi dan menandatangani formulir penetapan Wajib Pajak Nonaktif; dan b. melampirkan dokumen pendukung yang menunjukkan kriteria sebagaimana dimaksud dalam Pasal 34 ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3d81eeaced a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_69_1__2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3d81eeaced"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/69/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Atas permohonan pencabutan atas penambahan status Wajib Pajak yang telah diterbitkan bukti penerimaan elektronik atau bukti penerimaan surat, Kepala Kantor Pelayanan Pajak tempat Wajib Pajak terdaftar melakukan penelitian administrasi atas permohonan Wajib Pajak. (2) Berdasarkan penelitian administrasi sebagaimana dimaksud pada ayat (1), Kepala Kantor Pelayanan Pajak menerbitkan keputusan berupa: a. surat pencabutan penetapan Pengusaha Kena Pajak Toko Retail untuk pencabutan penetapan atas penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf a; b. surat pencabutan penetapan Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan untuk pencabutan penetapan atas penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf b; c. surat pencabutan penetapan Pemungut Bea Meterai untuk pencabutan penetapan penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf c; d. surat pencabutan keterangan dapat ditunjuk sebagai kuasa Wajib Pajak untuk pencabutan penetapan atas penambahan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf d; dan e. surat pencabutan penetapan atau keterangan lainnya untuk pencabutan status Wajib Pajak sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf e, dalam hal permohonan memenuhi ketentuan pencabutan status Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3de6923f0d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_52_1__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3de6923f0d"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/52/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal permohonan pengukuhan Pengusaha Kena Pajak diajukan oleh Pengusaha Badan yang menggunakan Kantor Virtual sebagai tempat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 51 ayat (1), permohonan sebagaimana dimaksud pada ayat (3) dilakukan dengan mengisi, menandatangani secara elektronik, dan menyampaikan formulir pengukuhan Pengusaha Kena Pajak dengan disertai: a. peta dan foto lokasi usaha; b. surat pernyataan tentang kegiatan usaha dan tempat kegiatan usaha yang sebenarnya; dan c. kontrak, perjanjian atau dokumen sejenis sebagaimana dimaksud dalam Pasal 51 ayat (5) huruf b, atau Pasal 51 ayat (6) huruf b."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3f5bfbcc3b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3f5bfbcc3b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "10. Nomor Induk Kependudukan adalah nomor identitas Penduduk yang bersifat unik atau khas, tunggal, dan melekat pada seseorang yang terdaftar sebagai Penduduk Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_3f79ddadd5 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_48 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-3f79ddadd5"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha yang sejak semula bermaksud melakukan penyerahan dan/atau ekspor sebagaimana diatur dalam Undang-Undang Pajak Pertambahan Nilai dapat melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_407f31b2d4 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_12 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-407f31b2d4"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "c. Wajib Pajak Badan wajib mendaftarkan diri paling lama 1 (satu) bulan setelah saat didirikan atau bertempat kedudukan di Indonesia;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_40e2006b26 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_38 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-40e2006b26"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "(3) Kepala Kantor Pelayanan Pajak menyampaikan surat pemberitahuan penetapan Wajib Pajak Nonaktif sebagaimana dimaksud pada ayat (1) kepada Wajib Pajak melalui : a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_42ee83a1fa a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_15_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-42ee83a1fa"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/15/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan pendaftaran Wajib Pajak melalui Portal Wajib Pajak, laman atau aplikasi lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak, dan/atau Contact Center sebagaimana dimaksud dalam Pasal 14 ayat (1) bagi orang pribadi yang merupakan Penduduk dilakukan dengan mengaktivasi Nomor Induk Kependudukan sebagai Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_446b663d05 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_1_p1 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-446b663d05"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "3. Undang-Undang Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah, yang selanjutnya disebut Undang-Undang Pajak Pertambahan Nilai adalah Undang-Undang Nomor 8 Tahun 1983 tentang Pajak -3- Pertambahan Nilai Barang dan Jasa dan Pajak Penjualan atas Barang Mewah sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 6 Tahun 2023 tentang Penetapan Peraturan Pemerintah Pengganti Undang-Undang Nomor 2 Tahun 2022 tentang Cipta Kerja menjadi Undang-Undang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_44db7c5346 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_10_7__9 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-44db7c5346"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/10/7..9"^^xsd:string ;
    kbr:hasSourceQuote "Instansi Pemerintah sebagaimana dimaksud pada ayat (1) huruf d wajib mendaftarkan diri pada Kantor Pelayanan Pajak yang wilayah kerjanya meliputi tempat kedudukan Instansi Pemerintah menurut keadaan yang sebenarnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_456794dde6 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_46_6__11 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-456794dde6"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/46/6..11"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang telah menerima keputusan penolakan penghapusan Nomor Pokok Wajib Pajak sebagaimana dimaksud pada ayat (5) huruf b dapat mengajukan kembali permohonan penghapusan Nomor Pokok Wajib Pajak dan permohonan tersebut merupakan permohonan baru."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_456f11db29 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_46_1__3 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-456f11db29"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/46/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan penghapusan Nomor Pokok Wajib Pajak secara langsung, atau melalui pos, perusahaan jasa ekspedisi, atau jasa kurir sebagaimana dimaksud dalam Pasal 44 ayat (8), dilakukan dengan: a. mengisi dan menandatangani formulir penghapusan Nomor Pokok Wajib Pajak; dan b. melampirkan dokumen pendukung sebagaimana dimaksud dalam Pasal 44 ayat (9)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_45b6081799 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_59 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-45b6081799"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/59"^^xsd:string ;
    kbr:hasSourceQuote "b. dalam hal permohonan tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1): 1. permohonan dikembalikan kepada Wajib Pajak secara langsung, untuk permohonan yang disampaikan secara langsung; atau 2. kepada Wajib Pajak diterbitkan surat pengembalian permohonan, untuk permohonan yang disampaikan melalui pos, perusahaan jasa ekspedisi atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_45b6a3b248 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_11 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-45b6a3b248"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "b. menetapkan tempat pendaftaran tertentu sebagai tempat pendaftaran Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_46b0aa1c5b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_46_6__11 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-46b0aa1c5b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/46/6..11"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak menyampaikan keputusan sebagaimana dimaksud pada ayat (5) dan ayat (7) kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_47031d8e57 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_20 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-47031d8e57"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak memberikan: a. Akun Wajib Pajak; dan b. Kode Otorisasi, serta menyampaikan surat penerbitan Akun Wajib Pajak dan surat penerbitan Kode Otorisasi Direktorat Jenderal Pajak kepada Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4748faa798 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_86_2__5 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4748faa798"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/86/2..5"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dokumen berupa: a. Kartu Nomor Pokok Wajib Pajak sebagaimana dimaksud dalam Pasal 15 ayat (5) huruf c, Pasal 15 ayat (10) huruf a angka 1, Pasal 16 ayat (4) huruf c, Pasal 16 ayat (10) huruf a, Pasal 18 ayat (1), Pasal 27 ayat (4), dan Pasal 30 ayat (2); b. Surat Keterangan Terdaftar sebagaimana dimaksud dalam Pasal 15 ayat (5) huruf c, Pasal 15 ayat (10) huruf a angka 2, Pasal 16 ayat (4) huruf c, Pasal 16 ayat (10) huruf b, Pasal 18 ayat (1), Pasal 27 ayat (4), dan Pasal 30 ayat (2); c. surat penolakan pendaftaran Wajib Pajak sebagaimana dimaksud dalam Pasal 15 ayat (10) huruf b dan Pasal 16 ayat (9) huruf b angka 2; d. surat keterangan aktivasi Nomor Induk Kependudukan sebagaimana dimaksud dalam -81- Pasal 15 ayat (5) huruf b, Pasal 16 ayat"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4903ad77cd a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_68_3__6 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4903ad77cd"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/68/3..6"^^xsd:string ;
    kbr:hasSourceQuote "(3) Permohonan pencabutan penetapan status Wajib Pajak sebagaimana dimaksud pada ayat (1) dilakukan secara: a. elektronik melalui Portal Wajib Pajak; atau b. langsung ke Kantor Pelayanan Pajak atau Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan, dalam hal Wajib Pajak tidak dapat mendaftarkan diri secara elektronik sebagaimana dimaksud pada huruf a, dan disampaikan dengan disertai dokumen yang disyaratkan. (4) Permohonan pencabutan penetapan status Wajib Pajak sebagaimana dimaksud pada ayat (3) dilakukan: a. secara elektronik melalui Portal Wajib Pajak sebagaimana dimaksud pada ayat (3) huruf a dengan: 1. mengisi, menandatangani secara elektronik dan menyampaikan formulir pencabutan status Wajib Pajak; dan 2. mengunggah salinan dokumen yang disyaratkan; atau b. secara langsung ke Kantor Pelayanan Pajak atau Kantor Pelayanan, Penyuluhan, dan Konsultasi Perpajakan sebagaimana dimaksud pada ayat ( 3) huruf b dengan: 1. mengisi dan menandatangani formulir pencabutan status Wajib Pajak; dan 2. melampirkan dokumen yang dipersyaratkan. (5) Dokumen yang disyaratkan sebagaimana dimaksud pada ayat (3) berupa salinan surat permohonan pencabutan penetapan Pemungut Bea Meterai dan surat pernyataan tidak lagi memenuhi kriteria sebagai Pemungut Bea Meterai, untuk Pemungut Bea Meterai sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf c. (6) Dikecualikan dari ketentuan untuk melampirkan dokumen yang dipersyaratkan sebagaimana dimaksud pada ayat (3), dalam hal pencabutan status Wajib Pajak: a. Pengusaha Kena Pajak Toko Retail yang berpartisipasi dalam skema pengembalian Pajak Pertambahan Nilai kepada turis asing sebagaimana dimaksud pada ayat (2) huruf a; b. Pengusaha Kena Pajak yang menggunakan pedoman penghitungan pengkreditan pajak masukan sebagaimana dimaksud pada ayat (2) huruf b; dan c. pihak yang ditunjuk sebagai kuasa Wajib Pajak sebagaimana dimaksud pada ayat (2) huruf d."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4a20cf1bc0 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_27 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4a20cf1bc0"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "b. surat penolakan perubahan data, dalam hal Wajib Pajak tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1)"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4a52383e65 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_16_1__4 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4a52383e65"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/16/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Aktivasi Nomor Induk Kependudukan sebagai Nomor Pokok Wajib Pajak sebagaimana dimaksud pada ayat (1) dilakukan dengan terlebih dahulu memvalidasi data Nomor Induk Kependudukan dengan basis data kependudukan melalui sistem administrasi Direktorat Jenderal Pajak yang terintegrasi dengan sistem administrasi kependudukan, pada saat permohonan diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4a90e5ffd1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_2 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4a90e5ffd1"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Untuk melaksanakan hak dan memenuhi kewajiban perpajakan, Wajib Pajak sebagaimana dimaksud pada ayat (5) harus melakukan perubahan data untuk mengaktivasi Nomor Induk Kependudukan sebagai Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4af9762f6c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_10_10__11 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4af9762f6c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/10/10..11"^^xsd:string ;
    kbr:hasSourceQuote "(1)) Dalam hal tempat kedudukan Instansi Pemerintah menurut keadaan sebenarnya sebagaimana dimaksud pada ayat (10) berada di luar wilayah Indonesia, Instansi Pemerintah dimaksud wajib mendaftarkan diri pada Kantor Pelayanan Pajak yang wilayah kerjanya meliputi tempat kedudukan kantor pusat Instansi Pemerintah yang berada di Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4b87fe74f8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_57 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4b87fe74f8"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "(3) Permohonan pencabutan pengukuhan Pengusaha Kena Pajak melalui Contact Center sebagaimana dimaksud pada ayat (2) huruf c merupakan permohonan pencabutan pengukuhan Pengusaha Kena Pajak yang dokumen pendukungnya dapat dikonfirmasi secara langsung oleh petugas Contact Center."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4b88b174fb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_81 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4b88b174fb"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "Dokumen pendukung sebagaimana dimaksud pada ayat (2) dan ayat (3) adalah dokumen sebagaimana dimaksud dalam Pasal 71 ayat (4) yang sudah berakhir dan tidak dilakukan perpanjangan masa berlakunya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4b8d18b09c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_84 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4b8d18b09c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "a. surat keputusan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan dalam hal permohonan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan telah memenuhi persyaratan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4c6f370650 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_71_4__7 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4c6f370650"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/71/4..7"^^xsd:string ;
    kbr:hasSourceQuote "(7) Nomor Objek Pajak sebagai identitas Objek Pajak sebagaimana dimaksud pada ayat (6) bersifat tetap dan tidak berubah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4d7acb727c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_30 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4d7acb727c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "b. melakukan pengawasan dalam rangka pengadministrasian Pengusaha Kena Pajak dengan melakukan penelitian lapangan, dalam hal Wajib Pajak tersebut telah berstatus Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4dd0852341 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_48 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4dd0852341"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/48"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha yang melakukan penyerahan dan/atau ekspor yang dikenai Pajak Pertambahan Nilai sebagaimana diatur dalam Undang-Undang Pajak Pertambahan Nilai, wajib melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_4f3c6b5858 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_84 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-4f3c6b5858"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "b. surat penolakan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan dalam hal permohonan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan tidak memenuhi persyaratan, paling lama 6 (enam) bulan sejak bukti penerimaan elektronik atau bukti penerimaan surat diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_50cea1b15a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_81 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-50cea1b15a"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/81"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak dapat melakukan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan terhadap Objek Pajak yang sudah tidak memenuhi persyaratan subjektif sesuai dengan ketentuan peraturan perundang-undangan di bidang Pajak Bumi dan Bangunan, berdasarkan permohonan Wajib Pajak atau secara jabatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_5246e3609c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_27 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-5246e3609c"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak menyampaikan keputusan sebagaimana dimaksud pada ayat (2) dan/atau Kartu Nomor Pokok Wajib Pajak, Surat Keterangan Terdaftar, dan/atau surat pengukuhan Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (4) kepada Wajib Pajak melalui: a. Akun Wajib Pajak; b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak; dan/atau c. pos, perusahaan jasa ekspedisi, atau jasa kurir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_52d51b8109 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_64 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-52d51b8109"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "(3) Keputusan sebagaimana dimaksud pada ayat (2) disampaikan kepada Wajib Pajak melalui: a. Akun Portal Wajib Pajak; dan b. alamat pos elektronik yang telah terdaftar di Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_52e4d8dc96 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_11 ;
