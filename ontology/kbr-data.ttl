    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_12 ;
    kbr:hasRuleId "R-PMK-2024-79-364a32aa26"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "KSO dan Anggota wajib melunasi dan melaporkan Pajak Penghasilan sesuai dengan ketentuan peraturan perundang- undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_79_37c3a89be0 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_6_1__7 ;
    kbr:hasRuleId "R-PMK-2024-79-37c3a89be0"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/6/1..7"^^xsd:string ;
    kbr:hasSourceQuote "Atas penyerahan sebagaimana dimaksud pada ayat (1) huruf a, Anggota yang merupakan Pengusaha Kena Pajak wajib membuat Faktur Pajak paling lambat pada saat KSO membuat Faktur Pajak atas penyerahan kepada Pelanggan sebagaimana dimaksud pada ayat (6)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_79_42b796ebb6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_79_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2024-79-42b796ebb6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-79#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "18. Surat Pemberitahuan adalah surat yang oleh Wajib Pajak digunakan untuk melaporkan penghitungan dan/ a tau pembayaran pajak, objek pajak dan/ atau bukan objek pajak, dan/ a tau harta dan kewajiban sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

