    kbr:hasSourceQuote "(6) Selain harus memenuhi ketentuan sebagaimana dimaksud pada ayat (3) dan ayat (5), Wajib Pajak juga harus memiliki surat keterangan fiskal secara otomasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

