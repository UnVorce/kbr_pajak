kbr:Aturan_R_PP_2022_50_1d4bdffb8c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_51 ;
    kbr:hasRuleId "R-PP-2022-50-1d4bdffb8c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "Keluarga sebagaimana dimaksud pada ayat (2) huruf c terdiri atas: a. suami; b. istri; atau c. keluarga sedarah atau semenda sampai dengan derajat kedua."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_1d4ef9a434 a kbr:Prosedur ;
