    kbr:hasSourceLocator "PP-2021-41#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Pegawai Badan Pengusahaan dapat berasal dari Pegawai ASN, Pegawai non-ASN, dan tenaga profesional."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_7a43833132 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2021_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_41_BT_31_1__2 ;
    kbr:hasRuleId "R-PP-2021-41-7a43833132"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/31/1..2"^^xsd:string ;
    kbr:hasSourceQuote "Perizinan Berusaha dari Badan Pengusahaan sebagaimana dimaksud pada ayat (1) berupa: a. pemasukan Barang Konsumsi untuk kebutuhan Penduduk; atau b. pemasukan danf atau pengeluaran barang, selain Barang Konsumsi untuk kebutuhan Penduduk."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_7bd7f8616b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2021_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_41_BT_55_1__11 ;
    kbr:hasRuleId "R-PP-2021-41-7bd7f8616b"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/55/1..11"^^xsd:string ;
    kbr:hasSourceQuote "Penyerahan Barang Kena Pajak tidak berwujud dan/atau Jasa Kena Pajak di KPBPB oleh pengusaha di KPBPB untuk dimanfaatkan di Tempat Penimbunan Berikat, dipungut PPN."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_7c16b5c6b5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2021_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_41_BT_1_p3 ;
    kbr:hasRuleId "R-PP-2021-41-7c16b5c6b5"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "30. Pegawai Negeri Sipil yang selanjutnya disingkat PNS adalah warga negara Indonesia yang memenuhi syarat tertentu, diangkat sebagai Pegawai ASN secara tetap oleh pejabat pembina kepegawaian untuk menduduki jabatan pemerintahan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_7ca5902d53 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2021_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_41_BT_33 ;
    kbr:hasRuleId "R-PP-2021-41-7ca5902d53"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Untuk kepentingan pengawasan, pejabat bea dan cukai berwenang melakukan pemeriksaan atas pengeluaran Barang Konsumsi berupa barang kiriman, barang penumpang, atau barang awak sarana pengangkut sebagaimana dimaksud pada ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_7ce7c8d125 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2021_41 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_41_BT_31_1__2 ;
    kbr:hasRuleId "R-PP-2021-41-7ce7c8d125"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/31/1..2"^^xsd:string ;
    kbr:hasSourceQuote "Badan Pengusahaan melakukan pengawasan terhadap kesesuaian jumlah dan jenis Barang Konsumsi yang telah dimasukkan oleh pengusaha sesuai dengan Perizinan Berusaha sebagaimana dimaksud pada ayat (2) huruf a."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_41_7d7a669db2 a kbr:Prosedur ;
