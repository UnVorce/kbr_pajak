    kbr:hasSourceLocator "UU-1983-6#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "(1c) Direktur . . . - 50 - (1c) Direktur Jenderal Pajak dalam jangka waktu paling lama 6 (enam) bulan sejak tanggal permohonan sebagaimana dimaksud pada ayat (1) diterima, harus memberi keputusan atas permohonan yang diajukan."^^xsd:string ;
