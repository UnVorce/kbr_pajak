    kbr:hasRuleId "R-PP-2022-50-974b7d105c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/7/6..6"^^xsd:string ;
    kbr:hasSourceQuote "l71 Tata cara pengungkapan ketidakbenaran perbuatan oleh Wajib Pajak dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_97a01a5d5e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_44_1__8 ;
    kbr:hasRuleId "R-PP-2022-50-97a01a5d5e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/44/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Surat Pemberitahuan yang menyatakan lebih bayar sebagaimana dimaksud pada ayat (2) menrpakan Surat Pemberitahuan yang menyatakan lebih bayar dengan permohonan pengembalian kelebihan pembayaran pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_985d66434a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_2 ;
    kbr:hasRuleId "R-PP-2022-50-985d66434a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Kewajiban mendaftarkan diri sebagaimana dimaksud pada ayat (1) berlaku pula terhadap wanita kawin yang dikenai pajak secara terpisah karena: a. hidup terpisah berdasarkan keputusan hakim; b. melakukan perjanjian pemisahan penghasilan dan harta dengan suami, secara tertulis; atau c. ingin melaksanakan hak dan memenuhi kewajiban perpajakan terpisah dari hak dan kewajiban perpajakan suami."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_98d01b25f1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p3 ;
    kbr:hasRuleId "R-PP-2022-50-98d01b25f1"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Data Balikan dari Pengguna adalah data yang bersifat unik dari setiap lembaga pengguna yang telah melakukan akses Data Kependudukan dan telah diadministrasikan dalam sistem administrasi kependudukan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_9b06117e89 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_44_1__8 ;
    kbr:hasRuleId "R-PP-2022-50-9b06117e89"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/44/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak diberi imbalan bunga dalam hal pengajuan keberatan, permohonan banding, atau permohonan peninjauan kembali, dikabulkan sebagian atau seluruhnya sehingga menyebabkan kelebihan pembayaran pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

