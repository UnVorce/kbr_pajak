kbr:Aturan_R_PP_2009_32_1294c472fe a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42 ;
    kbr:hasRuleId "R-PP-2009-32-1294c472fe"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Kawasan Daur Ulang Berikat dan pengusaha di Kawasan Daur Ulang Berikat wajib melakukan pengendalian pencemaran lingkungan sesuai dengan ketentuan peraturan perundang-undangan di bidang lingkungan hidup."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_12d421db51 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_2 ;
    kbr:hasRuleId "R-PP-2009-32-12d421db51"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Tempat Penimbunan Berikat sebagaimana dimaksud pada ayat (1) merupakan Kawasan Pabean dan sepenuhnya berada di bawah pengawasan Direktorat Jenderal Bea dan Cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_1333f36160 a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_16 ;
    kbr:hasRuleId "R-PP-2009-32-1333f36160"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "d. telah melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan telah menyampaikan Surat Pemberitahuan Tahunan Pajak Penghasilan tahun pajak terakhir bagi yang sudah wajib menyampaikan Surat Pemberitahuan Tahunan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_13b65092b9 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42A_3__7 ;
    kbr:hasRuleId "R-PP-2009-32-13b65092b9"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42A/3..7"^^xsd:string ;
    kbr:hasSourceQuote "Barang yang dimasukkan dari Tempat Penimbunan Berikat selain Pusat Logistik Berikat ke Pusat Logistik Berikat, berupa: a. barang asal luar daerah pabean: 1. diberikan penangguhan Bea Masuk; 2. tidak dipungut Pajak Dalam Rangka Impor; 3. diberikan pembebasan Cukai; dan/atau 4. tidak dipungut Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah; b. barang . . . - 18 - b. barang asal tempat lain dalam daerah pabean, tidak dipungut Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_192b76908a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_1 ;
    kbr:hasRuleId "R-PP-2009-32-192b76908a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal adalah Direktur Jenderal Bea dan Cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_1c06dfca40 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_11 ;
    kbr:hasRuleId "R-PP-2009-32-1c06dfca40"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Barang impor yang ditimbun di Gudang Berikat dapat dikeluarkan untuk: a. mendukung kegiatan industri di Kawasan Berikat, KEK, Kawasan Bebas, Kawasan ekonomi lainnya yang ditetapkan oleh pemerintah dan/atau tempat lain dalam daerah pabean; b. dimasukkan ke Gudang Berikat lainnya dan/atau Toko Bebas Bea; c. diekspor; dan/atau d. mendukung kegiatan industri yang mendapat fasilitas pembebasan Bea Masuk, tidak dipungut Pajak Dalam Rangka Impor, dan/atau pengembalian Bea Masuk berdasarkan ketentuan perundang-undangan di bidang Kepabeanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_1c7e061257 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_35 ;
    kbr:hasRuleId "R-PP-2009-32-1c7e061257"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/35"^^xsd:string ;
    kbr:hasSourceQuote "Barang sebagaimana dimaksud pada ayat (1) dan ayat (2), bukan merupakan barang untuk dikonsumsi di Tempat Lelang Berikat yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_2235c636dc a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_19_8__9 ;
    kbr:hasRuleId "R-PP-2009-32-2235c636dc"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/19/8..9"^^xsd:string ;
    kbr:hasSourceQuote "(9) Ketentuan lebih lanjut mengenai jangka waktu pengeluaran barang dalam rangka subkontrak sebagaimana dimaksud pada ayat (5) diatur dengan Peraturan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_22bc557bb0 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_31 ;
    kbr:hasRuleId "R-PP-2009-32-22bc557bb0"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "Penetapan tempat sebagai Toko Bebas Bea dan pemberian izin penyelenggara Toko Bebas Bea sekaligus pengusaha Toko Bebas Bea untuk jangka waktu tertentu ditetapkan dengan Keputusan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_23216abeac a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_14_1__6 ;
    kbr:hasRuleId "R-PP-2009-32-23216abeac"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/14/1..6"^^xsd:string ;
    kbr:hasSourceQuote "pengusaha Tempat Penimbunan Berikat wajib membuat faktur pajak yang dibubuhi cap Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas barang Mewah tidak dipungut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_25639a3ef4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_35 ;
    kbr:hasRuleId "R-PP-2009-32-25639a3ef4"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/35"^^xsd:string ;
    kbr:hasSourceQuote "Barang yang dimasukkan dari luar Daerah Pabean ke Tempat Lelang Berikat: a. diberikan . . . - 15 - a. diberikan penangguhan Bea Masuk; b. tidak dipungut Pajak Dalam Rangka Impor; dan/atau c. diberikan pembebasan cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_2856a6b46d a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_45 ;
    kbr:hasRuleId "R-PP-2009-32-2856a6b46d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/45"^^xsd:string ;
    kbr:hasSourceQuote "Penetapan Tempat Penimbunan Berikat dan izin penyelenggaraan atau pengusahaan di Tempat Penimbunan Berikat dicabut dalam hal penyelenggara dan/atau pengusaha Tempat Penimbunan Berikat: a. tidak melakukan kegiatan dalam jangka waktu 12 (dua belas) bulan secara terus menerus; b. dinyatakan . . . b. dinyatakan pailit; c. izin usaha yang dimilikinya tidak berlaku lagi; d. bertindak tidak jujur dalam usahanya; atau e. mengajukan permohonan pencabutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_28d221afda a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_46A ;
    kbr:hasRuleId "R-PP-2009-32-28d221afda"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/46A"^^xsd:string ;
    kbr:hasSourceQuote "Pengeluaran barang asal luar daerah pabean untuk diimpor untuk dipakai dari Tempat Penimbunan Berikat ke tempat lain dalam daerah pabean berlaku ketentuan pembatasan di bidang impor, kecuali sudah dipenuhi pada saat pemasukannya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_29630e8b36 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_9 ;
    kbr:hasRuleId "R-PP-2009-32-29630e8b36"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Untuk mendapatkan izin pengusaha Gudang Berikat sebagaimana dimaksud pada ayat (1), pihak yang akan menjadi pengusaha Gudang Berikat harus memenuhi persyaratan sebagai berikut: a. memiliki bukti kepemilikan atau penguasaan suatu tempat, atau bangunan yang mempunyai batas-batas yang jelas berikut peta lokasi/tempat dan rencana tata letak/denah; b. memiliki . . . b. memiliki Surat Izin Usaha Perdagangan, Dokumen Lingkungan Hidup, dan izin lainnya yang diperlukan dari instansi teknis terkait; dan c. telah melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan telah menyampaikan Surat Pemberitahuan Tahunan Pajak Penghasilan tahun pajak terakhir bagi yang sudah wajib menyampaikan Surat Pemberitahuan Tahunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_2cc5da4244 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_7 ;
    kbr:hasRuleId "R-PP-2009-32-2cc5da4244"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal barang sebagaimana dimaksud pada ayat (1) dan ayat (2) asal impor dikeluarkan ke tempat lain dalam daerah pabean dengan tujuan diimpor untuk dipakai, pengusaha Gudang Berikat atau pengusaha di Gudang Berikat wajib melunasi Bea Masuk dan Pajak Dalam Rangka Impor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_2ed14a0bc9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_21 ;
    kbr:hasRuleId "R-PP-2009-32-2ed14a0bc9"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "Penyelenggara Tempat Penyelenggaraan Pameran Berikat sebagaimana dimaksud pada ayat (3) melakukan kegiatan penyediaan dan pengelolaan kawasan untuk kegiatan pengusahaan Tempat Penyelenggaraan Pameran Berikat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_2f9a977ca5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_4 ;
    kbr:hasRuleId "R-PP-2009-32-2f9a977ca5"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Pengeluaran barang dari Tempat Penimbunan Berikat dengan tujuan ke KEK sebagaimana dimaksud pada ayat (1) huruf d, Kawasan Bebas sebagaimana dimaksud pada ayat (1) huruf e, dan Kawasan ekonomi lainnya yang ditetapkan oleh Pemerintah sesuai ketentuan perundang-undangan sebagaimana dimaksud pada ayat (1) huruf f diatur lebih lanjut oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_31a5587461 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_22 ;
    kbr:hasRuleId "R-PP-2009-32-31a5587461"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Pengusahaan Tempat Penyelenggaraan Pameran Berikat sementara, dilakukan oleh pengusaha Tempat Penyelenggaraan Pameran Berikat sementara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

