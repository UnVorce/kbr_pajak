    kbr:hasSourceQuote "Wajib Pajak harus memenuhi permintaan sebagaimana dimaksud pada ayat (4) huruf a paling lama 15 (lima belas) hari kerja sejak tanggal surat permintaan dikirim."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
