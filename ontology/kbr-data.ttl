    kbr:hasRuleId "R-PP-2010-79-b91e46ea2e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "Untuk mendorong pengembangan Wilayah Kerja, Menteri dapat menetapkan bentuk dan besaran Insentif Kegiatan Usaha Hulu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_bbd93cca09 a kbr:Prosedur ;
