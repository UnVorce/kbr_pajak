    kbr:hasSourceQuote "Rugi GloBE dari Bentuk Usaha Tetap harus dibukukan sebagai biaya Entitas Utama (Main Entity) untuk tujuan penghitungan Laba atau Rugi GloBE dengan ketentuan:"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

