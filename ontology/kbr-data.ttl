    kbr:hasSourceQuote "b. untuk yang diimpor: 1. 275% (dua ratus tujuh puluh lima persen) dari harga dasar apabila harga dasar yang digunakan adalah nilai pabean ditambah bea masuk; atau 2. 57% (lima puluh tujuh persen) dari harga dasar apabila harga dasar yang digunakan adalah harga jual eceran."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_fd94692854 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
