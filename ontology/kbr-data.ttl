    kbr:hasRuleId "R-PP-2021-41-64a728b03d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/38"^^xsd:string ;
    kbr:hasSourceQuote "Pemberitahuan Pabean sebagaimana dimaksud pada ayat (1) disampaikan dalam bentuk data elektronik melalui sistem pertukaran data elektronik kepabeanan yang terhubung dengan Indonesia National Single Window (INSW)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

