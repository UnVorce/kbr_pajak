    kbr:hasSourceLocator "PMK-2019-186#BT/24"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal tidak terdapat harga jual rata-rata mineral logam sebagaimana dimaksud dalam Pasal 22 ayat (4), harga jual mineral logam menggunakan HPM Logam rata-rata dalam tahun terakhir sebelum Tahun Pajak PBB terutang."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
