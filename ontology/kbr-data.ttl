    kbr:hasSourceQuote "2,62% (dua koma enam dua persen) untuk kepemilikan dan/atau penguasaan Kendaraan Bermotor keempat;"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_d229ab1479 a kbr:Sanksi ;
