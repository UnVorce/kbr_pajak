kbr:Aturan_R_PMK_2024_81_bf12e4a72f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_380 ;
    kbr:hasRuleId "R-PMK-2024-81-bf12e4a72f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/380"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Masukan yang tidak dilaporkan dalam Surat Pemberitahuan Masa Pajak Pertambahan Nilai yang diberitahukan dan/atau ditemukan pada waktu dilakukan Pemeriksaan sebagaimana dimaksud pada ayat (1) yaitu Pajak Pertambahan Nilai yang tercantum dalam: a. Faktur Pajak; dan/atau b. dokumen tertentu yang kedudukannya dipersamakan dengan Faktur Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_bf420893c7 a kbr:Definisi ;
