    kbr:hasRuleId "R-PMK-2010-68-ac73d4724c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-68#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Jumlah peredaran bruto dan/atau penerimaan bruto sebagaimana dimaksud pada ayat (1) adalah jumlah keseluruhan penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak yang dilakukan oleh pengusaha dalam rangka kegiatan usahanya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2010_68_b6da370f3a a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2010_68 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2010_68_BT_2 ;
    kbr:hasRuleId "R-PMK-2010-68-b6da370f3a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-68#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha kecil sebagaimana dimaksud dalam Pasal 1 ayat (1) tidak wajib melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan tidak wajib memungut, menyetor, dan melaporkan Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah yang terutang atas penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak yang dilakukannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2010_68_c4fc23dddd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2010_68 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2010_68_BT_4 ;
    kbr:hasRuleId "R-PMK-2010-68-c4fc23dddd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-68#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pengusaha wajib melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak, apabila sampai dengan suatu bulan dalam tahun buku jumlah peredaran bruto dan/atau penerimaan brutonya melebihi Rp4.800.000.000,00 (empat miliar delapan ratus juta rupiah). (2) Kewajiban melaporkan usaha untuk dikukuhkan sebagai Pengusaha Kena Pajak sebagaimana dimaksud pada ayat (1) dilakukan paling lama akhir bulan berikutnya setelah bulan saat www.djpp.kemenkumham.go.id 2013, No.1521 3 jumlah peredaran bruto dan/atau penerimaan brutonya melebihi Rp4.800.000.000,00 (empat miliar delapan ratus juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2010_68_e41432bdd8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2010_68 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2010_68_BT_7 ;
    kbr:hasRuleId "R-PMK-2010-68-e41432bdd8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-68#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pengusaha telah dikukuhkan sebagai Pengusaha Kena Pajak dan jumlah peredaran bruto dan/atau penerimaan brutonya dalam 1 (satu) tahun buku tidak melebihi Rp4.800.000.000,00 (empat miliar delapan ratus juta rupiah), Pengusaha Kena Pajak dapat mengajukan permohonan pencabutan pengukuhan sebagai Pengusaha Kena Pajak"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2014_111_007b80f733 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2014_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2014_111_BT_30 ;
    kbr:hasRuleId "R-PMK-2014-111-007b80f733"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2014-111#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Keberatan sebagaimana dimaksud pada ayat (1) tidak membatalkan keputusan mengenai pembekuan atau pencabutan Izin Praktik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2014_111_02643b345c a kbr:Kewajiban ;
