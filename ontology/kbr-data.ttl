    kbr:hasSourceLocator "PMK-2024-136#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "24. Kepemilikan Saham Portofolio adalah kepemilikan dalam suatu Entitas yang dimiliki oleh Grup PMN yang memberikan hak kurang dari 10% atas keuntungan,"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
