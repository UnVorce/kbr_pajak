    kbr:hasSourceLocator "UU-1995-10#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penetapan sebagaimana dimaksud pada ayat (1) dan/atau ayat (2) mengakibatkan kelebihan pembayaran bea masuk, pengembalian bea masuk dibayar sebesar kelebihannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_a8bc80b6d4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_82 ;
    kbr:hasRuleId "R-UU-1995-10-a8bc80b6d4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat bea dan cukai berwenang meminta importir, eksportir, pengangkut, pengusaha tempat penimbunan sementara, pengusaha tempat penimbunan berikat, atau yang mewakilinya menyerahkan barang untuk diperiksa, membuka sarana pengangkut atau bagiannya, dan membuka setiap bungkusan atau pengemas yang akan diperiksa."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_a935c0403d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_65 ;
    kbr:hasRuleId "R-UU-1995-10-a935c0403d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/65"^^xsd:string ;
    kbr:hasSourceQuote "barang sebagaimana dimaksud pada ayat (1) disimpan di Tempat Penimbunan Pabean dan dipungut sewa gudang yang ditetapkan oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_a94fd6c85c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_93A ;
    kbr:hasRuleId "R-UU-1995-10-a94fd6c85c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/93A"^^xsd:string ;
    kbr:hasSourceQuote "Apabila jaminan sebagaimana dimaksud pada ayat (1) berupa uang tunai dan pengembalian jaminan sebagaimana dimaksud pada ayat (5) dan ayat (6) dilakukan setelah jangka waktu 30 (tiga puluh) hari sejak keberatan diterima, pemerintah memberikan bunga sebesar 2% (dua persen) setiap bulannya paling lama 24 (dua puluh empat) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

