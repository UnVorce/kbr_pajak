    kbr:hasRuleId "R-UU-1995-10-88cf16b118"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/109"^^xsd:string ;
    kbr:hasSourceQuote "Sarana pengangkut yang digunakan untuk melakukan tindak pidana sebagaimana dimaksud dalam Pasal 102D, dapat dirampas untuk negara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
