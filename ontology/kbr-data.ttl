    kbr:hasSourceQuote "a. pegawai sebagaimana dimaksud pada ayat (2) huruf a merupakan pegawai tetap, termasuk kontraktor independen yang melakukan aktivitas operasi rutin Entitas Konstituen;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
