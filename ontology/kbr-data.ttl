    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai sinergi sebagaimana dimaksud pada ayat (2), diatur dalam Peraturan Gubernur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_4358d9f8af a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_10 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-4358d9f8af"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(1) PKB dikenakan untuk 12 (dua belas) bulan berturut-turut terhitung sejak tanggal pendaftaran Kendaraan Bermotor. (2) Dalam hal terjadi keadaan kahar (force majeure) sehingga Kepemilikan dan/atau Penguasaan Kendaraan Bermotor tidak sampai 12 (dua belas) bulan, dapat dilakukan pengembalian Pajak yang sudah dibayar untuk porsi jangka waktu yang belum dilalui."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_4359853265 a kbr:Kewajiban ;
