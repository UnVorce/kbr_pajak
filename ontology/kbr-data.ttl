    kbr:hasSourceQuote "Besaran pokok Opsen PKB dan Opsen BBNKB yang terutang dihitung dengan cara mengalikan tarif Pajak sebesar 66% (enam puluh enam persen) dengan dasar pengenaan Pajak sebagaimana dimaksud dalam Pasal 44 ayat (1) dan Pasal 47 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_APPROVED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_80a385c82d a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
