    kbr:hasSourceLocator "UU-1997-19#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal penyitaan dilaksanakan terhadap barang yang kepemilikannya terdaftar, tindasan Surat Pencabutan Sita disampaikan kepada instansi tempat barang tersebut terdaftar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_34b09b0910 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_12 ;
    kbr:hasRuleId "R-UU-1997-19-34b09b0910"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penyitaan dilaksanakan tidak dihadiri oleh Penanggung Pajak sebagaimana dimaksud dalam ayat (4), Berita Acara Pelaksanaan Sita ditandatangani Jurusita Pajak dan saksi-saksi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_398f58cb47 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_25 ;
    kbr:hasRuleId "R-UU-1997-19-398f58cb47"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/25"^^xsd:string ;
    kbr:hasSourceQuote "Barang yang disita sebagaimana dimaksud dalam ayat (2) digunakan untuk membayar biaya penagihan pajak dan utang pajak dengan cara : a. uang tunai disetor ke Kas Negara atau Kas Daerah; b. deposito berjangka, tabungan, saldo rekening koran, giro, atau bentuk lainnya yang dipersamakan dengan itu, dipindahbukukan ke Kas Negara atau Kas Daerah atas permintaan Pejabat kepada Bank yang bersangkutan; c. obligasi, saham, atau surat berharga lainnya yang diperdagangkan di bursa efek dijual di bursa efek atas permintaan Pejabat; d. obligasi, saham, atau surat berharga lainnya yang tidak diperdagangkan di bursa efek segera dijual oleh Pejabat; e. piutang dibuatkan berita acara persetujuan tentang pengalihan hak menagih dari Penanggung Pajak kepada Pejabat; f. penyertaan modal pada perusahaan lain dibuatkan akte persetujuan pengalihan hak menjual dari Penanggung Pajak kepada Pejabat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_3a0206060d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_28 ;
    kbr:hasRuleId "R-UU-1997-19-3a0206060d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Hak Penanggung Pajak atas barang yang telah dilelang berpindah kepada pembeli dan kepadanya diberikan Risalah Lelang yang merupakan bukti otentik sebagai dasar pendaftaran dan pengalihan hak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_3b4a2aeef1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_15 ;
    kbr:hasRuleId "R-UU-1997-19-3b4a2aeef1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal barang yang disita mudah rusak atau cepat busuk, dikecualikan dari penjualan secara lelang."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_3fc0ade010 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_28 ;
    kbr:hasRuleId "R-UU-1997-19-3fc0ade010"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Sisa barang beserta kelebihan uang hasil lelang dikembalikan oleh Pejabat kepada Penanggung Pajak segera setelah pelaksanaan lelang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_44d7b5c323 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_34 ;
    kbr:hasRuleId "R-UU-1997-19-44d7b5c323"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Penanggung Pajak tidak dapat mengajukan gugatan terhadap pelaksanaan penyanderaan setelah masa penyanderaan berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_45455e8872 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_15 ;
    kbr:hasRuleId "R-UU-1997-19-45455e8872"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Barang bergerak milik Penanggung Pajak yang dikecualikan dari penyitaan adalah : a. pakaian dan tempat tidur beserta perlengkapannya yang digunakan oleh Penanggung Pajak dan keluarga yang menjadi tanggungannya; b. persediaan makanan dan minuman untuk keperluan satu bulan beserta peralatan memasak yang berada di rumah; c. perlengkapan Penanggung Pajak yang bersifat dinas yang diperoleh dari negara; d. buku-buku yang bertalian dengan jabatan atau pekerjaan Penanggung Pajak dan alat-alat yang dipergunakan untuk pendidikan, kebudayaan dan keilmuan; e. peralatan dalam keadaan jalan yang masih digunakan untuk melaksanakan pekerjaan atau usaha sehari-hari dengan jumlah seluruhnya tidak lebih dari Rp 20.000.000,00 (dua puluh juta rupiah); atau f. peralatan penyandang cacat yang digunakan oleh Penanggung Pajak dan keluarga yang menjadi tanggungannya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_455c51f3cd a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_19 ;
    kbr:hasRuleId "R-UU-1997-19-455c51f3cd"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Penyitaan tidak dapat dilaksanakan terhadap barang yang telah disita oleh Pengadilan Negeri atau instansi lain yang berwenang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_45d98b7273 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_30 ;
    kbr:hasRuleId "R-UU-1997-19-45d98b7273"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "(4) Keputusan pencegahan sebagaimana dimaksud pada ayat (1) disampaikan kepada Penanggung Pajak yang dikenakan pencegahan, Menteri Kehakiman, Pejabat yang memohon pencegahan, atasan Pejabat yang bersangkutan, dan Kepala Daerah setempat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_464595797a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_20 ;
    kbr:hasRuleId "R-UU-1997-19-464595797a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "(3) Pejabat yang diminta bantuan sebagaimana dimaksud dalam ayat (1) dan ayat (2) memberitahukan pelaksanaan Surat Perintah Melaksanakan Penyitaan dimaksud kepada Pejabat yang meminta bantuan segera setelah penyitaan dilaksanakan dengan mengirimkan Berita Acara Pelaksanaan Sita."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_4be860aa47 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1997-19-4be860aa47"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "9. Penagihan Pajak adalah serangkaian tindakan agar Penanggung Pajak melunasi utang pajak dan biaya penagihan pajak dengan menegur atau memperingatkan, melaksanakan penagihan seketika dan sekaligus, memberitahukan Surat Paksa, mengusulkan pencegahan, melaksanakan penyitaan, melaksanakan penyanderaan, menjual barang yang telah disita."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_4d52f7d5d2 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_17 ;
    kbr:hasRuleId "R-UU-1997-19-4d52f7d5d2"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/17"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal penyitaan dilaksanakan terhadap barang tidak bergerak yang kepemilikannya belum terdaftar, Jurusita Pajak menyampaikan salinan Berita Acara Pelaksanaan Sita kepada Pemerintah Daerah dan Pengadilan Negeri setempat untuk diumumkan menurut cara yang lazim di tempat itu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_4eebd3d8f2 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_10_7__12 ;
    kbr:hasRuleId "R-UU-1997-19-4eebd3d8f2"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/10/7..12"^^xsd:string ;
    kbr:hasSourceQuote "(12) Pengajuan keberatan oleh Wajib Pajak tidak mengakibatkan penundaan pelaksanaan Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_533e5fdb50 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_26 ;
    kbr:hasRuleId "R-UU-1997-19-533e5fdb50"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(6) Pejabat dan Jurusita Pajak yang melanggar ketentuan sebagaimana dimaksud dalam ayat (4), dikenakan sanksi sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_545f754075 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_41 ;
    kbr:hasRuleId "R-UU-1997-19-545f754075"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/41"^^xsd:string ;
    kbr:hasSourceQuote "Penagihan pajak tidak dilaksanakan apabila telah daluwarsa sebagaimana diatur dalam undang-undang dan peraturan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_548026d36a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_15 ;
    kbr:hasRuleId "R-UU-1997-19-548026d36a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Perubahan besarnya nilai peralatan sebagaimana dimaksud dalam ayat (1) huruf e ditetapkan dengan Keputusan Menteri atau Keputusan Kepala Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_559b8d2e41 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_10_7__12 ;
    kbr:hasRuleId "R-UU-1997-19-559b8d2e41"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/10/7..12"^^xsd:string ;
    kbr:hasSourceQuote "(8) Dalam hal Wajib Pajak atau Penanggung Pajak tidak diketahui tempat tinggalnya, tempat usaha, atau tempat kedudukannya, penyampaian Surat Paksa dilaksanakan dengan cara menempelkan Surat Paksa pada papan pengumuman kantor Pejabat yang menerbitkannya, mengumumkan melalui media massa, atau cara lain yang ditetapkan dengan Keputusan Menteri atau Keputusan Kepala Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_55afc7ec43 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1997-19-55afc7ec43"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "3. Penanggung Pajak adalah orang pribadi atau badan yang bertanggung jawab atas pembayaran pajak, termasuk wakil yang menjalankan hak dan memenuhi kewajiban Wajib Pajak menurut ketentuan peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_56cd5e767f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_10_7__12 ;
    kbr:hasRuleId "R-UU-1997-19-56cd5e767f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/10/7..12"^^xsd:string ;
    kbr:hasSourceQuote "(7) Apabila pemberitahuan Surat Paksa sebagaimana dimaksud dalam ayat (3) dan ayat (4) tidak dapat dilaksanakan, Surat Paksa disampaikan melalui Pemerintah Daerah setempat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_5cfe4ccb81 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_22 ;
    kbr:hasRuleId "R-UU-1997-19-5cfe4ccb81"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pencabutan sita sebagaimana dimaksud dalam ayat (1) dilaksanakan berdasarkan Surat Pencabutan Sita yang diterbitkan oleh Pejabat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_5ed273d294 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_12 ;
    kbr:hasRuleId "R-UU-1997-19-5ed273d294"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Atas barang yang disita dapat ditempel atau diberi segel sita."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_5f088433be a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_12 ;
    kbr:hasRuleId "R-UU-1997-19-5f088433be"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Penanggung Pajak adalah Badan maka Berita Acara Pelaksanaan Sita ditandatangani oleh pengurus, kepala perwakilan, kepala cabang, penanggung jawab, pemilik modal atau pegawai tetap perusahaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_60c3b3305f a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_26 ;
    kbr:hasRuleId "R-UU-1997-19-60c3b3305f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(1a) Pengumuman lelang sebagaimana dimaksud dalam ayat (1) dilaksanakan paling singkat 14 (empat belas) hari setelah penyitaan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_610359ea6a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_5 ;
    kbr:hasRuleId "R-UU-1997-19-610359ea6a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jurusita Pajak bertugas : a. melaksanakan Surat Perintah Penagihan Seketika dan Sekaligus; b. memberitahukan Surat Paksa; c. melaksanakan penyitaan atas barang Penangung Pajak berdasarkan Surat Perintah Melaksanakan Penyitaan; dan d. melaksanakan penyanderaan berdasarkan Surat Perintah Penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_6780883a6f a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_41 ;
    kbr:hasRuleId "R-UU-1997-19-6780883a6f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/41"^^xsd:string ;
    kbr:hasSourceQuote "Gugatan sebagaimana dimaksud dalam Pasal 34 ayat (3) dan dalam Pasal 37 ayat (1) tidak menunda pelaksanaan penagihan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_67f59ef1bf a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_33 ;
    kbr:hasRuleId "R-UU-1997-19-67f59ef1bf"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Penyanderaan tidak boleh dilaksanakan dalam hal Penanggung Pajak sedang beribadah, atau sedang mengikuti sidang resmi, atau sedang mengikuti Pemilihan Umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_6bcfa367c7 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_12 ;
    kbr:hasRuleId "R-UU-1997-19-6bcfa367c7"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Salinan Berita Acara Pelaksanaan Sita dapat ditempelkan pada barang bergerak atau barang tidak bergerak yang disita, atau di tempat barang bergerak atau barang tidak bergerak yang disita berada, dan atau di tempat-tempat umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_6cfaa60059 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_6 ;
    kbr:hasRuleId "R-UU-1997-19-6cfaa60059"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "(3) Surat Perintah Penagihan Seketika dan Sekaligus diterbitkan sebelum penerbitan Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_6fb33d35aa a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_19 ;
    kbr:hasRuleId "R-UU-1997-19-6fb33d35aa"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Pengadilan Negeri atau instansi lain yang berwenang menentukan pembagian hasil penjualan barang dimaksud berdasarkan ketentuan hak mendahulu Negara untuk tagihan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1997_19_6fd8fb78f3 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1997_19 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1997_19_BT_33 ;
    kbr:hasRuleId "R-UU-1997-19-6fd8fb78f3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1997-19#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Masa penyanderaan paling lama 6 (enam) bulan dan dapat diperpanjang untuk selama-lamanya 6 (enam) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

