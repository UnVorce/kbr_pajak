    kbr:hasSourceQuote "Wajib Retribusi yang tidak melaksanakan kewajiban membayar atas layanan yang digunakan/dinikmati, sehingga merugikan Keuangan Daerah, diancam dengan pidana kurungan sesuai ketentuan peraturan perundang- undangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

