    kbr:hasSourceQuote "(2) Termasuk dalam cakupan zakat atas penghasilan sebagaimana dimaksud pada ayat (1) huruf a, yaitu zakat mal sesuai dengan peraturan perundang-undangan di bidang pengelolaan zakat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

