    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_32 ;
    kbr:hasRuleId "R-PMK-2023-96-6228c74f9a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "Penetapan sebagaimana dimaksud pada ayat (1) dilakukan paling lama 30 (tiga puluh) hari sejak tanggal PIBK dengan menerbitkan Surat Penetapan Tarif dan/atau Nilai Pabean (SPTNP)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_627a407bb8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_49 ;
    kbr:hasRuleId "R-PMK-2023-96-627a407bb8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "Konsolidasi Barang Kiriman atas beberapa pemberitahuan ekspor barang dan/ atau CN sebagaimana dimaksud dalam Pasal 48 ayat ( 1) yang menggunakan · peti kemas disampaikan oleh konsolidator dengan pemberitahuan konsolidasi barang ekspor kepada Pejabat Bea dan Cukai melalui SKP di Kantor Pabean pemuatan ekspor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_62c73ddebf a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_51 ;
    kbr:hasRuleId "R-PMK-2023-96-62c73ddebf"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan pemuatan dan penimbunan atas ekspor Barang Kiriman, dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan mengenai ketentuan kepabeanan di bidang ekspor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_634176f6b7 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_40 ;
    kbr:hasRuleId "R-PMK-2023-96-634176f6b7"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "(2) Barang Kiriman melalui PJT dapat dikeluarkan dari Kawasan Pabean atau tempat lain yang diperlakukan sama dengan TPS untuk diekspor kembali sebagaimana dimaksud dalam Pas al 19 ayat ( 1) h uruf e, dalam hal: a. Barang Kiriman rusak; b. Barang Kiriman salah kirim; dan/ atau c. Barang Kiriman tidak dapat diimpor sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

