    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/178/1..7"^^xsd:string ;
    kbr:hasSourceQuote "Apabila Wajib Pajak atau Wajib Retribusi mempunyai Utang Pajak atau Utang Retribusi lainnya, kelebihan pembayaran Pajak atau Retribusi sebagaimana dimaksud pada ayat (1) langsung diperhitungkan untuk melunasi terlebih dahulu Utang Pajak atau utang Retribusi lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

