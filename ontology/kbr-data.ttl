    kbr:hasSourceQuote "(2) Saat retribusi terutang terjadi dalam masa retribusi sejak pelayanan parkir di tepi jalan umum diberikan atau sejak diterbitkan SKRD atau sejak dokumen lain yang dipersamakan diberikan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

