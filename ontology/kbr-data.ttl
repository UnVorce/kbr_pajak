    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_d42dec2c01 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_21 ;
