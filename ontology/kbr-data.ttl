kbr:Aturan_R_PMK_2023_72_0d6ddb6f13 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_72 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_72_BT_16 ;
