    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/73"^^xsd:string ;
    kbr:hasSourceQuote "Gubernur melakukan pengelolaan piutang Pajak dan Retribusi untuk menentukan prioritas Penagihan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_a0d5316ea8 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
