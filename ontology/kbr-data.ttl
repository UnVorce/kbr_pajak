    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/147"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal pembetulan didasarkan atas penelitian sebagaimana dimaksud pada ayat (2) dan atas permohonan atau kemauan Wajib Pajak sendiri sebagaimana dimaksud dalam Pasal 146, Walikota atau Pejabat yang ditunjuk wajib menerbitkan Surat Keputusan Pembetulan sebagaimana dimaksud pada ayat (6), paling lama 1 (satu) bulan sejak tanggal diterimanya permohonan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
