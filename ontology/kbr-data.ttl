    kbr:hasRuleId "R-UU-1983-7-46a6331a5d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/17/4..7"^^xsd:string ;
    kbr:hasSourceQuote "Dengan Peraturan Pemerintah dapat ditetapkan tarif pajak tersendiri atas penghasilan sebagaimana dimaksud dalam Pasal 4 ayat (2), sepanjang tidak melebihi tarif pajak tertinggi sebagaimana tersebut pada ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

