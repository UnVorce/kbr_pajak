    kbr:hasSourceQuote "Pemungutan adalah suatu rangkaian kegiatan mulai dari penghimpunan data objek dan subjek pajak, penentuan besarnya pajak yang terutang sampai kegiatan penagihan pajak kepada Wajib Pajak serta pengawasan penyetorannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
