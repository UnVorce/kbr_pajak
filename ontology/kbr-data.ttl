kbr:Aturan_R_UU_1985_12_3b4c028c8c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_4 ;
