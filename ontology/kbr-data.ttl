    kbr:hasSourceLocator "PMK-2024-136#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "8. Entitas Induk Utama adalah Entitas yang memiliki kepentingan pengendali secara langsung atau tidak langsung pada Entitas lain dalam suatu grup yang sama dan tidak dimiliki oleh Entitas lain yang memiliki kepentingan pengendali, secara langsung atau tidak langsung."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

