    kbr:hasSourceQuote "Penetapan Peraturan Gubernur sebagaimana dimaksud pada ayat (3) dapat dilakukan untuk setiap pelaksanaan pemanfaatan barang milik daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
