    kbr:hasSourceQuote "b. dipotong atau dipungut oleh pemotong atau pemungut Pajak Penghasilan dalam hal Wajib Pajak bersangkutan melakukan transaksi dengan pihak yang ditunjuk sebagai pemotong atau pemungut pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2022_55_1fb2fcad1b a kbr:Definisi ;
