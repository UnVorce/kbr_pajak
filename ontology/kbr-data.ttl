    kbr:hasRuleId "R-PMK-2023-61-df35ceba89"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/71"^^xsd:string ;
    kbr:hasSourceQuote "e. menjadi wali nikah atau menghadiri pernikahan anak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

