    kbr:hasSourceQuote "Penyelenggara Perdagangan Melalui Sistem Elektronik yang bertempat tinggal atau bertempat kedudukan di luar negeri dapat ditunjuk oleh Menteri sebagai pemungut pajak untuk melakukan pemungutan, penyetoran, dan pelaporan pajak atas penghasilan yang diterima atau diperoleh Penjual Aset Kripto yang menerima atau memperoleh penghasilan sehubungan dengan Aset Kripto sebagaimana dimaksud dalam Pasal 10."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
