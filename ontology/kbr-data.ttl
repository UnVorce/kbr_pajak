    kbr:hasSourceQuote "(10) Permohonan pencabutan permintaan pelaksanaan Prosedur Persetujuan Bersama sebagaimana dimaksud pada ayat ( 1) huruf a juga dapat diajukan secara elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
