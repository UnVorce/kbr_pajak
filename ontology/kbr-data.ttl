    kbr:hasSourceQuote "Besaran Retribusi terutang sebagaimana dimaksud pada ayat (1) ditetapkan dengan SKRD atau dokumen lain yang dipersamakan, baik berbentuk dokumen tercetak maupun dokumen elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
