    kbr:hasSourceLocator "PP-2010-94#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Masukan yang tidak dapat dikreditkan sebagaimana dimaksud dalam Pasal 9 ayat (8) Undang- Undang Pajak Pertambahan Nilai Barang dan Jasa dan Pajak Penjualan atas Barang Mewah dapat dikurangkan dari penghasilan bruto sepanjang dapat dibuktikan"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
