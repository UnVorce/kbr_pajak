    kbr:hasSourceQuote "Orang atau badan yang bertindak selaku agen yang kedudukannya tidak bebas sebagaimana dimaksud dalam Pasal 4 ayat (2) huruf c merupakan bentuk usaha tetap sepanjang orang pribadi atau badan bertindak untuk dan atas nama Orang Pribadi Asing atau Badan Asing."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
