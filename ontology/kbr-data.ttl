    kbr:hasSourceLocator "PMK-2024-81#BT/131/1"^^xsd:string ;
    kbr:hasSourceQuote "c. pajak yang dipungut telah dilaporkan oleh Pengusaha Kena Pajak, Pemungut Pajak Pertambahan Nilai, atau Pihak Lain dalam Surat Pemberitahuan Masa Pajak Pertambahan Nilai Wajib Pajak Pemungut Pajak Pertambahan Nilai atau Pihak Lain;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

