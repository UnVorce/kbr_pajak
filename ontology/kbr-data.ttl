    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/93"^^xsd:string ;
    kbr:hasSourceQuote "Dalam rangka optimalisasi pengelolaan Pajak dan Retribusi, Pemerintah Daerah membangun dan mengembangkan sinergitas pengelolaan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

