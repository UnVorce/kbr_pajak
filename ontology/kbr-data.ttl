kbr:Aturan_R_UU_2022_1_6078559c45 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2022_1 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2022_1_BT_88_1__5 ;
