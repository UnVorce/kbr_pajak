    kbr:hasSourceQuote "dan/atau b. denda sebesar Rp 1.000.000,00 (satu juta rupiah) untuk setiap laporan sebagaimana dimaksud dalam Pasal 42 ayat (1) huruf b."^^xsd:string ;
