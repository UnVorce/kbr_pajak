    kbr:diaturDalam kbr:Reg_PMK_2023_164 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_164_BT_22 ;
    kbr:hasRuleId "R-PMK-2023-164-0b4b9d5ea9"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-164#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "c. kewajiban penyetoran Pajak Penghasilan yang bersifat final yang terutang atas penghasilan yang diterima atau diperoleh Wajib Pajak badan usaha milik desa/badan usaha milik desa bersama untuk Masa Pajak pertama Wajib Pajak dikenai Pajak Penghasilan yang bersifat final sebagaimana dimaksud dalam Pasal 3 ayat (1) sampai dengan Masa Pajak mulai berlakunya Peraturan Menteri ini, dilakukan paling lambat bersamaan dengan batas waktu penyetoran Pajak Penghasilan sebagaimana dimaksud dalam Pasal 7 ayat (2) untuk Masa Pajak setelah Masa Pajak Peraturan Menteri ini mulai berlaku;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

