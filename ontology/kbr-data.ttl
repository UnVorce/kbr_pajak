    kbr:hasSourceLocator "UU-1983-6#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "Orang pribadi atau badan dapat menunjuk seorang kuasa dengan surat kuasa khusus untuk menjalankan hak dan memenuhi kewajiban sesuai dengan ketentuan peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:terdampakPutusanMK kbr:MK_2017_63_PUU_XV ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_2f722696a4 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_21 ;
    kbr:hasRuleId "R-UU-1983-6-2f722696a4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "(3a) Dalam hal Wajib Pajak dinyatakan pailit, bubar, atau dilikuidasi maka kurator, likuidator, atau orang atau badan yang ditugasi untuk melakukan pemberesan dilarang membagikan harta Wajib Pajak dalam pailit, pembubaran atau likuidasi kepada pemegang saham atau kreditur lainnya sebelum menggunakan harta tersebut untuk membayar utang pajak Wajib Pajak tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

