kbr:Aturan_R_PMK_2023_80_938e3cd071 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_80 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_80_BT_3 ;
    kbr:hasRuleId "R-PMK-2023-80-938e3cd071"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-80#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(2) Surat Ketetapan Pajak Nihil dan Surat Ketetapan Pajak Lebih Bayar diterbitkan untukjenis pajak: a. Pajak Penghasilan; b. Pajak Pertambahan Nilai; c. Pajak Penjualan atas Barang Mewah; d. Pajak Bumi dan Bangunan; e. Bea Meterai; f. Pajak Penjualan; dan g. Pajak Karbon."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_80_963931180e a kbr:Definisi ;
