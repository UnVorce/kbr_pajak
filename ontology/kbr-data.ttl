    kbr:hasSourceQuote "kecuali bila Wajib Pajak menggunakan tahun buku yang tidak sama dengan tahun kalender."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_80_9c7b528e28 a kbr:Definisi ;
