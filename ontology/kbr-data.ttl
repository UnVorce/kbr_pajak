    kbr:hasSourceQuote "Pajak Reklame yang terutang dipungut di wilayah Daerah tempat Reklame tersebut diselenggarakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

