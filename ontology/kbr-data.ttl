    kbr:hasSourceQuote "Surat Tagihan Pajak Daerah yang selanjutnya disingkat STPD adalah surat untuk melakukan tagihan pajak dan/atau sanksi administratif berupa bunga dan/atau denda."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_6d2f62419a a kbr:Larangan ;
