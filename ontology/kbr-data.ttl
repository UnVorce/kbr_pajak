    kbr:hasRuleId "R-UU-1995-10-2ce75e7339"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/80"^^xsd:string ;
    kbr:hasSourceQuote "Kunci, segel, atau tanda pengaman yang telah dipasang sebagaimana dimaksud dalam Pasal 78 dan Pasal 79 tidak boleh dibuka, dilepas, atau dirusak tanpa izin Pejabat Bea dan Cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

