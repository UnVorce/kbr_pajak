    kbr:hasSourceQuote "Tingkat penggunaan jasa parkir di tempat khusus parkir diukur berdasarkan jenis kendaraan, frekuensi, fasilitas yang tersedia, dan jangka waktu pemanfaatan jasa pelayanan parkir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

