    kbr:hasSourceQuote "(4) Pejabat yang diminta bantuan sebagaimana dimaksud pada ayat (1) dan ayat (3) huruf a menyampaikan informasi mengenai pelaksanaan pemberitahuan Surat Paksa kepada Pejabat yang meminta bantuan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_3b5ccfc025 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_3 ;
    kbr:hasRuleId "R-PMK-2023-61-3b5ccfc025"^^xsd:string ;
