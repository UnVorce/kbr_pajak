    kbr:hasSourceLocator "PP-2022-50#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "(l ) Penyidik melakukan Penyidikan sebagaimana diatur dalam Pasal 44 Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan dalam hal terjadi tindak pidana di bidang perpajakan dan diperoleh bukti permulaan."^^xsd:string ;
