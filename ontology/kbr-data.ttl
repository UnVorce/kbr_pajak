    kbr:hasSourceQuote "31. Pemberitahuan Jasa Kawasan Ekonomi Khusus yang selanjutnya disingkat PJKEK adalah pemberitahuan yang digunakan dalam pemanfaatanjasa ke dan dari KEK."^^xsd:string ;
