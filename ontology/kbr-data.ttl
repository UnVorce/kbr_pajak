    kbr:hasSourceLocator "PP-2010-94#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Biaya pemeliharaan ternak yang berumur lebih dari 1 (satu) tahun dan hanya 1 (satu) kali memberikan hasil, dikapitalisasi selama periode pemeliharaan dan merupakan bagian dari harga pokok penjualan pada saat ternak dijual."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

