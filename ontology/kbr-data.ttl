    kbr:hasSourceQuote "PKB terutang terhitung sejak Wajib Pajak diakui secara sah memiliki dan/atau menguasai Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

