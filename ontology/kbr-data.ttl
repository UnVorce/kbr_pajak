    kbr:hasSourceQuote "Penyidik Pegawai Negeri Sipil Daerah berwenang untuk melakukan penyidikan tindak pidana di bidang perpajakan Daerah dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

