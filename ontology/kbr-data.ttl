kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_cd7e2427bf a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
