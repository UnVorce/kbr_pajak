    kbr:hasSourceQuote "Berdasarkan penagihan kekurangan pembayaran Pajak Rokok sebagaimana dimaksud pada ayat (5), Wajib Pajak Rokok melakukan pelunasan atas kekurangan Pajak Rokok melalui RKUN."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

