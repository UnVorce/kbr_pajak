    kbr:hasRuleId "R-PP-2010-79-c71bdd2ae3"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Seluruh barang dan peralatan yang dibeli oleh Kontraktor dalam rangka Operasi Perminyakan menjadi barang milik negara yang pembinaannya dilakukan oleh Pemerintah dan dikelol,a oleh SKK Mrgas."^^xsd:string ;
