    kbr:hasSourceQuote "Prinsip dan sasaran dalam penetapan tarif Retribusi Pelayanan Rumah Pemotongan Hewan Ternak ditetapkan dengan memperhatikan memperhatikan biaya penyediaan jasa yang meliputi biaya operasi dan pemeliharaan, petugas pelaksana pelayanan, kemampuan masyarakat, aspek keadilan, efektivitas pengendalian, kualitas atas pelayanan tersebut, dan tujuan untuk memperoleh keuntungan yang layak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

