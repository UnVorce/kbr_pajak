    kbr:hasSourceQuote "Prinsip dan sasaran dalam penetapan struktur dan besarnya tarif Retribusi Penyediaan Tempat Kegiatan Usaha adalah biaya administrasi, biaya pemeliharaan, biaya penyusutan, biaya operasional, dan biaya pembinaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
