    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "Termasuk dalam wilayah pemungutan PBB-P2 sebagaimana dimaksud pada ayat (4) merupakan wilayah Provinsi DKI Jakarta tempat Bumi dan/atau Bangunan berikut berada: a. laut pedalaman dan perairan darat serta Bangunan di atasnya; dan b. Bangunan yang berada di luar laut pedalaman dan perairan darat yang konstruksi tekniknya terhubung dengan Bangunan yang berada di daratan, kecuali pipa dan kabel bawah laut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_cd94adc7d5 a kbr:Definisi ;
