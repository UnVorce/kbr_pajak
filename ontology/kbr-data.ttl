    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_3 ;
    kbr:hasRuleId "R-PMK-2023-172-395644f3bf"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Prinsip Kewajaran dan Kelaziman Usaha sebagaimana dimaksud pada ayat (2) diterapkan dengan membandingkan kondisi dan indikator harga Transaksi yang Dipengaruhi Hubungan Istimewa dengan kondisi dan indikator harga Transaksi Independen yang sama atau sebanding."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
