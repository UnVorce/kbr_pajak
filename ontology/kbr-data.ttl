    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/89"^^xsd:string ;
    kbr:hasSourceQuote "Biaya penyelenggaraan pemberian izin sebagaimana dimaksud pada ayat (1) meliputi biaya penerbitan dokumen izin, pengawasan, penegakan hukum, penatausahaan, dan/atau biaya dampak negatif dari pemberian izin tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

