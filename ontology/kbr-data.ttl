    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_52_5__6 ;
    kbr:hasRuleId "R-PMK-2023-61-49dbe628f3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/52/5..6"^^xsd:string ;
    kbr:hasSourceQuote "(5) Terhadap piutang sebagaimana dimaksud pada ayat (1) huruf b angka 5, Pejabat dapat: a. menjual piutang; atau b. meminta pihak yang berkewajiban membayar utang menyetor pembayaran langsung ke kas negara, untuk melunasi Utang Pajak dan Biaya Penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

