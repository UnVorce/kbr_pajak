    kbr:hasSourceLocator "PMK-2023-61#BT/21/1..7"^^xsd:string ;
    kbr:hasSourceQuote "Dalam pelaksanaan Penyitaan, Jurusita Pajak harus: a. memperlihatkan kartu tanda pengenal Jurusita Pajak; b. memperlihatkan surat perintah melaksanakan Penyitaan; c. memberitahukan tentang maksud dan tujuan Penyitaan; dan d. membuat berita acara pelaksanaan sita atas setiap pelaksanaan Penyitaan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_4c2289e579 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_99 ;
    kbr:hasRuleId "R-PMK-2023-61-4c2289e579"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/99"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pembayaran Nilai Klaim Pajak dengan menggunakan harta kekayaan Penanggung Pajak atas Klaim Pajak yang telah disita sebagaimana dimaksud dalam Pasal 98 huruf a dilakukan dengan mengajukan permohonan kepada Pejabat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

