    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "Tingkat penggunaan jasa sebagaimana dimaksud pada ayat (1), merupakan jumlah penggunaan jasa yang dijadikan dasar alokasi beban biaya yang dipikul Pemerintah Provinsi untuk penyelenggaraan jasa yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_4ee9e29e71 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_36 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-4ee9e29e71"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "(3) Wilayah pemungutan Pajak Rokok merupakan wilayah kepabeanan Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_4eea3943c6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_78 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-4eea3943c6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "(1) Gubernur memberikan insentif atas dasar pencapaian kinerja tertentu kepada Perangkat Daerah yang melakukan pemungutan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_4fe4c7f875 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_75 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-4fe4c7f875"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "Gubernur atau Pejabat yang ditunjuk dapat memberikan keringanan, pengurangan, pembebasan, dan penundaan pembayaran atas pokok dan/atau sanksi Pajak dan/atau Retribusi dengan memperhatikan kondisi Wajib Pajak atau Wajib Retribusi dan/atau objek Pajak atau objek Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_4fff7369bf a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_11 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-4fff7369bf"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Pengecualian sebagaimana dimaksud pada ayat (4) huruf b dan huruf c, tidak berlaku apabila selama 12 (dua belas) bulan berturut-turut Kendaraan Bermotor tidak dikeluarkan kembali dari wilayah kepabeanan Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_508d47a75a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_75 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-508d47a75a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "Kondisi objek Pajak sebagaimana dimaksud pada ayat (1), paling sedikit berupa: a. lahan pertanian yang sangat terbatas; b. tanah dan bangunan yang ditempati Wajib Pajak atau Wajib Retribusi dari golongan tertentu; c. nilai objek Pajak sampai dengan batas tertentu; dan d. objek Pajak yang terdampak bencana alam, kebakaran, huru-hara, dan/atau kerusuhan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_5284b85c7d a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_77 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-5284b85c7d"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat dan/atau tenaga ahli yang ditetapkan oleh Gubernur untuk memberikan keterangan kepada Pejabat lembaga negara atau Instansi Pemerintah yang berwenang melakukan pemeriksaan dalam bidang keuangan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_531314ae07 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-531314ae07"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi adalah orang pribadi atau Badan yang menurut peraturan perundang-undangan diwajibkan untuk melakukan pembayaran Retribusi, termasuk pemungut Retribusi tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_53721e4660 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-53721e4660"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Bahan Bakar Kendaraan Bermotor, yang selanjutnya disingkat PBBKB adalah Pajak atas penggunaan BBKB dan Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_543d0180dd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_70 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-543d0180dd"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/70"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi yang bertindak selaku pemungut sebagaimana dimaksud pada ayat (1), menyetorkan seluruh penerimaan Retribusi yang dipungut ke kas daerah sesuai dengan ketentuan peraturan perundang- undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_54a6c5b799 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_68 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-54a6c5b799"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/68"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang tidak melaksanakan kewajiban pelaporan surat pemberitahuan pajak daerah sebagaimana dimaksud dalam ayat (2), dapat dikenakan sanksi administratif berupa denda."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_54e206acc4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-54e206acc4"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Alat Berat adalah alat yang diciptakan untuk membantu pekerjaan konstruksi dan pekerjaan teknik sipil lainnya yang sifatnya berat apabila dikerjakan oleh tenaga manusia, beroperasi menggunakan motor dengan atau tanpa roda, tidak melekat secara permanen serta beroperasi pada area tertentu, termasuk tetapi tidak terbatas pada area konstruksi, perkebunan, kehutanan, dan pertambangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_550fb86fd6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_26 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-550fb86fd6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(1) Besaran pokok PBBKB yang terutang dihitung dengan cara mengalikan dasar pengenaan PBBKB sebagaimana dimaksud dalam Pasal 24 dengan tarif PBBKB sebagaimana dimaksud dalam Pasal 25."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_55119b69a4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_15 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-55119b69a4"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "(5) Bukti Pembayaran BBNKB menjadi persyaratan dalam pendaftaran Kendaraan Bermotor baru sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_55a0e2435a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_4 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-55a0e2435a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dokumen yang digunakan sebagai dasar Pemungutan jenis Pajak sebagaimana dimaksud pada ayat (1), yaitu surat ketetapan Pajak dan surat pemberitahuan Pajak terutang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_55c0814372 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_77 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-55c0814372"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "Permintaan hakim sebagaimana dimaksud pada ayat (5), harus menyebutkan nama tersangka atau nama tergugat, keterangan yang diminta, serta kaitan antara perkara pidana atau perdata yang bersangkutan dengan keterangan yang diminta."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_587ea175a0 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_70 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-587ea175a0"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/70"^^xsd:string ;
    kbr:hasSourceQuote "Retribusi terutang sebagaimana dimaksud pada ayat (1), dapat dibayarkan sekaligus sebelum pelayanan diberikan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_59b1139a22 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_74 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-59b1139a22"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/74"^^xsd:string ;
    kbr:hasSourceQuote "Pemberian insentif fiskal sebagaimana dimaksud pada ayat (1), ditetapkan dalam Peraturan Gubernur dan diberitahukan kepada DPRD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_5ad9286fef a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_44 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-5ad9286fef"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/44"^^xsd:string ;
    kbr:hasSourceQuote "(3) Penyaluran bagi hasil Pajak Rokok berpedoman pada ketentuan peraturan perundang-undangan mengenai tata cara pemungutan dan penyetoran Pajak Rokok."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_5b42e4c519 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_17 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-5b42e4c519"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/17"^^xsd:string ;
    kbr:hasSourceQuote "(1) Subjek PAB yaitu orang pribadi atau Badan yang memiliki dan/atau menguasai Alat Berat. (2) Wajib PAB yaitu orang pribadi atau Badan yang memiliki dan/atau menguasai Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_5fe15e0b35 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_32 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-5fe15e0b35"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "(1) Objek Pajak Rokok yaitu konsumsi rokok. (2) Rokok sebagaimana dimaksud pada ayat (1), meliputi sigaret, cerutu, rokok daun, dan bentuk rokok lainnya yang dikenai cukai rokok. (3) Objek Pajak Rokok sebagaimana dimaksud pada ayat (1), dikecualikan terhadap rokok yang tidak dikenai cukai rokok berdasarkan ketentuan peraturan perundang- undangan di bidang cukai."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_6002c15371 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_52 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-6002c15371"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/52"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pelayanan sebagaimana dimaksud pada ayat (1), termasuk pelayanan yang diberikan oleh BLUD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_6134f2729a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_68 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-6134f2729a"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/68"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak untuk jenis Pajak yang dipungut berdasarkan penghitungan sendiri oleh Wajib Pajak wajib mengisi surat pemberitahuan pajak daerah atau dokumen lain yang dipersamakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_6188f48a5b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_72 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-6188f48a5b"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "(2) Ketentuan umum dan tata cara pemungutan Pajak dan Retribusi sebagaimana dimaksud pada ayat (1), meliputi pengaturan mengenai: a. pendaftaran dan pendataan; b. penetapan besaran Pajak dan Retribusi terutang; c. pembayaran dan penyetoran; d. pelaporan; e. pengurangan, pembetulan, dan pembatalan ketetapan; f. pemeriksaan Pajak; g. penagihan Pajak dan Retribusi; h. keberatan; i. gugatan; dan j. pengaturan lain yang berkaitan dengan tata cara pemungutan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_61b9ba7c68 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_76 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-61b9ba7c68"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "Gubernur dapat memberikan kemudahan perpajakan daerah kepada Wajib Pajak, berupa: a. perpanjangan batas waktu pembayaran atau pelaporan Pajak; dan/atau b. pemberian fasilitas angsuran atau penundaan pembayaran Pajak terutang atau utang Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_650965db50 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_70 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-650965db50"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/70"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi melakukan pembayaran Retribusi terutang yang ditetapkan dalam surat ketetapan retribusi daerah atau dokumen lain yang dipersamakan ke kas daerah atau melalui Wajib Retribusi yang bertindak selaku pemungut tepat pada waktunya dan membayar sesuai dengan jumlah Retribusi terutang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_6546c14f0c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_86 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-6546c14f0c"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/86"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pengawasan pelaksanaan Peraturan Daerah ini dilakukan oleh: a. Perangkat Daerah yang menangani pendapatan; b. Satuan Polisi Pamong Praja Provinsi; dan c. Perangkat Daerah atau lembaga terkait lainnya baik secara mandiri ataupun bersama-sama sesuai kewenangan, berdasarkan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

