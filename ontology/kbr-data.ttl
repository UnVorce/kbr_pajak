    kbr:hasSourceQuote "(2) Setiap orang yang dengan sengaja menyebabkan tidak terpenuhinya kewajiban pejabat dan pihak lain sebagaimana dimaksud dalam Pasal 35A ayat (1) dipidana dengan pidana kurungan paling lama 10 (sepuluh) bulan atau denda paling banyak Rp800.000.000,00 (delapan ratus juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_e4fe4eb144 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
