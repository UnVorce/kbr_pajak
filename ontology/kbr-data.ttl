    kbr:hasSourceLocator "UU-1995-10#BT/46/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Barangsiapa yang mengeluarkan barang dari Tempat Penimbunan Berikat sebelum diberikan persetujuan oleh Pejabat Bea dan Cukai dikenai sanksi administrasi berupa denda sebesar Rp. 5.000.000,00 (lima juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_e4a9fa7c69 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_75 ;
    kbr:hasRuleId "R-UU-1995-10-e4a9fa7c69"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/75"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat bea dan cukai dalam melaksanakan pengawasan terhadap sarana pengangkut di laut atau di sungai menggunakaan kapal patroli atau sarana lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_e4fe8fe566 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_70 ;
    kbr:hasRuleId "R-UU-1995-10-e4fe8fe566"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/70"^^xsd:string ;
    kbr:hasSourceQuote "Barang dan sarana pengangkut sebagaimana dimaksud dalam Pasal 68 ayat (1) huruf b diserahkan kembali kepada pemiliknya dalam jangka waktu tiga puluh hari sejak penyimpanan di Tempat Penimbunan Pabean dalam hal : a. Bea Masuk yang terutang telah dibayar dan apabila merupakan barang larangan atau pembatasan telah diserahkan dokumen atau keterangan yang diperlukan sehubungan dengan larangan atau pembatasan impor atau ekspor; atau b. Bea Masuk yang terutang telah dibayar dan apabila merupakan barang larangan atau pembatasan telah diserahkan dokumen atau keterangan yang diperlukan sehubungan dengan larangan atau pembatasan impor atau ekspor serta telah diserahkan sejumlah uang ditetapkan oleh Menteri sebagai ganti barang yang besarnya tidak melebihi harga barang, sepanjang barang tersebut tidak diperlukan untuk bukti di pengadilan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_e582d6d4a3 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_105 ;
    kbr:hasRuleId "R-UU-1995-10-e582d6d4a3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/105"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang dengan sengaja dan tanpa hak membuka, melepas, atau merusak kunci, segel atau tanda pengaman yang telah dipasang oleh pejabat bea dan cukai dipidana dengan pidana penjara paling singkat 1 (satu) tahun dan pidana penjara paling lama 3 (tiga) tahun dan/atau pidana denda paling sedikit Rp500.000.000,00 (lima ratus juta rupiah) dan paling banyak Rp1.000.000.000,00 (satu miliar rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_e5fffb9d56 a kbr:Kewajiban ;
