kbr:Aturan_R_UU_1983_7_f49af3ab48 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_16 ;
    kbr:hasRuleId "R-UU-1983-7-f49af3ab48"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Penghasilan Kena Pajak bagi Wajib Pajak orang pribadi dalam negeri yang terutang pajak dalam suatu bagian tahun pajak sebagaimana dimaksud dalam Pasal 2A ayat (6) dihitung berdasarkan penghasilan neto yang diterima atau diperoleh dalam bagian tahun pajak yang disetahunkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_f559a010a3 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_4_3_g__k ;
    kbr:hasRuleId "R-UU-1983-7-f559a010a3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/4/3/g..k"^^xsd:string ;
    kbr:hasSourceQuote "i. bagian laba atau sisa hasil usaha yang diterima atau diperoleh anggota dari koperasi, perseroan komanditer yang modalnya tidak terbagi atas saharn-saham, persekutuan, perkumpulan, firma, dan kongsi, termasuk pemegang unit penyertaan kontrak investasi kolektif;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_f61b00064d a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_4_3_f_p1 ;
    kbr:hasRuleId "R-UU-1983-7-f61b00064d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/4/3/f#p1"^^xsd:string ;
    kbr:hasSourceQuote "dalam hal dividen sebagaimana dimaksud pada angka 3 huruf b dan penghasilan setelah pajak dari suatu bentuk usaha tetap di luar negeri sebagaimana dimaksud pada angka 2, diinvestasikan di wilayah Negara Kesatuan Republik Indonesia sebesar lebih dari 30% (tiga puluh persen) dari jumlah laba setelah pajak sebagaimana dimaksud pada angka 2 huruf a) berlaku ketentuan: a) atas dividen dan penghasilan setelah pajak yang diinvestasikan tersebut dikecualikan dari pengenaan Pajak Penghasilan;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_f6e0b923c3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_8 ;
    kbr:hasRuleId "R-UU-1983-7-f6e0b923c3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Penghasilan anak yang belum dewasa digabung dengan penghasilan orang tuanya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_f76c639ee6 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_4_3_f_p2 ;
    kbr:hasRuleId "R-UU-1983-7-f76c639ee6"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/4/3/f#p2"^^xsd:string ;
    kbr:hasSourceQuote "pajak atas penghasilan yang telah dibayar atau terutang di luar negeri atas penghasilan sebagaimana dimaksud pada angka 2 dan angka 7, berlaku ketentuan: a) tidak dapat diperhitungkan dengan Pajak Penghasilan yang terutang; b) tidak dapat dibebankan sebagai biaya atau pengurang penghasilan; dan/atau c) tidak dapat dimintakan pengembalian kelebihan pembayaran pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_f7900c78f2 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_7 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_7_BT_11_1__6a ;
    kbr:hasRuleId "R-UU-1983-7-f7900c78f2"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/11/1..6a"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dengan persetujuan Direktur Jenderal Pajak, Wajib Pajak diperkenankan melakukan penyusutan mulai pada bulan harta tersebut digunakan untuk mendapatkan, menagih, dan memelihara penghasilan atau pada bulan harta yang bersangkutan mulai menghasilkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

