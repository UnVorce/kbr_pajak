    kbr:hasSourceLocator "PMK-2024-81#BT/398/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal terdapat keadaan di luar kekuasaan Wajib Pajak yang menyebabkan tidak dapat dipenuhinya jangka waktu sebagaimana dimaksud pada ayat (1), Wajib Pajak dapat mengajukan permohonan perpanjangan jangka waktu tersebut kepada Direktur Jenderal Pajak melalui Portal Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
