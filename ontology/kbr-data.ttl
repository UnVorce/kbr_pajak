    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "(2) Besaran persentase NJOP sebagaimana dimaksud pada ayat (1) atas kelompok objek PBB-P2 ditentukan dengan mempertimbangkan, meliputi: a. kenaikan NJOP hasil penilaian; b. bentuk pemanfaatan objek Pajak; dan/atau c. klasterisasi NJOP dalam satu wilayah Kota."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

