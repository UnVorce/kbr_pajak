    kbr:diaturDalam kbr:Reg_PMK_2023_143 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_143_BT_10_2__7 ;
    kbr:hasRuleId "R-PMK-2023-143-f59540943a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/10/2..7"^^xsd:string ;
    kbr:hasSourceQuote "Pemimpin PPA BUN penerimaan, pemotongan, dan penyetoran Pajak Rokok dapat mengusulkan penggantian KPA BUN penerimaan dan pemotongan Pajak Rokok dan/ atau KPA BUN penyetoran Pajak Rokok kepada Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2023_143_f70463dbd8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_143 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_143_BT_20 ;
    kbr:hasRuleId "R-PMK-2023-143-f70463dbd8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penyetoran penerimaan Pajak Rokok ke RKUD Provinsi dilaksanakan setiap triwulanan pada bulan pertama triwulan berikutnya. (3) Penyetoran penerimaan Pajak Rokok ke RKUD Provinsi sebagaimana dimaksud pada ayat (2) untuk penerimaan bulan Oktober dan November dilaksanakan pada bulan Desember. (4) Penyetoran penerimaan Pajak Rokok ke RKUD Provinsi sebagaimana dimaksud pada ayat (2) untuk penerimaan sampai dengan bulan Desember tahun berkenaan yang masih terdapat di RKUN dilaksanakan bersamaan dengan penyetoran triwulan I tahun anggaran berikutnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

