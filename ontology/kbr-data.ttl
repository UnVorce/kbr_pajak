    kbr:hasSourceQuote "Direktur Jenderal Pajak menerbitkan bukti penerimaan atas penyampaian permohonan Kesepakatan Harga Transfer sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
