    kbr:hasRuleId "R-PMK-2023-61-98379907e3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/79/1..2"^^xsd:string ;
    kbr:hasSourceQuote "e. hak untuk melakukan penagihan Pajak atas Utang Pajak belum daluwarsa."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_98496a8976 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_20_1__5 ;
    kbr:hasRuleId "R-PMK-2023-61-98496a8976"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/20/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal Objek Sita berada di luar kota tempat kedudukan kantor Pejabat yang menerbitkan Surat Paksa tetapi masih dalam wilayah kerjanya, Pejabat yang menerbitkan Surat Paksa: a. meminta bantuan kepada Kepala Kantor Wilayah atau Kepala Kantor Pelayanan Pajak yang tempat kedudukannya berada di kota tempat Objek Sita berada dan wilayah kerjanya meliputi kota tempat Objek Sita berada, untuk menerbitkan surat perintah melaksanakan Penyitaan kepada Jurusita untuk melakukan Penyitaan; atau b. memerintahkan Jurusita Pajaknya untuk melaksanakan Penyitaan secara langsung disertai dengan penyampaian informasi mengenai pelaksanaan Penyitaan kepada Pejabat setempat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_9a65395bc3 a kbr:Prosedur ;
