kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4d831f92b6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_86 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-4d831f92b6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/86"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi melakukan pembayaran Retribusi terutang yang ditetapkan dalam SKRD atau dokumen lain yang dipersamakan sebagaimana dimaksud pada ayat (2) ke kas Daerah atau melalui Wajib Retribusi yang bertindak selaku pemungut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4e20fd2c40 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_76 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-4e20fd2c40"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "Biaya pengelolaan pertambangan rakyat sebagaimana dimaksud pada ayat (1) mengacu pada ketentuan peraturan perundang-undangan yang berlaku pada kementerian di bidang energi dan sumber daya mineral."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4e7dfdcdef a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_107 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-4e7dfdcdef"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/107"^^xsd:string ;
    kbr:hasSourceQuote "Jumlah kekurangan pajak yang terutang dalam SKPDKB sebagaimana dimaksud dalam Pasal 83 ayat (2) huruf a, Wajib Pajak dikenakan sanksi administratif berupa bunga sebesar 1,8% (satu koma delapan persen) per bulan dari pajak yang kurang atau terlambat bayar, dihitung sejak saat terutangnya pajak atau berakhirnya masa pajak,"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4e7e2d0a7e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_56 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-4e7e2d0a7e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/56"^^xsd:string ;
    kbr:hasSourceQuote "Besaran Retribusi Jasa Umum yang terutang dihitung dengan cara mengalikan tingkat penggunaan jasa sebagaimana dimaksud dalam Pasal 54 dengan tarif Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4f6dc0c0d5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_67 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-4f6dc0c0d5"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/67"^^xsd:string ;
    kbr:hasSourceQuote "Tingkat penggunaan jasa atas pelayanan Jasa Usaha merupakan jumlah penggunaan jasa yang dijadikan dasar alokasi beban biaya oleh Pemerintah Daerah untuk penyelenggaraan jasa yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_4fe48ff8b2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_28 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-4fe48ff8b2"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "(4) Setiap pelaku usaha yang beroperasional di Daerah Provinsi wajib menggunakan bahan bakar dari penyedia BBKB sebagaimana dimaksud dalam Pasal 25 ayat (3) di wilayah pemungutan PBBKB sebagaimana dimaksud pada ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

