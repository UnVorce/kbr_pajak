    kbr:hasSourceQuote "Rencana Kerja dan Anggaran adalah suatu perencanaan kegiatan dan pengeluaran anggaran tahunan oleh Kontraktor untuk Kegiatan Usaha Hulu Minyak dan Gas Bumi pada suatu Wilayah Kerja."^^xsd:string ;
