kbr:Aturan_R_UU_2002_14_8815f49df8 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_51 ;
    kbr:hasRuleId "R-UU-2002-14-8815f49df8"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "apabila tidak mengundurkan diri sedangkan sengketa telah diputus, putusan dimaksud tidak sah dan Ketua memerintahkan sengketa dimaksud segera disidangkan kembali dengan susunan Majelis dan/atau Panitera yang berbeda."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_888f92590a a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_89 ;
    kbr:hasRuleId "R-UU-2002-14-888f92590a"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/89"^^xsd:string ;
    kbr:hasSourceQuote "(1) Permohonan peninjauan kembali sebagaimana dimaksud dalam Pasal 77 ayat (3) hanya dapat diajukan 1 (satu) kali kepada Mahkamah Agung melalui Pengadilan Pajak. (2) Permohonan peninjauan kembali tidak menangguhkan atau menghentikan pelaksanaan putusan Pengadilan Pajak. (3) Permohonan peninjauan kembali dapat dicabut sebelum diputus, dan dalam hal sudah dicabut permohonan peninjauan kembali tersebut tidak dapat diajukan lagi."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:merujukSEMA kbr:SEMA_2019_2_TUN_5 ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_8bf67ec1fc a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_77 ;
    kbr:hasRuleId "R-UU-2002-14-8bf67ec1fc"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "Pihak-pihak yang bersengketa dapat mengajukan peninjauan kembali atas putusan Pengadilan Pajak kepada Mahkamah Agung."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_8bfe4dceb6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_1 ;
    kbr:hasRuleId "R-UU-2002-14-8bfe4dceb6"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Undang-undang ini yang dimaksud dengan: 1. Pejabat yang berwenang adalah Direktur Jenderal Pajak, Direktur Jenderal Bea dan Cukai, Gubernur, Bupati/Walikota, atau pejabat yang ditunjuk untuk melaksanakan peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_8e21ff6f8f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_67 ;
    kbr:hasRuleId "R-UU-2002-14-8e21ff6f8f"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/67"^^xsd:string ;
    kbr:hasSourceQuote "Pemeriksaan dengan acara cepat terhadap Sengketa Pajak sebagaimana dimaksud dalam Pasal 66 ayat (1) dilakukan tanpa Surat Uraian Banding atau Surat Tanggapan dan tanpa Surat Bantahan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_932e3a73e6 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_92 ;
    kbr:hasRuleId "R-UU-2002-14-932e3a73e6"^^xsd:string ;
    kbr:hasSourceLocator "UU-2002-14#BT/92"^^xsd:string ;
    kbr:hasSourceQuote "(3) Pengajuan permohonan peninjauan kembali berdasarkan alasan sebagaimana dimaksud dalam Pasal 91 huruf c, huruf d, dan huruf e dilakukan dalam jangka waktu paling lambat 3 (tiga) bulan sejak putusan dikirim."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_2002_14_9372e41599 a kbr:Kewajiban ;
