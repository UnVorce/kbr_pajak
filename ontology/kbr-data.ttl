kbr:Aturan_R_PERDA_PROV_BALI_2024_1_2dc3a23613 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_76 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-2dc3a23613"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai administrasi dan tata cara pemberian kemudahan perpajakan daerah sebagaimana dimaksud pada ayat (1), diatur dengan Peraturan Gubernur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_3097c99220 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
