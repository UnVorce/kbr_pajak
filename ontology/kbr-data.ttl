    kbr:hasSourceQuote "Wajib Pajak yang tidak memenuhi ketentuan sebagaimana dimaksud pada ayat (1), ayat (2), dan ayat (3) dikenai sanksi sebagaimana diatur dalam Undang­ Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
