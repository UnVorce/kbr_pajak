    kbr:hasSourceQuote "(2) Pengawasan Wajib Pajak belum terdaftar sebagaimana dimaksud pada ayat (1) dilakukan terhadap pemenuhan kewajiban perpajakan sejak timbulnya kewajiban perpajakan sesuai ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

