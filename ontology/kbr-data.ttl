    kbr:hasSourceQuote "(2) Surat Teguran sebagaimana dimaksud pada ayat (1) diterbitkan setelah lewat waktu 7 (tujuh) Hari terhitung sejak saat diterima Klaim Pajak dari Negara Mitra atau - jdih.kemenkeu.go.id -58- Yurisdiksi Mitra sebagaimana dimaksud dalam Pasal 83 ayat (7)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

