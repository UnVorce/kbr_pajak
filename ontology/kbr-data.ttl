    kbr:hasSourceQuote "(4) Apabila setelah 'Iewat waktu 14 (empat belas) Hari sejak tanggal pelaksanaan Penyitaan, Penanggung Pajak belum melunasi Utang Pajak dan Biaya Penagihan Pajak, Pejabat melakukan pengumuman lelang atas Barang sitaan yang akan dilelang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_977495049c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_9_3__9 ;
    kbr:hasRuleId "R-PMK-2023-61-977495049c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/9/3..9"^^xsd:string ;
    kbr:hasSourceQuote "Termasuk pengertian orang yang nyata-nyata sebagaimana dimaksud pada ayat (2) huruf a sampai dengan huruf i yakni: a. orang yang berwenang menandatangani kontrak dengan pihak ketiga dan/atau menandatangani eek; b. orang yang berwenang mengangkat, menggantikan, atau memberhentikan anggota direksi, anggota dewan komisaris, kepala perwakilan, kepala cabang, penanggung jawab, pengurus, pengawas, pimpinan, atau jabatan setingkat; dan/atau c. orang yang berwenang atau berkuasa untuk mempengaruhi atau mengendalikan Wajib Pajak Badan tanpa harus mendapat otorisasi dari pihak manapun."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_97b0f22a6a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_44_1__3 ;
    kbr:hasRuleId "R-PMK-2023-61-97b0f22a6a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/44/1..3"^^xsd:string ;
    kbr:hasSourceQuote "d. Penanggung Pajak dapat meyakinkan Pejabat dengan membuktikan bahwa harta kekayaan yang diblokir tidak dapat digunakan untuk melunasi Utang Pajak dan Biaya Penagihan Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

