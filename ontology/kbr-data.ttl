    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_12 ;
    kbr:hasRuleId "R-PMK-2023-96-13de2bcef5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "f. Penyelenggara Pos dinyatakan bersalah melakukan tindak pidana di bidang kepabeanan dan/ atau cukai berdasarkan putusan pengadilan yang berkekuatan hukum tetap;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
