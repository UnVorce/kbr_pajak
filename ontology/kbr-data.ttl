    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_d8ef11ab3e a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_79 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_79_BT_17 ;
    kbr:hasRuleId "R-PP-2010-79-d8ef11ab3e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/17"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal total realisasi biaya penutupan dan pemulihan tambang lebih kecil atau lebih besar dari jumlah yang dicadangkan, selisihnya menjadi pengurang atau penambah biaya operasi yang dapat dikembalikan dari masing-masing wilayah kerja atau lapangan yang bersangkutan, setelah mendapat persetujuan Kepala Badan Pelaksana."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

