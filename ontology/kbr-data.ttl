    kbr:hasSourceQuote "Dokumen Penentuan Harga Transfer sebagaimana dimaksud dalam Pasal 16 ayat (2) huruf c harus tersedia paling lama 12 (dua belas) bulan setelah akhir tahun pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2023_172_bbf6cfabba a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_56_6__12 ;
    kbr:hasRuleId "R-PMK-2023-172-bbf6cfabba"^^xsd:string ;
