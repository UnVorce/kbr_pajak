    kbr:hasSourceLocator "PMK-2024-81#BT/29/1/b#p2"^^xsd:string ;
    kbr:hasSourceQuote "Karena total tambahan pengurangan penghasilan bruto sebesar Rp210.000.000,00 lebih kecil daripada 40% dari Penghasilan Kena Pajak sebelum mendapat fasilitas (40% x Rp600.000.000,00), maka di Tahun Pajak 2029 PT X berhak memanfaatkan seluruh tambahan pengurangan penghasilan bruto sebesar Rp210.000.000,00."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_6a3f99b181 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_113 ;
    kbr:hasRuleId "R-PMK-2024-81-6a3f99b181"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/113"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak dapat mengajukan permohonan kepada Direktur Jenderal Pajak untuk mengangsur atau menunda pembayaran pajak atas: a. kekurangan pembayaran pajak berdasarkan Surat Pemberitahuan Penghasilan sebagaimana dimaksud ayat (1); dan yang terutang Tahunan Pajak dalam Pasal 95 - jdih.kemenkeu.go.id -91 - b. pajak yang masih harus dibayar sebagaimana dimaksud dalam Pasal 97 ayat (3) dan kewajiban pelunasan Pasal 98 ayat ( 1), dalam hal Wajib Pajak mengalami kesulitan likuiditas atau mengalami keadaan di luar kekuasaannya sehingga Wajib Pajak tidak mampu memenuhi kewajiban pajak pada waktunya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

