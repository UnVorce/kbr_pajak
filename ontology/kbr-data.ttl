    kbr:hasSourceQuote "Pemasukan barang ke Pelaku Usaha di KEK dari lokasi sebagaimana dimaksud dalam Pasal90 huruf b sampai dengan huruf d menggunakan pemberitahuan pabean dan diberikan fasilitas dan kemudahan berupa: a. penangguhan atau pembebasan Bea Masuk; b. pembebasan cukai, sepanjang barang tersebut merupakan bahan baku atau bahan penolong dalam pembuatan barang hasil akhir yang bukan merupakan barang kena cukai; dan/atau c. tidak dipungut Pajak Dalam Rangka Impor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

