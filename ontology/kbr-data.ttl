    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/68"^^xsd:string ;
    kbr:hasSourceQuote "Pelaporan surat pemberitahuan pajak daerah sebagaimana dimaksud dalam ayat (1), dilakukan setiap masa Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

