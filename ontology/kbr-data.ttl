kbr:Aturan_R_PMK_2023_96_e7350b5f78 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_44 ;
    kbr:hasRuleId "R-PMK-2023-96-e7350b5f78"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/44"^^xsd:string ;
    kbr:hasSourceQuote "Eksportir atau Penyelenggara Pos menyampaikan pemberitahuan ekspor barang atas ekspor Barang Kiriman kepada Pejabat Bea dan Cukai di Kantor Pabean pemuatan ekspor dalam hal Barang Kiriman: a. memiliki berat kotor melebihi 30 (tiga puluh) kilogram; b. diekspor oleh Eksportir yang merupakan · perusahaan penerima fasilitas tempat penimbunan berikat; c. diekspor oleh Eksportir yang perusahaan penerima fasilitas dan/ a tau pengembalian; dan/ a tau merupakan pembebasan d. merupakan barang impor yang diberitahukan dengan PIB/PIBK yang akan diekspor kembali sebagaimana dimaksud dalam Pasal 40 ayat (4). Dalam hal tertentu, Eksportir atau Penyelenggara Pos dapat menyampaikan pemberitahuan ekspor barang kepada Pejabat Bea dan Cukai di Kantor Pabean pemuatan ekspor atas barang kiriman yang memiliki berat kotor tidak melebihi 30 (tiga puluh) kilogram."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

