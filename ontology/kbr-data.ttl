    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "(1) Subjek PAB merupakan orang pribadi atau Badan yang memiliki dan/atau menguasai Alat Berat. (2) Wajib PAB merupakan orang pribadi atau Badan yang memiliki dan/atau menguasai Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

