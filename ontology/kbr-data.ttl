    kbr:hasSourceQuote "(1) Saat terutang Pajak ditetapkan pada saat orang pribadi atau Badan telah memenuhi syarat subjektif dan objektif atas suatu jenis Pajak dalam satu kurun waktu tertentu dalam masa Pajak, dalam tahun Pajak, atau bagian tahun Pajak sesuai dengan ketentuan peraturan perundang-undangan perpajakan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
