    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_30 ;
    kbr:hasRuleId "R-PP-2022-50-2912ef5e5b"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "(2) Tata cara pencabutan penetapan Wajib Pajak dengan kriteria tertentu dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_2984aeaccf a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_65 ;
    kbr:hasRuleId "R-PP-2022-50-2984aeaccf"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/65"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pembayaran yang dilakukan oleh Wajib Pajak, tersangka, atau terdakwa pada tahap Penyidikan sampai dengan persidangan belum memenuhi jumlah sebagaimana dimaksud dalam Pasal 63 ayat (2) dan ayat (3), atas pembayaran tersebut dapat diperhitungkan sebagai pembayaran pidana denda."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_2998024176 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_8_1__5 ;
    kbr:hasRuleId "R-PP-2022-50-2998024176"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/8/1..5"^^xsd:string ;
    kbr:hasSourceQuote "c. Surat Setoran Pajak atas sanksi administratif berupa bunga sebagaimana diatur dalam Pasal 8 ayat (5) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan jika pengungkapan ketidakbenaran pengisian Surat Pemberitahuan mengakibatkan pajak yang kurang dibayar menjadi lebih besar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_29e328b59e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_37_1__5 ;
    kbr:hasRuleId "R-PP-2022-50-29e328b59e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/37/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Kesalahan hitung sebagaimana dimaksud pada ayat (1) meliputi: a. kesalahan yang berasal dari penjumlahan, pengurangan, perkalian, dan/atau pembagian suatu bilangan; atau b. kesalahan hitung yang diakibatkan oleh adanya penerbitan Surat Ketetapan Pajak, Surat Tagihan Pajak, surat keputusan, atau putusan yang terkait dengan bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

