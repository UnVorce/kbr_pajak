kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_eadfda0e2e a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_6_7__10 ;
