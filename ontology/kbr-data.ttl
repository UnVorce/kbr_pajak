    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/86"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi yang bertindak selaku pemungut sebagaimana dimaksud pada ayat (1) menyetorkan seluruh penerimaan Retribusi yang dipungut ke kas Daerah sesuai ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

