    kbr:hasSourceQuote "34. Jasa Perhotelan adalah jasa penyediaan akomodasi yang dapat dilengkapi dengan jasa pelayanan makan dan minum, kegiatan hiburan, dan/atau fasilitas lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

