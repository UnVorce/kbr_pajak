kbr:Aturan_R_PMK_2024_136_ecc5326155 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_17 ;
    kbr:hasRuleId "R-PMK-2024-136-ecc5326155"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/17"^^xsd:string ;
    kbr:hasSourceQuote "Pajak tambahan berdasarkan UTPR sebagaimana dimaksud pada ayat (1) dari suatu Entitas Konstituen menjadi 0 (nol) dalam hal semua Kepentingan Kepemilikan Entitas Induk Utama dalam Entitas Konstituen yang Dikenai Pajak Rendah dimiliki secara langsung atau tidak langsung oleh satu atau lebih - 26 - Entitas Induk yang diwajibkan untuk menerapkan Qualified IIR."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_ed55892da4 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_21_9__12 ;
    kbr:hasRuleId "R-PMK-2024-136-ed55892da4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/21/9..12"^^xsd:string ;
    kbr:hasSourceQuote "(11) Sehubungan dengan penyesuaian akun keuangan umum sebagaimana dimaksud pada ayat (2) huruf c, Entitas Konstituen Pelapor dapat melakukan Pemilihan Lima Tahun berupa: a. pemilihan instrumen lindung nilai (hedging instrument); dan b. pemilihan penyertaan investasi ekuitas (equity investment inclusion election)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

