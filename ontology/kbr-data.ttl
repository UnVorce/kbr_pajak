    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_15 ;
    kbr:hasRuleId "R-PMK-2023-61-12fae8b2ef"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "(1) Surat Paksa diberitahukan oleh Jurusita Pajak dengan pernyataan dan penyerahan salinan Surat Paksa kepada Penanggung Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

