    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_80_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2023-80-963931180e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-80#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "22. Surat Ketetapan Pajak adalah surat ketetapan yang meliputi surat ketetapan pajak kurang bayar, surat - jdih.kemenkeu.go.id - 5 - ketetapan pajak kurang bayar tambahan, surat ketetapan pajak nihil, atau surat ketetapan pajak lebih bayar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_80_97d5dc4ee6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_80 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_80_BT_32 ;
    kbr:hasRuleId "R-PMK-2023-80-97d5dc4ee6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-80#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal diterbitkan: a. surat keputusan pembetulan atas Surat Pemberitahuan Pajak Terutang atau Surat Ketetapan Pajak Pajak Bumi dan Bangunan; b. surat keputusan pengurangan Pajak Bumi dan Bangunan; c. surat keputusan pengurangan atas Surat Pemberitahuan Pajak Terutang yang tidak benar; d. surat keputusan pengurangan atas Surat Ketetapan Pajak Pajak Bumi dan Bangunan yang tidak benar; e. surat keputusan pengurangan denda administratif atas Pajak Bumi dan Bangunan; f. surat keputusan keberatan atas Pajak Bumi dan Bangunan; g. putusan banding; atau h. putusan peninjauan kembali, yang menyebabkan terdapat Pajak Bumi dan Bangunan yang masih harus dibayar dan Surat Tagihan Pajak Pajak Bumi dan Bangunan belum diterbitkan, DirekturJenderal Pajak menerbitkan Surat Tagihan Pajak Pajak Bumi dan Bangunan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_80_9b5a0f9c14 a kbr:Definisi ;
