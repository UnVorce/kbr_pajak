kbr:Aturan_R_PMK_2023_61_614664edd0 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_26_1 ;
    kbr:hasRuleId "R-PMK-2023-61-614664edd0"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/26/1"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pencabutan sita dilaksanakan dalam hal: a. Penanggung Pajak telah melunasi Utang Pajak dan Biaya Penagihan Pajak yang menjadi dasar dilakukan Penyitaan sesuai dengan tanggungjawab Penanggung Pajak sebagaimana dimaksud dalam Pasal 8 atau Pasal 9; jdih.kemenkeu.go.id -24- b. adanya putusan pengadilan atau berdasarkan putusan pengadilan pajak; atau c. terdapat kondisi tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

