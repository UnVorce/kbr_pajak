    kbr:hasSourceQuote "Katup pintu, dioperasikan secara manual, dari besi atau baja: - - - - Mempunyai diameter bagian dalam pemasukan clan pengeluaran lebih dari 5 cm tetapi tidak lebih dari 40 cm - - - - Mempunyai diameter bagian dalam pemasukan clan pengeluaran lebih dari 40 cm - - - - Mempunyai diameter bagian dalam pemasukan clan pengeluaran tidak lebih dari 5 cm - - - Manifold valve : - - - - Lain-lain"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
