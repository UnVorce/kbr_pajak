    kbr:hasSourceQuote "Wajib Retribusi Jasa Usaha merupakan orang pribadi atau Badan yang menurut ketentuan peraturan perundang- undangan diwajibkan untuk melakukan pembayaran Retribusi atas jenis pelayanan Jasa Usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

