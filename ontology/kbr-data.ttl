    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_92 ;
    kbr:hasRuleId "R-PMK-2024-81-37f0339168"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/92"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal Wajib Pajak menyatakan menolak untuk dilakukan Pendataan lapangan sebagaimana dimaksud dalam Pasal 91 ayat (1), Wajib Pajak harus menandatangani surat pernyataan penolakan Pendataan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_3833441720 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_213 ;
    kbr:hasRuleId "R-PMK-2024-81-3833441720"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/213"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal ketentuan sebagaimana dimaksud pada ayat (2) tidak dapat dipenuhi karena Kontraktor Kontrak Kerja Sama Minyak dan Gas Bumi yang menerima pengalihan Partisipasi Interes belum terdaftar sebagai Wajib Pajak, Pajak Penghasilan yang terutang dimaksud wajib dipotong, disetorkan, dan dilaporkan oleh Kontraktor Kontrak Kerja Sama Minyak dan Gas Bumi yang menerima pengalihan Partisipasi Interes pada saat setelah terdaftar sebagai Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_386a617211 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_302 ;
    kbr:hasRuleId "R-PMK-2024-81-386a617211"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/302"^^xsd:string ;
    kbr:hasSourceQuote "Faktur Pajak sebagaimana dimaksud pada ayat (1) dibuat sesuai dengan ketentuan peraturan perundang­ undangan di bidang Pajak Pertambahan Nilai yang mengatur mengenai Faktur Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_390094f059 a kbr:Prosedur ;
