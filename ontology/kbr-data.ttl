    kbr:hasSourceQuote "Penyelenggara bursa efek wajib melaporkan pemotongan dan penyetoran Pajak Penghasilan sebagaimana dimaksud pada ayat (1) dan ayat (5) melalui Surat Pemberitahuan Masa Pajak Penghasilan Unifikasi paling lama 20 (dua puluh) hari setelah Masa Pajak berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

