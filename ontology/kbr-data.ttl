    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_11 ;
    kbr:hasRuleId "R-PP-2022-55-2e57f79e0c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "1. akhir bulan ketiga setelah Tahun Pajak diterima atau diperoleh dividen atau penghasilan lain, untuk Wajib Pajak orang pribadi"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

