    kbr:hasSourceQuote "(2) Hasil penerimaan PBJT atas Tenaga Listrik, dialokasikan paling sedikit 10% (sepuluh persen) untuk penyediaan penerangan jalan umum."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

