    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_80 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-5813458b33"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/80"^^xsd:string ;
    kbr:hasSourceQuote "Berdasarkan hasil penelitian administrasi sebagaimana dimaksud pada ayat (2) dilakukan penerbitan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan dan surat pemberitahuan perubahan data objek Pajak Bumi dan Bangunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

