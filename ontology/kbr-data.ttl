    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/90"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap pembayaran Retribusi, diberikan tanda bukti pembayaran."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

