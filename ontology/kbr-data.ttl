    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-6e8d18f5c4"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Air Permukaan adalah semua air yang terdapat pada permukaan tanah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_6ef7cf846c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_1_p3 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-6ef7cf846c"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Utang Pajak adalah Pajak yang masih harus dibayar termasuk sanksi administratif berupa bunga, denda, dan/atau kenaikan yang tercantum dalam surat ketetapan Pajak atau surat sejenisnya berdasarkan peraturan perundang-undangan perpajakan Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_6ff475a3e9 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_20 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-6ff475a3e9"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Tarif PAB ditetapkan sebesar 0,2% (nol koma dua persen) dari nilai jual alat berat."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_70686b7b0e a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_104 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-70686b7b0e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/104"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak membayar atau menyetor tepat pada waktunya sesuai jangka waktu sebagaimana dimaksud pada ayat (1), Wajib Pajak dikenai sanksi administratif berupa bunga sebesar 1% (satu persen) per bulan dari Pajak terutang yang tidak atau kurang dibayar atau disetor, dihitung dari tanggal jatuh tempo pembayaran sampai dengan tanggal pembayaran, untuk jangka waktu paling lama 24 (dua puluh empat) bulan serta bagian dari bulan dihitung penuh 1 (satu) bulan dan ditagih dengan menggunakan STPD."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_709db90602 a kbr:Kewajiban ;
