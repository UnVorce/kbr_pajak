    kbr:hasSourceQuote "(6) Pengenaan sanksi administratif sebagaimana dimaksud pada ayat (5) dilakukan secara bertahap, sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
