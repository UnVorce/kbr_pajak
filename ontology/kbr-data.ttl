    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_324 ;
    kbr:hasRuleId "R-PMK-2024-81-d575b3b4d0"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/324"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dasar pengenaan pajak sebagaimana dimaksud pada ayat (2) berupa nilai tertentu sebesar jumlah biaya yang dikeluarkan dan/atau yang dibayarkan untuk membangun bangunan untuk setiap Masa Pajak sampai dengan bangunan selesai, tidak termasuk biaya perolehan tanah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_d5d366bdeb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_162_1__3 ;
