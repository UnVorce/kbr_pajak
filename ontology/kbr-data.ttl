    kbr:hasSourceLocator "PMK-2023-96#BT/58/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(5) Persetujuan perubahan atas kesalahan data CN dan/atau pemberitahuan konsolidasi barang kiriman (PKBK) sebagaimana dimaksud pada ayat (2), ayat (3), dan ayat (4) dilakukan oleh: a. SKP; dan/atau b. Pejabat Bea dan Cukai yang ditunjuk."^^xsd:string ;
