    kbr:hasSourceLocator "UU-1983-6#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "(3a) Buku, catatan, dan dokumen, serta data, informasi, dan keterangan lain sebagaimana dimaksud pada ayat (3) wajib dipenuhi oleh Wajib Pajak paling lama 1 (satu) bulan sejak permintaan disampaikan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
