    kbr:hasSourceLocator "PMK-2025-15#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "12. Pajak Penjualan atas Barang Mewah adalah pajak penjualan atas barang mewah sebagaimana diatur dalam Undang-Undang Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
