    kbr:hasSourceLocator "PMK-2023-61#BT/23"^^xsd:string ;
    kbr:hasSourceQuote "Barang tidak bergerak sebagaimana dimaksud pada ayat (3) huruf b dapat berupa: 1. tanah dan/atau bangunan; dan 2. kapal dengan isi kotor paling sedikit 20 (dua puluh) meter kubik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_5541c7ccae a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_135 ;
    kbr:hasRuleId "R-PMK-2023-61-5541c7ccae"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/135"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyampaian permohonan dan/atau pemberitahuan sebagaimana dimaksud dalam Pasal 132 ayat (3) huruf c, Dokumen Penagihan Pajak sebagaimana dimaksud dalam Pasal 133 ayat (2) huruf c, dan surat sebagaimana dimaksud dalam 134 ayat (2) huruf c dilakukan dalam hal sistem sudah tersedia. (2) Tata cara penyampaian permohonan dan/ atau pemberitahuan, Dokumen Penagihan Pajak, dan surat sebagaimana dimaksud pada ayat (1) sesuai dengan Peraturan Menteri yang mengatur mengenai tata cara pelaksanaan hak dan pemenuhan kewajiban perpajakan serta penerbitan, penandatanganan, dan pengiriman keputusan atau ketetapan pajak secara elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

