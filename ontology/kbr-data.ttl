    kbr:hasSourceQuote "NJOP bangunan sebagaimana dimaksud dalam Pasal 11 untuk objek pajak PBB Sektor Pertambangan Mineral atau Batubara ditentukan berdasarkan Nilai Perolehan Baru."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2019_186_826b49693f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2019_186 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2019_186_BT_14_3__4 ;
