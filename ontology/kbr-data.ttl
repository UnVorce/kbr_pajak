    kbr:hasRuleId "R-UU-1983-7-fcd07e1e74"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "(2) Ketentuan mengenai dasar pemungutan, kriteria, sifat, dan besarnya pungutan pajak sebagaimana dimaksud pada ayat (1) diatur dengan atau berdasarkan Peraturan Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

