    kbr:hasRuleId "R-PP-2010-79-e7bc055673"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-79#BT/25/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Penghasilan kena pajak untuk 1 (satu) tahun pajak bagi kontraktor untuk kontrak bagi hasil, dihitung berdasarkan penghasilan dalam rangka kontrak bagi hasil sebagaimana dimaksud dalam Pasal 9 ayat (2) dikurangi biaya bukan modal tahun berjalan dikurangi penyusutan biaya modal tahun berjalan dikurangi biaya operasi yang belum dapat dikembalikan pada tahun-tahun sebelumnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

