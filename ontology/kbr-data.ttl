kbr:Aturan_R_PP_2021_40_3fb9f0f2db a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_35 ;
    kbr:hasRuleId "R-PP-2021-40-3fb9f0f2db"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/35"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal KEK yang ditetapkan merupakan usulan Pemerintah Daerah provinsi sebagaimana dimaksud dalam Pasal 19, penetapan Badan Usaha untuk membangun KEK dilakukan oleh Pemerintah Daerah provinsi secara terbuka dan transparan berdasarkan: a. ketentuan peraturan perllndang-undangan yang mengatur mengenai pengadaan barang/jasa pemerintah dalam hal pembangunan KEK dibiayai dari anggaran pendapatan dan belanja daerah provinsi; atau b. ketentuan peraturan perundang-undangan yang mengatur mengenai kerja sama pemerintah dan badan usaha dalam hal pembangunan KEK dibiayai dari kerja sama Pemerintah Daerah provinsi dengan Badan Usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

