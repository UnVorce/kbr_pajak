    kbr:hasRuleId "R-PP-2021-40-a7d8496b83"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pengusulan sebagaimana dimaksud pada ayat (1) disampaikan secara tertulis kepada Dewan Nasional KEK oleh: a. pimpinan Badan Usaha; b. bupati/wali kota; c. gubernur; atau d. ketua Dewan Kawasan KPBPB."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_a7d9e6b6ca a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_105 ;
    kbr:hasRuleId "R-PP-2021-40-a7d9e6b6ca"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/105"^^xsd:string ;
    kbr:hasSourceQuote "Pengesahan rencana penggunaan tenaga kerja asing sebagaimana dimaksud pada ayat (1) diberikan untuk jangka waktu: a. paling lama 5 (lima) tahun dan dapat diperpanjang; dan b. untuk tenaga kerja asing yang mempunyai jabatan sebagai direksi atau komisaris, diberikan sekali dan berlaku selama tenaga kerja asing yang bersangkutan menjadi direksi atau komisaris."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_a82856bef4 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_150 ;
    kbr:hasRuleId "R-PP-2021-40-a82856bef4"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/150"^^xsd:string ;
    kbr:hasSourceQuote "Persetujuan kesesuaian kegiatan pemanfaatan ruang kepada Badan Usaha dan Pelaku Usaha di KEK diberikan melalui sistem OSS tanpa melalui tahapan penilaian dokumen usulan kegiatan pemanfaatan ruang."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_a8d688f447 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_140 ;
    kbr:hasRuleId "R-PP-2021-40-a8d688f447"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/140"^^xsd:string ;
    kbr:hasSourceQuote "Pengadaan tanah dalam lokasi KEK yang penetapannya berdasarkan usulan Dewan Nasional, Pemerintah Daerah provinsi, Pemerintah Daerah kabupaten f kota, atau badan usaha milik negara/badan usaha milik daerah yang belum beroperasi, pelaksanaannya dilakukan berdasarkan ketentuan peraturan perundang-undangan di bidang pengadaan tanah bagi pembangunan untuk kepentingan umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_a95a6f72bf a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_100 ;
    kbr:hasRuleId "R-PP-2021-40-a95a6f72bf"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/100"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan mengenai bentuk, besaran, dan tata cara pengurangan, keringanan, dan pembebasan pajak daerah dan/atau retribusi daerah sebagaimana dimaksud pada ayat (1) ditetapkan dengan Peraturan Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_a9cbc03609 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_105 ;
    kbr:hasRuleId "R-PP-2021-40-a9cbc03609"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/105"^^xsd:string ;
    kbr:hasSourceQuote "Badan Usaha dan Pelaku Usaha di KEK selaku pemberi kerja yang akan mempekerjakan tenaga kerja asing wajib memiliki rencana penggunaan tenaga kerja asing yang disahkan oleh menteri yang menyelenggarakan urusan pemerintahan di bidang ketenagakerjaan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_aa968da1fd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_17_6 ;
    kbr:hasRuleId "R-PP-2021-40-aa968da1fd"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/17/6"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal lokasi KEK yang diusulkan berada pada lintas wilayah kabupatenf kota, persetujuan Pemerintah Daerah kabupaten/kota sebagaimana dimaksud pada ayat (3) huruf b harus diperoleh dari masing-masing Pemerintah Daerah kabupaten/kota yang lahan di wilayahnya masuk dalam lokasi KEK."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

