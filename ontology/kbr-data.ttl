    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-32d464b71b"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/6/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Harga pasaran umum sebagaimana dimaksud pada ayat (4) adalah harga rata-rata yang diperoleh dari berbagai sumber data yang akurat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_3351b5d513 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
