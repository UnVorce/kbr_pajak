    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_87 ;
    kbr:hasRuleId "R-PMK-2024-81-1e8f6b2b46"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/87"^^xsd:string ;
    kbr:hasSourceQuote "Tanggal diterimanya surat permintaan klarifikasi sebagaimana dimaksud pada ayat (3) merupakan tanggal dikirimnya surat permintaan klarifikasi ke Akun Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

