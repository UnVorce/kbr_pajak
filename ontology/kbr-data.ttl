    kbr:hasSourceLocator "PMK-2023-80#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "Denda administratif sebagaimana dimaksud pada ayat (2) huruf b dihitung dari saat jatuh tempo Surat Pemberitahuan Pajak Terutang atau Surat Ketetapan Pajak Pajak Bumi dan Bangunan sampai dengan tanggal penerbitan Surat Tagihan Pajak Pajak Bumi dan Bangunan untukjangka waktu paling lama 24 {dua puluh empat) bulan dan bagian dari bulan dihitung penuh 1 (satu) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

