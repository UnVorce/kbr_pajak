    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-42c530cb54"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/158"^^xsd:string ;
    kbr:hasSourceQuote "Jurusita Pajak melaksanakan Penagihan Seketika dan Sekaligus berdasarkan surat perintah Penagihan Seketika dan Sekaligus apabila: a. Penanggung Pajak akan meninggalkan Indonesia untuk selama-lamanya atau berniat untuk itu; b. Penanggung Pajak memindahtangankan barang yang dimiliki atau yang dikuasai dalam rangka menghentikan atau mengecilkan kegiatan usahanya atau pekerjaan yang dilakukannya di Indonesia; c. terdapat tanda-tanda bahwa Penanggung Pajak akan membubarkan badan usahanya, menggabungkan usahanya, atau memekarkan usahanya, atau memindahtangankan perusahaan yang dimiliki atau dikuasainya, atau melakukan perubahan bentuk lainnya; d. badan usaha akan dibubarkan oleh negara; atau e. terjadi penyitaan atas barang Penanggung Pajak oleh pihak ketiga atau terdapat tanda-tanda kepailitan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_42db5a85b3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_182 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-42db5a85b3"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/182"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dokumen perjanjian kerja sama sebagaimana dimaksud pada ayat (3) paling sedikit mengatur ketentuan mengenai: a. subjek kerja sama; b. maksud dan tujuan; c. ruang lingkup; d. hak dan kewajiban para pihak yang terlibat; e. jangka waktu perjanjian; f. sumber pembiayaan; g. penyelesaian perselisihan; h. sanksi; i. korespondensi; dan j. perubahan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_4349ccdac8 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_135_1__9 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-4349ccdac8"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/135/1..9"^^xsd:string ;
    kbr:hasSourceQuote "Selain dikenakan sanksi administratif sebagaimana dimaksud pada ayat (7) terhadap wajib pajak yang tidak membayar atau menyetor tepat waktu sebagaimana dimaksud pada ayat (5) dan ayat (6), Wajib Pajak juga dapat dikenai sanksi administratif dikenakan sanksi administratif berupa: a. peringatan tertulis; b. penutupan sementara kegiatan/usaha; c. pembekuan perizinan berusaha; dan/atau d. pencabutan perizinan berusaha."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_43d607e03f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_163 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-43d607e03f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/163"^^xsd:string ;
    kbr:hasSourceQuote "(4) Piutang Pajak yang dihapuskan sebagaimana dimaksud pada ayat (3) ditetapkan dalam Keputusan Walikota."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_4420e1a695 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_151 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-4420e1a695"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/151"^^xsd:string ;
    kbr:hasSourceQuote "2. Wajib Pajak tidak memenuhi kewajiban sebagaimana dimaksud dalam Pasal 142 ayat (1) atau Pasal 150 ayat (1);"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_44a232d346 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_150 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-44a232d346"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/150"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam pelaksanaan Pemeriksaan sebagaimana dimaksud dalam Pasal 149, hak Wajib Pajak dan/atau Wajib Retribusi yang diperiksa paling sedikit: a. meminta identitas dan bukti penugasan Pemeriksaan kepada pemeriksa; b. meminta kepada pemeriksa untuk memberikan penjelasan tentang alasan dan tujuan Pemeriksaan; dan c. menerima dokumen hasil Pemeriksaan serta memberikan tanggapan atau penjelasan atas hasil Pemeriksaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_44ec9e0a3f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_1_p4 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-44ec9e0a3f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/1#p4"^^xsd:string ;
    kbr:hasSourceQuote "Retribusi Pelayanan Kesehatan adalah pungutan Daerah sebagai pembayaran atas pemberian pelayanan kesehatan yang diselenggarakan oleh Pemerintah Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_46ea8a0997 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_6 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-46ea8a0997"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "(3) Objek Pajak yang dikecualikan dari PBB-P2 adalah kepemilikan, penguasaan, dan/atau pemanfaatan atas: a. Bumi dan/atau Bangunan kantor Pemerintah, kantor Pemerintahan Daerah, dan kantor penyelenggara negara lainnya yang dicatat sebagai barang milik negara atau barang milik Daerah; b. Bumi dan/atau Bangunan yang digunakan semata-mata untuk melayani kepentingan umum dibidang keagamaan, panti sosial, kesehatan, pendidikan, dan kebudayaan nasional, yang tidak dimaksudkan untuk memperoleh keuntungan; c. Bumi dan/atau Bangunan yang semata-mata digunakan untuk tempat makam (kuburan), peninggalan purbakala atau yang sejenis; d. Bumi yang merupakan hutan lindung, hutan suaka alam, hutan wisata, taman nasional, tanah penggembalaan yang dikuasai oleh desa, dan tanah negara yang belum dibebani suatu hak; e. Bumi dan/atau Bangunan yang digunakan oleh perwakilan diplomatik dan konsulat berdasarkan asas perlakuan timbal balik; f. Bumi dan/atau Bangunan yang digunakan oleh Badan atau perwakilan lembaga internasional yang ditetapkan dengan Peraturan Menteri yang menyelenggarakan urusan pemerintahan bidang keuangan negara; g. Bumi dan/ atau Bangunan untuk jalur kereta api, moda raya terpadu (Mass Rapid Transit), lintas raya terpadu (Light Rail Transit) atau yang sejenis; h. Bumi dan/atau Bangunan tempat tinggal lainnya berdasarkan NJOP tertentu yang ditetapkan oleh Walikota; dan i. Bumi dan/atau Bangunan yang dipungut pajak bumi dan bangunan oleh Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_4759889512 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_1_p5 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-4759889512"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/1#p5"^^xsd:string ;
    kbr:hasSourceQuote "Tempat Parkir di Tepi Jalan Umum adalah fasilitas parkir kendaraan di tepi jalan umum yang ditentukan oleh Pemerintah Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_4777234a43 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_112 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-4777234a43"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/112"^^xsd:string ;
    kbr:hasSourceQuote "(5) Peraturan Walikota sebagaimana dimaksud pada ayat (4) disampaikan kepada Menteri yang menyelenggarakan urusan pemerintahan bidang Keuangan Negara, menteri yang menyelenggarakan Urusan Pemerintahan Dalam Negeri, dan DPRD paling lambat 7 (tujuh) hari kerja sejak Peraturan Walikota ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_4798ff5cfd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_184 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-4798ff5cfd"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/184"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Pemerintah Daerah telah menerapkan sistem online terhadap jenis pajak daerah dan retribusi daerah maka Wajib Pajak dan Wajib Retribusi wajib melaksanakan sistem online dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_48cf032b51 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_4 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-48cf032b51"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Masa Pajak yang menjadi dasar bagi Wajib Pajak untuk menghitung, menyetor, dan melaporkan Pajak yang terutang untuk jenis Pajak yang dipungut berdasarkan penghitungan sendiri Wajib Pajak sebagaimana dimaksud pada ayat (2), ditetapkan untuk jangka waktu 1 (satu) bulan kalender atau jangka waktu paling lama 3 (tiga) bulan kalender."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_48d283a72e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_151 ;
    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-48d283a72e"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/151"^^xsd:string ;
    kbr:hasSourceQuote "SKPDKBT sebagaimana dimaksud pada ayat (1) diterbitkan dalam hal ditemukan data baru dan/atau data yang semula belum terungkap dan menyebabkan penambahan Pajak yang terutang setelah dilakukan Pemeriksaan dalam rangka penerbitan SKPDKBT."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_490d3de032 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_13 ;
