    kbr:hasSourceQuote "Kompensasi ke Utang Pajak dan/ atau Deposit Pajak sebagaimana dimaksud pada ayat ( 1) dilakukan melalui potongan Surat Perintah Membayar Kelebihan Pajak dan Surat Perintah Membayar Imbalan Bunga."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
