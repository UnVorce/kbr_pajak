    kbr:hasSourceLocator "PMK-2024-136#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "2. Grup Perusahaan Multinasional yang selanjutnya disebut Grup PMN adalah grup yang memiliki setidaknya satu entitas atau bentuk usaha tetap yang tidak berada di negara atau yurisdiksi entitas induk utama."^^xsd:string ;
