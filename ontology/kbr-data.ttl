kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a0e1fab4ed a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_83_1__9 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a0e1fab4ed"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/83/1..9"^^xsd:string ;
    kbr:hasSourceQuote "SKPDKB sebagaimana dimaksud pada ayat (1) dan ayat (2) serta SKPDKBT sebagaimana dimaksud pada ayat (3) wajib dilunasi dalam jangka waktu paling lama 1 (satu) bulan sejak tanggal diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a13f179abc a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_83_1__9 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a13f179abc"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/83/1..9"^^xsd:string ;
    kbr:hasSourceQuote "SKPDN sebagaimana dimaksud pada ayat (1) diterbitkan jika jumlah pajak yang terutang sama besarnya dengan jumlah kredit pajak atau pajak tidak terutang dan tidak ada kredit pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a1e36783e3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_1_p2 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a1e36783e3"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Mineral Bukan Logam dan Batuan yang selanjutnya disebut MBLB adalah mineral bukan logam dan batuan sebagaimana dimaksud di dalam peraturan perundang- undangan di bidang mineral dan batu bara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a29fa3b5c7 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_22 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a29fa3b5c7"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "(1) PAB terutang terhitung sejak Wajib Pajak diakui secara sah memiliki dan/atau menguasai Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a2f2746f96 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_96_1__1 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a2f2746f96"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/96/1..1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam mendukung kebijakan kemudahan berinvestasi, Gubernur dapat memberikan insentif fiskal kepada pelaku usaha di Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a3046dac79 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_101_1__5 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a3046dac79"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/101/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Setiap pejabat dilarang memberitahukan kepada pihak lain segala sesuatu yang diketahui atau diberitahukan kepadanya oleh Wajib Pajak dalam rangka jabatan atau pekerjaannya untuk menjalankan ketentuan peraturan perundang-undangan di bidang perpajakan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a356f07866 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_101_1__5 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a356f07866"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/101/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Untuk kepentingan pemeriksaan di pengadilan dalam perkara pidana atau perdata, atas permintaan hakim sesuai dengan hukum acara pidana dan hukum acara perdata, Gubernur dapat memberikan izin tertulis kepada pejabat sebagaimana dimaksud pada ayat (1), dan tenaga ahli sebagaimana dimaksud pada ayat (2), untuk memberikan dan memperlihatkan bukti tertulis dan keterangan Wajib Pajak yang ada padanya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a40d3e1792 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_3 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a40d3e1792"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jenis Pajak sebagaimana dimaksud dalam Pasal 2, yang dipungut berdasarkan penetapan Gubernur terdiri atas: a. PKB; b. BBNKB; c. PAB; dan d. PAP."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a4430a09fb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_18 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a4430a09fb"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "(1) Subjek PAB adalah orang pribadi dan Badan yang memiliki dan/atau menguasai Alat Berat. (2) Wajib PAB adalah orang pribadi dan Badan yang memiliki dan/atau menguasai Alat Berat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a4547cbd31 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_19 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a4547cbd31"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(3) Harga rata-rata pasaran umum sebagaimana dimaksud pada ayat (2) ditetapkan berdasarkan harga rata-rata yang diperoleh dari berbagai sumber data yang akurat pada minggu pertama bulan Desember Tahun Pajak sebelumnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a4ff1ba075 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_110 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a4ff1ba075"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/110"^^xsd:string ;
    kbr:hasSourceQuote "Tindak pidana di bidang perpajakan Daerah tidak dapat dituntut apabila telah melampaui jangka waktu 5 (lima) tahun terhitung sejak saat Pajak terutang atau masa Pajak berakhir atau bagian Tahun Pajak berakhir atau Tahun Pajak yang bersangkutan berakhir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a5398f52ab a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_76 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a5398f52ab"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "Pelayanan pengelolaan pertambangan rakyat sebagaimana dimaksud pada ayat (1) diberikan kepada: a. orang perseorangan yang merupakan penduduk setempat; atau b. Koperasi atau Badan Usaha lainnya yang di kelola masyarakat serta anggotanya merupakan penduduk setempat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a59dfe4ab3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_1_p4 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a59dfe4ab3"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p4"^^xsd:string ;
    kbr:hasSourceQuote "Surat Setoran Pajak Daerah yang selanjutnya disingkat SSPD adalah bukti pembayaran atau penyetoran pajak yang telah dilakukan dengan menggunakan formulir atau telah dilakukan dengan cara lain ke Kas Daerah melalui tempat pembayaran yang ditunjuk oleh Gubernur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a5a886d581 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_1_p3 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a5a886d581"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Kendaraan Bermotor Umum adalah setiap kendaraan bermotor yang dipergunakan untuk mengangkut orang atau barang dengan dipungut bayaran dan memiliki izin angkutan dan/atau izin trayek."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a678a9bc12 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_82_1__8 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a678a9bc12"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/82/1..8"^^xsd:string ;
    kbr:hasSourceQuote "Dokumen yang digunakan sebagai dasar pemungutan jenis Pajak yang dipungut berdasarkan penetapan Gubernur sebagaimana dimaksud pada ayat (1) adalah SKPD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a82c44eced a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_6_1__6 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a82c44eced"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/6/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal harga pasaran umum suatu Kendaraan Bermotor tidak diketahui, NJKB dapat ditentukan berdasarkan sebagian atau seluruh faktor-faktor: a. harga Kendaraan Bermotor dengan isi silinder dan/ atau satuan tenaga yang sama; b. penggunaan Kendaraan Bermotor untuk umum atau pribadi; c. harga Kendaraan Bermotor dengan merek Kendaraan Bermotor yang sama; d. harga Kendaraan Bermotor dengan tahun pembuatan Kendaraan Bermotor yang sama; e. harga Kendaraan Bermotor dengan pembuat Kendaraan Bermotor; f. harga Kendaraan Bermotor dengan Kendaraan Bermotor sejenis; dan g. harga Kendaraan Bermotor berdasarkan dokumen pemberitahuan impor barang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a88a8c9a1f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_96_1__1 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a88a8c9a1f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/96/1..1"^^xsd:string ;
    kbr:hasSourceQuote "Insentif fiskal sebagaimana dimaksud pada ayat (1) dapat diberikan atas permohonan Wajib Pajak dan/atau Wajib Retribusi atau diberikan secara jabatan oleh Gubernur berdasarkan pertimbangan, meliputi: a. kemampuan membayar Wajib Pajak dan/atau Wajib Retribusi; b. kondisi tertentu objek Pajak, seperti objek Pajak terkena bencana alam, kebakaran, dan/atau penyebab lainnya yang terjadi bukan karena adanya unsur kesengajaan yang dilakukan oleh Wajib Pajak dan/atau pihak lain yang bertujuan untuk menghindari pembayaran Pajak; c. untuk mendukung dan melindungi pelaku usaha mikro dan ultra mikro; d. untuk mendukung kebijakan Daerah dalam mencapai program prioritas Daerah; dan/atau Dokumen ini telah ditandatangani secara elektronik menggunakan sertifikat elektronik yang diterbitkan oleh Balai Sertifikasi Elektronik (BSrE) Badan Siber dan Sandi Negara. Dokumen digital yang asli dapat diperoleh dengan memindai QR Code, memasukkan kode pada Aplikasi NDE Pemerintah Daerah Provinsi Jawa Barat, atau mengakses tautan berikut https://sidebar.jabarprov.go.id/v/95C90148AA 95C90148AA 38 e. untuk mendukung kebijakan pemerintah pusat dalam mencapai program prioritas nasional;"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a951ac31c9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_71 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a951ac31c9"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/71"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi Perizinan Tertentu merupakan Orang Pribadi atau Badan yang menurut peraturan perundang- undangan diwajibkan untuk melakukan pembayaran Retribusi atas pemberian Perizinan Tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_ab7130acbe a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_84 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-ab7130acbe"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/84"^^xsd:string ;
    kbr:hasSourceQuote "Gubernur dan bank tempat pembayaran PKB dan BBNKB, melakukan rekonsiliasi data penerimaan PKB dan BBNKB serta Opsen PKB dan Opsen BBNKB setiap triwulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_ab7af0b378 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
