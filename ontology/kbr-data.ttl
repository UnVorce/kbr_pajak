    kbr:hasSourceLocator "PMK-2023-172#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "(3) Penyesuaian harga jual atau penggantian yang dipengaruhi oleh hubungan istimewa sebagaimana dimaksud pada ayat (1) juga dapat dilakukan dalam hal terdapat Penentuan Harga Transfer oleh Direktur Jenderal Pajak sebagaimana dimaksud dalam Pasal 36 ayat (6) yang dapat dialokasikan pada setiap transaksi penyerahan barang kena pajak dan/atau jasa kena pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

