    kbr:hasSourceQuote "Untuk mendapatkan fasilitas dan kemudahan sebagaimana dimaksud pada ayat (1), Pelaku Usaha harus memenuhi syarat sebagai berikut: a. merupakan Wajib Pajak badan dalam negeri, baik pusat maupun cabang; dan b. memiliki Perizinan Berusaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

