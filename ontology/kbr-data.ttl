    kbr:hasRuleId "R-PP-2021-41-631e49ad1a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-41#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap barang yang akan: a. dimasukkan ke KPBPB dari luar Daerah Pabean, KPBPB lainnya, Tempat Penimbunan Berikat, atau KEK; atau b. dikeluarkan dari KPBPB ke luar Daerah Pabean, KPBPB lainnya, Tempat Penimbunan Berikat, KEK, atau tempat lain dalam Daerah Pabean, dapat dilakukan penelitian dokumen secara selektif berdasarkan manajemen risiko."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

