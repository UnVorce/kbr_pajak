    kbr:hasSourceQuote "(6) Dikecualikan objek retribusi sebagaimana dimaksud pada ayat (1) meliputi penerbitan PBG untuk bangunan milik Pemerintah, Pemerintah Provinsi, Pemerintah Daerah, atau Pemerintah Daerah lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

