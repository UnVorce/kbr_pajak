    kbr:hasSourceQuote "g. terdapat jumlah pajak yang tidak atau kurang dibayar dalam jangka waktu sesuai dengan persetujuan untuk mengangsur atau menunda kekurangan pembayaran pajak yang terutang berdasarkan Surat Pemberitahuan Tahunan Pajak Penghasilan sebagaimana diatur dalam Pasal 9 ayat (4) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

