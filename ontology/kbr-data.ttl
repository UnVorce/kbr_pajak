    kbr:hasSourceLocator "PMK-2014-111#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "(7) Apabila sampai dengan berakhirnya jangka waktu sebagaimana dimaksud pada ayat (2) belum terdapat suatu keputusan, permohonan sebagaimana dimaksud pada ayat (1) dianggap disetujui."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2014_111_6c3e2d67a3 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2014_111 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2014_111_BT_28_4__6 ;
