    kbr:hasSourceQuote "(1) Untuk menentukan besarnya Penghasilan Kena Pajak sebagaimana dimaksud dalam Pasal 7 ayat (3), penghasilan dikurangi dengan biaya untuk mendapatkan, menagih, dan memelihara penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

