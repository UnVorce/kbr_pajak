    kbr:hasRuleId "R-PMK-2023-143-e4243fe166"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penyetoran penerimaan Pajak Rokok berikutnya dilaksanakan sesuai dengan ketentuan dalam Pasal 20 dengan memperhatikan ketentuan peraturan perundang- undangan mengcnai pembentukan provinsi baru sebagaimana dimaksud pada ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
