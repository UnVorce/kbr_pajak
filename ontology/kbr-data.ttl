    kbr:hasSourceLocator "PER-DJP-2025-7#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penetapan penambahan atas status Wajib Pajak secara jabatan sebagaimana dimaksud pada ayat (1) dilakukan dengan menerbitkan surat penetapan Pemungut Bea Meterai untuk penambahan status sebagaimana dimaksud dalam Pasal 62 ayat (2) huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
