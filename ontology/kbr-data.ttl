kbr:Aturan_R_PMK_2024_81_1eb2b8a96b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_157_1__3 ;
    kbr:hasRuleId "R-PMK-2024-81-1eb2b8a96b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/157/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Surat Keputusan Pengembalian Kelebihan Pembayaran Pajak sebagaimana dimaksud pada ayat (1) merupakan: a. Surat Keputusan Pengembalian Kelebihan Pembayaran Pajak dengan nomor rekening, dalam hal terdapat nomor rekening pada profil Wajib Pajak dalam basis data perpajakan; atau b. Surat Keputusan Pengembalian Kelebihan Pembayaran Pajak tanpa nomor rekening, dalam hal tidak terdapat nomor rekening pada profil Wajib Pajak dalam basis data perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

