    kbr:hasSourceQuote "(4) Pejabat yang menerima pelimpahan kewenangan dalam bentuk delegasi sebagaimana dimaksud pada ayat (1), ayat (2) , dan ayat (3) dapat mendelegasikan lebih lanjut atau mensubdelegasikan . kewenangan dimaksud kepada pejabat satu tingkat dibawahnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
