    kbr:hasSourceQuote "Dalam mendistribusikan Meterai Elektronik sebagaimana dimaksud pada ayat (1), Perusahaan Umum (Perum) Percetakan Uang Republik Indonesia bekerja sama dengan Distributor."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

