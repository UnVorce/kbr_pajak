    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e0e6774520 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_53 ;
    kbr:hasRuleId "R-PMK-2023-61-e0e6774520"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/53"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pelaksanaan pemindahbukuan sebagaimana dimaksud pada ayat (1) dilakukan paling banyak sebesar sejumlah yang tercantum dalam berita acara pelaksanaan sita."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e187e77b13 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_80 ;
    kbr:hasRuleId "R-PMK-2023-61-e187e77b13"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/80"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak dapat memberitahukan secara tertulis kepada pejabat yang berwenang di Negara Mitra atau Yurisdiksi Mitra dalam hal terdapat perubahan informasi atau data permintaan Bantuan Penagihan Pajak sebagaimana dimaksud dalam Pasal 79 ayat (3), meliputi: a. pengurangan sebagianjumlah Utang Pajak; b. penambahan daftar Barang milik Penanggung Pajak; c. perubahan tanggal daluwarsa penagihan Pajak; dan/atau d. perubahan Nomor Rekening Pemerintah Lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e19aa1e4fa a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_11 ;
    kbr:hasRuleId "R-PMK-2023-61-e19aa1e4fa"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penagihan Pajak dilakukan dengan terlebih dahulu menerbitkan Surat Teguran sebagaimana dimaksud dalam Pasal 5 ayat (1) huruf a. (2) Surat Teguran tidak diterbitkan terhadap Wajib Pajak yang telah mendapat persetujuan untuk mengangsur atau menunda pembayaran Utang Pajak sebagaimana dimaksud dalam Pasal 4 ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e1f7753c52 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_18 ;
    kbr:hasRuleId "R-PMK-2023-61-e1f7753c52"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal Penanggung Pajak tidak diketahui tempat tinggalnya, tempat usaha, atau tempat kedudukannya, penyampaian Surat Paksa dilaksanakan dengan menempelkan Surat Paksa pada papan pengumuman di kantor Pejabat yang menerbitkannya, mengumumkan melalui media massa, atau cara lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e29d9df6f3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_77 ;
    kbr:hasRuleId "R-PMK-2023-61-e29d9df6f3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "(7) Pemberian ganti rugi kepada Penanggung Pajak sebagaimana dimaksud pada ayat (5) huruf b dimuat dalam surat keputusan pemberian ganti rugi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e2b8426633 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_24 ;
    kbr:hasRuleId "R-PMK-2023-61-e2b8426633"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/24"^^xsd:string ;
    kbr:hasSourceQuote "(4) Penyitaan sebagaimana dimaksud pada ayat (1) dilaksanakan sampai dengan jumlah nilai Barang sitaan diperkirakan cukup untuk melunasi Utang Pajak dan Biaya Penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e31eec9cae a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_124 ;
    kbr:hasRuleId "R-PMK-2023-61-e31eec9cae"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/124"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal Pajak mengembalikan hasil penagihan Pajak atas Nilai Klaim Pajak kepada Penanggung Pajak atas Klaim Pajak dalam hal terdapat: a. pemberitahuan perubahan informasi yang tercantum dalam Klaim Pajak berupa pengurangan sebagian Nilai Klaim Pajak sebagaimana dimaksud Pasal 121 ayat (1) huruf a; a tau b. permintaan penghentian pemberian Bantuan Penagihan Pajak dari Negara Mitra atau Yurisdiksi Mitra sebagaimana dimaksud dalam Pasal 122 ayat ( 1)' sebelum hasil penagihan Pajak atas Nilai Klaim Pajak dikirimkan ke Negara Mitra atau Yurisdiksi Mitra. Dalam hal surat setoran Klaim Pajak sudah diterbitkan, pengembalian sebagaimana dimaksud pada ayat (1) dilakukan setelah surat setoran Klaim Pajak dibatalkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e384f5f6d5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_7 ;
    kbr:hasRuleId "R-PMK-2023-61-e384f5f6d5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Penagihan Pajak dilakukan terhadap: a. Penanggung Pajak atas Wajib Pajak orang pribadi; atau b. Penanggung Pajak atas Wajib Pajak Badan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e457ca07b1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_9_3__9 ;
    kbr:hasRuleId "R-PMK-2023-61-e457ca07b1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/9/3..9"^^xsd:string ;
    kbr:hasSourceQuote "Untuk pengurus yang namanya tidak tercantum dalam akta, urutan penagihan Pajak tetap mengikuti ketentuan sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e5b0ed4830 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_10 ;
    kbr:hasRuleId "R-PMK-2023-61-e5b0ed4830"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penagihan Pajak dapat dilakukan terhadap Penanggung Pajak dari Wajib Pajak sebagaimana dimaksud dalam Pasal 7 yang: a. dinyatakan pailit; b. dibubarkan, dilikuidasi, atau status badan hukumnya berakhir; c. dilakukan Penggabungan; d. dilakukan Peleburan; dan/ atau e. dilakukan Pemisahan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e623b447fb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2023-61-e623b447fb"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Penyitaan adalah tindakan Jurusita Pajak untuk menguasai barang Penanggung Pajak, guna dijadikan jaminan untuk melunasi Utang Pajak menurut peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e634a96bb8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_39 ;
    kbr:hasRuleId "R-PMK-2023-61-e634a96bb8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "Pembayaran Utang Pajak dan Biaya Penagihan Pajak dengan menggunakan harta kekayaan Penanggung Pajak yang telah disita sesuai dengan tanggung jawab Penanggung Pajak sebagaimana dimaksud dalam Pasal 38 ayat (2) huruf a dilakukan dengan mengajukan permohonan kepada Pejabat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e6477c5388 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_113_1__2 ;
    kbr:hasRuleId "R-PMK-2023-61-e6477c5388"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/113/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pertimbangan tertentu dari Menteri sebagaimana dimaksud pada ayat (1) huruf d, meliputi: a. Penanggung Pajak atas Klaim Pajak menyerahkan Barang yang tercantum dalam Klaim Pajak sebagaimana dimaksud dalam Pasal 83 ayat (3) huruf f sejumlah: 1. seluruh Barang yang tercantum dalam Klaim Pajak dalam hal Nilai Klaim Pajak sama atau lebih besar dari pada perkiraan nilai Barang yang tercantum dalam Klaim Pajak; atau 2. sebagian Barang yang tercantum dalam Klaim Pajak yang nilainya diperkirakan mencukupi untuk melunasi seluruh Nilai Klaim Pajak, dalam hal Nilai Klaim Pajak lebih kecil dari pada perkiraan nilai Barang yang tercantum dalam Klaim Pajak; b. Penanggung Pajak atas Klaim Pajak telah berumur 80 {delapan puluh) tahun atau lebih; c. Penanggung Pajak atas Klaim Pajak menderita sakit berat sehingga memerlukan perawatan dalam jangka waktu yang lama di luar tempat Penyanderaan yang dibuktikan dengan surat keterangan dokter yang ditunjuk oleh Pejabat; d. untuk kepentingan umum atau pertimbangan kemanusiaan; e. hak untuk melakukan penagihan Pajak atas Nilai Klaim Pajak yang menjadi dasar dilakukan Penyanderaan telah daluwarsa penagihan; dan/atau f. pemberian Bantuan Penagihan Pajak telah dihentikan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e6a66440bf a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_19 ;
    kbr:hasRuleId "R-PMK-2023-61-e6a66440bf"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(5) Penyampaian informasi mengenai pelaksanaan pemberitahuan Surat Paksa sebagaimana dimaksud pada ayat (4) dilampiri dengan berita acara pemberitahuan Surat Paksa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e6e3948342 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_145 ;
    kbr:hasRuleId "R-PMK-2023-61-e6e3948342"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/145"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal terdapat pemberitahuan dari Negara Mitra atau Yurisdiksi Mitra mengenai perubahan tanggal daluwarsa sebagaimana dimaksud dalam Pasal 83 ayat (3) huruf g, hak untuk melakukan penagihan Pajak atas Nilai Klaim Pajak daluwarsa sejak tanggal daluwarsa yang tercantum dalam pemberitahuan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e7726d7865 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_133_1 ;
    kbr:hasRuleId "R-PMK-2023-61-e7726d7865"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/133/1"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pejabat menyampaikan Dokumen Penagihan Pajak berupa: a. Surat Teguran sebagaimana dimaksud dalam Pasal 11 dan Pasal 86; b. salinan berita acara pelaksanaan sita sebagaimana dimaksud dalam: 1. Pasal 21 ayat (7); 2. Pasal 37 ayat (3) huruf b angka 1; dan 3. Pasal 46 ayat (3) huruf b; c. surat pencabutan sita sebagaimana dimaksud dalam: 1. Pasal 26 ayat (5); 2. Pasal 40 ayat (3); 3. Pasal 41 huruf b; 4. Pasal 47 ayat (5) huruf b; 5. Pasal 53 ayat (1) huruf b; 6. Pasal 92 ayat (2); 7. Pasal 99 ayat (5); 8. Pasal 100 huruf b; 9. Pasal 104 ayat (2) huruf b; dan 10. Pasal 109 ayat (1) huruf b; d. tembusan permintaan pencabutan blokir harta kekayaan Penanggung Pajak yang tersimpan pada Lembaga Jasa Keuangan sektor perbankan, Lembaga Jasa Keuangan sektor perasuransian, Lembaga Jasa Keuangan Lainnya, dan/ atau Entitas Lain sebagaimana dimaksud dalam: jdih.kemenkeu.go.id -81- 1. Pasal 36; 2. Pasal 41 huruf a; 3. Pasal 96; dan 4. Pasal 100 huruf a; e. tembusan permintaan pencabutan blokir dan pemindahbukuan harta kekayaan Penanggung Pajak yang tersimpan pada Lembaga Jasa Keuangan sektor perbankan, Lembaga Jasa Keuangan sektor perasuransian, Lembaga Jasa Keuangan Lainnya, dan/atau Entitas Lain sebagaimana dimaksud dalam: 1. Pasal 35 ayat (1); 2. Pasal 40 ayat (1); 3. Pasal 53 ayat (1) huruf a; 4. Pasal 95 ayat (3); 5. Pasal 99 ayat (3); dan 6. Pasal 109 ayat (1) huruf a; f. tembusan permintaan pencabutan blokir atas Rekening Keuangan yang terdapat pada Lembaga Jasa Keuangan sektor pasar modal sebagaimana dimaksud dalam: 1. Pasal 45; 2. Pasal 4 7 ayat (5) huruf a; 3. Pasal 102 ayat (3); dan 4. Pasal 104 ayat (2) huruf a; g. keputusan Menteri mengenai Pencegahan sebagaimana dimaksud dalam Pasal 59; h. keputusan Menteri mengenai perpanjangan jangka waktu Pencegahan sebagaimana dimaksud dalam Pasal 61 ayat (1) huruf b; 1. keputusan Menteri mengenai pencabutan Pencegahan sebagaimana dimaksud dalam Pasal 63 ayat (4) hurufb; dan/atau J. keputusan pembetulan, penggantian, atau pembatalan Dokumen Penagihan Pajak sebagaimana dimaksud dalam Pasal 129 dan Pasal 130, kepada Penanggung Pajak atau Penanggung Pajak atas Klaim Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e81670cf2b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_143_1__4 ;
    kbr:hasRuleId "R-PMK-2023-61-e81670cf2b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/143/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal Wajib Pajak menyatakan pengakuan Utang Pajak secara langsung sebagaimana dimaksud dalam Pasal 140 ayat (1) dan Pasal 142 ayat (1), daluwarsa penagihan Pajak dihitung sejak tanggal: a. pernyataan Wajib Pajak masih mempunyai Utang Pajak; b. permohonan angsuran atau penundaan pembayaran Utang Pajak sebagaimana dimaksud dalam Pasal 140 ayat (1) huruf b dan Pasal 142 ayat (1) huruf b diterima oleh Direktur Jenderal Pajak; atau c. pembayaran sebagian Utang Pajak oleh Wajib Pajak sebagaimana dimaksud dalam Pasal 140 ayat (1) huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e8e03297d8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_91 ;
    kbr:hasRuleId "R-PMK-2023-61-e8e03297d8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "(2) Mekanisme pelaksanaan Penyitaan sebagaimana dimaksud dalam Pasal 20 ayat (2) sampai dengan ayat (6) dan Pasal 21 dan penitipan Barang sitaan sebagaimana dimaksud dalam Pasal 25 berlaku secara mutatis mutandis terhadap pelaksanaan Penyitaan dan penitipan Barang sitaan untuk penagihan Pajak atas Klaim Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e98f430742 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_1_p1 ;
    kbr:hasRuleId "R-PMK-2023-61-e98f430742"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Peraturan Menteri ini, yang dimaksud dengan: 1. Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan adalah Undang-Undang Nomor 6 Tahun 1983 tentang Ketentuan Umum dan Tata Cara Perpajakan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 7 Tahun 2021 tentang Harmonisasi Peraturan Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e9e72e76bd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_30_1__3 ;
    kbr:hasRuleId "R-PMK-2023-61-e9e72e76bd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/30/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(2) · Pemblokiran sebagaimana dimaksud pada ayat (1) huruf a dilakukan secara seketika setelah permintaan Pemblokiran diterima oleh Lembaga Jasa Keuangan sektor perbankan, Lembaga Jasa Keuangan sektor perasuransian, Lembaga Jasa Keuangan Lainnya, dan/ atau Entitas Lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_e9e8d479e4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_111 ;
    kbr:hasRuleId "R-PMK-2023-61-e9e8d479e4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/111"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pencegahan terhadap Penanggung'Pajak atas Klaim Pajak sebagaimana dimaksud dalam Pasal 110 berakhir karena: a. jangka waktu yang ditetapkan telah habis; atau b. dicabut berdasarkan keputusan Menteri. (2) Keputusan Menteri sebagaimana dimaksud pada ayat (1) huruf b dilakukan dengan pertimbangan sebagai berikut: a. Penanggung Pajak atas Klaim Pajak membayar lunas seluruh Nilai Klaim Pajak yang menjadi dasar dilakukan Pencegahan; b. Penanggung Pajak atas Klaim Pajak menyerahkan Barang yang tercantum dalam Klaim Pajak sebagaimana dimaksud dalam Pasal 83 ayat (3) huruf f sejumlah: 1. seluruh Barang yang tercantum dalam Klaim Pajak dalam hal Nilai Klaim Pajak sama atau lebih besar dari pada perkiraan nilai Barang yang tercantum dalam Klaim Pajak; atau 2. sebagian Barang yang tercantum dalam Klaim Pajak yang nilainya diperkirakan mencukupi untuk melunasi seluruh Nilai Klaim Pajak, dalam hal Nilai Klaim Pajak lebih kecil dari pada perkiraan nilai Barang yang tercantum dalam Klaim Pajak; c. terdapat putusan pengadilan pajak; d. untuk kepentingan umum atau pertimbangan kemanusiaan; e. hak untuk melakukan penagihan Pajak atas Nilai Klaim Pajak yang menjadi dasar dilakukan Pencegahan telah daluwarsa penagihan; atau f. pemberian Bantuan Penagihan Pajak telah dihentikan. (3) Terhadap pelaksanaan pencabutan Pencegahan sebagaimana dimaksud pada ayat (2) huruf b, Pejabat jdih.kemenkeu.go.id -70- melakukan Penyitaan terlebih dahulu atas Barang yang diserahkan. (4) Dalam hal terpenuhinya salah satu pertimbangan sebagaimana dimaksud pada ayat (2), Pejabat mengajukan permintaan pencabutan Pencegahan kepada Menteri. (5) Mekanisme permintaan pencabutan Pencegahan sebagaimana dimaksud dalam Pasal 63 ayat (2) sampai dengan ayat (5) berlaku secara m,utatis mutandis terhadap permintaan pencabutan Pencegahan terhadap Penanggung Pajak atas Klaim Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_ea71431d68 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_76 ;
    kbr:hasRuleId "R-PMK-2023-61-ea71431d68"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/76"^^xsd:string ;
    kbr:hasSourceQuote "Penanggung Pajak dapat mengajukan permohonan rehabilitasi nama _baik dan ganti rugi atas Penyanderaan yang telah dijalaninya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_eade0342ee a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_10 ;
    kbr:hasRuleId "R-PMK-2023-61-eade0342ee"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(3) Setelah Wajib Pajak dibubarkan, dilikuidasi, atau status badan hukumnya berakhir sebagaimana dimaksud pada ayat (1) huruf b, tindakan penagihan Pajak tetap dapat dilakukan kepada Penanggung Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_eb24b4f0e8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_128 ;
    kbr:hasRuleId "R-PMK-2023-61-eb24b4f0e8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/128"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pembetulan, penggantian, atau pembatalan Dokumen .Penagihan Pajak dilakukan: a. berdasarkan permohonan Penanggung Pajak; atau b. secara jabatan oleh Pejabat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_eb46f8aeda a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_87 ;
    kbr:hasRuleId "R-PMK-2023-61-eb46f8aeda"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/87"^^xsd:string ;
    kbr:hasSourceQuote "(3) Surat perintah Penagihan Seketika dan Sekaligus sebagaimana dimaksud pada ayat (1) paling sedikit memuat: a. nama Penanggung Pajak atas Klaim Pajak; b. besarnya Nilai Klaim Pajak; c. perintah untuk membayar; dan d. saat pelunasan Nilai Klaim Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_eb8d178b1e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_54 ;
    kbr:hasRuleId "R-PMK-2023-61-eb8d178b1e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/54"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat atau Jurusita Pajak yang menerima hasil penjualan secara lelang atau penggunaan, penjualan, dan/atau pemindahbukuan Barang sitaan yang penjualannya dikecualikan dari penjualan secara lelang sebagaimana dimaksud dalam Pasal 50 ayat ( 1), harus menyetorkan ke kas negara untuk melunasi Utang Pajak dan Biaya Penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_ec00f2f3f3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_6_1__7 ;
    kbr:hasRuleId "R-PMK-2023-61-ec00f2f3f3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/6/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pejabat menerbitkan Surat Teguran setelah lewat waktu 7 (tujuh) Hari sejak saat jatuh tempo pembayaran Utang Pajak, dalam hal Wajib Pajak tidak melunasi Utang Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_ec4e58d786 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_9_2_b__d ;
    kbr:hasRuleId "R-PMK-2023-61-ec4e58d786"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/9/2/b..d"^^xsd:string ;
    kbr:hasSourceQuote "1. sekutu komplementer/ sekutu aktif/ sekutu pengurus bertanggung jawab secara pribadi dan/atau secara renteng atas seluruh Utang Pajak dan Biaya Penagihan Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_eca6eff143 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_37 ;
    kbr:hasRuleId "R-PMK-2023-61-eca6eff143"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal setelah saldo harta kekayaan Penanggung Pajak yang tersimpan pada Lembaga Jasa Keuangan sektor perbankan, Lembaga Jasa Keuangan sektor perasuransian, Lembaga Jasa Keuangan Lainnya, dan/atau Entitas Lain diketahui dan Penanggung Pajak tidak melunasi Utang Pajak dan Biaya Penagihan Pajak, Jurusita Pajak melaksanakan Penyitaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_ed15b3fc6b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2023-61-ed15b3fc6b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Surat Teguran, Surat Peringatan, atau surat lain yang sejenis adalah surat yang diterbitkan oleh Pejabat untuk menegur atau memperingatkan kepada Wajib Pajak untuk melunasi utang pajaknya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_ee06a5ab14 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_38_3__4 ;
    kbr:hasRuleId "R-PMK-2023-61-ee06a5ab14"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/38/3..4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Terhadap pelaksanaan pencabutan sita atas kondisi tertentu sebagaimana dimaksud pada ayat (2) huruf c, Pejabat melakukan Penyitaan terlebih dahulu atas Barang yang diserahkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_ef216286bb a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_87 ;
    kbr:hasRuleId "R-PMK-2023-61-ef216286bb"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/87"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jurusita Pajak melaksanakan Penagihan Seketika dan Sekaligus berdasarkan surat perintah Penagihan Seketika dan Sekaligus terhadap Penanggung Pajak atas Klaim Pajak, dalam hal: a. Penanggung Pajak atas Klaim Pajak akan meninggalkan Indonesia untuk selama-lamanya atau berniat untuk itu; b. Penanggung Pajak atas Klaim Pajak memindahtangankan Barang yang tercantum dalam Klaim Pajak untuk menghentikan atau mengecilkan kegiatan perusahaan atau pekerjaan yang dilakukan di Indonesia; c. terdapat tanda-tanda bahwa Badan yang identitasnya tercantum dalam Klaim Pajak akan dibubarkan, digabungkan, dimekarkan, dipindahtangankan, atau dilakukan perubahan bentuk lainnya; d. Badan yang identitasnya tercantum dalam Klaim Pajak akan dibubarkan oleh negara; e. terjadi Penyitaan atas Barang Penanggung Pajak atas Klaim Pajak oleh pihak ketiga; atau f. terdapat tanda-tanda kepailitan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_efa5d334d5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_83_4__8 ;
    kbr:hasRuleId "R-PMK-2023-61-efa5d334d5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/83/4..8"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Direktur Jenderal Pajak menerima Klaim Pajak sebagaimana dimaksud pada ayat (6), Direktur Jenderal Pajak menerbitkan surat persetujuan pemberian Bantuan Penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_efba4a53e9 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_32 ;
    kbr:hasRuleId "R-PMK-2023-61-efba4a53e9"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "Sejak saat diterimanya permintaan Pemblokiran sebagaimana dimaksud dalam Pasal 29, Lembaga Jasa Keuangan sektor perbankan, Lembaga Jasa Keuangan sektor perasuransian, Lembaga Jasa Keuangan Lainnya, dan/atau Entitas Lain tidak diizinkan melakukan pemindahbukuan dan/atau penarikan atas saldo dalam - jdih.kemenkeu.go.id -28- Rekening Keuangan Penanggung Pajak yang telah diblokir, kecuali terdapat permintaan dari Pejabat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f18f3605f5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_128 ;
    kbr:hasRuleId "R-PMK-2023-61-f18f3605f5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/128"^^xsd:string ;
    kbr:hasSourceQuote "(5) Pembatalan Dokumen Penagihan Pajak sebagaimana dimaksud pada ayat (1) dilakukan dalam hal seharusnya tidak diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f25c056c23 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_5 ;
    kbr:hasRuleId "R-PMK-2023-61-f25c056c23"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penjualan Barang sitaan sebagaimana dimaksud pada ayat (1) huruf e dilakukan dengan: a. pengumuman lelang dan lelang, untuk Barang sitaan yang dilakukan penjualan secara lelang; dan/atau b. penggunaan, penjualan, dan/atau pemindahbukuan Barang sitaan, untuk Barang sitaan yang dikecualikan dari penjualan secara lelang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f28749c606 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_1_p3 ;
    kbr:hasRuleId "R-PMK-2023-61-f28749c606"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Penggabungan adalah perbuatan hukum yang dilakukan oleh satu Badan atau lebih untuk menggabungkan diri dengan Badan lain yang telah ada yang mengakibatkan aktiva dan pasiva dari Badan yang menggabungkan diri beralih karena hukum kepada Badan yang menerima penggabungan dan selanjutnya status Badan yang menggabungkan diri berakhir karena hukum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f2a72258b0 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_49 ;
    kbr:hasRuleId "R-PMK-2023-61-f2a72258b0"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal Penanggung Pajak menolak untuk menandatangani berita acara atau akta persetujuan pengalihan hak sebagaimana dimaksud pada ayat (3), Penanggung Pajak tidak diketahui tempat tinggal, tempat usaha, atau tempat kedudukannya, atau Penanggung Pajak patut diduga melakukan tindak pidana di bidang perpajakan, Penyitaan tetap dapat dilaksanakan dan Jurusita Pajak membuat berita acara pelaksanaan sita."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f39f69f467 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_63 ;
    kbr:hasRuleId "R-PMK-2023-61-f39f69f467"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/63"^^xsd:string ;
    kbr:hasSourceQuote "(2) Atas permintaan pencabutan Pencegahan, Menteri menetapkan keputusan Menteri mengena1 pencabutan Pencegahan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f43ddeda1c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_34 ;
    kbr:hasRuleId "R-PMK-2023-61-f43ddeda1c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "a. cetakan bukti pembuatan tagihan penerimaan negara bukan Pajak atau yang dipersamakan untuk pembayaran Biaya Penagihan Pajak; b. cetakan kode billing untuk pembayaran Utang Pajak; dan c. surat permintaan pemindahbukuan kepada Lembaga Jasa Keuangan sektor perbankan, Lembaga Jasa Keuangan sektor perasuransian, Lembaga Jasa Keuangan Lainnya, dan/atau Entitas Lain sebagai pelunasan Utang Pajak dan Biaya Penagihan Pajak dengan menggunakan harta kekayaan yang telah diblokir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f48f75f498 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_148_2__2 ;
    kbr:hasRuleId "R-PMK-2023-61-f48f75f498"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/148/2..2"^^xsd:string ;
    kbr:hasSourceQuote "(2) Kewenangan Direktur Jenderal Pajak untuk: a. menampung hasil permintaan Bantuan Penagihan Pajak sebagaimana dimaksud dalam Pasal 81 ayat (1); b. menampung dan mengirimkan hasil penagihan Pajak atas Nilai Klaim Pajak sebagaimana dimaksud dalam dan Pasal 119 ayat (1); dan c. mengelola Rekening Pemerintah Lainnya, dapat didelegasikan kepada pejabat setingkat Eselon II yang mempunyai tugas merumuskan serta melaksanakan kebijakan di bidang perpajakan internasional, atau pejabat setingkat Eselon II yang mempunyai tugas merumuskan serta melaksanakan kebijakan dan standardisasi teknis di bidang penagihan perpajakan, dan/atau pejabat setingkat Eselon II yang menyelenggarakan fungsi pengelolaan keuangan pada Direktorat Jenderal Pajak. (3) Kewenangan Direktur Jenderal Pajak untuk memberikan rekomendasi dan/ atau permohonan: a. pembatasan atau pemblokiran layanan publik tertentu sebagaimana dimaksud dalam Pasal 146 ayat (1) huruf a; dan b. pembukaan pembatasan atau pemblokiran layanan publik tertentu sebagaimana dimaksud dalam Pasal 146 ayat (3), dapat didelegasikan kepada pejabat setingkat Eselon II yang mempunyai tugas merumuskan serta melaksanakan kebijakan dan standardisasi teknis di bidang penagihan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f4b0655399 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_140 ;
    kbr:hasRuleId "R-PMK-2023-61-f4b0655399"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/140"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pengakuan Utang Pajak secara langsung sebagaimana dimaksud dalam Pasal 139 ayat (3) huruf b, dalam hal Wajib Pajak: a. menyatakan masih mempunyai Utang Pajak; b. mengajukan permohonan angsuran atau penundaan pembayaran Utang Pajak sebagaimana dimaksud dalam Pasal 4 ayat (3); dan/atau c. melakukan pembayaran sebagian Utang Pajak. (2) Pengakuan Utang Pajak secara tidak langsung sebagaimana dimaksud dalam Pasal 139 ayat (3) huruf b, dalam hal Wajib Pajak: a. mengajukan permohonan pembetulan atas surat ketetapan pajak atau surat tagihan pajak; b. mengajukan keberatan, banding, atau peninjauan kembali; c. mengajukan permohonan pengurangan a tau penghapusan sanksi administrasi; d. mengajukan permohonan pengurangan atau pembatalan surat ketetapan pajak atau surat tagihan pajak yang tidak benar; dan/atau e. mengajukan gugatan kepada pengadilan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f5b4e22a76 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_117 ;
    kbr:hasRuleId "R-PMK-2023-61-f5b4e22a76"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/117"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Nilai Klaim Pajak sebagaimana dimaksud pada ayat (1) tidak dapat tertagih, Biaya Penagihan Pajak ditanggung oleh negara Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f704c82006 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_130 ;
    kbr:hasRuleId "R-PMK-2023-61-f704c82006"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/130"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dokumen Penagihan Pajak pembetulan atau pengganti sebagaimana dimaksud pada ayat (3) mempunyai kekuatan eksekutorial dan/atau kedudukan hukum yang sama dengan Dokumen Penagihan Pajak yang dibetulkan atau diganti."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f72f568d0c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_44_1__3 ;
    kbr:hasRuleId "R-PMK-2023-61-f72f568d0c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/44/1..3"^^xsd:string ;
    kbr:hasSourceQuote "c. Penanggung Pajak dapat meyakinkan Pejabat dengan membuktikan bahwa dalam kedudukannya tidak dapat dibebani Utang Pajak dan Biaya Penagihan Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_f775df6e78 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_22 ;
    kbr:hasRuleId "R-PMK-2023-61-f775df6e78"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Penyitaan tambahan dapat dilaksariakan untuk: a. nilai Barang sitaan yang tidak cukup untuk melunasi Utang Pajak dan Biaya Penagihan Pajak; atau b. hasil lelang, penggunaan, penjualan, dan/atau pemindahbukuan Barang sitaan yang tidak cukup untuk melunasi Utang Pajak dan Biaya Penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

