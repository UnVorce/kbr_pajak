    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_a044bc4109 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_36 ;
    kbr:hasRuleId "R-UU-1995-10-a044bc4109"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "Bea masuk, denda administrasi, dan bunga yang terutang kepada negara menurut Undang-Undang ini, dibayar di kas negara atau di tempat pembayaran lain yang ditunjuk oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_a0cfda2212 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_30 ;
    kbr:hasRuleId "R-UU-1995-10-a0cfda2212"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan mengenai nilai tukar mata uang yang digunakan untuk penghitungan dan pembayaran bea masuk diatur lebih lanjut dengan peraturan menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_a272f6cfe8 a kbr:Prosedur ;
