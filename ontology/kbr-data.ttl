    kbr:hasSourceLocator "PMK-2023-143#BT/37/1..9"^^xsd:string ;
    kbr:hasSourceQuote "(3) Penggunaan Pajak Rokok untuk mendanai penegakan hukum sebagaimana dimaksud pada ayat (1) oleh pemerintah daerah provinsi dan kabupaten/kota dilakukan dengan berpedoman pada petunjuk teknis yang ditetapkan oleh Direktur Jenderal Bea dan Cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

