@prefix kbr: <http://www.semanticweb.org/ontology/kbr_pajak#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0117957031 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_91 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0117957031"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "(1) Setiap pejabat dilarang memberitahukan kepada pihak lain segala sesuatu yang diketahui atau diberitahukan kepadanya oleh Wajib Pajak dalam rangka jabatan atau pekerjaannya untuk menjalankan ketentuan peraturan perundang-undangan di bidang perpajakan Daerah. (2) Larangan sebagaimana dimaksud pada ayat (1) berlaku juga terhadap tenaga ahli yang ditunjuk oleh Wali Kota untuk membantu dalam pelaksanaan ketentuan peraturan perundang-undangan di bidang perpajakan Daerah. (3) Yang dikecualikan dari ketentuan sebagaimana dimaksud pada ayat (1) dan ayat (2) adalah: a. Pejabat dan/atau tenaga ahli yang bertindak sebagai saksi atau ahli dalam sidang pengadilan; dan b. Pejabat dan/atau tenaga ahli yang ditetapkan oleh Wali Kota untuk memberikan keterangan kepada pejabat lembaga negara atau instansi Pemerintah yang berwenang melakukan pemeriksaan dalam bidang Keuangan Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_013c3c8767 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_63 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-013c3c8767"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/63"^^xsd:string ;
    kbr:hasSourceQuote "(1) Retribusi Jasa Umum atas pelayanan kesehatan sebagaimana dimaksud dalam Pasal 62 ayat (1) huruf a meliputi pelayanan kesehatan pada: a. rumah sakit umum daerah; b. puskesmas; c. puskesmas keliling; d. puskesmas pembantu; e. laboratorium kesehatan; dan f. tempat pelayanan kesehatan lainnya yang sejenis yang dimiliki dan/atau dikelola oleh Pemerintah Daerah. (2) Pelayanan kesehatan sebagaimana dimaksud pada ayat (1), dikecualikan untuk pelayanan administrasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0155f7669c a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_13 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0155f7669c"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "Tarif BPHTB ditetapkan sebesar 5% (lima persen)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_APPROVED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0282215f32 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_102 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0282215f32"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/102"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang dengan sengaja tidak memenuhi kewajiban perpajakan, tidak memenuhi dokumen surat pemberitahuan pajak daerah secara benar dan lengkap serta tidak disampaikan kepada Pemerintah Daerah sehingga merugikan Keuangan Daerah, diancam dengan pidana sesuai dengan ketentuan peraturan perundang- undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_034988e67f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_60 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-034988e67f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "Hasil penerimaan PBJT atas Tenaga Listrik sebagaimana dimaksud dalam Pasal 3 ayat (2) huruf b angka 2, dialokasikan paling sedikit 10% (sepuluh persen) untuk penyediaan penerangan jalan umum."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0384cee186 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_68 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0384cee186"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/68"^^xsd:string ;
    kbr:hasSourceQuote "Prinsip dan sasaran dalam penetapan tarif Retribusi Jasa Umum yang diberikan oleh BLUD ditetapkan sesuai dengan ketentuan peraturan perundang-undangan mengenai BLUD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_03ff3f197d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_14 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-03ff3f197d"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "(1) Besaran pokok BPHTB yang terutang dihitung dengan cara mengalikan dasar pengenaan BPHTB sebagaimana dimaksud dalam Pasal 12 ayat (1) setelah dikurangi nilai perolehan objek pajak tidak kena pajak sebagaimana dimaksud dalam Pasal 12 ayat (4) atau ayat (5), dengan tarif BPHTB sebagaimana dimaksud dalam Pasal 13."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0551112fa1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_91 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0551112fa1"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/91"^^xsd:string ;
    kbr:hasSourceQuote "(5) Untuk kepentingan pemeriksaan di pengadilan dalam perkara pidana atau perdata, atas permintaan hakim sesuai dengan hukum acara pidana dan hukum acara perdata, Wali Kota dapat memberikan izin tertulis kepada pejabat sebagaimana dimaksud pada ayat (1), dan tenaga ahli sebagaimana dimaksud pada ayat (2), untuk 45 memberikan dan memperlihatkan bukti tertulis dan keterangan Wajib Pajak yang ada padanya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_05cb511e0b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_19 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-05cb511e0b"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penjualan dan/atau penyerahan Makanan dan/atau Minuman sebagaimana dimaksud dalam Pasal 18 huruf a meliputi Makanan dan/atau Minuman yang disediakan oleh: a. Restoran yang paling sedikit menyediakan layanan penyajian Makanan dan/atau Minuman berupa meja, kursi, dan/atau peralatan makan dan minum; dan b. penyedia jasa boga atau katering yang melakukan: 1. proses penyediaan bahan baku dan bahan setengah jadi, pembuatan, penyimpanan, serta penyajian berdasarkan pesanan; 2. penyajian di lokasi yang diinginkan oleh pemesan dan berbeda dengan lokasi dimana proses pembuatan dan penyimpanan dilakukan; dan 3. penyajian dilakukan dengan atau tanpa peralatan dan petugasnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_05e060eff2 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_92 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-05e060eff2"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/92"^^xsd:string ;
    kbr:hasSourceQuote "(1) Instansi yang melaksanakan pemungutan Pajak dan Retribusi dapat diberi insentif atas dasar pencapaian kinerja tertentu. (2) Pemberian insentif sebagaimana dimaksud pada ayat (1) ditetapkan melalui APBD. (3) Tata cara pemberian dan pemanfaatan insentif sebagaimana dimaksud pada ayat (1) diatur dengan Peraturan Wali Kota berdasarkan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_06a06bafc8 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_23 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-06a06bafc8"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/23"^^xsd:string ;
    kbr:hasSourceQuote "(2) Yang dikecualikan dari Jasa Kesenian dan Hiburan sebagaimana dimaksud pada ayat (1) yakni Jasa Kesenian dan Hiburan yang semata-mata untuk: a. promosi budaya tradisional dengan tidak dipungut bayaran; b. kegiatan layanan masyarakat dengan tidak dipungut bayaran; dan/atau c. panti pijat dan pijat refleksi yang pengelola/pemilik dan seluruh terapisnya merupakan Penyandang Disabilitas."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:terdampakPutusanMK kbr:MK_2024_19_PUU_XXII ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_06af66a7f5 a kbr:Definisi ;
