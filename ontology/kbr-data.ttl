    kbr:hasRuleId "R-UU-1985-12-3672124ce8"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/25"^^xsd:string ;
    kbr:hasSourceQuote "(3) Ancaman pidana sebagaimana dimaksud dalam ayat (1) dilipatkan dua apabila seseorang melakukan lagi tindak pidana di bidang perpajakan sebelum lewat 1 (satu) tahun, terhitung sejak selesainya menjalani sebagian atau seluruh pidana penjara yang dijatuhkan atau sejak dibayarnya denda."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

