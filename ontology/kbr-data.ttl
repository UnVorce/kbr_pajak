    kbr:hasRuleId "R-PMK-2023-80-818ab995b3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-80#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "21. Surat Pemberitahuan Pajak Terutang adalah surat yang digunakan oleh Direktorat Jenderal Pajak untuk memberitahukan besarnya Pajak Bumi dan Bangunan terutang kepada Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

