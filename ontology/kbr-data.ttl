kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_db3ccaa94e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_DKI_JAKARTA_2024_1 ;
