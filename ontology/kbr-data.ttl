    kbr:hasSourceLocator "PMK-2023-61#BT/128"^^xsd:string ;
    kbr:hasSourceQuote "(4) Penggantian Dokumen Penagihan Pajak sebagaimana dimaksud pada ayat (1) dilakukan dalam hal hilang, rusak, atau karena alasan lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

