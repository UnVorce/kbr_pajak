    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_145 ;
    kbr:hasRuleId "R-PMK-2024-81-e3ca008e88"^^xsd:string ;
