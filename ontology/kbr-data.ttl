    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_143_BT_2 ;
    kbr:hasRuleId "R-PMK-2023-143-f1d60c8c9b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "(4) Besaran pokok Pajak Rokok yang terutang dihitung dengan cara mengalikan dasar pengenaan Pajak Rokok sebagaimana dimaksud pada ayat (1) dengan tarif Pajak Rokok sebagaimana dimaksud pada ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

