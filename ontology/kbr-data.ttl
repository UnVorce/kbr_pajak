    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2024-136-888c9886f1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "21. Badan Akuntansi yang Berwenang (Authorised Accounting Body) adalah badan yang memiliki kewenangan untuk menetapkan, membentuk, atau menerima standar akuntansi untuk tujuan penyampaian laporan keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

