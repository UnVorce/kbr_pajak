    kbr:hasSourceLocator "PMK-2026-6#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Pemotong Pajak wajib menghitung, memotong, menyetorkan, dan melaporkan Pajak Penghasilan Pasal 21 sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

