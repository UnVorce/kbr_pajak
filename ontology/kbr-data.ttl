    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(1) Objek Pajak Rokok merupakan konsumsi rokok yang meliputi sigaret, cerutu, rokok daun, dan bentuk rokok lainnya yang dikenai cukai rokok. (2) Dikecualikan dari objek Pajak Rokok sebagaimana dimaksud pada ayat (1) yaitu rokok yang tidak dikenai cukai rokok berdasarkan ketentuan peraturan perundang-undangan di bidang cukai."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

