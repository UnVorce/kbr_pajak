    kbr:hasSourceQuote "Saat terutang Pajak Rokok ditetapkan pada saat terjadinya pemungutan cukai rokok terhadap pengusaha pabrik rokok/produsen dan importir rokok yang memiliki izin berupa nomor pokok pengusaha barang kena cukai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

