    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_e5ebfb1293 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_90 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-e5ebfb1293"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/90"^^xsd:string ;
    kbr:hasSourceQuote "(1) Wali Kota atau Pejabat yang ditunjuk dapat memberikan keringanan, pengurangan, pembebasan, dan penundaan pembayaran atas pokok dan/atau sanksi Pajak dan/atau Retribusi dengan memperhatikan kondisi Wajib Pajak atau Wajib Retribusi dan/atau objek Pajak atau objek Retribusi (2) Kondisi Wajib Pajak atau Wajib Retribusi sebagaimana dimaksud pada ayat (1) paling sedikit berupa kemampuan 44 membayar Wajib Pajak atau Wajib Retribusi atau tingkat likuiditas Wajib Pajak atau Wajib Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_e8cfa51856 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_31 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-e8cfa51856"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal Reklame diselenggarakan sendiri, nilai sewa Reklame sebagaimana dimaksud pada ayat (1) dihitung dengan memperhatikan factor: a. jenis; b. bahan yang digunakan; c. lokasi penempatan; d. waktu penayangan; e. jangka waktu penyelenggaraan; f. jumlah; dan g. ukuran media Reklame."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_ec0392b8a3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_62 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-ec0392b8a3"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/62"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal terdapat penyesuaian detail rincian objek atas pelayanan yang diberikan oleh BLUD sebagaimana dimaksud pada ayat (3), penyesuaian detail rincian objek diatur dalam Peraturan Wali Kota sesuai ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

