kbr:Aturan_R_PP_2010_94_14c343c0e2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_9 ;
    kbr:hasRuleId "R-PP-2010-94-14c343c0e2"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Keuntungan atau kerugian selisih kurs mata uang asing sebagaimana dimaksud pada ayat (1) yang tidak berkaitan langsung dengan usaha Wajib Pajak yang: a. dikenakan Pajak Penghasilan yang bersifat final; atau b. tidak termasuk objek pajak, diakui sebagai penghasilan atau biaya sepanjang biaya tersebut dipergunakan untuk mendapatkan, menagih, dan memelihara penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_16b1f05f78 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_20 ;
    kbr:hasRuleId "R-PP-2010-94-16b1f05f78"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Penghasilan yang dipotong atau dipungut berdasarkan tarif pemotongan atau pemungutan sebagaimana dimaksud dalam Pasal 21 ayat (5a), Pasal 22 ayat (3), dan Pasal 23 ayat (1a) Undang-Undang Pajak Penghasilan, dapat dikreditkan terhadap Pajak Penghasilan yang terutang untuk tahun pajak yang bersangkutan setelah Wajib Pajak tersebut memiliki Nomor Pokok Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_18d7000cd6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_3 ;
    kbr:hasRuleId "R-PP-2010-94-18d7000cd6"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terjadi pengalihan harta perusahaan kepada pegawainya, maka keuntungan berupa selisih antara harga pasar harta tersebut dengan nilai sisa buku merupakan penghasilan bagi perusahaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_1a104c8428 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_9 ;
    kbr:hasRuleId "R-PP-2010-94-1a104c8428"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Keuntungan atau kerugian selisih kurs mata uang asing sebagaimana dimaksud pada ayat (1) yang berkaitan langsung dengan usaha Wajib Pajak yang: a. dikenakan Pajak Penghasilan yang bersifat final; atau b. tidak termasuk objek pajak, tidak diakui sebagai penghasilan atau biaya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
