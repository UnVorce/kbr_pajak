    kbr:hasSourceLocator "UU-2002-14#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "usul pemberhentian dengan hormat sebagaimana dimaksud dalam Pasal 13 ayat (1) huruf d dan usul pemberhentian tidak dengan hormat sebagaimana dimaksud dalam Pasal 14 huruf b, huruf c, huruf d, dan huruf e diajukan setelah yang bersangkutan diberi kesempatan secukupnya untuk membela diri di hadapan Majelis Kehormatan Hakim."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
