    kbr:hasSourceQuote "(5) Penghitungan nilai perolehan Air Permukaan dilakukan oleh Perangkat Daerah yang melaksanakan fungsi penunjang pendapatan daerah dengan memperhatikan pertimbangan teknis dari Perangkat Daerah yang melaksanakan sub urusan sumber daya air dan Perangkat Daerah terkait."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
