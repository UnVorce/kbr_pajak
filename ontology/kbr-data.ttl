    kbr:hasSourceLocator "PMK-2024-81#BT/283"^^xsd:string ;
    kbr:hasSourceQuote "Saat terutangnya Pajak Pertambahan Nilai atas Ekspor Jasa Kena Pajak yaitu pada saat Ekspor Jasa Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e52cfa04f6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
