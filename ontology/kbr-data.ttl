    kbr:hasRuleId "R-PMK-2024-81-7fb571a5ab"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "(2) Akses pembuatan Faktur Pajak sebagaimana dimaksud pada ayat ( 1) dapat digunakan oleh Pengusaha sejak tanggal dimulainya kewajiban sebagai Pengusaha Kena Pajak sebagaimana tercantum dalam keputusan pengukuhan sebagai Pengusaha Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
