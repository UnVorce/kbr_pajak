    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/39"^^xsd:string ;
    kbr:hasSourceQuote "(3) Wilayah pemungutan Pajak Rokok merupakan wilayah kepabeanan Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_a0d7d56a03 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_15 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-a0d7d56a03"^^xsd:string ;
