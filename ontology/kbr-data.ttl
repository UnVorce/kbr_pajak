    kbr:hasRuleId "R-PMK-2025-15-f60b33cb46"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/23/3..10"^^xsd:string ;
    kbr:hasSourceQuote "c. Pemeriksaan Bukti Permulaan atau penyidikan tindak pidana di bidang perpajakan dihentikan karena telah daluwarsa sebagaimana diatur dalam Pasal 40 Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_faea315965 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_6_1__5 ;
    kbr:hasRuleId "R-PMK-2025-15-faea315965"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/6/1..5"^^xsd:string ;
    kbr:hasSourceQuote "jangka waktu pengujian sebagaimana dimaksud pada ayat (1) huruf a yang terkait dengan: a. Wajib Pajak dalam satu grup; dan/atau b. Wajib Pajak yang terindikasi melakukan transaksi transfer pricing dan/atau transaksi khusus lain yang terindikasi adanya rekayasa transaksi keuangan, dapat diperpanjang untuk jangka waktu paling lama 4 (empat) bulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_fb18babbb5 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_19_3__7 ;
    kbr:hasRuleId "R-PMK-2025-15-fb18babbb5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/19/3..7"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal pada saat melakukan Pembahasan Akhir Hasil Pemeriksaan, Wajib Pajak, Wakil, atau Kuasa dari Wajib Pajak yang diperiksa menyatakan untuk mengajukan permohonan pembahasan dengan Tim Quality Assurance Pemeriksaan namun tidak menyampaikan surat permohonan pembahasan dengan Tim Quality Assurance Pemeriksaan sesuai jangka waktu sebagaimana dimaksud pada ayat (3), Pemeriksa Pajak melalui pejabat pada Unit Pelaksana Pemeriksaan menyampaikan surat panggilan kepada Wajib Pajak untuk melakukan penandatanganan berita acara Pembahasan Akhir Hasil Pemeriksaan yang dilampiri dengan ikhtisar hasil pembahasan akhir."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_fc08b750e3 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_12_6__10 ;
    kbr:hasRuleId "R-PMK-2025-15-fc08b750e3"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/12/6..10"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal buku, catatan, dan/atau dokumen, termasuk Data Elektronik perlu dilindungi kerahasiaannya, Wajib Pajak dapat mengajukan permintaan agar pelaksanaan Pemeriksaan dilakukan di tempat Wajib Pajak dengan menyediakan ruangan khusus."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_15_fd1f0552dd a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_30 ;
    kbr:hasRuleId "R-PMK-2025-15-fd1f0552dd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "a. Pemeriksaan terhadap jenis pajak selain Pajak Bumi dan Bangunan yang dimulai sebelum berlakunya Peraturan Menteri ini dan belum selesai, untuk proses penyelesaian Pemeriksaan dilakukan berdasarkan ketentuan sebagaimana diatur dalam Peraturan Menteri Keuangan Nomor 17/PMK.03/2013 tentang Tata Cara Pemeriksaan sebagaimana telah beberapa kali diubah terakhir dengan Peraturan Menteri Keuangan Nomor 18/PMK.03/2021 tentang Pelaksanaan Undang-Undang Nomor 11 Tahun 2020 tentang Cipta Kerja di Bidang Pajak Penghasilan, Pajak - 50 - Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah, serta Ketentuan Umum dan Tata Cara Perpajakan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2025_37_04878023d5 a kbr:Sanksi ;
