kbr:Aturan_R_PMK_2024_81_19f8336792 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_435 ;
    kbr:hasRuleId "R-PMK-2024-81-19f8336792"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/435"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya tambahan pengurangan Penghasilan Bruto yang dapat dibebankan di setiap Tahun Pajak paling tinggi sebesar 40% (empat puluh persen) dari penghasilan kena pajak sebelum dikurangi dengan tambahan pengurangan Penghasilan Bruto sebagaimana dimaksud dalam Pasal 432 ayat (2) huruf b."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_1a6b9363c1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_95 ;
    kbr:hasRuleId "R-PMK-2024-81-1a6b9363c1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/95"^^xsd:string ;
    kbr:hasSourceQuote "Kekurangan pembayaran pajak yang terutang berdasarkan Surat Pemberitahuan Tahunan untuk Pajak Penghasilan dan Pajak Karbon, wajib dibayar secara lunas sebelum Surat Pemberitahuan Tahunan disampaikan tetapi tidak melebihi batas waktu penyampaian Surat Pemberitahuan Tahunan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

