    kbr:hasSourceLocator "PMK-2023-66#BT/2/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Biaya penggantian atau imbalan yang diberikan dalam bentuk natura dan/atau kenikmatan berkenaan dengan pekerjaan atau jasa dapat dikurangkan dari penghasilan bruto untuk menentukan penghasilan kena pajak oleh pemberi kerja atau pemberi imbalan atau penggantian dalam bentuk natura dan/atau kenikmatan sepanjang merupakan biaya untuk mendapatkan, menagih, dan memelihara penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

