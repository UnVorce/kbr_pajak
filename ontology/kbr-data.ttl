    kbr:diaturDalam kbr:Reg_PMK_2023_72 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_72_BT_8 ;
    kbr:hasRuleId "R-PMK-2023-72-3ba7ce1431"^^xsd:string ;
