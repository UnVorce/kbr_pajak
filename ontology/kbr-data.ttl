kbr:Aturan_R_PP_2022_50_b6ad48c9ac a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_62 ;
    kbr:hasRuleId "R-PP-2022-50-b6ad48c9ac"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/62"^^xsd:string ;
    kbr:hasSourceQuote "Keputusan pencegahan sebagaimana dimaksud pada ayat (1) mencakup keputusan pencegahan, perpanjangan masa pencegahan, dan pencabutan pencegahan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

