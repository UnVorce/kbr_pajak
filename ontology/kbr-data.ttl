    kbr:merujukSEMA kbr:SEMA_2024_2_TUN_4 ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_33a38f214c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_3_1__3b ;
    kbr:hasRuleId "R-UU-1983-6-33a38f214c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/3/1..3b"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak sebagaimana dimaksud pada ayat (1) dan ayat (1a) mengambil sendiri Surat Pemberitahuan di tempat yang ditetapkan oleh Direktur Jenderal Pajak atau mengambil dengan cara lain yang tata cara pelaksanaannya diatur dengan atau berdasarkan Peraturan Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_33f5981a36 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_8_1__2a ;
    kbr:hasRuleId "R-UU-1983-6-33f5981a36"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/8/1..2a"^^xsd:string ;
    kbr:hasSourceQuote "(1a) Dalam hal pembetulan Surat Pemberitahuan sebagaimana dimaksud pada ayat (1) menyatakan rugi atau lebih bayar, pembetulan Surat Pemberitahuan harus disampaikan paling lama 2 (dua) tahun sebelum daluwarsa penetapan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_342d405aaf a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_17B_1__3 ;
    kbr:hasRuleId "R-UU-1983-6-342d405aaf"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/17B/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Direktur Jenderal Pajak setelah melakukan pemeriksaan atas permohonan pengembalian kelebihan pembayaran pajak, selain permohonan pengembalian kelebihan pembayaran pajak dari Wajib Pajak sebagaimana dimaksud dalam Pasal L7C dan Wajib Pajak sebagaimana dimaksud dalam Pasal l7D, harus menerbitkan surat ketetapan pajak paling lama 12 (dua belas) bulan sejak surat permohonan diterima secara lengkap. (1a) Ketentuan sebagaimana dimaksud pada ayat (1) tidak berlaku terhadap Wajib Pajak yang sedang dilakukan pemeriksaan bukti permulaan tindak pidana di bidang perpajakan yzrng ketentuannya diatur dengan atau berdasarkan Peraturan Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_34a661d7dd a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_28_11__2 ;
    kbr:hasRuleId "R-UU-1983-6-34a661d7dd"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/28/11..2"^^xsd:string ;
    kbr:hasSourceQuote "(1)) Buku, catatan, dan dokumen yang menjadi dasar pembukuan atau pencatatan dan dokumen lain termasuk hasil pengolahan data dari pembukuan yang dikelola secara elektronik atau secara program aplikasi on-line wajib disimpan selama 10 (sepuluh) tahun di Indonesia, yaitu di tempat kegiatan atau tempat tinggal Wajib Pajak orang pribadi, atau di tempat kedudukan Wajib Pajak badan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_34b599b509 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_16 ;
    kbr:hasRuleId "R-UU-1983-6-34b599b509"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Atas permohonan Wajib Pajak atau karena jabatannya, Direktur Jenderal Pajak dapat membetulkan surat ketetapan pajak, Surat Tagihan Pajak, Surat Keputusan Pembetulan, Surat Keputusan Keberatan, Surat Keputusan Pengurangan Sanksi Administrasi, Surat Keputusan Penghapusan Sanksi Administrasi, Surat Keputusan Pengurangan Ketetapan Pajak, Surat Keputusan Pembatalan Ketetapan Pajak, Surat Keputusan Pengembalian Pendahuluan Kelebihan Pajak, atau Surat Keputusan Pemberian Imbalan Bunga . . . - 26 - Bunga, yang dalam penerbitannya terdapat kesalahan tulis, kesalahan hitung, dan/atau kekeliruan penerapan ketentuan tertentu dalam peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_35a004083f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_6 ;
    kbr:hasRuleId "R-UU-1983-6-35a004083f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/6"^^xsd:string ;
    kbr:hasSourceQuote "Tanda bukti dan tanggal pengiriman surat untuk penyampaian Surat Pemberitahuan sebagaimana dimaksud pada ayat (2) dianggap sebagai tanda bukti dan tanggal penerimaan sepanjang Surat Pemberitahuan tersebut telah lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_36618d2463 a kbr:Kewajiban ;
