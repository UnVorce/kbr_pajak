    kbr:hasSourceLocator "PMK-2024-136#BT/18/3"^^xsd:string ;
    kbr:hasSourceQuote "c. jumlah pegawai di semua negara atau yurisdiksi Grup PMN yang menerapkan UTPR sebagaimana dimaksud pada ayat (2) huruf a merupakan seluruh jumlah pegawai dari semua Entitas Konstituen dari Grup PMN di negara atau yurisdiksi yang menerapkan Qualified UTPR yang berlaku untuk suatu Tahun Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
