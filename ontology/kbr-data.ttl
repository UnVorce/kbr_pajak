    kbr:hasSourceQuote "4. 5% (lima persen) bagi Wajib Pajak yang tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 9 ayat (3) huruf d angka 1, dalam hal Wajfb Pajak atas kehendak sendiri mengungkapkan penghasilan tersebut dan menyetorkan sendiri Pajak Penghasilan yang terutang."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

