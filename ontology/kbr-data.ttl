    kbr:hasSourceQuote "Dikecualikan dari objek Retribusi Jasa Umum sebagaimana dimaksud dalam Pasal 51 ayat (1), yaitu pelayanan jasa yang dilakukan oleh pemerintah pusat, badan usaha milik negara, badan usaha milik daerah, dan pihak swasta."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

