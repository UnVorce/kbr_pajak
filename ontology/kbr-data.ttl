    kbr:hasSourceQuote "Penghapusan Nomor Pokok Wajib Pajak sebagaimana dimaksud dalam Pasal 2 ayat ( 1) dilakukan dalam hal bentuk usaha tetap menghentikan kegiatan usahanya di"^^xsd:string ;
