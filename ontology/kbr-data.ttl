    kbr:hasSourceQuote "Pemberi kerja atau pemberi penggantian atau imbalan dalam bentuk natura dan/atau kenikmatan wajib melakukan pemotongan Pajak Penghasilan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2023_66_e28e6599f9 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_66 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_66_BT_18 ;
    kbr:hasRuleId "R-PMK-2023-66-e28e6599f9"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-66#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pemberi Kerja Berstatus Pusat selain pemberi kerja pemegang izm pertambangan tertentu yang telah mendapatkan keputusan persetujuan penetapan berlokasi usaha di daerah tertentu dapat mengajukan permohonan I / jdih.kemenkeu.go.id - 15 - perpanjangan penetapan berlokasi usaha di daerah tertentu sebagaimana dimaksud dalam Pasal 10 ayat (4) huruf b kepada Kepala Kantor Wilayah DJP Pemberi Kerja Berstatus Pusat."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

