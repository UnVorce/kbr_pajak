    kbr:hasRuleId "R-PP-2009-32-ef9b1428a9"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Atas penyerahan barang dari Gudang Berikat ke tempat lain dalam daerah pabean, pengusaha Gudang Berikat dan pengusaha di Gudang Berikat wajib membuat faktur pajak dan memungut Pajak Pertambahan Nilai sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_f5529a3be7 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_1 ;
    kbr:hasRuleId "R-PP-2009-32-f5529a3be7"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Tempat Penyelenggaraan Pameran Berikat adalah Tempat Penimbunan Berikat untuk menimbun barang impor dalam jangka waktu tertentu, dengan atau tanpa barang dari dalam Daerah Pabean untuk dipamerkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_f60eb52da8 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_46A ;
    kbr:hasRuleId "R-PP-2009-32-f60eb52da8"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/46A"^^xsd:string ;
    kbr:hasSourceQuote "Pemasukan barang asal luar daerah pabean ke Tempat Penimbunan Berikat belum diberlakukan ketentuan pembatasan di bidang impor kecuali ditentukan lain berdasarkan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_f6a6e7f993 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_46A ;
    kbr:hasRuleId "R-PP-2009-32-f6a6e7f993"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/46A"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Tempat Penimbunan Berikat wajib melakukan pencatatan atas pemasukan dan pengeluaran barang dengan menggunakan sistem informasi persediaan berbasis komputer."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_fb19e4bc2a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_42A_2__2 ;
    kbr:hasRuleId "R-PP-2009-32-fb19e4bc2a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/42A/2..2"^^xsd:string ;
    kbr:hasSourceQuote """Untuk mendapatkan izin pengusaha Pusat Logistik Berikat sebagaimana dimaksud pada ayat (1), pihak yang akan menjadi pengusaha Pusat Logistik Berikat harus memenuhi persyaratan sebagai berikut: a. memiliki bukti kepemilikan atau penguasaan suatu tempat, atau bangunan yang mempunyai batas-batas yang jelas berikut peta lokasi/tempat dan rencana tata letak/denah; b. memiliki Surat Izin Usaha Perdagangan dan izin lainnya yang diperlukan dari instansi teknis terkait; dan c. telah melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan telah menyampaikan Surat Pemberitahuan Tahunan Pajak Penghasilan tahun pajak terakhir bagi yang sudah wajib menyampaikan Surat Pemberitahuan T
      """^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_fd0335678b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_8 ;
    kbr:hasRuleId "R-PP-2009-32-fd0335678b"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Penetapan tempat sebagai Gudang Berikat dan pemberian izin penyelenggara Gudang Berikat untuk jangka waktu tertentu ditetapkan dengan Keputusan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_32_fe4601912d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_32 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_32_BT_8 ;
    kbr:hasRuleId "R-PP-2009-32-fe4601912d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-32#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Untuk mendapatkan penetapan tempat sebagai Gudang Berikat dan izin penyelenggara Gudang Berikat sebagaimana dimaksud pada ayat (1), pihak yang akan menjadi penyelenggara Gudang Berikat harus memenuhi persyaratan sebagai berikut: a. memiliki bukti kepemilikan atau penguasaan suatu kawasan, tempat, atau bangunan yang mempunyai batas-batas yang jelas, berikut peta lokasi/tempat dan rencana tata letak/denah yang akan dijadikan Gudang Berikat; b. memiliki Surat Izin Tempat Usaha, Dokumen Lingkungan Hidup, dan izin lainnya yang diperlukan dari instansi teknis terkait; dan c. telah melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak dan telah menyampaikan Surat Pemberitahuan Tahunan Pajak Penghasilan tahun pajak terakhir bagi yang sudah wajib menyampaikan Surat Pemberitahuan Tahunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PP_2009_68_0188197302 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2009_68 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_68_BT_7 ;
    kbr:hasRuleId "R-PP-2009-68-0188197302"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-68#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Pemotong Pajak wajib menghitung, memotong, menyetorkan, dan melaporkan Pajak Penghasilan Pasal 21 yang terutang atas Uang Pesangon, Uang Manfaat Pensiun, Tunjangan Hari Tua, atau Jaminan Hari Tua."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PP_2009_68_10ea7dffa9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_68 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_68_BT_3 ;
    kbr:hasRuleId "R-PP-2009-68-10ea7dffa9"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-68#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(3) Dalam hal pemberi kerja mengalihkan Uang Pesangon secara bertahap atau berkala kepada Pengelola Dana Pesangon Tenaga Kerja, Pegawai dianggap belum menerima hak atas Uang Pesangon."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PP_2009_68_1651a4ae19 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2009_68 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2009_68_BT_3 ;
    kbr:hasRuleId "R-PP-2009-68-1651a4ae19"^^xsd:string ;
    kbr:hasSourceLocator "PP-2009-68#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal terjadi pengalihan Uang Manfaat Pensiun kepada perusahaan asuransi jiwa dengan cara Dana Pensiun membeli anuitas seumur hidup, Pegawai sebagai peserta dianggap telah menerima hak atas Uang Manfaat Pensiun yang dibayarkan secara sekaligus."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PP_2009_68_196f5a8d35 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PP_2009_68 ;
