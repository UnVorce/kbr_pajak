    kbr:hasSourceLocator "PMK-2024-136#BT/2/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Entitas Konstituen membentuk Grup PMN baru dan pada tahun pertama dan kedua Grup PMN baru tersebut memiliki peredaran bruto tahunan sebagaimana dimaksud pada ayat (1) huruf a, Entitas Konstituen menerapkan GloBE pada Tahun Pajak ketiga."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

