    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak menggunakan hak untuk hadir sebagaimana dimaksud pada ayat (1), Wajib Pajak dapat memberikan surat tanggapan hasil penelitian keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2024_118_c28c211aad a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_118 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_118_BT_5 ;
