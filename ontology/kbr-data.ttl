    kbr:hasSourceLocator "PMK-2023-61#BT/138"^^xsd:string ;
    kbr:hasSourceQuote "(3) Penyampaian sebagaimana dimaksud pada ayat (1) dan ayat (2) dHakukan: a. secara langsung; b. melalui pos, perusahaan jasa ekspedisi, atau jasa kurir dengan bukti pengiriman surat; atau c. secara elektronik melalui alamat pos elektronik resmi Direktorat Jenderal Pajak."^^xsd:string ;
