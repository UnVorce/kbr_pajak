kbr:Aturan_R_PMK_2024_81_e699b96af2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_29_1_c_p1 ;
    kbr:hasRuleId "R-PMK-2024-81-e699b96af2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/29/1/c#p1"^^xsd:string ;
    kbr:hasSourceQuote "Selain itu, jumlah luas bangunan yang dibangun pada satu kesatuan kegiatan tersebut telah melebihi batasan 200m2 (dua ratus meter persegi). Oleh karena itu, atas kegiatan membangun sendiri tersebut dikenai Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e6f9a48c97 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_16_6__8 ;
    kbr:hasRuleId "R-PMK-2024-81-e6f9a48c97"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/16/6..8"^^xsd:string ;
    kbr:hasSourceQuote "(6) Orang pribadi yang: a. belum memenuhi persyaratan objektif sebagai Wajib Pajak; b. tidak memenuhi persyaratan subjektif sebagai subjek pajak dalam negeri; atau c. tidak termasuk subjek pajak sesuai dengan ketentuan peraturan perundang-undangan di bidang Pajak Penghasilan, dapat diberikan nomor identitas perpajakan dalam bentuk Nomor Pokok Wajib Pajak untuk kepentingan administrasi perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e7043d22f7 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_387 ;
    kbr:hasRuleId "R-PMK-2024-81-e7043d22f7"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/387"^^xsd:string ;
    kbr:hasSourceQuote "Faktur Pajak sebagaimana dimaksud dalam Pasal 386 ayat (1) wajib: a. diunggah oleh Pengusaha Kena Pajak dengan menggunakan modul dalam Portal Wajib Pajak 1t '-- jdih.kemenkeu.go.id - 260 - atau laman lain yang terintegrasi dengan sistem administrasi Direktorat Jenderal Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_e73f28c18e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_194 ;
    kbr:hasRuleId "R-PMK-2024-81-e73f28c18e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/194"^^xsd:string ;
    kbr:hasSourceQuote "( 1) Orang pribadi a tau Badan yang menerima atau memperoleh penghasilan dari pengalihan hak atas tanah dan/ atau bangunan sebagaimana dimaksud dalam Pasal 191 ayat (1) huruf a kepada pemerintah, dipungut Pajak Penghasilan oleh Instansi Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

