    kbr:hasSourceLocator "PMK-2023-96#BT/58/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(6) Ketentuan pembetulan terhadap pemberitahuan ekspor barang sebagaimana dimaksud Pasal 44 dan pemberitahuan konsolidasi barang ekspor sebagaimana dimaksud Pasal 49 ayat (2) dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan mengenai ketentuan kepabeanan di bidang ekspor."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

