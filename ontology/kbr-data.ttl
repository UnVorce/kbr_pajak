    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_92 ;
    kbr:hasRuleId "R-PMK-2023-61-d2f725b672"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/92"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pencabutan sita sebagaimana dimaksud pada ayat (1) dilaksanakan berdasarkan surat pencabutan sita yang diterbitkan oleh Pejabat dan disampaikan oleh Jurusita Pajak kepada Penanggung Pajak atas Klaim Pajak dan instansi yang terkait."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_d38510d363 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_53 ;
    kbr:hasRuleId "R-PMK-2023-61-d38510d363"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/53"^^xsd:string ;
    kbr:hasSourceQuote "(3) Permintaan pencabutan blokir dan pemindahbukuan harta kekayaan Penanggung Pajak sebagaimana dimaksud pada ayat (1) huruf a dilampiri dengan: a. cetakan bukti pembuatan tagihan penerimaan negara bukan Pajak atau yang dipersamakan untuk pembayaran Biaya Penagihan Pajak; dan b. cetakan kode billing untuk pembayaran Utang Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

