    kbr:hasSourceQuote "Besaran pokok Opsen PKB yang terutang dihitung dengan cara mengalikan dasar pengenaan Opsen PKB sebagaimana dimaksud pada ayat (1) dengan tarif Opsen PKB sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

