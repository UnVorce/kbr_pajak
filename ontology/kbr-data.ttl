kbr:Aturan_R_PMK_2023_172_90138ab9a1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_12 ;
    kbr:hasRuleId "R-PMK-2023-172-90138ab9a1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "(6) Rentang kewajaran sebagaimana dimaksud pada ayat (1) huruf b merupakan rentang indikator harga yang terbentuk dari dua atau lebih pembanding yang memiliki nilai indikator harga yang berbeda, berupa: a. nilai minimum sampai dengan nilai maksimum (full range), dalam hal terbentuk dari dua pembanding; a tau b. nilai kuartil satu sampai dengan nilai kuartil tiga (interquartile range), dalam hal terbentuk dari tiga atau lebih pembanding."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

