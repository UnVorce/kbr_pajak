    kbr:hasSourceLocator "PP-2010-79#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Operasi Perminyakan adalah kegiatan Eksplorasi, Eksploitasi, pengangkutan sampai dengan titik penyerahan, penutupan dan peninggalan sumur Qtlug and abandonmenQ serta pemulihan bekas penambangan (site restorolion) Minyak dan Gas Bumi, termasuk kegiatan pengolahan lapangan, pengangkutan, penyimpanan, dan penjualan hasil produksi sendiri sebagai kelanjutan dari Eksplorasi dan Eksploitasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2010_79_b91e46ea2e a kbr:Prosedur ;
