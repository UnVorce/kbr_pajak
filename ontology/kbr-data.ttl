kbr:Aturan_R_UU_1983_8_e08a4c03b0 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_8 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_8_BT_12 ;
