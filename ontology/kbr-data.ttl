    kbr:hasRuleId "R-UU-2022-1-1df02f08ad"^^xsd:string ;
    kbr:hasSourceLocator "UU-2022-1#BT/121"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal tidak terdapat kabupaten/kota pengolah sebagaimana dimaksud dalam Pasal 116, Pasal 117, dan Pasal 118, porsi kabupaten/kota pengolah dibagikan secara merata kepada kabupaten/kota lainnya dalam satu provinsi yang bersangkutan dan kabupaten/kota lainnya yang berbatasan langsung dengan kabupaten/ kota penghasil."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_2022_1_1f4c9fd3f7 a kbr:Definisi ;
