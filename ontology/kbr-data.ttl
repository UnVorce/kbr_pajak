    kbr:hasSourceQuote "Khusus untuk PBB-P2, pendataan sebagaimana dimaksud pada ayat (1) meliputi seluruh Bumi dan/atau Bangunan dalam wilayah Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_80659245c7 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
