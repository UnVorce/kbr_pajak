    kbr:hasSourceLocator "PMK-2024-78#BT/3/1..2"^^xsd:string ;
    kbr:hasSourceQuote "c. Dokumen diserahkan kepada pihak untuk siapa Dokumen tersebut dibuat, untuk: 1. surat keterangan, surat pernyataan, lainnya yang sejenis, beserta sebagaimana dimaksud dalam Pasal huruf a; 2. Dokumen lelang sebagaimana dimaksud dalam Pasal 3 ayat (2) huruf f; dan 3. Dokumen yang menyatakan jumlah uang sebagaimana dimaksud dalam Pasal 3 ayat"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

