    kbr:hasSourceLocator "UU-1995-10#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penetapan sebagaimana dimaksud pada ayat (1) dan/atau ayat (2) mengakibatkan kekurangan pembayaran bea masuk kecuali importir mengajukan keberatan sebagaimana dimaksud dalam Pasal 93 ayat (1), importir wajib melunasi bea masuk yang kurang dibayar sesuai dengan penetapan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
