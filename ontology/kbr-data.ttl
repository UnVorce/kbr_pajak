    kbr:hasSourceQuote "NJOP bumi sebagaimana dimaksud dalam Pasal11 untuk objek pajak PBB Sektor Perkebunan merupakan penjumlahan NJOP bumi untuk Areal Produktif Perkebunan, Areal Belum Produktif Perkebunan, Areal Tidak Produktif Perkebunan, Areal Pengaman Perkebunan, dan Areal Emplasemen Perkebunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

