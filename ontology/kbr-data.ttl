    kbr:hasSourceQuote "Berita acara pelaksanaan sita sebagaimana dimaksud pada ayat (5) tetap sah serta mempunyai kekuatan hukum yang mengikat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

