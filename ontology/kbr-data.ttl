    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_66 ;
    kbr:hasRuleId "R-UU-1995-10-e2656a2c3e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "d. merupakan barang yang dibatasi disediakan untuk diselesaikan oleh pemiliknya dalam jangka waktu enam puluh hari terhitung sejak disimpan di Tempat Penimbunan Pabean."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_e3eb84652f a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_46_1__4 ;
