kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_3c60f6b7f6 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
