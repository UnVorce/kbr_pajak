    kbr:hasSourceLocator "PMK-2024-136#BT/6/8..11"^^xsd:string ;
    kbr:hasSourceQuote "Pajak tambahan untuk suatu Entitas Konstituen sebagaimana dimaksud pada ayat (1), dihitung dengan cara mengalikan pajak tambahan dimaksud dengan hasil pembagian antara laba GloBE dari Entitas Konstituen tersebut dan laba GloBE agregat dari seluruh Entitas Konstituen."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

