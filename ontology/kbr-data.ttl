kbr:Aturan_R_UU_2002_14_85e8cefcd1 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_2002_14 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_2002_14_BT_48 ;
