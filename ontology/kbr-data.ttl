    kbr:hasSourceQuote "41. Opsen Pajak Kendaraan Bermotor yang selanjutnya disebut Opsen PKB adalah Opsen yang dikenakan oleh kabupaten/kota atas pokok PKB sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

