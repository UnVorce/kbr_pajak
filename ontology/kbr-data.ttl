kbr:Aturan_R_PMK_2010_16_20942d8217 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2010_16 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2010_16_BT_9 ;
    kbr:hasRuleId "R-PMK-2010-16-20942d8217"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-16#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal tanggal jatuh tempo penyetoran Pajak Penghasilan Pasal 21 sebagaimana dimaksud pada ayat (2) dan batas akhir pelaporan Pajak Penghasilan Pasal 21 sebagaimana dimaksud pada ayat (3) bertepatan dengan hari libur termasuk hari Sabtu atau hari libur nasional, penyetoran dan pelaporan Pajak Penghasilan Pasal 21 dapat dilakukan pada hari kerja berikutnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2010_16_2ceb6cfd61 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2010_16 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2010_16_BT_8 ;
    kbr:hasRuleId "R-PMK-2010-16-2ceb6cfd61"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-16#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "(2) Atas pengalihan Uang Manfaat Pensiun kepada perusahaan asuransi jiwa dengan cara Dana Pensiun membeli anuitas seumur hidup sebagaimana dimaksud pada ayat (1) terutang Pajak Penghasilan Pasal 21 yang bersifat final sebagaimana dimaksud dalam Pasal 2 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2010_16_3924cbe162 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2010_16 ;
