    kbr:hasRuleId "R-PMK-2024-136-594a907eec"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Anak usaha yang dimiliki secara minoritas sebagaimana dimaksud pada ayat (2) huruf b merupakan Entitas Konstituen yang dimiliki secara minoritas sebagaimana dimaksud pada ayat (1) yang Kepentingan Pengendalinya dimiliki oleh Entitas Induk yang dimiliki secara minoritas sebagaimana dimaksud pada ayat (3), secara langsung atau tidak langsung."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_597b3141b1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_1_p4 ;
