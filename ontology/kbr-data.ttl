    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/104"^^xsd:string ;
    kbr:hasSourceQuote "(1) Objek Retribusi Tempat Rekreasi, Pariwisata, dan Olahraga sebagaimana dimaksud dalam Pasal 76 ayat (2) huruf e berupa pemanfaatan pelayanan tempat rekreasi, pariwisata, dan olahraga yang disediakan, dimiliki dan/atau dikelola oleh Pemerintah Daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_5cbeb4b2f4 a kbr:Definisi ;
