    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai tata cara penghapusan piutang Pajak diatur dalam Peraturan Gubernur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

