    kbr:hasSourceQuote "Ketentuan pemberian insentif sebagaimana dalam Pasal 79, tidak berlaku dalam hal penghasilan Aparatur Sipil Negara di lingkungan Pemerintah Daerah Provinsi telah mempertimbangkan kelas jabatan untuk tugas dan fungsi pemungutan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

