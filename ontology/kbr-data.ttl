    kbr:hasSourceQuote "Wajib Retribusi atas jenis Retribusi sebagaimana pada ayat (1) merupakan orang pribadi atau Badan yang menggunakan atau menikmati pelayanan barang, jasa, dan/atau perizinan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

