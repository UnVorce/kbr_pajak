    kbr:hasSourceQuote "(1) Pelayanan penggunaan tenaga kerja asing sebagaimana dimaksud dalam Pasal 70 ayat (1) huruf a merupakan pelayanan pengesahan rencana penggunaan tenaga kerja asing perpanjangan sesuai wilayah kerja tenaga kerja asing sesuai ketentuan peraturan perundang-undangan mengenai penggunaan tenaga kerja asing."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
