    kbr:hasSourceLocator "UU-1995-10#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "barang sebagaimana dimaksud pada ayat (1) sepanjang belum dilelang, oleh pemiliknya dapat : a. diimpor untuk dipakai setelah Bea Masuk dan biaya lainnya yang terutang dilunasi; b. diekspor kembali setelah biaya yang terutang dilunasi; c. dibatalkan ekspornya setelah biaya yang terutang dilunasi; d. diekspor setelah biaya yang terutang dilunasi; atau e. dikeluarkan dengan tujuan Tempat Penimbunan Berikat setelah biaya yang terutang dilunasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

