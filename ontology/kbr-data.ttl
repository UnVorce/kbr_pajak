    kbr:hasSourceQuote "Hasil penerimaan PKB sebagaimana dimaksud dalam Pasal 3 ayat (1) huruf a, paling sedikit 10% (sepuluh persen) dialokasikan untuk pembangunan dan/atau pemeliharaan jalan serta peningkatan moda dan sarana transportasi umum."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_bf434a361e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
