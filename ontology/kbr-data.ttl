kbr:Aturan_R_PMK_2023_172_d7c9a08c77 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2023-172-d7c9a08c77"^^xsd:string ;
