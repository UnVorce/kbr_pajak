    kbr:hasSourceQuote "33. Tenaga Listrik adalah tenaga atau energi yang dihasilkan oleh suatu pembangkit tenaga listrik yang didistribusikan untuk bermacam peralatan listrik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

