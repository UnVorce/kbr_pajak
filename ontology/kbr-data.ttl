    kbr:hasSourceQuote "Aset Pajak Tangguhan dan Kewajiban Pajak Tangguhan sebagaimana dimaksud pada ayat (1) harus dihitung dengan menerapkan tarif yang lebih rendah antara Tarif Minimum dan tarif pajak domestik yang berlaku."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

