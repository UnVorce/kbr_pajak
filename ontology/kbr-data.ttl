    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_64 ;
    kbr:hasRuleId "R-UU-1995-11-16bcdd22f7"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai penghentian penyidikan sebagaimana dimaksud pada ayat (1) diatur dengan atau berdasarkan Peraturan Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

