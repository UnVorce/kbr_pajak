    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_6_5__11 ;
    kbr:hasRuleId "R-PMK-2023-96-fcfa23a76a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/6/5..11"^^xsd:string ;
    kbr:hasSourceQuote "(11) Surat pemberitahuan penolakan sebagaimana dimaksud pada ayat (7) diterbitkan dengan menggunakan contoh format sebagaimana dimaksud dalam Lampiran Huruf F yang merupakan bagian tidak terpisahkan dari Peraturan Menteri ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_fd80d9d647 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_35_1__7 ;
    kbr:hasRuleId "R-PMK-2023-96-fd80d9d647"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/35/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(7) Dalam hal jaminan telah dicairkan atau dilakukan klaim sebagaimana dimaksud pada ayat (6), PJT harus menyesuaikan kembali jaminan sehingga me.menuhi jumlah jaminan yang telah ditetapkan sebagaimana dimaksud dalam Pasal 7 ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_fde080c959 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2023-96-fde080c959"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Barang Kiriman Tertentu adalah Barang Kiriman selain Kartu Pos, Surat, dan Dokumen, yang pengirimannya dilakukan melalui PPYD yang tidak disertai dengan Consignment Note."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_ff734316da a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_18_1__4 ;
    kbr:hasRuleId "R-PMK-2023-96-ff734316da"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/18/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(3) Pengajuan perincian terhadap pemberitahuan pabean kedatangan sarana Pengangkut (inward manifest) sebagaimana dimaksud pada ayat (1), dapat dilakukan oleh Penyelenggara Pos tanpa persetujuan Kepala Kantor Pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

