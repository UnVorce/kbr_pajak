    kbr:hasSourceLocator "PMK-2024-81#BT/389"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pengusaha Kena Pajak harus melakukan pembatalan Faktur Pajak yang telah dibuat atas penyerahan: a. Barang Kena Pajak dan/atau Jasa Kena Pajak yang transaksinya dibatalkan; atau b. barang dan / a tau j asa yang seharusnya tidak dibuatkan Faktur Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
