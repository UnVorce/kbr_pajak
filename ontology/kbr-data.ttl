    kbr:hasSourceLocator "PMK-2024-136#BT/1#p5"^^xsd:string ;
    kbr:hasSourceQuote "Persetujuan Penghindaran Pajak Berganda yang selanjutnya disebut P3B adalah perjanjian antara Pemerintah Indonesia dengan pemerintah negara atau yurisdiksi mitra untuk mencegah terjadinya pengenaan pajak berganda dan pengelakan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

