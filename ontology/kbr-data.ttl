    kbr:hasSourceQuote "(2) Pajak Masukan atas perolehan Barang Kena Pajak dan/atau Jasa Kena Pajak sehubungan dengan penyerahan Agunan tidak dapat dikreditkan oleh Kreditur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
