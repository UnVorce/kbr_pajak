    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/7/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dasar pengenaan PKB, khusus untuk Kendaraan Bermotor di air, ditetapkan hanya berdasarkan NJKB."^^xsd:string ;
