    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_309 ;
    kbr:hasRuleId "R-PMK-2024-81-50a03e1c24"^^xsd:string ;
