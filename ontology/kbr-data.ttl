    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_1791552fa2 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_19 ;
    kbr:hasRuleId "R-PMK-2023-96-1791552fa2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Barang Kiriman impor dapat dikeluarkan dari Kawasan Pabean atau tempat lain yang diperlakukan sama dengan TPS setelah dipenuhi Kewajiban Pabean untuk: a. diimpor untuk dipakai; b. diimpor sementara; c. diangkut ke TPS di Kawasan Pabean di Kantor Pabean lainnya; d. ditimbun di tempat penimbunan berikat; e. diekspor kembali; f. dimasukkan ke kawasan ekonomi khusus; atau g. dimasukkan ke kawasan perdagangan bebas dan pelabuhan bebas."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_180bd02d74 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_18_1__4 ;
    kbr:hasRuleId "R-PMK-2023-96-180bd02d74"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/18/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyelenggara Pos melakukan perincian lebih lanjut atas pos pemberitahuan pabean kedatangan sarana Pengangkut (inward manifest) Barang Kiriman, dalam hal pemberitahuan pabean kedatangan sarana Pengangkut (inward manifest) belum memuat rincian Barang Kiriman untuk setiap CN atau setiap item Barang Kiriman."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_1837236ed8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_41_1__7 ;
    kbr:hasRuleId "R-PMK-2023-96-1837236ed8"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/41/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(1) Untuk mendapatkan persetujuan ekspor kembali Barang Kiriman sebagaimana dimaksud dalam Pasal 40 ayat (3), Importir a tau Penyelenggara Pos mengajukan permohonan ekspor kembali kepada Kepala Kantor Pabean atau Pejabat Bea dan Cukai yang menangani Barang Kiriman dengan menyebutkan alasan dan disertai dengan dokumen dan/ atau bukti pendukung."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_18d36f3b7a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_53 ;
    kbr:hasRuleId "R-PMK-2023-96-18d36f3b7a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/53"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan impor kembali Barang Kiriman yang telah diekspor sebagaimana dimaksud pada ayat (1), dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan mengenai impor kembali barang yang telah diekspor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_1a6e7c9600 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_47 ;
    kbr:hasRuleId "R-PMK-2023-96-1a6e7c9600"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/47"^^xsd:string ;
    kbr:hasSourceQuote "Penelitian atas pemenuhan ketentuan larangan dan/ atau pembatasan sebagaimana dimaksud pada ayat (2) dilakukan oleh: a. Pejabat Bea dan Cukai; b. SKP; dan/atau c. Sistem Indonesia Nasional Single Window (SIN SW)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_1a9eee31fe a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_26 ;
    kbr:hasRuleId "R-PMK-2023-96-1a9eee31fe"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat Bea dan Cukai dan/ atau SKP menetapkan tarif dan nilai pabean berdasarkan informasi yang tersedia, dalam hal permintaan informasi tidak dipenuhi dalam jangka waktu sebagaimana dimaksud pada ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

