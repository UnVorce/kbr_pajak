    kbr:hasSourceQuote "Ketentuan tentang pengenaan sanksi administrasi dan penyesuaian besarnya sanksi administrasi serta penyesuaian besarnya bunga menurut Undang-undang ini ditetapkan lebih lanjut dengan Peraturan Pemerintah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

