    kbr:hasSourceLocator "PMK-2023-72#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Harta berwujud yang dimiliki dan digunakan serta merupakan komoditas pokok dalam bidang usaha tertentu sebagaimana dimaksud pada ayat (1), yaitu ternak yang dapat berproduksi berkali-kali dan sudah menghasilkan setelah dipelihara kurang dari atau sampai dengan 1 (satu) tahun, dapat berupa ayam petelur dan bebek petelur."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

