    kbr:hasSourceLocator "PP-2022-55#BT/17/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(2) Atas penerimaan Badan Pengelola Keuangan Haji yang berupa: a. dana setoran Biaya Penyelenggaraan Ibadah Haji dan/atau Biaya Penyelenggaraan Ibadah Haji Khusus sebagaimana dimaksud pada ayat (1) huruf a; dan b. penghasilan dari pengembarlgan keuangan haji sebagaimana dimaksud pada ayat (1) huruf b dalam bidang atau instrumen keuangan tertentu, dikecualikan dari objek Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

