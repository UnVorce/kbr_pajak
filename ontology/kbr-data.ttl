kbr:Aturan_R_PMK_2023_61_4dba83748b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_4 ;
    kbr:hasRuleId "R-PMK-2023-61-4dba83748b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak melunasi Utang Pajak yang masih harus dibayar setelah lewatjatuh tempo pelunasan, dilakukan serangkaian tindakan penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_4e2f9e0727 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_44_1__3 ;
    kbr:hasRuleId "R-PMK-2023-61-4e2f9e0727"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/44/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Barang lain sebagaimana dimaksud pada ayat (1) huruf b merupakan: a. milik Penanggung Pajak, termasuk milik istri atau suami dan anak yang masih dalam tanggungan Penanggung Pajak kecuali terdapat perjanjian pemisahan harta sebagaimana dimaksud dalam Pasal 23 ayat (2); b. tidak sedang dijaminkan atas pelunasan utang tertentu; dan c. Barang yang mudah dijual atau dicairkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_4e5088c11c a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_126 ;
    kbr:hasRuleId "R-PMK-2023-61-4e5088c11c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/126"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terdapat: a. pengiriman hasil penagihan Pajak atas Nilai Klaim Pajak sebagaimana dimaksud dalam Pasal 119 ayat (2); atau b. pengembalian hasil penagihan Pajak atas Nilai Klaim Pajak kepada Penanggung Pajak sebagaimana dimaksud dalam Pasal 125 ayat (1), dengan menggunakan satuan mata uang selain rupiah, hasil penagihan Pajak atas Nilai Klaim Pajak dikonversi dengan menggunakan kurs yang ditetapkan oleh bank tempat pembukaan Rekening · Pemerintah Lainnya pada tanggal transaksi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_4f247cc679 a kbr:Definisi ;
