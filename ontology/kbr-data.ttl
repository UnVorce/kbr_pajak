    kbr:hasSourceLocator "PMK-2024-81#BT/157/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pelayanan Pajak menerbitkan Surat Keputusan Pengembalian Kelebihan Pembayaran Pajak berdasarkan nota penghitungan sebagaimana dimaksud dalam Pasal 156 ayat ( 1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_7ef75f0cb4 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_175_5 ;
    kbr:hasRuleId "R-PMK-2024-81-7ef75f0cb4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/175/5"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Surat Setoran Pajak atau sarana administrasi lain yang disamakan dengan Surat Setoran Pajak telah tervalidasi dalam sistem Direktorat Jenderal Pajak, pemberitahuan perpanjangan Surat Pemberitahuan tidak perlu dilampiri dengan Surat Setoran Pajak atau sarana administrasi lain yang disamakan dengan Surat Setoran Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_7f00bcdc69 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_206 ;
    kbr:hasRuleId "R-PMK-2024-81-7f00bcdc69"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/206"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang wajib membayar sendiri Pajak Penghasilan yang terutang sebagaimana dimaksud dalam Pasal 203 ayat (1) wajib melaporkan penghasilan yang diterima atau diperoleh dan Pajak Penghasilan yang telah dibayar dalam suatu Masa Pajak kepada Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_7f39c8c472 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_436 ;
    kbr:hasRuleId "R-PMK-2024-81-7f39c8c472"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/436"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang melakukan Penelitian dan Pengembangan untuk memperoleh tambahan pengurangan Penghasilan Bruto sebagaimana dimaksud dalam Pasal 432 ayat (3) huruf a, huruf b, dan/ atau huruf d wajib mendaftarkan hak Kekayaan Intelektual berupa Paten atau Hak Perlindungan Varietas Tanaman"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

