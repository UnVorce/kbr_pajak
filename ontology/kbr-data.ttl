    kbr:hasRuleId "R-PMK-2024-136-504e24b833"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Entitas Induk yang dimiliki secara minoritas sebagaimana dimaksud pada ayat (2) huruf a merupakan: a. Entitas Konstituen yang dimiliki secara minoritas sebagaimana dimaksud pada ayat (1); b. yang memiliki Kepentingan Pengendali dari Entitas Konstituen yang dimiliki secara minoritas lainnya secara langsung atau tidak langsung; dan c. Kepentingan Pengendali Entitas Induk tersebut tidak dimiliki oleh Entitas Konstituen yang dimiliki secara minoritas lainnya, secara langsung atau tidak langsung."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

