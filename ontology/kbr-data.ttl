kbr:Aturan_R_PMK_2024_136_f3a1880b32 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_27_1__4 ;
