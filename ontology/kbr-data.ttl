    kbr:hasSourceQuote "d. barang kena cukai dan/atau barang lainnya yang terkait dengan barang kena cukai yang berada di tempat sebagaimana dimaksud pada huruf a, huruf b, dan huruf c."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_0de42dbac0 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_2__2 ;
    kbr:hasRuleId "R-UU-1995-11-0de42dbac0"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/2..2"^^xsd:string ;
    kbr:hasSourceQuote "(2) Barang Kena Cukai yang pemiliknya tidak diketahui, dikuasai negara dan berada di bawah pengawasan serta wajib diumumkan secara resmi oleh Direktorat Jenderal Bea dan Cukai untuk diselesaikan oleh yang bersangkutan dalam waktu tiga puluh hari terhitung sejak dikuasai negara, dan apabila dalam jangka waktu dimaksud yang bersangkutan tidak menyelesaikan kewajibannya, Barang Kena Cukai tersebut menjadi milik negara."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_0e393c840d a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_1__2 ;
    kbr:hasRuleId "R-UU-1995-11-0e393c840d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pengusaha Pabrik atau Pengusaha Tempat Penyimpanan dapat mengajukan keberatan secara tertulis hanya kepada Direktur Pasal 41 Bagian Pertama Keberatan dan Banding BABXI KEBERATAN, BANDING, DAN LEMBAGA BANDING"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_0e77fbeea1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_3__1 ;
    kbr:hasRuleId "R-UU-1995-11-0e77fbeea1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/3..1"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pengusaha Pabrik atau Pengusaha Tempat Penyimpanan atau orang yang terhadapnya dilakukan pemeriksaan, wajib menyediakan tenaga, peralatan dan menyerahkan catatan atau dokumen yang wajib diadakan berdasarkan Undang-undang ini dan pembukuan"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_0e7f7cfd1c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_35 ;
    kbr:hasRuleId "R-UU-1995-11-0e7f7cfd1c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/35"^^xsd:string ;
    kbr:hasSourceQuote "c. tempat usaha penyalur, tempat penjualan eceran, atau tempat lain yang bukan rumah tinggal, yang di dalamnya terdapat barang kena cukai;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_0ef5c2fe1c a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_39_1c__3 ;
    kbr:hasRuleId "R-UU-1995-11-0ef5c2fe1c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/39/1c..3"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang menyebabkan pejabat bea dan cukai tidak dapat menjalankan kewenangan audit cukai dikenai sanksi administrasi berupa denda sebesar Rp75.000.000,00 (tujuh puluh lima juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_0f05a39ad1 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_3__1 ;
    kbr:hasRuleId "R-UU-1995-11-0f05a39ad1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/3..1"^^xsd:string ;
    kbr:hasSourceQuote "(5) Barangsiapa menyebabkan Pejabat Bea dan Cukai tidak dapat melaksanakan ketentuan sebagaimana dimaksud pada ayat (1), ayat (2) , dan ayat (3), dikenai sanksi administrasi berupa denda paling banyak Rp50.000.000,OO(lima puluh juta rupiah) dan paling sedikit Rp5.000.000,OO(limajuta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_100df694f8 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_1_b__c ;
    kbr:hasRuleId "R-UU-1995-11-100df694f8"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/1/b..c"^^xsd:string ;
    kbr:hasSourceQuote "b. membeli, menyimpan, mempergunakan, menjual, menawarkan, menyerahkan, menyediakan untuk dijual, atau mengimpor pita cukai yang palsu atau dipalsukan atau dibuat secara melawan hukum"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_1062dbf2d3 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_7__1 ;
    kbr:hasRuleId "R-UU-1995-11-1062dbf2d3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/7..1"^^xsd:string ;
    kbr:hasSourceQuote "Permohonan banding sebagaimana dimaksud dalam Pasal 42 diajukan hanya kepada badan peradilan pajak sebagaimana dimaksud da1am Undang-undang Nomor 6 Tahun 1983 tentang Ketentuan Umum dan Tata Cara Perpajakan sebagaimana te1ah diubah dengan Undang-undang"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_11520d64ce a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_53 ;
    kbr:hasRuleId "R-UU-1995-11-11520d64ce"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/53"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang dengan sengaja memperlihatkan atau menyerahkan buku, catatan, dan/atau dokumen, sebagaimana dimaksud dalam Pasal 36 ayat (1) atau laporan keuangan, buku, catatan dan dokumen yang menjadi bukti dasar pembukuan, dan dokumen lain yang berkaitan dengan kegiatan usaha, termasuk data elektronik serta surat yang berkaitan dengan kegiatan di bidang cukai sebagaimana dimaksud dalam Pasal 39 ayat (1b) yang palsu atau dipalsukan, dipidana dengan pidana penjara paling singkat 1 (satu) tahun dan paling lama 6 (enam) tahun dan pidana denda paling sedikit Rp75.000.000,00 (tujuh puluh lima juta rupiah) dan paling banyak Rp750.000.000,00 (tujuh ratus lima puluh juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_11651a179d a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_64 ;
    kbr:hasRuleId "R-UU-1995-11-11651a179d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "Pembayaran sebagaimana dimaksud pada ayat (3) menjadi pertimbangan untuk dituntut tanpa disertai penjatuhan pidana penjara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_1256c63f58 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_26 ;
    kbr:hasRuleId "R-UU-1995-11-1256c63f58"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha pabrik atau pengusaha tempat penyimpanan yang tidak melaporkan pemindahan barang kena cukai yang belum dilunasi cukainya karena keadaan darurat sebagaimana dimaksud pada ayat (2) dikenai sanksi administrasi berupa denda paling sedikit Rp1.000.000,00 (satu juta rupiah) dan paling banyak Rp10.000.000,00 (sepuluh juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_127010019d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_1__3 ;
    kbr:hasRuleId "R-UU-1995-11-127010019d"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Daerah Pabean adalah wilayah Republik Indonesia yang meliputi wilayah darat, perairan, dan ruang udara di atasnya serta tempat-tempat tertentu di zona ekonomi eksklusif dan landas kontirien yang di dalamnya berlaku Undang-undang tentang Kepabeanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_131cff8140 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_32 ;
    kbr:hasRuleId "R-UU-1995-11-131cff8140"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/32"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pengusaha pabrik, importir barang kena cukai, penyalur, atau pengusaha tempat penjualan eceran, yang pelunasan cukainya dengan cara pelekatan pita cukai atau pembubuhan tanda pelunasan cukai lainnya, yang melanggar ketentuan larangan sebagaimana dimaksud pada ayat (1) dikenai sanksi administrasi berupa denda paling sedikit 2 (dua) kali nilai cukai dan paling banyak 10 (sepuluh) kali nilai cukai dari pita cukai atau tanda pelunasan cukai lainnya yang didapati telah dipakai."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_135f4e7b9f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_16A ;
    kbr:hasRuleId "R-UU-1995-11-135f4e7b9f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/16A"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pembukuan wajib diselenggarakan di Indonesia dengan menggunakan huruf latin, angka arab, mata uang rupiah, serta bahasa Indonesia, atau dengan mata uang asing dan bahasa lain yang diizinkan oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_14efb08ce6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_I_2__1 ;
    kbr:hasRuleId "R-UU-1995-11-14efb08ce6"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/I/2..1"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pengangkut wajib menunjukkan dokumen cukai dan/atau dokumen pelengkap cukai yang diwajibkan menurut Undang-undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_1581091bba a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_16 ;
    kbr:hasRuleId "R-UU-1995-11-1581091bba"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha pabrik skala kecil, penyalur skala kecil yang wajib memiliki izin, dan pengusaha tempat penjualan eceran yang wajib memiliki izin, yang tidak melakukan pencatatan sebagaimana dimaksud pada ayat (2) dikenai sanksi administrasi berupa denda sebesar Rp10.000.000,00 (sepuluh juta rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_160344d664 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_18 ;
    kbr:hasRuleId "R-UU-1995-11-160344d664"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Buku rekening barang kena cukai juga ditutup setelah dilakukan pencacahan atau atas permintaan pengusaha pabrik atau pengusaha tempat penyimpanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_167b3ca4f0 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_10 ;
    kbr:hasRuleId "R-UU-1995-11-167b3ca4f0"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "dikenai bunga sebesar 2% (dua persen) setiap bulan untuk paling lama 24 (dua puluh empat) bulan dari nilai utang cukai, kekurangan cukai, dan/atau sanksi administrasi berupa denda yang tidak dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

