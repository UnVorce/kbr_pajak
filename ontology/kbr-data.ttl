    kbr:hasSourceQuote "Surat Keputusan Persetujuan Bersama sebagaimana dimaksud pada ayat ( 1) disampaikan kepada: a. Pemohon; b. Wajib Pajak dalam negeri yang terkait dengan permintaan pelaksanaan Prosedur Persetujuan Bersama sebagaimana dimaksud dalam Pasal 41 ayat (3) huruf c dan huruf d; dan/ atau c. unit kerja di lingkungan Direktorat Jenderal Pajak yang berwenang menindaklanjuti."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

