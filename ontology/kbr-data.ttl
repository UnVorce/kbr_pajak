kbr:Aturan_R_PMK_2024_81_44b23f178d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_202 ;
    kbr:hasRuleId "R-PMK-2024-81-44b23f178d"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/202"^^xsd:string ;
    kbr:hasSourceQuote "Jumlah bruto nilai pengalihan Real Estat sebagaimana dimaksud pada ayat (1) meliputi: a. seluruh jumlah yang sesungguhnya diterima atau diperoleh Wajib Pajak dari Special Purpose Company atau Kontrak Investasi Kolektif atas pengalihan Real Estat dalam skema Kontrak Investasi Kolektif tertentu, dalam hal Wajib Pajak tidak memiliki hubungan istimewa dengan Special Purpose Company atau Kontrak Investasi Kolektif; atau b. seluruh jumlah yang seharusnya diterima atau diperoleh Wajib Pajak dari Special Purpose Company atau Kontrak Investasi Kolektif atas pengalihan Real Estat dalam skema Kontrak Investasi Kolektif tertentu dalam hal Wajib Pajak memiliki hubungan istimewa dengan Special Purpose Company atau Kontrak Investasi Kolektif."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

