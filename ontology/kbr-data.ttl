    kbr:hasSourceLocator "PP-2022-50#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "4. Pajak Penghasilan adalah Pajak Penghasilan sebagaimana dimaksud dalam Undang-Undang Nomor 7 Tahun 1983 tentang Pajak Penghasilan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 7 Tahun 202L tentang Harmonisasi Peraturan Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
