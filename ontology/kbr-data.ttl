    kbr:hasRuleId "R-PMK-2023-96-9cbc33d479"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/60/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Kepala Kantor Pabean melakukan penelitian dan memutuskan persetujuan atau penolakan atas permohonan sebagaimana dimaksud pada ayat (2) dalam jangka waktu paling lama 3 (tiga) hari kerja setelah permohonan diterima secara lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_9d2433c469 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_33 ;
    kbr:hasRuleId "R-PMK-2023-96-9d2433c469"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat Bea dan Cukai yang menangani Barang Kiriman melakukan penetapan tarif dan nilai pabean terhadap daftar Barang Kiriman, CN, dan PIBK yang disampaikan sebelum pembongkaran Barang Kiriman di Kawasan Pabean atau tempat lain yang diperlakukan sama dengan TPS se bagaimana dimaksud pada ayat ( 1), setelah Penyelenggara Pos melakukan perincian lebih lanjut atas pos pemberitahuan pa bean kedatangan sarana Pengangkut (inward manifest) sebagaimana dimaksud dalam Pasal 18 ayat (1) dan menyampaikan nomor sub Pos pemberitahuan pa bean kedatangan sarana Pengangkut (inward manifest)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_9fb789e260 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_38_1__6 ;
    kbr:hasRuleId "R-PMK-2023-96-9fb789e260"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/38/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(4) Pemberitahuan pemindahan penimbunan Barang Kiriman sebagaimana dimaksud pada ayat (2) yang telah diterima dan mendapat nomor dan tanggal pendaftaran merupakan dokumen pemberitahuan pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_a0073fea06 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_63 ;
    kbr:hasRuleId "R-PMK-2023-96-a0073fea06"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/63"^^xsd:string ;
    kbr:hasSourceQuote "Barang Kiriman dinyatakan sebagai barang tidak dikuasai, dalam hal: a. Barang Kiriman ditimbun di TPS melebihi jangka waktu 30 (tiga puluh) hari;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

