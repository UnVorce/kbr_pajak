    kbr:hasSourceQuote "Dasar pengenaan PKB merupakan hasil perkalian dari: a. NJKB; dan b. bobot yang mencerminkan secara relatif tingkat kerusakan jalan dan/atau pencemaran lingkungan akibat penggunaan Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

