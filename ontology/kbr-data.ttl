kbr:Aturan_R_PMK_2023_61_889d135b06 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_16 ;
    kbr:hasRuleId "R-PMK-2023-61-889d135b06"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Penanggung Pajak telah diterbitkan surat perintah Penagihan Seketika dan Sekaligus sebagaimana dimaksud dalam Pasal 5 ayat (1) huruf b atau Penanggung Pajak tidak memenuhi ketentuan sebagaimana tercantum dalam keputusan persetujuan pengangsuran atau penundaan pembayaran Utang Pajak, Surat Paksa dapat diterbitkan tanpa didahului Surat Teguran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

