    kbr:hasSourceLocator "UU-1995-10#BT/94"^^xsd:string ;
    kbr:hasSourceQuote "(2) Direktur Jenderal memutuskan keberatan sebagaimana dimaksud pada ayat (1) dalam jangka waktu 60 (enam puluh) hari sejak diterimanya pengajuan keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_80b82987d9 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_107 ;
    kbr:hasRuleId "R-UU-1995-10-80b82987d9"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/107"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha pengurusan jasa kepabeanan yang melakukan pengurusan Pemberitahuan Pabean atas kuasa yang diterimanya dari importir atau eksportir, apabila melakukan perbuatan yang diancam dengan pidana berdasarkan Undang-undang ini, ancaman pidana tersebut berlaku juga terhadapnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_83b8696f47 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_50 ;
    kbr:hasRuleId "R-UU-1995-10-83b8696f47"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/50"^^xsd:string ;
    kbr:hasSourceQuote "orang sebagaimana dimaksud dalam Pasal 49 wajib menyerahkan laporan keuangan, buku, catatan dan dokumen yang menjadi bukti dasar pembukuan, surat yang berkaitan dengan kegiatan usaha termasuk data elektronik, serta surat yang berkaitan dengan kegiatan di bidang kepabeanan untuk kepentingan audit kepabeanan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_84866a95a2 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_83 ;
    kbr:hasRuleId "R-UU-1995-10-84866a95a2"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/83"^^xsd:string ;
    kbr:hasSourceQuote "Surat yang dicurigai berisi barang impor atau barang ekspor yang dikirim melalui pos dapat dibuka di hadapan si alamat, atau jika si alamat tidak dapat ditemukan, surat dapat dibuka oleh Pejabat Bea dan Cukai bersama petugas kantor pos."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

