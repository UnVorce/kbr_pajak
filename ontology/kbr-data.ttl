    kbr:hasSourceQuote "Dokumen Pelengkap Pabean adalah semua dokumen yang digunakan sebagai pelengkap Pemberitahuan Pabean, misalnya invoice, packing list, bill of lading/ airway bill, dokumen iden tifikasi barang, dokumen pemenuhan persyaratan impor, dan dokumen lainnya yang dipersyaratkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

