    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/50"^^xsd:string ;
    kbr:hasSourceQuote "(1) Jenis pelayanan yang merupakan objek Retribusi Jasa Umum meliputi adalah: a. Pelayanan Kesehatan; b. Pelayanan Kebersihan; c. Pelayanan Parkir di Tepi Jalan Umum; dan d. Pelayanan Pasar. (2) Pelayanan yang merupakan objek Retribusi Jasa Umum sebagaimana dimaksud pada ayat (1) merupakan pelayanan yang disediakan atau diberikan oleh Pemerintah Daerah berdasarkan kewenangan Daerah sebagaimana diatur dalam ketentuan Peraturan Perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

