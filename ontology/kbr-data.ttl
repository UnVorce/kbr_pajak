    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2024_118_c3dd554a98 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_118 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_118_BT_28_7__8 ;
    kbr:hasRuleId "R-PMK-2024-118-c3dd554a98"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-118#BT/28/7..8"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak tidak memenuhi sebagian atau seluruh permintaan sebagaimana dimaksud pada ayat (3) huruf a atau huruf b, permohonan pengurangan atau penghapusan sanksi administratif atau permohonan pengurangan denda administratif Pajak Bumi dan - 35 - Bangunan tetap diproses sesuai dengan dokumen, data, informasi, dan/atau keterangan yang tersedia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

