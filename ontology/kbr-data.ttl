    kbr:hasSourceLocator "PP-2022-50#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "28. Surat Keputusan Pemberian Imbalan Bunga adalah surat keputusan yang menentukan jumlah imbalan bunga yang diberikan kepada Wajib Pajak."^^xsd:string ;
