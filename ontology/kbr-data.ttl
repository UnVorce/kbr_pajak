kbr:Aturan_R_PMK_2023_61_497ebf30dd a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_24 ;
    kbr:hasRuleId "R-PMK-2023-61-497ebf30dd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/24"^^xsd:string ;
    kbr:hasSourceQuote "Keadaan tertentu sebagaimana dimaksud pada ayat (1), mencakup: · a. Jurusita Pajak tidak menjumpai Barang bergerak yang dapat dijadikan Objek Sita; atau b. Barang bergerak yang dijumpai tidak mempunyai nilai atau harganya tidak memadai jika dibandingkan dengan Utang Pajaknya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

