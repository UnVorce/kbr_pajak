    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_72_BT_20 ;
    kbr:hasRuleId "R-PMK-2023-72-3e2ce6609b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-72#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang mengajukan permohonan sebagaimana dimaksud dalam Pasal 19 ayat (1) huruf c harus memenuhi ketentuan telah menyampaikan Surat Pemberitahuan Tahunan Pajak Penghasilan untuk 2 (dua) Tahun Pajak terakhir yang telah menjadi kewajibannya sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

