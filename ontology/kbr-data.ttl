    kbr:diaturDalam kbr:Reg_PMK_2023_164 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_164_BT_22 ;
    kbr:hasRuleId "R-PMK-2023-164-786ae6218a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-164#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "3. Wajib Pajak yang memilih dikenai Pajak Penghasilan Berdasarkan Ketentuan Umum Pajak Penghasilan sebagaimana dimaksud pada angka 1 huruf b) dan huruf c) wajib menyampaikan pemberitahuan sebagaimana dimaksud dalam Pasal 5 ayat (1) paling lama 60 (enam puluh) hari terhitung sejak tanggal Peraturan Menteri ini mulai berlaku;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

