kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_0f93a1019c a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_7 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-0f93a1019c"^^xsd:string ;
