kbr:Aturan_R_PMK_2025_112_d1ccccb164 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2025_112 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_112_BT_16 ;
    kbr:hasRuleId "R-PMK-2025-112-d1ccccb164"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-112#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Pemotong atau Pemungut Pajak sebagaimana dimaksud dalam Pasal 11 ayat (2) wajib menyimpan: a. tanda terima Formulir DGT sebagaimana dimaksud dalam Pasal 10 ayat (3) huruf b; dan - 15 - b. buku, catatan, dan/atau dokumen yang menjadi dasar pemotongan atau pemungutan Pajak Penghasilan sebagaimana dimaksud dalam Pasal 11 ayat (4), sesuai dengan ketentuan dalam Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2025_112_d38d51dc52 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2025_112 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_112_BT_12 ;
    kbr:hasRuleId "R-PMK-2025-112-d38d51dc52"^^xsd:string ;
