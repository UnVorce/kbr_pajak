    kbr:hasSourceQuote "a. atas premi dibayar tertanggung kepada Perusahaan Asuransi di luar negeri baik secara langsung maupun melalui pialang, sebesar 50% (lima puluh persen) dari jumlah premi yang dibayar;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_03129e6db1 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
