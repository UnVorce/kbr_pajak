    kbr:hasRuleId "R-PMK-2023-143-2c62951efd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Penetapan sebagaimana dimaksud pada ayat (1) dilakukan berdasarkan rasio jumlah penduduk provinsi terhadap jumlah penduduk nasional dan target penerimaan Cukai Rokok pada Undang-Undang mengenai anggaran pendapatan dan belanja negara."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2023_143_2ce006323e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_143 ;
