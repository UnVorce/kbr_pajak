    kbr:hasRuleId "R-PP-2022-50-7f17b3f111"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/65"^^xsd:string ;
    kbr:hasSourceQuote "pelunasan sebagaimana dimaksud pada ayat (1) dilakukan setelah menerima informasi kerugian pada pendapatan negara dan/atau jumlah pajak beserta sanksi administratif sebagaimana dimaksud dalam Pasal 63 ayat (2) dan ayat (3) dari Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_80631a84f4 a kbr:Definisi ;
