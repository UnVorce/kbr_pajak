kbr:Aturan_R_PMK_2024_136_eefced2c89 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_43_1__3 ;
    kbr:hasRuleId "R-PMK-2024-136-eefced2c89"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/43/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Usaha patungan (joint venture) merupakan Entitas yang hasil keuangannya dilaporkan dengan menggunakan metode ekuitas dalam Laporan Keuangan Konsolidasi dari Entitas Induk Utama sepanjang Entitas Induk Utama tersebut memiliki secara langsung atau tidak langsung paling sedikit 50% (lima puluh persen) dari Kepentingan Kepemilikan Entitas tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_ef120f9fdf a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_65_7__12 ;
    kbr:hasRuleId "R-PMK-2024-136-ef120f9fdf"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/65/7..12"^^xsd:string ;
    kbr:hasSourceQuote "Dikecualikan dari ketentuan sebagaimana dimaksud pada ayat (5), Entitas Konstituen yang berada di Indonesia yang telah menyampaikan GIR sebagaimana dimaksud pada ayat (3), tidak wajib menyampaikan Notifikasi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_ef1a30958f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_65_1__6 ;
    kbr:hasRuleId "R-PMK-2024-136-ef1a30958f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/65/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Atas penyampaian GIR sebagaimana dimaksud pada ayat (3) dan Notifikasi sebagaimana dimaksud pada ayat (5), Direktur Jenderal Pajak memberikan tanda terima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2024_136_f17f1ee626 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_35_8__11 ;
    kbr:hasRuleId "R-PMK-2024-136-f17f1ee626"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/35/8..11"^^xsd:string ;
    kbr:hasSourceQuote "Pemilihan rugi GloBE sebagaimana dimaksud pada ayat (1) harus dilaporkan dalam GIR pada Tahun Pajak pertama saat Grup PMN memiliki Entitas Konstituen yang berlokasi di negara atau yurisdiksi tempat pemilihan tersebut dibuat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

