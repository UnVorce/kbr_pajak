    kbr:hasSourceQuote "2. dapat diperkirakan secara wajar bahwa jumlah agregat Pajak Tercakup yang dibayar oleh Entitas Induk Utama dan Entitas lainnya"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

