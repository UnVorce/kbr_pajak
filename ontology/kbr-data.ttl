    kbr:hasSourceLocator "PMK-2023-72#BT/16"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang bergerak dalam bidang usaha tertentu sebagaimana dimaksud dalam Pasal 12 huruf c angka 2 melakukan: a. pembebanan sekaligus atas pengeluaran untuk memperoleh harta berwujud yang memiliki masa manfaat kurang dari atau sampai dengan 1 (satu) tahun; b. penyusutan atas pengeluaran untuk memperoleh harta berwujud yang memiliki masa manfaat lebih dari 1 (satu) tahun sampai dengan 4 (empat) tahun dalam bagian-bagian yang sama besar selama masa manfaat harta tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

