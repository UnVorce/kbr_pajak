    kbr:hasSourceQuote "Direktur Jenderal Pajak menetapkan besarnya PBB terutang melalui penerbitan: a. SPPT; atau b. SKP PBB, dengan menggunakan NJOP PBB sebagaimana dimaksud dalam Pasal 11."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
