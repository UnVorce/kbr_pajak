    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_65_1__4 ;
    kbr:hasRuleId "R-PMK-2023-172-eb61ff0423"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/65/1..4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal sampai dengan jangka waktu sebagaimana dimaksud pada ayat (2) belum dicapai kesepakatan, hasil perundingan Kesepakatan Harga Tran sf er Unilateral dianggap berupa ketidaksepakatan sebagaimana dimaksud dalam Pasal 61 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2023_172_ec0196d253 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_66_1__5 ;
