    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/192"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap hak dan kewajiban Wajib Pajak dan Wajib Retribusi yang belum diselesaikan sebelum Peraturan Daerah ini ditetapkan, penyelesaiannya dilakukan berdasarkan ketentuan yang diatur dalam Peraturan Daerah sebelum berlakunya Peraturan Daerah ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_daef34febc a kbr:Prosedur ;
