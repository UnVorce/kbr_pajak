    kbr:hasSourceQuote "(9) Surat Pemberitahuan Masa Pajak Pertambahan Nilai sebagaimana climaksucl pacla ayat (8) clisampaikan oleh Pengusaha Kena Pajak sejak Pengusaha seharusnya clikukuhkan sebagai Pengusaha Kena Pajak pacla: a. Masa Pajak terakhir clalam tahun buku sebelum tahun buku saat Pengusaha clikukuhkan sebagai Pengusaha Kena Pajak, yang meliputi Pajak Keluaran atas penyerahan Barang Kena Pajak clan/ atau Jasa Kena Pajak untuk periocle tahun buku yang bersangkutan; clan/ atau b. Masa Pajak terakhir sebelum Pengusaha clikukuhkan sebagai Pengusaha Kena Pajak clalam Tahun Buku saat Pengusaha clikukuhkan sebagai Pengusaha Kena Pajak, yang meliputi Pajak Keluaran atas penyerahan Barang Kena Pajak clan/ atau Jasa Kena Pajak sebelum Pengusaha clikukuhkan sebagai Pengusaha Kena Pajak untuk periocle tahun buku yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

