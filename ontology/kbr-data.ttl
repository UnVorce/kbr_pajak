    kbr:hasSourceQuote "Wajib Pajak dengan kemauan sendiri dapat membetulkan SPTPD yang telah disampaikan dengan menyampaikan pernyataan tertulis sepanjang belum dilakukan Pemeriksaan."^^xsd:string ;
