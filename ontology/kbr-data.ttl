    kbr:hasSourceQuote "b. dalam hal berita acara serah terima penyelesaian pekerjaan ditandatangani oleh Penyedia Jasa dan Pengguna Jasa sejak tanggal 1 Januari 2009 atau penyelesaian pekerjaan tidak menggunakan berita acara serah terima penyelesaian pekerjaan, pengenaan Pajak Penghasilan dilakukan berdasarkan ketentuan Peraturan Pemerintah Nomor 51 Tahun 2008 tentang Pajak Penghasilan atas Penghasilan dari Usaha Jasa Konstruksi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
