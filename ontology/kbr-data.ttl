kbr:Aturan_R_PMK_2023_168_0043f76502 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_168 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_168_BT_17_1__5 ;
    kbr:hasRuleId "R-PMK-2023-168-0043f76502"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-168#BT/17/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Penghasilan tetap dan teratur setiap bulan yang menjadi beban APBN atau APBD meliputi penghasilan tetap dan teratur bagi: a. Pejabat Negara, untuk: 1. gaji dan tunjangan lain yang sifatnya tetap dan teratur setiap bulan; atau 2. imbalan tetap sejenisnya, yang ditetapkan berdasarkan ketentuan peraturan perundang-undangan; b. PNS, Anggota TNI, dan Anggota POLRI, untuk gaji dan tunjangan lain yang sifatnya tetap dan teratur setiap bulan yang ditetapkan berdasarkan ketentuan peraturan perundang-undangan; dan c. Pensiunan, untuk uang pensiun dan tunjangan lain yang sifatnya tetap dan teratur setiap bulan yang ditetapkan berdasarkan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_168_04cf61a053 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2023_168 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_168_BT_11 ;
    kbr:hasRuleId "R-PMK-2023-168-04cf61a053"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-168#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya biaya pensiun sebagaimana dimaksud pada ayat (1) huruf a ditetapkan sebesar 5% (lima persen) dari penghasilan bruto, paling banyak Rp2.400.000,00 (dua juta empat ratus ribu rupiah) setahun atau paling banyak Rp200.000,00 (dua ratus ribu rupiah) sebulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_168_091aebe221 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2023_168 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_168_BT_15 ;
    kbr:hasRuleId "R-PMK-2023-168-091aebe221"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-168#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "b. Masa Pajak Terakhir yaitu sebesar selisih antara Pajak Penghasilan Pasal 21 yang terutang selama 1 (satu) Tahun Pajak atau bagian Tahun Pajak dengan Pajak Penghasilan Pasal 21 yang telah dipotong pada Masa Pajak selain Masa Pajak Terakhir sebagaimana dimaksud dalam huruf a."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_168_0bd6f85cbe a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_168 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_168_BT_9 ;
    kbr:hasRuleId "R-PMK-2023-168-0bd6f85cbe"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-168#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "Besarnya Penghasilan Tidak Kena Pajak sebagaimana dimaksud dalam Pasal 8 ayat (3) diatur dalam Pasal 7 ayat (1) dan ayat (3) Undang-Undang Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2023_168_0d7a829d8e a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2023_168 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_168_BT_12_2__3 ;
    kbr:hasRuleId "R-PMK-2023-168-0d7a829d8e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-168#BT/12/2..3"^^xsd:string ;
    kbr:hasSourceQuote "c. diterima atau diperoleh secara bulanan, sebesar jumlah penghasilan bruto."^^xsd:string ;
