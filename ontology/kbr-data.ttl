    kbr:hasSourceQuote "(1) Pejabat Bea dan Cukai berwenang melakukan pemeriksaan atas bangunan dan tempat lain : a. yang penyelenggaraannya berdasarkan izin yang telah diberikan menurut Undang-undang ini; atau b. yang menurut Pemberitahuan Pabean berisi barang di bawah pengawasan pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

