    kbr:hasSourceQuote "Pejabat pegawai negeri sipil tertentu di lingkungan Pemerintah Daerah Provinsi diberi wewenang khusus sebagai penyidik untuk melakukan penyidikan tindak pidana di bidang perpajakan Daerah dan Retribusi, sebagaimana dimaksud dalam undang-undang mengenai Hukum Acara Pidana."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_20d3179327 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
