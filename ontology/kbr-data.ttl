    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_12 ;
    kbr:hasRuleId "R-PMK-2023-96-6381ca9323"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "b. persetujuan untuk dapat melakukan Akses Kepabeanan sebagai PPJK dicabut atau dinyatakan tidak berlaku sesuai dengan ketentuan peraturan perundang-undangan mengenai registrasi kepabeanan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

