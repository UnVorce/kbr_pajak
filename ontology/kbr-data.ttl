kbr:Aturan_R_PMK_2020_237_49e5907273 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2020_237 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_237_BT_60 ;
    kbr:hasRuleId "R-PMK-2020-237-49e5907273"^^xsd:string ;
