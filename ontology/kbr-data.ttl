    kbr:hasSourceQuote "Subjek retribusi PTKA sebagaimana dimaksud dalam Pasal 114 ayat (1) huruf b adalah pemberi kerja tenaga kerja asing yang memperoleh pengesahan rencana penggunaan tenaga kerja asing perpanjangan bagi tenaga kerja asing yang bekerja hanya di dalam wilayah daerah."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
