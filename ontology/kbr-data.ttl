    kbr:hasSourceQuote "a. penghasilan dari luar negeri tersebut merupakan penghasilan pada Tahun Pajak diperoleh;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2022_55_4a139e88e4 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2022_55 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_57_2__4 ;
    kbr:hasRuleId "R-PP-2022-55-4a139e88e4"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/57/2..4"^^xsd:string ;
    kbr:hasSourceQuote "(4) Wajib Pajak sebagaimana dimaksud pada ayat (2) huruf e dan huruf f serta ayat (3), untuk Tahun Pajak-Tahun Pajak berikutnya tidak dapat dikenai Pajak Penghasilan bersifat linal berdasarkan Peraturan Pemerintah ini,"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2022_55_4a36655211 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2022_55 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_55_BT_20 ;
    kbr:hasRuleId "R-PP-2022-55-4a36655211"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Untuk menentukan besarnya penghasilan kena pajak bagi Wajib Pajak dalam negeri dan bentuk usaha tetap, pembentukan atau pemupukan dana cadangan tidak boleh dikurangkan dari penghasilan bruto."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
