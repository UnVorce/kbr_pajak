    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_e2e4e0a5f1 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_40 ;
    kbr:hasRuleId "R-UU-1983-6-e2e4e0a5f1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/40"^^xsd:string ;
    kbr:hasSourceQuote "Tindak pidana di bidang perpajakan tidak dapat dilakukan penuntutan setelah lampau waktu 10 (sepuluh) tahun sejak saat terutangnya pajak, berakhirnya Masa Pajak, berakhirnya Bagian Tahun Pajak, atau berakhirnya Tahun Pajak yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

