    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_17254ce2a9 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_93A ;
    kbr:hasRuleId "R-UU-1995-10-17254ce2a9"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/93A"^^xsd:string ;
    kbr:hasSourceQuote "Direktur Jenderal memutuskan keberatan sebagaimana dimaksud pada ayat (1) dalam jangka waktu 60 (enam puluh hari) sejak diterimanya pengajuan keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_172a94a30e a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_63 ;
    kbr:hasRuleId "R-UU-1995-10-172a94a30e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/63"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan penangguhan pengeluaran barang yang diduga merupakan hasil pelanggaran hak atas kekayaan intelektual tidak diberlakukan terhadap barang bawaan penumpang, awak sarana pengangkut, pelintas batas, atau barang kiriman melalui pos atau jasa titipan yang tidak dimaksudkan untuk tujuan komersial."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_182d352d11 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_72 ;
    kbr:hasRuleId "R-UU-1995-10-182d352d11"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pemilik barang dan/atau sarana pengangkut sebagaimana dimaksud dalam Pasal 68 dapat mengajukan keberatan secara tertulis kepada Menteri dalam jangka waktu tiga puluh hari sejak diberitahukan oleh Pejabat Bea dan Cukai dengan menyebutkan alasan dan bukti yang menguatkan keberatannya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_190bd4f00c a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_102B ;
    kbr:hasRuleId "R-UU-1995-10-190bd4f00c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/102B"^^xsd:string ;
    kbr:hasSourceQuote "Pelanggaran sebagaimana dimaksud dalam Pasal 102 dan Pasal 102A yang mengakibatkan terganggunya sendi- sendi perekonomian negara dipidana dengan pidana penjara paling singkat 5 (lima) tahun dan pidana penjara paling lama 20 (dua puluh) tahun dan pidana denda paling sedikit Rp5.000.000.000,00 (lima miliar rupiah) dan paling banyak Rp100.000.000.000,00 (seratus miliar rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_1ce48ee87e a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_57 ;
    kbr:hasRuleId "R-UU-1995-10-1ce48ee87e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penangguhan pengeluaran barang sebagaimana dimaksud dalam Pasal  56 huruf b dilaksanakan untuk jangka waktu paling lama 10 (sepuluh) hari kerja. (2) Jangka waktu sebagaimana dimaksud pada ayat (1), berdasarkan alasan dan dengan syarat tertentu, dapat diperpanjang satu kali untuk paling lama 10 (sepuluh) hari kerja dengan perintah tertulis ketua pengadilan niaga. (3) Perpanjangan penangguhan terhadap pengeluaran barang impor atau ekspor sebagaimana dimaksud pada ayat (2) disertai dengan perpanjangan jaminan sebagaimana dimaksud dalam Pasal 55 huruf d."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_1e274e81a3 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_111 ;
    kbr:hasRuleId "R-UU-1995-10-1e274e81a3"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/111"^^xsd:string ;
    kbr:hasSourceQuote "Tindak pidana di bidang Kepabeanan tidak dapat dituntut setelah lampau waktu sepuluh tahun sejak diserahkan Pemberitahuan Pabean atau sejak terjadinya tindak pidana."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_1f36138004 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_104 ;
    kbr:hasRuleId "R-UU-1995-10-1f36138004"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/104"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang: a. mengangkut barang yang berasal dari tindak pidana sebagaimana dimaksud dalam Pasal 102, Pasal 102A, atau Pasal 102B; b. memusnahkan, memotong, menyembunyikan, atau membuang buku atau catatan yang menurut Undang- Undang ini harus disimpan; c. menghilangkan, menyetujui, atau turut serta dalam penghilangan keterangan dari pemberitahuan pabean, dokumen pelengkap pabean, atau catatan; atau d. menyimpan . . . d. menyimpan dan/atau menyediakan blangko faktur dagang dari perusahaan yang berdomisili di luar negeri yang diketahui dapat digunakan sebagai kelengkapan pemberitahuan pabean menurut Undang- Undang ini dipidana dengan pidana penjara paling singkat 1 (satu) tahun, dan pidana penjara paling lama 3 (tiga) tahun dan/atau pidana denda paling sedikit Rp500.000.000,00 (lima ratus juta rupiah) dan paling banyak Rp3.000.000.000,00 (tiga miliar rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_21261c6fa8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_47 ;
    kbr:hasRuleId "R-UU-1995-10-21261c6fa8"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/47"^^xsd:string ;
    kbr:hasSourceQuote "Bilamana izin Tempat Penimbunan Berikat telah dicabut sebagaimana dimaksud dalam Pasal 46, pengusaha dalam batas waktu tiga puluh hari sejak pencabutan izin harus : a. melunasi semua Bea Masuk yang terutang; b. mengekspor kembali barang yang masih ada di Tempat Penimbunan Berikat; atau c. memindahkan barang yang masih ada di Tempat Penimbunan Berikat ke Tempat Penimbunan Berikat lain."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_2156cf4092 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_10 ;
    kbr:hasRuleId "R-UU-1995-10-2156cf4092"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "Barang yang akan diekspor wajib diberitahukan dengan menggunakan Pemberitahuan Pabean."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

