    kbr:hasRuleId "R-PP-2021-40-e7223c5208"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/141"^^xsd:string ;
    kbr:hasSourceQuote "Lokasi KEK yang ditetapkan oleh Dewan Nasional, atau diusulkan oleh Pemerintah Daerah provinsi, Pemerintah Daerah kabupatenfkota, badan usaha milik negarafbadan usaha milik daerah, yang tanahnya telah dibebaskan sesuai dengan ketentuan sebagaimana dimaksud dalam Pasal l40 ayat (1), diberikan hak pengelolaan sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2021_40_e73797e703 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2021_40 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2021_40_BT_37 ;
    kbr:hasRuleId "R-PP-2021-40-e73797e703"^^xsd:string ;
    kbr:hasSourceLocator "PP-2021-40#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "Selain menggunakan ketentuan sebagaimana dimaksud pada ayat (2) r, penetapan Badan Usaha dapat dilakukan berdasarkan kerja sama strategis dengan Badan Usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

