    kbr:hasSourceLocator "PMK-2023-61#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Biaya Penagihan Pajak adalah biaya pelaksanaan surat paksa, surat perintah melaksanakan penyitaan, pengumuman lelang, pembatalan lelang, jasa penilai, dan biaya lainnya sehubungan dengan penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

