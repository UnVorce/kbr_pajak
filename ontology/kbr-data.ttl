kbr:Aturan_R_PP_2010_94_5b4291a328 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_5 ;
    kbr:hasRuleId "R-PP-2010-94-5b4291a328"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "Bagian laba yang diterima atau diperoleh oleh pemegang unit penyertaan Kontrak Investasi Kolektif termasuk keuntungan atas pelunasan kembali unit penyertaannya, tidak termasuk sebagai objek pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_6c08c73dba a kbr:Kelayakan ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_29 ;
    kbr:hasRuleId "R-PP-2010-94-6c08c73dba"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "Kepada Wajib Pajak yang melakukan penanaman modal baru yang merupakan industri pionir, yang tidak mendapatkan fasilitas sebagaimana dimaksud dalam Pasal 31A Undang-Undang Pajak Penghasilan dapat diberikan fasilitas pembebasan atau pengurangan Pajak Penghasilan badan sebagaimana dimaksud dalam Pasal 18 ayat (5) Undang-Undang Nomor 25 Tahun 2007 tentang Penanaman Modal."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_70553bdeb6 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_15 ;
    kbr:hasRuleId "R-PP-2010-94-70553bdeb6"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Pemotongan Pajak Penghasilan oleh pihak sebagaimana dimaksud dalam Pasal 26 ayat (1) Undang-Undang Pajak Penghasilan, dilakukan pada akhir bulan: a. dibayarkannya penghasilan; b. disediakan untuk dibayarkannya penghasilan; atau c. jatuh temponya pembayaran penghasilan yang bersangkutan, tergantung peristiwa yang terjadi terlebih dahulu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_751862a496 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_28 ;
    kbr:hasRuleId "R-PP-2010-94-751862a496"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "Sisa rugi fiskal yang masih dapat dikompensasikan yang berasal dari tahun-tahun pajak sebelum perubahan tahun buku dapat dikompensasikan dengan penghasilan untuk Bagian Tahun Pajak dan Tahun Pajak berikutnya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_753c3e95ce a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_15 ;
    kbr:hasRuleId "R-PP-2010-94-753c3e95ce"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Pemotongan Pajak Penghasilan oleh pihak sebagaimana dimaksud dalam Pasal 23 ayat (1) dan ayat (3) Undang- Undang Pajak Penghasilan, dilakukan pada akhir bulan: a. dibayarkannya penghasilan; b. disediakan untuk dibayarkannya penghasilan; atau c. jatuh temponya pembayaran penghasilan yang bersangkutan, tergantung peristiwa yang terjadi terlebih dahulu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_7887f33d30 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_11 ;
    kbr:hasRuleId "R-PP-2010-94-7887f33d30"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/11"^^xsd:string ;
    kbr:hasSourceQuote "Biaya pengembangan tanaman industri yang berumur lebih dari 1 (satu) tahun dan hanya 1 (satu) kali memberikan hasil, dikapitalisasi selama periode pengembangan dan merupakan bagian dari harga pokok penjualan pada saat hasil tanaman industri dijual."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_7e04a04312 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_26 ;
    kbr:hasRuleId "R-PP-2010-94-7e04a04312"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pelaksanaan perlakuan perpajakan sebagaimana dimaksud pada ayat (1) dilakukan setelah mendapat persetujuan Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_83fd874920 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_5 ;
    kbr:hasRuleId "R-PP-2010-94-83fd874920"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan terhadap bagian laba termasuk keuntungan atas pelunasan kembali unit penyertaannya sebagaimana dimaksud pada ayat (1) berlaku juga bagi pemegang unit penyertaan yang merupakan Subjek Pajak luar negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_8fe9fbfd22 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_26 ;
    kbr:hasRuleId "R-PP-2010-94-8fe9fbfd22"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(3) Ketentuan lebih lanjut mengenai pelaksanaan perlakuan perpajakan sebagaimana dimaksud pada ayat (2) diatur dengan Peraturan Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_9878b9065c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_10 ;
    kbr:hasRuleId "R-PP-2010-94-9878b9065c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Masukan yang dapat dikurangkan dari penghasilan bruto sebagaimana dimaksud pada ayat (1) sehubungan dengan pengeluaran untuk memperoleh harta berwujud dan/atau harta tidak berwujud serta biaya lainnya yang mempunyai masa manfaat lebih dari 1 (satu) tahun sebagaimana dimaksud dalam Pasal 11 dan Pasal 11A Undang-Undang Pajak Penghasilan, harus dikapitalisasi dengan pengeluaran atau biaya tersebut dan dibebankan melalui penyusutan atau amortisasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_9960e245eb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_12 ;
    kbr:hasRuleId "R-PP-2010-94-9960e245eb"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "Pinjaman tanpa bunga dari pemegang saham yang diterima oleh Wajib Pajak berbentuk perseroan terbatas diperkenankan apabila: a. pinjaman tersebut berasal dari dana milik pemegang saham itu sendiri dan bukan berasal dari pihak lain; b. modal yang seharusnya disetor oleh pemegang saham pemberi pinjaman telah disetor seluruhnya; c. pemegang saham pemberi pinjaman tidak dalam keadaan merugi; dan d. perseroan terbatas penerima pinjaman sedang mengalami kesulitan keuangan untuk kelangsungan usahanya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_9be9c1138e a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_19 ;
    kbr:hasRuleId "R-PP-2010-94-9be9c1138e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penghasilan tidak dikenai Pajak Penghasilan yang bersifat final dengan Peraturan Pemerintah tersendiri, atas penghasilan tersebut dikenai Pajak Penghasilan berdasarkan tarif sebagaimana dimaksud dalam Pasal 17 Undang-Undang Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_9f5ff84c57 a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_21 ;
    kbr:hasRuleId "R-PP-2010-94-9f5ff84c57"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/21"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang atas penghasilannya hanya dikenakan pajak bersifat final, dapat mengajukan permohonan pembebasan dari pemotongan dan/atau pemungutan Pajak Penghasilan yang dapat dikreditkan kepada Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_a2641db86a a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_22 ;
    kbr:hasRuleId "R-PP-2010-94-a2641db86a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Dalam menghitung Pajak Penghasilan sebagaimana dimaksud dalam Pasal 26 ayat (4) Undang-Undang Pajak Penghasilan, terhadap bentuk usaha tetap yang terutang Pajak Penghasilan pada suatu tahun pajak, kerugian fiskal tidak dapat dikompensasikan lagi dengan Penghasilan Kena Pajak setelah dikurangi dengan Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_a55ac95a5e a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_26 ;
    kbr:hasRuleId "R-PP-2010-94-a55ac95a5e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal terdapat ketentuan perpajakan yang diatur dalam perjanjian internasional yang berbeda dengan ketentuan perpajakan yang diatur dalam Undang-Undang Pajak Penghasilan, perlakuan perpajakannya didasarkan pada ketentuan dalam perjanjian tersebut sampai dengan berakhirnya perjanjian dimaksud, dengan syarat perjanjian tersebut telah sesuai dengan Undang-Undang tentang Perjanjian Internasional."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_a9830f17d2 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_2 ;
    kbr:hasRuleId "R-PP-2010-94-a9830f17d2"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Objek pajak berupa dividen sebagaimana dimaksud dalam Pasal 4 ayat (1) huruf g Undang-Undang Pajak Penghasilan tidak termasuk pemberian saham bonus yang dilakukan tanpa penyetoran yang berasal dari: a. kapitalisasi agio saham kepada pemegang saham yang telah menyetor modal atau membeli saham di atas harga nominal, sepanjang jumlah nilai nominal saham yang dimilikinya setelah pembagian saham bonus tidak melebihi jumlah setoran modal; dan b. kapitalisasi selisih lebih penilaian kembali aktiva tetap sebagaimana dimaksud dalam Pasal 19 ayat (1) Undang- Undang Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_c2c5ff5734 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_15 ;
    kbr:hasRuleId "R-PP-2010-94-c2c5ff5734"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "Pemungutan Pajak Penghasilan oleh pihak sebagaimana dimaksud dalam Pasal 22 ayat (1) Undang-Undang Pajak Penghasilan, dilakukan pada saat: a. pembayaran; atau b. tertentu lainnya yang diatur oleh Menteri Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_ce1c5c63bb a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_4 ;
    kbr:hasRuleId "R-PP-2010-94-ce1c5c63bb"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Disagio saham yang timbul dari selisih lebih antara nilai nominal saham dan nilai pasar saham, bukan merupakan pengurang dari penghasilan bruto."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_d4845b7293 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_27 ;
    kbr:hasRuleId "R-PP-2010-94-d4845b7293"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/27"^^xsd:string ;
    kbr:hasSourceQuote "(2) Biaya bersama bagi Wajib Pajak sebagaimana dimaksud pada ayat (1) yang tidak dapat dipisahkan dalam rangka penghitungan besarnya Penghasilan Kena Pajak, pembebanannya dialokasikan secara proporsional."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_d75cc90022 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_18 ;
    kbr:hasRuleId "R-PP-2010-94-d75cc90022"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Penghasilan atas pembayaran royalti sebagaimana dimaksud dalam Pasal 23 ayat (1) huruf a angka 3 Undang–Undang Pajak Penghasilan yang dilakukan dengan cara bagi hasil dipotong oleh pihak yang wajib membayarkan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_de440500eb a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2010_94_BT_23 ;
    kbr:hasRuleId "R-PP-2010-94-de440500eb"^^xsd:string ;
    kbr:hasSourceLocator "PP-2010-94#BT/23"^^xsd:string ;
    kbr:hasSourceQuote """(1) Pajak Penghasilan yang terutang dari Penghasilan Kena Pajak sesudah dikurangi pajak dari suatu bentuk usaha tetap di Indonesia sebagaimana dimaksud dalam Pasal 26 ayat (4) Undang-Undang Pajak Penghasilan harus dibayar lunas sebelum Surat Pemberitahuan Tahunan Pajak Penghasilan disampaikan. (2) Dalam hal Wajib Pajak bentuk usaha tetap memperpanjang jangka waktu penyampaian Surat Pemberitahuan Tahunan Pajak Penghasilan sebagaimana dimaksud pada ayat (1), Pajak Penghasilan yang terutang berdasarkan penghitungan sementara harus dibayar lunas sebelum penyampaian pemberitahuan perpanjangan jangka waktu penyampaian Surat P
emberitahuan Tahunan Pajak Penghasilan."""^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PP_2010_94_edab1b6ca6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2010_94 ;
