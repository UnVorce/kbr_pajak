    kbr:hasSourceLocator "PMK-2023-80#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "30. Pemeriksaan adalah serangkaian kegiatan menghimpun dan mengolah data, keterangan, dan/ atau bukti yang dilaksanakan secara objektif dan profesional berdasarkan suatu standar pemeriksaan untuk menguji kepatuhan pemenuhan kewajiban perpajakan dan/ atau untuk tujuan lain dalam rangka melaksanakan ketentuan peraturan perundang-undangan perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
