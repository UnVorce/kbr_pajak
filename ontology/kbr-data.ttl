    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_46 ;
    kbr:hasRuleId "R-PMK-2023-61-58834eda9e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/46"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penyitaan terhadap surat berharga milik Penanggung Pajak yang diperdagangkan di pasar modal dilaksanakan sampai dengan jumlah yang mencukupi untuk melunasi Utang Pajak dan Biaya Penagihan Pajak sesuai dengan tanggung jawab Penanggung Pajak sebagaimana dimaksud dalam Pasal 8 atau Pasal 9."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

