    kbr:hasSourceLocator "PMK-2023-96#BT/57/1..8"^^xsd:string ;
    kbr:hasSourceQuote "(2) Permohonan sebagaimana dimaksud pada ayat (1) ditolak dalam hal: a. Barang Kiriman telah dikeluarkan dari Kawasan Pabean atau tempat lain yang diperlakukan sama dengan TPS untuk diimpor untuk dipakai atau diimpor sementara; b. kesalahan data tersebut merupakan temuan Pejabat Bea dan Cukai; atau c. CN atau PIBK telah mendapatkan penetapan oleh Pejabat Bea dan Cukai dan/ atau SKP."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

