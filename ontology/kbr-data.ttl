    kbr:hasSourceLocator "PMK-2025-111#BT/10/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak dapat menyampaikan tanggapan sebagaimana dimaksud pada ayat (1) lebih dari 1 (satu) - 14 - kali, dengan memperhatikan jangka waktu penyampaian tanggapan sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
