    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_34 ;
    kbr:hasRuleId "R-PMK-2023-61-1d6999a77b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/34"^^xsd:string ;
    kbr:hasSourceQuote "Pembayaran Utang Pajak dan Biaya Penagihan Pajak dengan menggunakan harta kekayaan Penanggung Pajak yang telah diblokir sebagaimana dimaksud dalam Pasal 33 ayat (1) huruf a dilakukan dengan mengajukan permohonan kepada Pejabat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

