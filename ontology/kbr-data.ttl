    kbr:hasSourceLocator "PERDA-PROV-DKI-JAKARTA-2024-1#BT/109"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Retribusi yang tidak melaksanakan kewajiban membayar atas pelayanan yang digunakan atau dinikmati sebagaimana dimaksud dalam Pasal 66 ayat (3), sehingga merugikan keuangan daerah, diancam dengan pidana kurungan atau pidana denda sesuai dengan Undang- Undang mengenai hubungan keuangan antara pemerintah pusat dan pemerintahan daerah."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

