    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_4_1__7 ;
    kbr:hasRuleId "R-PMK-2023-96-85270d0329"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/4/1..7"^^xsd:string ;
    kbr:hasSourceQuote "c. bukti penetapan TPS atas nama PPYD atau bukti kerja sama dengan pengusaha TPS dalam hal PPYD menggunakan TPS yang diusahakan untuk umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_PMK_2023_96_85b94c8af5 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_1_p2 ;
    kbr:hasRuleId "R-PMK-2023-96-85b94c8af5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-96#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Surat adalah Barang Kiriman yang menjadi bagian dari komunikasi tertulis dengan atau tanpa sampul yang ditujukan kepada individu atau badan dengan alamat tertentu, yang dalam proses penyampaiannya dilakukan seluruhnya secara fisik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

