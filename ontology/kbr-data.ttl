    kbr:hasRuleId "R-UU-1995-11-ef2ba1cb2c"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/25"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai pemasukan atau pengeluaran barang kena cukai sebagaimana dimaksud pada ayat (1), ayat (2), dan ayat (3) diatur dengan atau berdasarkan peraturan menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_11_f4dbd71455 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_11 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_11_BT_35 ;
    kbr:hasRuleId "R-UU-1995-11-f4dbd71455"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-11#BT/35"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat bea dan cukai berwenang melakukan pemeriksaan terhadap: a. pabrik, tempat penyimpanan, atau tempat lain yang digunakan untuk menyimpan barang kena cukai dan/atau barang lainnya yang terkait dengan barang kena cukai, yang belum dilunasi cukainya atau memperoleh pembebasan cukai;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

