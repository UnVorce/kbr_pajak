    kbr:hasSourceLocator "PMK-2024-81#BT/292"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal perusahaan sebagaimana dimaksud pada ayat ( 1) huruf b dan huruf c tidak lagi dimiliki secara langsung oleh Badan U saha Milik Negara, perusahaan dimaksud tidak lagi ditunjuk sebagai Pemungut Pajak Pertambahan Nilai."^^xsd:string ;
