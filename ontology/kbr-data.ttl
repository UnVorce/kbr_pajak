kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_4c65f10e8a a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
