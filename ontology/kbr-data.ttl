kbr:Aturan_R_PMK_2023_61_145d61492e a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_38_1__2 ;
    kbr:hasRuleId "R-PMK-2023-61-145d61492e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/38/1..2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Setelah clilaksanakannya Penyitaan tetapi belum clilakukan peminclahbukuan, pencabutan sita clilakukan clalam hal: a. Penanggung Pajak telah melunasi Utang Pajak clan Biaya Penagihan Pajak yang menjacli clasar clilakukan Penyitaan sesuai clengan tanggungjawab Penanggung Pajak sebagaimana climaksucl clalam Pasal 8 atau Pasal 9; b. aclanya putusan pengaclilan atau berclasarkan putusan pengaclilan pajak; atau c. terclapat konclisi tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_14b4508cc0 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
