    kbr:hasSourceQuote "(6) Pembayaran atau penyetoran Pajak dilakukan melalui sistem pembayaran berbasis elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

