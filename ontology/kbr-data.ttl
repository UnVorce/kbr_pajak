    kbr:hasSourceQuote "Rekanan sebagaimana dimaksud dalam Pasal 291 ayat (1) wajib membuat Faktur Pajak untuk setiap penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak kepada Pemungut Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

