    kbr:hasSourceLocator "UU-1983-7#BT/8"^^xsd:string ;
    kbr:hasSourceQuote "Penghasilan suami-isteri dikenai pajak secara terpisah apabila: a. suami-isteri telah hidup berpisah berdasarkan putusan hakim; b. dikehendaki secara tertulis oleh suami-isteri berdasarkan perjanjian pemisahan harta dan penghasilan; atau c. dikehendaki oleh isteri yang memilih untuk menjalankan hak dan kewajiban perpajakannya sendiri."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_UU_1983_7_4b234d559f a kbr:Definisi ;
