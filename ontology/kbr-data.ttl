    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/83/1..9"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak dapat mengajukan keberatan kepada Gubernur terhadap SKPD, SKPDKB, SKPDKBT dan SKPDLB secara tertulis yang ditindaklanjuti dengan SKK."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_73bbb1728d a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_14 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-73bbb1728d"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "Tarif BBNKB atas penyerahan pertama kendaraan bermotor roda empat atau lebih, roda tiga, dan roda dua ditetapkan sebesar: a. 12% (dua belas persen), untuk kendaraan bermotor orang pribadi, Badan, Pemerintah, Pemerintah Daerah, TNI dan Polri; dan b. 8,80% (delapan koma delapan nol persen), untuk Kendaraan Bermotor angkutan umum."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_76647784d3 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_7 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-76647784d3"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Penerapan tarif PKB progresif tidak berlaku bagi kendaraan bukan umum yang dimiliki oleh Badan, instansi pemerintah, dan kendaraan umum."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

