    kbr:hasSourceLocator "PMK-2023-61#BT/67/9"^^xsd:string ;
    kbr:hasSourceQuote "(9) Berita acara pelaksanaan Penyarideraan sebagaimana dimaksud pada ayat (7) huruf a dan berita acara penempatan atau penitipan sandera sebagaimana dimaksud pada ayat (7) huruf b paling sedikit memuat: a. nomor dan tanggal surat perintah Penyanderaan; b. izin tertulis Menteri; c. identitas Jurusita Pajak; d. identitas Penanggung Pajak yang disandera; e. tempat Penyanderaan; f. lamanya Penyanderaan; dan g. identitas saksi pelaksanaan Penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

