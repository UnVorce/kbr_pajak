kbr:Aturan_R_PP_2017_34_a465bbabaa a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2017_34 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2017_34_BT_3 ;
    kbr:hasRuleId "R-PP-2017-34-a465bbabaa"^^xsd:string ;
    kbr:hasSourceLocator "PP-2017-34#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Atas penghasilan sebagaimana dimaksud dalam Pasal 2 ayat (1) yang diterima atau diperoleh dari Penyewa yang bertindak atau ditunjuk sebagai Pemotong Pajak Penghasilan, wajib dipotong Pajak Penghasilan oleh Penyewa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

kbr:Aturan_R_PP_2017_34_bcb446b0c8 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2017_34 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2017_34_BT_4 ;
    kbr:hasRuleId "R-PP-2017-34-bcb446b0c8"^^xsd:string ;
    kbr:hasSourceLocator "PP-2017-34#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Nilai Bangunan sebagaimana dimaksud pada ayat (3) ditentukan berdasarkan nilai yang tertinggi antara nilai pasar dan nilai jual objek pajak Bangunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

kbr:Aturan_R_PP_2017_34_c72a9e8c9d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2017_34 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2017_34_BT_3 ;
    kbr:hasRuleId "R-PP-2017-34-c72a9e8c9d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2017-34#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "Pemotong pajak sebagaimana dimaksud pada ayat (1) meliputi badan pemerintah, subjek pajak badan daiam negeri, penyelenggara kegiatan, bentuk usaha tetap, kerja sama operasi, perwakilan perusahaan luar negeri lainnya, dan orang pribadi sebagai wajib pajak dalam negeri yang ditunjuk oleh Direktur Jenderal Pajak, Kementerian Keuangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

kbr:Aturan_R_PP_2017_34_d474f43225 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2017_34 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2017_34_BT_5_3 ;
    kbr:hasRuleId "R-PP-2017-34-d474f43225"^^xsd:string ;
    kbr:hasSourceLocator "PP-2017-34#BT/5/3"^^xsd:string ;
    kbr:hasSourceQuote "a. Penghasilan atas pelaksanaan sewa yang telah dimulai sebelum berlakunya Peraturan Pemerintah ini, dikenai Pajak Penghasilan berdasarkan Pasal 17 Undang-Undang Nomor 7 Tahun 1983 tentang Pajak Penghasilan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 36 Tahun 2008 tentang Perubahan Keempat atas Undang- Undang Nomor 7 Tahun 1983 tentang Pajak Penghasilan sampai dengan berakhirnya jangka waktu sewa sesuai perjanjian sewa tersebut;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

kbr:Aturan_R_PP_2017_34_fac78fb711 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2017_34 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2017_34_BT_4 ;
    kbr:hasRuleId "R-PP-2017-34-fac78fb711"^^xsd:string ;
    kbr:hasSourceLocator "PP-2017-34#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Jumlah bruto nilai persewaan tanah dan/atau Bangunan sebagaimana dimaksud pada ayat (1) merupakan semua jumlah yang dibayarkan atau yang diakui sebagai utang oleh Penyewa dengan nama dan dalam bentuk apapun yang berkaitan dengan tanah dan/atau Bangunan yang disewa termasuk biaya perawatan, biaya pemeliharaan, biaya keamanan, biaya layanan, dan biaya fasilitas lainnya, baik yang perjanjiannya dibuat secara terpisah maupun yang disatukan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

