kbr:Aturan_R_PMK_2024_81_dafb109361 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_61_1__5 ;
    kbr:hasRuleId "R-PMK-2024-81-dafb109361"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/61/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Selain harus memenuhi ketentuan sebagaimana dimaksud pada ayat (4), Pengusaha yang menyediakan jasa Kantor Virtual harus memiliki: a. dokumen yang menunjukkan adanya kontrak, perjanjian, atau dokumen sejenis yang masih berlaku antara Pengusaha yang menyediakan jasa Kantor Virtual dan Pengusaha; dan b. dokumen yang menunjukkan adanya pemberian izin, keterangan usaha, atau keterangan kegiatan dari pejabat atau instansi yang berwenang, yaitu nomor induk berusaha atau dokumen lain yang seJen1s."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_db5d355d75 a kbr:Definisi ;
