kbr:Aturan_R_PMK_2023_61_35964ff7c1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_1_p1 ;
    kbr:hasRuleId "R-PMK-2023-61-35964ff7c1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "9. Pejabat adalah pejabat yang berwenang mengangkat dan memberhentikan jurusita Pajak, menerbitkan surat perintah penagihan seketika dan sekaligus, surat paksa, surat perintah melaksanakan penyitaan, surat pencabutan sita, pengumuman lelang, surat penentuan harga limit, pembatalan lelang, surat perintah - jdih.kemenkeu.go.id -4- penyanderaan, dan surat lain yang diperlukan untuk penagihan Pajak sehubungan dengan Penanggung Pajak tidak melunasi sebagian atau seluruh utang Pajak menurut undang-undang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_369379f8d5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_57 ;
    kbr:hasRuleId "R-PMK-2023-61-369379f8d5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/57"^^xsd:string ;
    kbr:hasSourceQuote "(1) Menteri menyampaikan Keputusan Menteri mengenai Pencegahan sebagaimana dimaksud dalam Pasal 56 kepada menteri yang menyelenggarakan urusan pemerintahan di bidang hukum dan hak asasi manusia paling lambat 3 (tiga) Hari sejak tanggal keputusan Menteri ditetapkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_36ad123180 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_146 ;
    kbr:hasRuleId "R-PMK-2023-61-36ad123180"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/146"^^xsd:string ;
    kbr:hasSourceQuote "a. Direktur Jenderal Pajak dapat memberikan rekomendasi dan/ atau mengajukan permohonan pembatasan atau pemblokiran layanan publik tertentu terhadap Penanggung Pajak yang tidak melunasi Utang Pajak dan Biaya Penagihan Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

