    kbr:diaturDalam kbr:Reg_PP_2022_44 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_44_BT_13 ;
    kbr:hasRuleId "R-PP-2022-44-1beb3b1272"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-44#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan mengenai kriteria dan/ atau rincian barang dan jasa yang termasuk dalam jenis barang dan jenis jasa yang tidak dikenai Pajak Pertambahan Nilai sebagaimana dimaksud pada ayat (1) diatur dengan Peraturan Menteri."^^xsd:string ;
