kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_8c4adee3ec a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
