    kbr:hasSourceQuote "Pendapatan bersih mineral atau batubara sebagaimana dimaksud dalam Pasal 21 ayat (7) huruf b merupakan pendapatan kotor mineral atau batubara dikurangi biaya produksi mineral atau batubara."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

