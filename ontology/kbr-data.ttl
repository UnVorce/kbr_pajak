    kbr:hasRuleId "R-PMK-2024-136-8a872407b6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "Pemilihan sebagaimana dimaksud pada ayat (1) dapat dilakukan oleh perusahaan asuransi bersama (mutual insurance companies) sehubungan dengan entitas investasi dan entitas investasi asuransi yang dikendalikannya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

