    kbr:hasSourceLocator "PMK-2024-81#BT/326"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Pertambahan Nilai sebagaimana dimaksud dalam Pasal 323 ayat (1) wajib disetor ke Kas Negara dengan menggunakan Surat Setoran Pajak atau sarana administrasi lain yang disamakan dengan Surat Setoran Pajak paling lambat tanggal 15 (lima belas) bulan berikutnya setelah berakhirnya Masa Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

