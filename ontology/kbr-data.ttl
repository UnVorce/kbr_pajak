    kbr:hasSourceQuote "Subjek PKB merupakan orang pribadi atau Badan yang memiliki dan/atau menguasai Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

