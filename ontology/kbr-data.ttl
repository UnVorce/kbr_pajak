    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_31 ;
    kbr:hasRuleId "R-UU-1983-6-6a9dff9c6f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "kewajiban menyampaikan surat pemberitahuan hasil pemeriksaan kepada Wajib Pajak, dan hak Wajib Pajak untuk hadir dalam pembahasan akhir hasil pemeriksaan dalam batas waktu yang ditentukan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_6ae598f29f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_3_1__3b ;
    kbr:hasRuleId "R-UU-1983-6-6ae598f29f"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/3/1..3b"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak dengan kriteria tertentu dapat melaporkan beberapa Masa Pajak dalam 1 (satu) Surat Pemberitahuan Masa."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_6b94cf8534 a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_36A ;
    kbr:hasRuleId "R-UU-1983-6-6b94cf8534"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/36A"^^xsd:string ;
    kbr:hasSourceQuote "Pegawai pajak yang dalam melakukan tugasnya dengan sengaja bertindak di luar kewenangannya yang diatur dalam ketentuan peraturan perundang-undangan perpajakan, dapat diadukan ke unit internal Departemen Keuangan yang berwenang melakukan pemeriksaan dan investigasi dan apabila terbukti melakukannya dikenai sanksi sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_6e83174dfb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_1_p1 ;
    kbr:hasRuleId "R-UU-1983-6-6e83174dfb"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "6. Nomor Pokok Wajib Pajak adalah nomor yang diberikan kepada Wajib Pajak sebagai sarana dalam administrasi perpajakan yang dipergunakan sebagai tanda pengenal diri atau identitas Wajib Pajak dalam melaksanakan hak dan kewajiban perpajakannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_705f97cccc a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_2_6__10 ;
    kbr:hasRuleId "R-UU-1983-6-705f97cccc"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/2/6..10"^^xsd:string ;
    kbr:hasSourceQuote "(7) Direktur Jenderal Pajak setelah melakukan pemeriksaan harus memberikan keputusan atas permohonan penghapusan Nomor Pokok Wajib Pajak dalam jangka waktu 6 (enam) bulan untuk Wajib Pajak orang pribadi atau 12 (dua belas) bulan untuk Wajib Pajak badan, sejak tanggal permohonan diterima secara lengkap."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_717440c99f a kbr:Definisi ;
