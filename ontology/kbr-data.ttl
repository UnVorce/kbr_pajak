    kbr:hasSourceQuote "Detail rincian objek atas pelayanan yang diberikan oleh BLUD sebagaimana dimaksud pada ayat (5), diatur dalam Peraturan Gubernur sesuai dengan ketentuan peraturan perundang- undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_DKI_JAKARTA_2024_1_b040a32aae a kbr:Definisi ;
