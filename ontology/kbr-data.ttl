    kbr:hasSourceQuote "Hak atas Tanah dan/atau Bangunan adalah hak atas tanah, termasuk hak pengelolaan, beserta Bangunan di atasnya, sebagaimana dimaksud dalam Undang-Undang di bidang pertanahan dan Bangunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

