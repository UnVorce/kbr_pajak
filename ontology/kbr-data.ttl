kbr:Aturan_R_UU_1995_10_e0f4c900b5 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_18 ;
    kbr:hasRuleId "R-UU-1995-10-e0f4c900b5"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Bea Masuk Antidumping dikenakan terhadap barang impor dalam hal : a. harga ekspor dari barang tersebut lebih rendah dari nilai normalnya; dan b. impor barang tersebut : 1. menyebabkan kerugian terhadap industri dalam negeri yang memproduksi barang sejenis dengan barang tersebut; 2. mengecam terjadinya kerugian terhadap industri dalam negeri yang memproduksi barang sejenis dengan barang tersebut; dan 3. menghalangi pengembangan industri barang sejenis di dalam negeri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_e1fbdc775b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_79 ;
    kbr:hasRuleId "R-UU-1995-10-e1fbdc775b"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/79"^^xsd:string ;
    kbr:hasSourceQuote "Persyaratan dapat diterimanya segel atau tanda pengamannya sebagaimana dimaksud pada ayat (1) ditetapkan oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_e2656a2c3e a kbr:Kewajiban ;
