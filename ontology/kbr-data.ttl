    kbr:hasSourceQuote "b. dasar penyusutan dan amortisasi dipercepat yakni: 1. harga perolehan Aktiva Tetap Berwujud bagi Wajib Pajak yang menggunakan metode penyusutan garis lurus; atau 2. nilai sisa buku Aktiva Tetap Berwujud bagi Wajib Pajak yang menggunakan metode penyusutan saldo menurun;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
