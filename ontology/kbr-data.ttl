    kbr:hasSourceQuote "(6) Keberatan yang tidak memenuhi persyaratan sebagaimana dimaksud pada ayat (1), ayat (2), ayat (3), dan ayat (5) tidak dianggap sebagai surat keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

