    kbr:hasSourceQuote "Dalam hal keputusan sebagaimana dimaksud pada ayat (2) tidak diterbitkan setelah melampaui jangka waktu 3 (tiga) bulan, permohonan Wajib Pajak dianggap disetujui."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
