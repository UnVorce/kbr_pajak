    kbr:hasRuleId "R-PERDA-KOTA-SURABAYA-2023-7-8665b26067"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/112"^^xsd:string ;
    kbr:hasSourceQuote "(3) Detail rincian objek Retribusi yang diatur dalam Peraturan Walikota sebagaimana dimaksud pada ayat (2) dilaksanakan dengan ketentuan: a. tidak bertentangan dengan peraturan perundang- undangan yang lebih tinggi; b. tidak menghambat iklim investasi di Daerah; dan c. tidak menimbulkan ekonomi biaya tinggi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_87412c5c55 a kbr:AturanTarif ;
