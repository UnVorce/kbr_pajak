kbr:Aturan_R_UU_1983_6_79147f3cc1 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_UU_1983_6 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1983_6_BT_27B_1__7 ;
