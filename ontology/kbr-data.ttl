    kbr:hasSourceLocator "PP-2022-50#BT/8/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(5) Surat Setoran Pajak sebagaimana dimaksud pada ayat (2) huruf b diperhitungkan sebagai kredit pajak dalam Surat Ketetapan Pajak yang diterbitkan berdasarkan hasil Pemeriksaan sebagaimana dimaksud pada ayat (3) dan ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_9feb93e3df a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_68 ;
    kbr:hasRuleId "R-PP-2022-50-9feb93e3df"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/68"^^xsd:string ;
    kbr:hasSourceQuote "Menteri mendelegasikan kepada Direktur Jenderal Pajak untuk menerima dan meminta Data Kependudukan dan Data Balikan dari Pengguna sebagaimana dimaksud pada ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_a01e701bec a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_49 ;
    kbr:hasRuleId "R-PP-2022-50-a01e701bec"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal Wajib Pajak tidak menyetujui sebagian atau seluruh jumlah pajak yang masih harus dibayar dalam Pembahasan Akhir Hasil Pemeriksaan dan Wajib Pajak tidak mengajukan keberatan, Surat Teguran sebagaimana dimaksud pada ayat (1) disampaikan setelah 7 (tujuh) hari terhitung sejak saat jatuh tempo pengajuan keberatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

