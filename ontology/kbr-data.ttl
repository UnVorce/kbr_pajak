kbr:Aturan_R_PMK_2023_48_aeb6491766 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2023_48 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_48_BT_21 ;
    kbr:hasRuleId "R-PMK-2023-48-aeb6491766"^^xsd:string ;
