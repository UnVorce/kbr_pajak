    kbr:hasSourceQuote "b. untuk Kepemilikan dan/atau Penguasaan Kendaraan Bermotor di atas 200cc, ditetapkan sebesar 1,2% (satu koma dua persen)"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_APPROVED"^^xsd:string ;
