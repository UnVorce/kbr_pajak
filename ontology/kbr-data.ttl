    kbr:hasRuleId "R-UU-1983-6-333f633783"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "(1d) Apabila jangka waktu sebagaimana dimaksud pada ayat (1c) telah lewat tetapi Direktur Jenderal Pajak tidak memberi suatu keputusan, permohonan Wajib Pajak sebagaimana dimaksud pada ayat (1) dianggap dikabulkan."^^xsd:string ;
