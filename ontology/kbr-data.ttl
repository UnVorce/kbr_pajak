    kbr:hasSourceQuote "Pemeriksaan Pajak dan/atau Retribusi sebagaimana dimaksud pada ayat (1) bertujuan untuk memastikan bahwa Wajib Pajak dan/atau Wajib Retribusi yang mengajukan permohonan insentif fiskal berhak untuk menerima insentif fiskal sesuai dengan pertimbangan dan faktor sebagaimana dimaksud dalam Pasal 173 ayat (3) dan ayat (5)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

