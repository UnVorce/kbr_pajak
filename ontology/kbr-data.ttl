    kbr:hasRuleId "R-PMK-2025-50-c61755b5a2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-50#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "Pemanfaat jasa sebagaimana dimaksud dalam Pasal 18 ayat (2) merupakan orang pribadi atau badan yang memenuhi kriteria: a. bertempat tinggal atau bertempat kedudukan di Indonesia; b. melakukan pembayaran menggunakan fasilitas debit, kredit, dan/atau fasilitas pembayaran lainnya yang disediakan oleh institusi di Indonesia; dan/atau c. bertransaksi dengan menggunakan alamat internet protocol di Indonesia atau menggunakan nomor telepon dengan kode telepon negara Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

