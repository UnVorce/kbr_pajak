    kbr:hasRuleId "R-PP-2022-50-6c57bd4f01"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/51"^^xsd:string ;
    kbr:hasSourceQuote "Seorang kuasa yang ditunjuk sebagaimana dimaksud pada ayat (1) harts mempunyai kompetensi tertentu dalam aspek perpajakan, kecuali keluarga."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_6c65cbd3ca a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p2 ;
    kbr:hasRuleId "R-PP-2022-50-6c65cbd3ca"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "26. Surat Keputusan Pembatalan Ketetapan Pajak adalah surat keputusan mengenai pembatalan ketetapan pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_6d5cb4f52c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_66 ;
    kbr:hasRuleId "R-PP-2022-50-6d5cb4f52c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak dalam melaksanakan hak dan memenuhi kewajiban perpajakan dapat dilakukan secara elektronik dan menggunakan tanda tangan elektronik sesuai dengan ketentuan peraturan perundang-undangan mengenai informasi dan transaksi elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_6ef6e3007b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p2 ;
    kbr:hasRuleId "R-PP-2022-50-6ef6e3007b"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "27. Surat Keputusan Pengembalian Pendahuluan Kelebihan Pajak adalah surat keputusan yang menentukan jumlah pengembalian pendahuluan kelebihan pajak untuk Wajib Pajak tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_6ff401651d a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_69_8__9 ;
    kbr:hasRuleId "R-PP-2022-50-6ff401651d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/69/8..9"^^xsd:string ;
    kbr:hasSourceQuote "(8) Wajib Pajak yang melakukan aktivitas yang menghasilkan emisi karbon sebagaimana dimaksud pada ayat (3) dengan kriteria tertentu, dikecualikan dari kewajiban melaporkan Surat Pemberitahuan sebagaimana dimaksud pada ayat (s)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_731a55ab39 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_61 ;
    kbr:hasRuleId "R-PP-2022-50-731a55ab39"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/61"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal hasil Penyidikan dinyatakan sudah lengkap oleh penuntut umum, penyerahan tanggung jawab tersangka dan barang bukti dari Penyidik kepada penuntut umum dapat dilakukan tanpa kehadiran tersangka apabila: a. tersangka telah dipanggil secara sah dan tidak hadir tanpa memberikan alasan yang patut dan wajar; dan b. Penyidik telah melakukan tindakan sebagaimana dimaksud pada ayat (5)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_737337b95f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_15 ;
    kbr:hasRuleId "R-PP-2022-50-737337b95f"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/15"^^xsd:string ;
    kbr:hasSourceQuote "(U Direktur Jenderal Pajak wajib menyampaikan hasil Pemeriksaan melalui surat pemberitahuan hasil Pemeriksaan kepada Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_7411617948 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_38_3__9 ;
    kbr:hasRuleId "R-PP-2022-50-7411617948"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/38/3..9"^^xsd:string ;
    kbr:hasSourceQuote "(9) Tata cara pengurangan, penghapusan, dan pembatalan sebagaimana dimaksud pada ayat (1) dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_74f2ca56f1 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_49 ;
    kbr:hasRuleId "R-PP-2022-50-74f2ca56f1"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "(6) Dalam hal Wajib Pajak tidak menyetujui sebagian atau seluruh jumlah pajak yang masih harus dibayar dalam Pembahasan Akhir Hasil Pemeriksaan dan Wajib Pajak mengajukan permohonan banding atas keputusan keberatan, Surat Teguran sebagaimana dimaksud pada ayat (1) disampaikan setelah 7 (tujuh) hari terhitung sejak saat jatuh tempo pelunasan pajak yang masih harus dibayar berdasarkan Putusan Banding."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_7723b8061b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_17_1 ;
    kbr:hasRuleId "R-PP-2022-50-7723b8061b"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/17/1"^^xsd:string ;
    kbr:hasSourceQuote "Pemeriksaan yang ditangguhkan sebagaimana dimaksud pada ayat (1) dilanjutkan jika: a. Pemeriksaan Bukti Permulaan dihentikan karena: 1. tidak ditemukan adanya bukti permulaan tindak pidana di bidang perpajakan; 2. peristiwa bukan merrrpakan tindak pidana di bidang perpajakan; atau 3. Wajib... 3. Wajib Pajak orang pribadi yang dilakukan Pemeriksaan Bukti Permulaan meninggal dunia; b. Penyidikan dihentikan: 1. karena tidak terdapat cukup bukti; 2. karena peristiwa bukan merupakan tindak pidana di bidang perpajakan; atau 3. demi hukum karena terhadap perkara yang sama tidak dapat diadili untuk kedua kalinya (nebis in ideml atau tersangka meninggal dunia; atau c. terdapat putusan pengadilan atas tindak pidana di bidang perpajakan yang telah mempunyai kekuatan hukum tetap yang memutus bebas atau lepas dari segala tuntutan hukum dan salinan putrrsan pengadilan tersebut telah diterima oleh Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_77773c1f82 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_8_6 ;
    kbr:hasRuleId "R-PP-2022-50-77773c1f82"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/8/6"^^xsd:string ;
    kbr:hasSourceQuote "Surat Setoran Pajak sebagaimana dimaksud pada ayat (2) huruf c merupakan bukti pembayaran sanksi administratif terkait dengan pengungkapan ketidakbenaran pengisian Surat Pemberitahuan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_77bbce3fc2 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_60 ;
    kbr:hasRuleId "R-PP-2022-50-77bbce3fc2"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "(2) Bukti permulaan sebagaimana dimaksud pada ayat (1) berasal dari kegiatan: a. Pemeriksaan Bukti Permulaan; b. penanganan tindak pidana yang diketahui seketika; atau c. pengembangan Penyidikan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_7874a601b7 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_36 ;
    kbr:hasRuleId "R-PP-2022-50-7874a601b7"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/36"^^xsd:string ;
    kbr:hasSourceQuote "Atas sanksi administratif sebagaimana dimaksud pada ayat (1), diterbitkan Surat Tagihan Pajak paling lama 2 (dua) tahun sejak tanggal diterima Putusan Peninjauan Kembali oleh Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_7a99e88c0e a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_6_6__8 ;
    kbr:hasRuleId "R-PP-2022-50-7a99e88c0e"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/6/6..8"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan lebih lanjut mengenai tata cara pembetulan Surat Pemberitahuan Tahunan diatur dalam Peraturan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_7b52d23e3c a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_28 ;
    kbr:hasRuleId "R-PP-2022-50-7b52d23e3c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/28"^^xsd:string ;
    kbr:hasSourceQuote "(2) Surat Keputusan Pengembalian Pendahuluan Kelebihan Pajak sebagaimana dimaksud pada ayat (1) diterbitkan paling lama: a. 3 (tiga) bulan sejak permohonan diterima secara lengkap untuk Pajak Penghasilan; atau b. 1 (satu) bulan sejak permohonan diterima secara lengkap untuk Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_7c6d489afa a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_66 ;
    kbr:hasRuleId "R-PP-2022-50-7c6d489afa"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/66"^^xsd:string ;
    kbr:hasSourceQuote "Tanda tangan elektronik sebagaimana dimaksud pada ayat (1) meliputi tanda tangan elektronik tersertifikasi dan tanda tangan elektronik tidak tersertifikasi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_7ca113fd50 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_22 ;
    kbr:hasRuleId "R-PP-2022-50-7ca113fd50"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Jumlah pajak yang tidak atau kurang dibayar dalam Surat Ketetapan Pajak Kurang Bayar Tambahan sebagaimana dimaksud dalam Pasal 21 ayat (1) huruf a ditambah sanksi administratif berupa kenaikan sebesar LOO%o (seratus persen) dari jumlah pajak yang tidak atau kurang dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

