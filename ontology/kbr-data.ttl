    kbr:hasSourceQuote "Apabila Direktur Jenderal Pajak mendapatkan bukti jumlah pajak yang terutang menurut Surat Pemberitahuan sebagaimana dimaksud pada ayat (2) tidak benar, Direktur Jenderal Pajak menetapkan jumlah pajak yang terutang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

