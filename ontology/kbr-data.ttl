    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/50"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal penetapan tarif hanya memperhatikan biaya penyediaan jasa sebagaimana dimaksud pada ayat (1), penetapan tarif hanya untuk menutup sebagian biaya sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_fa2dfa3013 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_1_p2 ;
