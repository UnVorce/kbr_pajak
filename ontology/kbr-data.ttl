    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/108"^^xsd:string ;
    kbr:hasSourceQuote "Ketentuan mengenai insentif pemungutan Pajak dan Retribusi sebagaimana diatur dalam Pasal 92, hanya dapat dilaksanakan sampai dengan diberlakukannya pengaturan mengenai penghasilan aparatur sipil negara yang telah mempertimbangkan kelas jabatan untuk tugas dan fungsi pemungutan Pajak dan Retribusi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

