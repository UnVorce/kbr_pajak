    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_18 ;
    kbr:hasRuleId "R-UU-1985-12-3e2790c0e1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Hasil penerimaan pajak merupakan penerimaan negara yang dibagi antara Pemerintah Pusat dan Pemerintah Daerah dengan imbangan pembagian sekurang-kurangnya 90% (sembilan puluh persen) untuk Pemerintah Daerah Tingkat II dan Pemerintah Daerah Tingkat I sebagai pendapatan daerah yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

