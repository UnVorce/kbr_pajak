    kbr:hasSourceQuote "Penghapusan Nomor Pokok Wajib Pajak secarajabatan sebagaimana dimaksud dalam Pasal 56 ayat (1) dilakukan Kepala Kantor Pelayanan Pajak berdasarkan data dan/ atau informasi perpajakan yang dimiliki atau diperoleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

