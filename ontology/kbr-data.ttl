    kbr:hasSourceLocator "PMK-2024-136#BT/8/1..6"^^xsd:string ;
    kbr:hasSourceQuote "e. 7,2% (tujuh koma dua persen) untuk Tahun Pajak 2027;"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
