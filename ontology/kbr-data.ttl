    kbr:hasRuleId "R-PP-2022-55-abe5cfcebc"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-55#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "Hubungan istimewa sebagaimana dimaksud dalam Pasal 32 ayat (3) merupakan keadaan ketergantungan atau keterikatan satu pihak dengan pihak lainnya yang disebabkan oleh: a. kepemilikan atau penyertaan modal; b. penguasaan; atau c. hubungan keluarga sedarah atau semenda, yang mengakibatkan pihak satu dapat mengendalikan pihak yang lain atau tidak berdiri bebas dalam menjalankan usaha atau melakukan kegiatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

