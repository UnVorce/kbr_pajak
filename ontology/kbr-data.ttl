    kbr:hasSourceLocator "UU-1995-10#BT/52"^^xsd:string ;
    kbr:hasSourceQuote "(2) Orang yang tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 51 ayat (1), ayat (2), atau ayat (3) dikenai sanksi administrasi berupa denda sebesar Rp25.000.000,00 (dua puluh lima juta rupiah)"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
