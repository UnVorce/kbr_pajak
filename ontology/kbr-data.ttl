    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_56 ;
    kbr:hasRuleId "R-PMK-2023-61-d74b8084dd"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/56"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pejabat mengajukan permintaan Pencegahan sebagaimana dimaksud dalam Pasal 55 kepada Menteri. (2) Atas permintaan Pencegahan sebagaimana dimaksud pada ayat (1), Menteri menetapkan keputusan Menteri mengenai Pencegahan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_d78d6d9bfe a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_23 ;
    kbr:hasRuleId "R-PMK-2023-61-d78d6d9bfe"^^xsd:string ;
