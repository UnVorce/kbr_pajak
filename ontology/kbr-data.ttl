    kbr:diaturDalam kbr:Reg_PMK_2025_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_15_BT_22_1__5 ;
    kbr:hasRuleId "R-PMK-2025-15-890178281c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-15#BT/22/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dikecualikan dari pengaturan sebagaimana dimaksud pada ayat (1), Surat Pemberitahuan Objek Pajak tidak dapat dilakukan pengungkapan ketidakbenaran - 40 - sebagaimana diatur dalam Pasal 8 ayat (4) Undang- Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

