    kbr:hasSourceLocator "PMK-2023-96#BT/58/1..7"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penyelenggara Pos dapat mengajukan permohonan perubahan atas kesalahan data CN sebagaimana dimaksud dalam Pasal 43 dan/atau pemberitahuan konsolidasi barang kiriman (PKBK) sebagaimana dimaksud dalam Pasal 49 ayat (1) ke Kantor Pabean pemuatan ekspor melalui SKP."^^xsd:string ;
