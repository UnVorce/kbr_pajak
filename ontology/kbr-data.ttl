    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/60"^^xsd:string ;
    kbr:hasSourceQuote "Jenis pelayanan yang merupakan objek Retribusi Perizinan Tertentu sebagaimana dimaksud dalam Pasal 46 ayat (1) huruf c, yaitu Retribusi perpanjangan pengesahan rencana penggunaan tenaga kerja asing."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_e637c5a217 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_20 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-e637c5a217"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "(1) Besaran pokok PAB yang terutang dihitung dengan cara mengalikan dasar pengenaan PAB sebagaimana dimaksud dalam Pasal 18 ayat (1) dengan tarif PAB sebagaimana dimaksud dalam Pasal 19."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_e66100b9a9 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_7_1__6 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-e66100b9a9"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/7/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(6) Bobot sebagaimana dimaksud pada ayat (1) huruf b, dinyatakan dalam koefisien, dengan ketentuan sebagai berikut: a. koefisien sama dengan 1 (satu) berarti kerusakan jalan dan/atau pencemaran lingkungan oleh penggunaan Kendaraan Bermotor tersebut dianggap masih dalam batas toleransi; dan b. koefisien lebih besar dari 1 (satu) berarti kerusakan jalan dan/atau pencemaran lingkungan oleh penggunaan Kendaraan Bermotor tersebut dianggap melewati batas toleransi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_eaea3fe541 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_29 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-eaea3fe541"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "(6) Besaran nilai perolehan Air Permukaan sebagaimana dimaksud pada ayat (1), ditetapkan dengan Peraturan Gubernur dengan berpedoman pada ketentuan yang ditetapkan oleh menteri yang menyelenggarakan urusan pemerintahan di bidang pekerjaan umum."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_eb791033f6 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_26 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-eb791033f6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/26"^^xsd:string ;
    kbr:hasSourceQuote "(2) Saat terutang PBBKB ditetapkan pada saat terjadinya penyerahan BBKB oleh penyedia BBKB."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_ed94bea79f a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_77 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-ed94bea79f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "Untuk kepentingan pemeriksaan di pengadilan dalam perkara pidana atau perdata, atas permintaan hakim sesuai dengan hukum acara pidana dan hukum acara perdata, Gubernur dapat memberikan izin tertulis kepada Pejabat sebagaimana dimaksud pada ayat (1), dan tenaga ahli sebagaimana dimaksud pada ayat (2), untuk memberikan dan memperlihatkan bukti tertulis dan keterangan Wajib Pajak yang ada padanya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_eda70286a6 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_BALI_2024_1_BT_77 ;
    kbr:hasRuleId "R-PERDA-PROV-BALI-2024-1-eda70286a6"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-BALI-2024-1#BT/77"^^xsd:string ;
    kbr:hasSourceQuote "Untuk kepentingan daerah, Gubernur berwenang memberikan izin tertulis kepada Pejabat sebagaimana dimaksud pada ayat (1) dan tenaga ahli sebagaimana dimaksud pada ayat (2), agar memberikan keterangan, memperlihatkan bukti tertulis dari atau tentang Wajib Pajak kepada pihak yang ditunjuk."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_BALI_2024_1_ee6cdb2a4c a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_BALI_2024_1 ;
