    kbr:hasSourceLocator "PMK-2024-136#BT/56/12..15"^^xsd:string ;
    kbr:hasSourceQuote "(13) Dalam hal Grup PMN tidak memenuhi pengujian tertentu sebagaimana dimaksud pada ayat (3) pada suatu Tahun Pajak dalam periode tertentu sebagaimana dimaksud pada ayat (2), Grup PMN dapat menerapkan ketentuan permanent safe harbour."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

