kbr:Aturan_R_PMK_2023_96_d105efb6f8 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2023_96 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_96_BT_64 ;
