    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_82 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-57ba737f87"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/82"^^xsd:string ;
    kbr:hasSourceQuote "a. mengisi dan menandatangani formulir permohonan pencabutan Surat Keterangan Terdaftar Objek Pajak Pajak Bumi dan Bangunan; dan b. mengunggah salinan digital dokumen sebagaimana dimaksud dalam Pasal  81 ayat (4)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
