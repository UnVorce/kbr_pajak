    kbr:hasRuleId "R-UU-1983-6-e3e83dd6af"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/32A/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(5) Permintaan hakim sebagaimana dimaksud pada ayat (4) harus menyebutkan nama tersangka atau nama tergugat, keterangan yang diminta, serta kaitan antara perkara pidana atau perdata yang bersangkutan dengan keterangan yang diminta."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

