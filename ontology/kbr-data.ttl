    kbr:hasSourceQuote "untuk mendapatkan penetapan tempat sebagai Kawasan Berikat dan izin penyelenggara Kawasan Berikat sebagaimana dimaksud pada ayat (1), pihak yang akan menjadi penyelenggara Kawasan Berikat harus memenuhi persyaratan sebagai berikut:"^^xsd:string ;
