kbr:Aturan_R_UU_1985_12_2356065326 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_30 ;
    kbr:hasRuleId "R-UU-1985-12-2356065326"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/30"^^xsd:string ;
    kbr:hasSourceQuote "Terhadap obyek pajak dalam bidang penambangan minyak dan gas bumi serta dalam bidang penambangan lainnya, sehubungan dengan Kontrak Karya dan Kontrak Bagi Hasil yang masih berlaku pada saat berlakunya Undang-undang ini, tetap dikenakan Iuran Pembangunan Daerah (Ipeda) berdasarkan ketentuan-ketentuan dalam perjanjian Kontrak Karya dan Kontrak Bagi Hasil yang masih berlaku."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_2f0e8778c4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_29 ;
    kbr:hasRuleId "R-UU-1985-12-2f0e8778c4"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "Dengan berlakunya Undang-undang ini, peraturan pelaksanaan yang telah ada di bidang luran Pembangunan Daerah (ipeda) berdasarkan Undang-undang Nomor 11 Prp Tahun 1959 tentang Pajak Hasil Bumi, tetap berlaku sampai dengan tanggal 31 Desember 1990 sepanjang tidak bertentangan dan belum diatur dengan peraturan pelaksanaan yang baru berdasarkan Undang- undang ini."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_1985_12_353e73d494 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1985_12 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1985_12_BT_20 ;
    kbr:hasRuleId "R-UU-1985-12-353e73d494"^^xsd:string ;
    kbr:hasSourceLocator "UU-1985-12#BT/20"^^xsd:string ;
    kbr:hasSourceQuote "Atas permintaan wajib pajak Direktur Jenderal Pajak dapat mengurangkan denda administrasi karena hal-hal tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

