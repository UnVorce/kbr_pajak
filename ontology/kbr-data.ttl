    kbr:hasRuleId "R-PMK-2024-81-1f271869f5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/379/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha yang ticlak membuat Faktur Pajak atas penyerahan Barang Kena Pajak clan/atau Jasa Kena Pajak sebelum Pengusaha clikukuhkan sebagai jdih.kemenkeu.go.id -254 - Pengusaha Kena Pajak tidak memenuhi ketentuan sebagaimana diatur dalam Pasal 14 ayat (1) huruf d Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan dan tidak dikenai sanksi administratif sebagaimana diatur dalam Pasal 14 ayat (4) Undang­ Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_1f3267b8ba a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_170 ;
    kbr:hasRuleId "R-PMK-2024-81-1f3267b8ba"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/170"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak Badan yang memiliki kewajiban penyampaian Surat Pemberitahuan Tahunan Pajak Penghasilan untuk Bagian Tahun Pajak, wajib menyampaikan Surat Pemberitahuan tersebut paling lama 4 (empat) bulan setelah akhir Bagian Tahun Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

