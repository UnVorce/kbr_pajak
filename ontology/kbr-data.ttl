    kbr:hasSourceLocator "PMK-2024-81#BT/308"^^xsd:string ;
    kbr:hasSourceQuote "Anak usaha PT Pertamina (Persero) sebagaimana dimaksud pada ayat (1) huruf c meliputi PT Pertamina Patra Niaga, PT Kilang Pertamina Internasional, PT Elnusa Petrofin, dan anak usaha PT Pertamina (Persero) lainnya yang ditunjuk untuk menjalankan fungsi penjualan dan/atau distribusi bahan bakar minyak dan/atau bahan bakar bukan minyak"^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

