kbr:Aturan_R_PMK_2024_81_35c225e5c2 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_430 ;
    kbr:hasRuleId "R-PMK-2024-81-35c225e5c2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/430"^^xsd:string ;
    kbr:hasSourceQuote "Pembebanan pengurangan penghasilan neto sebagaimana dimaksud dalam Pasal 423 ayat (1) tidak dapat dilakukan, dalam hal: a. Kegiatan Usaha Utama Wajib Pajak tidak lagi memenuhi ketentuan bidang usaha sebagaimana dimaksud dalam Pasal 423 ayat (3) huruf b; b. Wajib Pajak, dalam masa pemanfaatan fasilitas Pajak Penghasilan, tidak memenuhi persyaratan jumlah tenaga kerja sebagaimana dimaksud dalam Pasal 423 ayat (3) huruf c; atau c. Wajib Pajak tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 429."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_35eb783226 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_99_1__8 ;
