    kbr:hasSourceQuote "Penggantian atau imbalan dalam bentuk natura dan/atau kenikmatan merupakan objek Pajak Penghasilan sebagaimana dimaksud dalam Pasal 4 ayat (1) huruf a Undang-Undang Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
