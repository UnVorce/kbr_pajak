kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_e3448d078f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_10_1__5 ;
    kbr:hasRuleId "R-PERDA-KOTA-SEMARANG-2023-10-e3448d078f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/10/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Perolehan Hak atas Tanah dan/atau Bangunan sebagaimana dimaksud pada ayat (1) meliputi: a. pemindahan hak karena: 1. jual beli; 2. tukar-menukar; 3. hibah; 4. hibah wasiat; 5. waris; 12 6. pemasukan dalam perseroan atau badan hukum lain; 7. pemisahan hak yang mengakibatkan peralihan; 8. penunjukan pembeli dalam lelang; 9. pelaksanaan putusan hakim yang mempunyai kekuatan hukum tetap; 10. penggabungan usaha; 11. peleburan usaha; 12. pemekaran usaha; atau 13. hadiah; dan b. pemberian hak baru karena: 1. kelanjutan pelepasan hak; atau 2. di luar pelepasan hak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_e430d63219 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SEMARANG_2023_10 ;
