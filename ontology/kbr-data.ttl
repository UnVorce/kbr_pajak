    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_37_BT_3 ;
    kbr:hasRuleId "R-PMK-2025-37-18ca581746"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-37#BT/3"^^xsd:string ;
    kbr:hasSourceQuote "(1) Pihak Lain yang ditunjuk oleh Menteri sebagai pemungut Pajak Penghasilan sebagaimana dimaksud dalam Pasal 2 ayat (1) merupakan Penyelenggara Perdagangan Melalui Sistem Elektronik yang bertempat tinggal atau bertempat kedudukan di: a. dalam wilayah negara Republik Indonesia; dan b. luar wilayah negara Republik Indonesia, yang memenuhi kriteria tertentu."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2025_37_1e9d70a50b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2025_37 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_37_BT_5 ;
    kbr:hasRuleId "R-PMK-2025-37-1e9d70a50b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-37#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "Termasuk Pedagang Dalam Negeri sebagaimana dimaksud pada ayat (1) yaitu perusahaan jasa pengiriman atau ekspedisi, perusahaan asuransi, dan pihak lainnya yang melakukan transaksi dengan pembeli barang dan/atau jasa melalui Perdagangan Melalui Sistem Elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

kbr:Aturan_R_PMK_2025_37_1ef58114ee a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2025_37 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2025_37_BT_6_1__6 ;
    kbr:hasRuleId "R-PMK-2025-37-1ef58114ee"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-37#BT/6/1..6"^^xsd:string ;
    kbr:hasSourceQuote "(5) Informasi sebagaimana dimaksud pada: a. ayat (2) harus disampaikan kembali setiap awal Tahun Pajak berikutnya, dalam hal Pedagang Dalam Negeri sebagaimana dimaksud pada ayat (2) menerima atau memperoleh penghasilan dengan Peredaran Bruto tidak melebihi Rp4.800.000.000,00 (empat miliar delapan ratus juta rupiah) dalam 1 (satu) Tahun Pajak;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

