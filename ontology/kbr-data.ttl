    kbr:hasSourceLocator "PER-DJP-2025-7#BT/18"^^xsd:string ;
    kbr:hasSourceQuote "Penelitian administrasi sebagaimana dimaksud pada ayat (1) merupakan penelitian atas data dan/atau informasi yang dimiliki atau diperoleh Direktorat Jenderal Pajak, termasuk data dan/atau informasi yang diperoleh dari kegiatan ekstensifikasi dan kegiatan pengumpulan data."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_22b2cf244b a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_22 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-22b2cf244b"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak memilih untuk menggunakan Tanda Tangan Elektronik yang dibuat dengan menggunakan Sertifikat Elektronik yang diterbitkan oleh penyelenggara sertifikasi elektronik, Wajib Pajak harus mendaftarkan terlebih dahulu Sertifikat Elektronik dalam -27- sistem administrasi Direktorat Jenderal Pajak dengan mengisi dan menyampaikan formulir pemberitahuan Sertifikat Elektronik penyelenggara sertifikasi elektronik."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_7_23341e4e36 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PER_DJP_2025_7_BT_74 ;
    kbr:hasRuleId "R-PER-DJP-2025-7-23341e4e36"^^xsd:string ;
    kbr:hasSourceLocator "PER-DJP-2025-7#BT/74"^^xsd:string ;
    kbr:hasSourceQuote "surat penolakan pendaftaran objek pajak Pajak Bumi dan Bangunan dalam hal permohonan pendaftaran Objek Pajak tidak memenuhi persyaratan, paling lama 10 (sepuluh) hari kerja setelah bukti penerimaan elektronik atau bukti penerimaan surat diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

