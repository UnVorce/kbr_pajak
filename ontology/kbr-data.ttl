kbr:Aturan_R_PMK_2023_61_d558b4c53b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_125 ;
    kbr:hasRuleId "R-PMK-2023-61-d558b4c53b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/125"^^xsd:string ;
    kbr:hasSourceQuote "Surat pengembalian Klaim Pajak paling sedikit memuat: a. nomor identitas Penanggung Pajak atas Klaim Pajak; b. nama Penanggung Pajak atas Klaim Pajak; c. alamat Penanggung Pajak atas Klaim Pajak; d. nomor referensi Klaim Pajak; e. jumlah pembayaran; dan f. rincian pembayaran, termasuk: 1. pengembalian Nilai Klaim Pajak; 2. Utang Pajak; 3. Biaya Penagihan Pajak; dan/ atau 4. biaya lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_d66c30a66f a kbr:Definisi ;
