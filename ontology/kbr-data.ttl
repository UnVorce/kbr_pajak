    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_33 ;
    kbr:hasRuleId "R-PP-2022-50-a0c5b2d496"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/33"^^xsd:string ;
    kbr:hasSourceQuote "(U Direktur Jenderal Pajak hams menyelesaikan keberatan yang diajukan oleh Wajib Pajak dalam jangka waktu paling lama 12 (dua belas) bulan sebagaimana diatur dalam Pasal 26 ayat (1) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan. (2) Jangka waktu paling lama L2 (dua belas) bulan sebagaimana dimaksud pada ayat (1) dihitung sejak tanggal surat pengajuan keberatan diterima oleh Direktur Jenderal Pajak sampai dengan tanggal Surat Keputusan Keberatan diterbitkan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_a42c57ba11 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p3 ;
    kbr:hasRuleId "R-PP-2022-50-a42c57ba11"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Surat Setoran Pajak adalah bukti pembayaran atau penyetoran pajak yang telah dilakukan dengan menggunakan formulir atau telah dilakukan dengan cara lain ke kas negara melalui tempat pembayaran yang ditunjuk oleh Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_a4ee2a247d a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p1 ;
    kbr:hasRuleId "R-PP-2022-50-a4ee2a247d"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "10. Pemeriksaan Bukti Permulaan adalah pemeriksaan yang dilakukan untuk mendapatkan bukti permulaan tentang adanya dugaan telah terjadi tindak pidana di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_a56fad001c a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_69_1__6 ;
    kbr:hasRuleId "R-PP-2022-50-a56fad001c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/69/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak sebagaimana dimaksud pada ayat (3) dan ayat (a) wajib mengisi Surat Pemberitahuan sesuai ketentuan dalam Pasal 3 ayat (1) Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_a6b18fe522 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_31 ;
    kbr:hasRuleId "R-PP-2022-50-a6b18fe522"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/31"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terdapat penerbitan Surat Keputusan Pembetulan secara jabatan sebagaimana dimaksud pada ayat (2) huruf d dan Wajib Pajak belum mengajukan keberatan atas Surat Ketetapan Pajak, Wajib Pajak masih dapat mengajukan keberatan atas Surat Ketetapan Pajak tersebut dalam jangka waktu paling lama 3 (tiga) bulan sejak tanggal dikirim Surat Keputusan Pembetulan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_a9d64c4087 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p3 ;
    kbr:hasRuleId "R-PP-2022-50-a9d64c4087"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Surat Teguran adalah surat yang diterbitkan oleh pejabat untuk menegur atau memperingatkan kepada Wajib Pajak untuk melunasi utang pajaknya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_aa5fb889ed a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_61 ;
    kbr:hasRuleId "R-PP-2022-50-aa5fb889ed"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/61"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal tersangka tidak memenuhi panggilan sebagaimana dimaksud pada ayat (3), Penyidik melakukan tindakan berupa: a. mengumumkan pemanggilan tersebut pada media berskala nasional dan/atau internasional; b. mengusulkan tersangka masuk dalam daftar pencarian orang; dan c. meminta bantuan kepada pihak yang berwenang untuk dicatat dalam red notice."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_aaa284409b a kbr:Definisi ;
