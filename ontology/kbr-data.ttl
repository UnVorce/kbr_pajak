    kbr:hasRuleId "R-PMK-2010-2-1ffb2fa857"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2010-2#BT/4"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal promosi dilakukan dalam bentuk pemberian sampel produk, besarnya biaya yang dapat dikurangkan dari penghasilan bruto adalah sebesar harga pokok sampel produk yang diberikan, sepanjang belum dibebankan dalam perhitungan harga pokok penjualan."^^xsd:string ;
