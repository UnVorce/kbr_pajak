    kbr:hasRuleId "R-PMK-2025-105-4010be7915"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-105#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Penghasilan yang diterima atau diperoleh Pegawai sehubungan dengan pekerjaan wajib dipotong Pajak Penghasilan Pasal 21 oleh Pemberi Kerja sesuai dengan ketentuan dalam Pasal 21 Undang-Undang Pajak Penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_OP_POTPUT .

