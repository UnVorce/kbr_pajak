kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_72ff836f1f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_PROV_JAWA_BARAT_2023_9 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_12 ;
    kbr:hasRuleId "R-PERDA-PROV-JAWA-BARAT-2023-9-72ff836f1f"^^xsd:string ;
    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/12"^^xsd:string ;
    kbr:hasSourceQuote "(1) Subjek Pajak BBNKB adalah orang pribadi, Badan, dan instansi pemerintah yang menerima penyerahan Kendaraan Bermotor. (2) Wajib Pajak BBNKB adalah orang pribadi, Badan, dan Instansi Pemerintah yang menerima penyerahan Kendaraan Bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_73389b07cf a kbr:Hak ;
