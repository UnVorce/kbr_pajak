    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/94"^^xsd:string ;
    kbr:hasSourceQuote "Gubernur melakukan pengelolaan piutang Pajak untuk menentukan prioritas penagihan Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_72507ab927 a kbr:BatasWaktu ;
