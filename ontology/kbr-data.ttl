    kbr:hasRuleId "R-UU-1983-6-47c05e4ac6"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-6#BT/14/4..6"^^xsd:string ;
    kbr:hasSourceQuote "(5a) Tarif bunga per bulan yang ditetapkan oleh Menteri Keuangan sebagaimana dimaksud pada ayat (3) dihitung berdasarkan suku bunga acuan ditambah 5% (lima persen) dan dibagi 12 (dua belas) yang berlaku pada tanggal dimulainya penghitungan sanksi."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

