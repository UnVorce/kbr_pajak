    kbr:hasSourceLocator "UU-1995-10#BT/78"^^xsd:string ;
    kbr:hasSourceQuote "Pejabat bea dan cukai berwenang untuk mengunci, menyegel, dan/atau melekatkan tanda pengaman yang diperlukan terhadap barang impor yang belum diselesaikan kewajiban pabeannya dan barang ekspor atau barang lain yang harus diawasi menurut Undang-Undang ini yang berada di sarana pengangkut, tempat penimbunan atau tempat lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

