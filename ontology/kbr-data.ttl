    kbr:hasSourceQuote "d. Tahun Pajak 2023: 1 Januari s.d. 31 Maret 2023 dikenai PPh atas penghasilan yang diterima atau diperolehnya baik yang berasal dari Indonesia maupun dari luar Indonesia."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

