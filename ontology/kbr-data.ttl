    kbr:hasRuleId "R-PMK-2025-37-04878023d5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2025-37#BT/9"^^xsd:string ;
    kbr:hasSourceQuote "(3) Pedagang Dalam Negeri yang tidak melaksanakan kewajiban sebagaimana dimaksud pada ayat (1) dan/atau ayat (2) dikenai sanksi sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
