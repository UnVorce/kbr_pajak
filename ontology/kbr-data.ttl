    kbr:hasSourceLocator "UU-1995-10#BT/71"^^xsd:string ;
    kbr:hasSourceQuote "(2) Harga terendah untuk barang yang akan dilelang sebagaimana dimaksud pada ayat (1) ditetapkan oleh Menteri, dan jika harga yang ditetapkan tidak tercapai, barang dapat dimusnahkan untuk tujuan lain atas persetujuan Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

