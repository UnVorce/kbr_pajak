kbr:Aturan_R_PP_2022_50_ae01cc3ef2 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_47 ;
    kbr:hasRuleId "R-PP-2022-50-ae01cc3ef2"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/47"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak usaha kecil dan Wajib Pajak di daerah tertentu menyetujui seluruh jumlah pajak yang masih harus dibayar dalam Pembahasan Akhir Hasil Pemeriksaan, pelunasan atas jumlah pajak yang masih harus dibayar dilakukan paling lama 2 (dua) bulan terhitung sejak tanggal penerbitan Surat Ketetapan Pajak sebagaimana diatur dalam Pasal 9 ayat (3a) Undang- Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_ae98219e52 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_17_1 ;
    kbr:hasRuleId "R-PP-2022-50-ae98219e52"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/17/1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pada saat dilakukan Pemeriksaan ditemukan adanya dugaan tindak pidana di bidang perpajakan, Pemeriksaan ditangguhkan dan ditindaklanjuti dengan Pemeriksaan Bukti Permulaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_afb6d1a69a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_61 ;
    kbr:hasRuleId "R-PP-2022-50-afb6d1a69a"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/61"^^xsd:string ;
    kbr:hasSourceQuote "Dalam melaksanakan kewenangan Penyidikan sebagaimana diatur dalam Pasal 44 ayat (2) Undang- Undang Ketentuan Umum dan Tata Cara Perpajakan, Penyidik dapat meminta bantuan aparat penegak hukum lain, berupa: a. bantuan teknis; b. bantuan taktis; c. bantuan upaya paksa; dan/atau d. bantuan konsultasi dalam rangka Penyidikan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_b0829d848c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p1 ;
    kbr:hasRuleId "R-PP-2022-50-b0829d848c"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "Dalam Peraturan Pemerintah ini yang dimaksud dengan: 1. Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan adalah Undang-Undang Nomor 6 Tahun 1983 tentang Ketentuan Umum dan Tata Cara Perpajakan sebagaimana telah beberapa kali diubah terakhir dengan Undang-Undang Nomor 7 Tahun 202L tentang Harmonisasi Peraturan Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

