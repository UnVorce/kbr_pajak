    kbr:hasRuleId "R-PMK-2024-81-fba6c83d47"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/65"^^xsd:string ;
    kbr:hasSourceQuote "(4) Dalam hal Pengusaha Kena Pajak tidak menyampaikan klarifikasi sesuai dengan ketentuan sebagaimana dimaksud pada ayat (2) dalam jangka waktu 30 (tiga puluh) hari sejak penonaktifan akses pembuatan Faktur Pajak atau klarifikasi Pengusaha Kena Pajak ditolak, Kepala Kantor Pelayanan Pajak melakukan Pencabutan Pengukuhan Pengusaha Kena Pajak secara jabatan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

