    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_80_BT_1_p1 ;
    kbr:hasRuleId "R-PMK-2023-80-cb56b5153c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-80#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "12. Pengusaha Kena Pajak adalah pengusaha yang melakukan penyerahan barang kena pajak dan/ atau penyerahan jasa kena pajak yang dikenai pajak berdasarkan Undang- Undang Pajak Pertambahan Nilai."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

