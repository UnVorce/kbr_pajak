    kbr:hasSourceLocator "PMK-2024-81#BT/7/2..4"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pelaksanaan hak dan pemenuhan kewajiban perpajakan sebagaimana dimaksud dalam Pasal 3 dilakukan oleh kuasa Wajib Pajak, dokumen sebagaimana dimaksud pada ayat (1) harus dilampiri surat kuasa khusus sebagaimana diatur dalam peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
