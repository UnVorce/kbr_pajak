    kbr:hasSourceQuote "Dalam hal laporan realisasi penanaman modal disampaikan oleh kuasa Wajib Pajak, harus dilampiri surat kuasa khusus."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

