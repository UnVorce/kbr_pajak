    kbr:hasSourceQuote "Pada saat Peraturan Pemerintah ini mulai berlaku, ketentuan Pajak Penghasilan bagi pemegang PKP2B yang dalam kontraknya diatur ketentuan kewajiban Pajak Penghasilan berdasarkan PKP2B sebagaimana dimaksud dalam Pasal 2 huruf d dilaksanakan berdasarkan ketentuan dalam PKP2B tersebut sampai dengan berakhirnya kontrak dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

