    kbr:hasSourceLocator "PER-DJP-2025-11#BT/49"^^xsd:string ;
    kbr:hasSourceQuote "(2) Termasuk Faktur Pajak yang harus dibatalkan sebagaimana dimaksud pada ayat (1) yaitu Faktur Pajak yang salah dalam pengisian atau penulisan identitas Pembeli Barang Kena Pajak dan/atau Penerima Jasa Kena Pajak sebagaimana dimaksud dalam Pasal 48 ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PER_DJP_2025_11_ed547be7f1 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PER_DJP_2025_11 ;
