    kbr:hasRuleId "R-PMK-2024-136-540e972aa1"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/44/1..3"^^xsd:string ;
    kbr:hasSourceQuote "Grup PMN multiinduk (multi-parented MNE groups) merupakan 2 (dua) atau lebih grup yang: a. Entitas Induk Utama dari grup tersebut menyepakati suatu perjanjian terkait penggabungan grup berupa stapled structure atau dual-listed arrangement; dan b. minimal terdapat 1 (satu) Entitas atau Bentuk Usaha Tetap dari gabungan grup sebagaimana dimaksud pada huruf a berada di negara atau yurisdiksi yang berbeda dari Entitas lainnya dalam gabungan grup tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

