    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/93"^^xsd:string ;
    kbr:hasSourceQuote "Pelaksanaan sinergitas koordinasi, jejaring kerja, kemitraan dan kerjasama sebagaimana dimaksud pada ayat (1) dilaksanakan sesuai dengan ketentuan peraturan perundang-undangan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

