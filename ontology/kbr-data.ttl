    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/133"^^xsd:string ;
    kbr:hasSourceQuote "a. SPOP tidak disampaikan oleh Wajib Pajak dan setelah Wajib Pajak ditegur secara tertulis oleh Walikota atau Pejabat yang ditunjuk sebagaimana ditentukan dalam surat teguran;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

