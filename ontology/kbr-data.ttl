    kbr:hasSourceQuote "(3) Wilayah pemungutan PKB yang terutang merupakan wilayah Daerah tempat Kendaraan Bermotor terdaftar."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
