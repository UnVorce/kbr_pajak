    kbr:hasSourceQuote "d. sebesar 0,2% (nol koma dua persen) untuk NJOP diatas Rp 2.000.000.000,00 (dua miliar rupiah) sampai dengan Rp 10.000.000.000,00 (sepuluh miliar rupiah);"^^xsd:string ;
