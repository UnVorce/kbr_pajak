    kbr:hasRuleId "R-PMK-2023-80-3da926a55b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-80#BT/37"^^xsd:string ;
    kbr:hasSourceQuote "a. penelitian berdasarkan keterangan lain yang dimulai sebelum berlakunya Peraturan Menteri ini sehingga diketahui: 1. Pajak Bumi dan Bangunan yang terutang atas Surat Pemberitahuan Objek Pajak yang tidak disampaikan oleh subjek pajak atau Wajib Pajak; atau 2. Pajak Bumi dan Bangunan yang terutang lebih besar 1f - jdih.kemenkeu.go.id - 20 - dari jumlah Pajak Bumi dan Bangunan yang dihitung berdasarkan Surat Pemberitahuan Objek Pajak yang disampaikan subjek pajak atau Wajib Pajak, tetap dilanjutkan dan diterbitkan Surat Ketetapan Pajak Pajak Bumi dan Bangunan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

