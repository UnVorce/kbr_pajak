    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_7fe506e254 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_12_2__7 ;
    kbr:hasRuleId "R-PMK-2020-130-7fe506e254"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/12/2..7"^^xsd:string ;
    kbr:hasSourceQuote "(7) Tata cara untuk memperoleh surat keterangan fiskal sebagaimana dimaksud pada ayat (6) sesuai dengan ketentuan yang mengatur mengenai tata cara pemberian surat keterangan fiskal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_8255ddd3c5 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_8_1__5 ;
    kbr:hasRuleId "R-PMK-2020-130-8255ddd3c5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/8/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(1) Bagi Wajib Pajak yang mendapat penugasan pemerintah sesuai peraturan perundang-undangan mengenai percepatan pelaksanaan proyek strategis nasional dapat mengajukan permohonan pengurangan Pajak Penghasilan badan sebagaimana dimaksud dalam Pasal 2 ayat (1) dan diberikan perlakuan tertentu, sepanjang memenuhi ketentuan sebagaimana dimaksud dalam Pasal 3 atau Pasal 5"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_839523982b a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_8_1__5 ;
    kbr:hasRuleId "R-PMK-2020-130-839523982b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/8/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(3) Penugasan pemerintah sebagaimana dimaksud pada ayat (1) ditunjukkan dengan adanya penetapan berdasarkan keputusan menteri atau keputusan pimpinan lembaga setingkat menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_87a76fa8ca a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_24 ;
    kbr:hasRuleId "R-PMK-2020-130-87a76fa8ca"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/24"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak badan yang telah mendapatkan dan/ atau memanfaatkan fasilitas pengurangan Pajak Penghasilan badan berdasarkan Peraturan Menteri Keuangan Nomor 35/PMK.010/2018 tentang Pemberian Fasilitas Pengurangan Pajak Penghasilan Badan, tetap dapat memanfaatkan fasilitas pengurangan Pajak Penghasilan badan sampai dengan berakhirnya jangka waktu pemanfaatan fasilitas pengurangan Pajak Penghasilan badan dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_88a3c15a10 a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_17_1__5 ;
    kbr:hasRuleId "R-PMK-2020-130-88a3c15a10"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/17/1..5"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pencabutan keputusan sebagaimana dimaksud pada ayat (1) huruf a berdasarkan hasil pemeriksaan sebagaimana dimaksud dalam Pasal 14 huruf g dikecualikan bagi Wajib Pajak yang mendapat penugasan pemerintah sebagaimana dimaksud dalam Pasal 8."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_8b020c8bbb a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_3_1__3 ;
    kbr:hasRuleId "R-PMK-2020-130-8b020c8bbb"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/3/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(3) Rincian bidang usaha dan jenis produksi dari masing-masing cakupan Industri Pionir sebagaimana dimaksud pada ayat (2) berdasarkan Peraturan Badan Koordinasi Penanaman Modal."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_8deef94ab0 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_8_1__5 ;
    kbr:hasRuleId "R-PMK-2020-130-8deef94ab0"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/8/1..5"^^xsd:string ;
    kbr:hasSourceQuote "b. pengaJuan permohonan pengurangan Pajak Penghasilan badan dilakukan: 1. bersamaan dengan pendaftaran untuk mendapatkan nomor induk berusaha bagi Wajib Pajak baru; atau 2. paling lambat 1 (satu) tahun setelah penerbitan izin usaha untuk penanaman modal baru;"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_938b30fe4c a kbr:Hak ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_22 ;
    kbr:hasRuleId "R-PMK-2020-130-938b30fe4c"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Pada saat Peraturan Menteri ini berlaku, Wajib Pajak badan yang telah mendapatkan dan/ atau memanfaatkan fasilitas pembebasan atau pengurangan Pajak Penghasilan badan berdasarkan Peraturan Menteri Keuangan Nomor 130/PMK.011/2011 tentang Pemberian Fasilitas Pembebasan atau Pengurangan Pajak Penghasilan Badan sebagaimana telah diubah dengan Peraturan Menteri Keuangan Nomor 192/PMK.011/2014 tentang Perubahan atas Peraturan Menteri Keuangan Nomor 130/PMK.011/2011 tentang Pemberian Fasilitas Pembebasan atau Pengurangan Pajak Penghasilan Badan, tetap dapat memanfaatkan fasilitas pembebasan atau pengurangan Pajak Penghasilan badan sampai dengan berakhirnya jangka waktu pemanfaatan fasilitas pembebasan atau pengurangan Pajak Penghasilan badan dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_963d243c17 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_12_2__7 ;
    kbr:hasRuleId "R-PMK-2020-130-963d243c17"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/12/2..7"^^xsd:string ;
    kbr:hasSourceQuote "(5) Permohonan pemanfaatan fasilitas pengurangan Pajak Penghasilan badan sebagaimana dimaksud pada ayat (2) dilakukan oleh Wajib Pajak secara daring melalui sistem OSS dengan mengunggah dokumen yang meliputi: a. daftar realisasi penanaman modal berupa aktiva tetap beserta gambar tata letak; dan b. dokumen yang berkaitan dengan: 1. transaksi penjualan barang atau penyerahan jasa dari Kegiatan Usaha Utama ke pasaran pertama kali, dapat berupa faktur pajak atau bukti tagihan; atau 2. hasil produksi atau jasa dari Kegiatan U saha Utama pertama kali digunakan sendiri untuk proses produksi lebih lanjut, dapat berupa laporan pemakaian sendiri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_98de58130e a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_16_1__5 ;
    kbr:hasRuleId "R-PMK-2020-130-98de58130e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/16/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Wajib Pajak: a. tidak menyampaikan laporan sebagaimana dimaksud pada ayat ( 1) a tau menyampaikan laporan namun tidak memenuhi ketentuan sebagaimana dimaksud dalam Lampiran huruf C; atau b. tidak memenuhi komitmen sebagaimana dimaksud dalam Pasal 3 ayat ( 1) huruf f, Direktur Jenderal Pajak menerbitkan surat teguran kepada Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_99f6e9a060 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_13 ;
    kbr:hasRuleId "R-PMK-2020-130-99f6e9a060"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/13"^^xsd:string ;
    kbr:hasSourceQuote "(2) Pemeriksaan lapangan sebagaimana dimaksud pada ayat ( 1) meliputi kegiatan: a. penentuan mengenai Saat Mulai Berproduksi Komersial; b. pengujian jumlah nilai realisasi penanaman modal baru pada Saat Mulai Berproduksi Komersial; c. pengujian jumlah nilai realisasi penanaman modal baru pada saat Wajib Pajak menyatakan telah merealisasikan seluruh rencana penanaman modal bagi Wajib Pajak yang mendapat penugasan pemerintah sebagaimana dimaksud dalam Pasal 8; d. pengujian kesesuaian realisasi dengan rencana Kegiatan Usaha Utama; dan e. pengujian atas pemenuhan ketentuan mengenai saat pengajuan permohonan fasilitas pengurangan Pajak Penghasilan badan sebagaimana dimaksud dalam Pasal 6 ayat (1)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_a25e99f15f a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_3_4__6 ;
    kbr:hasRuleId "R-PMK-2020-130-a25e99f15f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/3/4..6"^^xsd:string ;
    kbr:hasSourceQuote "Tata cara untuk memperoleh surat keterangan fiskal sebagaimana dimaksud pada ayat (4) sesuai dengan ketentuan yang mengatur mengenai tata cara pemberian surat keterangan fiskal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_a3c9ffdaa5 a kbr:AturanTarif ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_2_1__3 ;
    kbr:hasRuleId "R-PMK-2020-130-a3c9ffdaa5"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/2/1..3"^^xsd:string ;
    kbr:hasSourceQuote "50% (lima puluh persen) dari jumlah Pajak Penghasilan badan yang terutang untuk penanaman modal baru sebagaimana dimaksud pada ayat (1) dengan nilai paling sedikit Rp100.000.000.000,00 (seratus miliar rupiah) dan paling banyak kurang dari Rp500.000.000.000,00 (lima ratus miliar rupiah)"^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_a4c87c9530 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_16_1__5 ;
    kbr:hasRuleId "R-PMK-2020-130-a4c87c9530"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/16/1..5"^^xsd:string ;
    kbr:hasSourceQuote "Laporan sebagaimana dimaksud pada ayat (1) disampaikan paling lambat 30 (tiga puluh) hari setelah berakhirnya tahun pajak yang bersangkutan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2020_130_a4f7a4c7e2 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2020_130 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_130_BT_15_1__3 ;
    kbr:hasRuleId "R-PMK-2020-130-a4f7a4c7e2"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-130#BT/15/1..3"^^xsd:string ;
    kbr:hasSourceQuote "(2) Dalam hal hasil pemeriksaan sebagaimana dimaksud dalam Pasal 14 huruf b dan huruf d terpenuhi, Menteri Keuangan menetapkan keputusan penyesuaian besaran dan/ atau jangka waktu serta penetapan pemanfaatan fasilitas pengurangan Pajak Penghasilan badan yang memuat: a. penyesuaian besaran dan/ atau jangka waktu pemberian pengurangan Pajak Penghasilan badan; b. tanggal Saat Mulai Berproduksi Komersial; -- 22 - c. tanggal saat seluruh rencana penanaman modal telah direalisasikan bagi W ajib Pajak yang mendapat penugasan pemerintah sebagaimana dimaksud dalam Pasal 8; d. jumlah nilai realisasi penanaman modal baru pada Saat Mulai Berproduksi Komersial; e. jumlah nilai realisasi penanaman modal baru pada saat seluruh rencana penanaman modal telah direalisasikan bagi Wajib Pajak yang mendapat penugasan pemerintah sebagaimana dimaksud dalam Pasal 8; dan f. kesesuaian antara realisasi dengan rencana Kegiatan Usaha Utama."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

