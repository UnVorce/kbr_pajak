    kbr:hasSourceQuote "Termasuk penyerahan Kendaraan Bermotor sebagaimana dimaksud pada ayat (1) merupakan pemasukan Kendaraan Bermotor dari luar negeri untuk dipakai secara tetap di Indonesia, kecuali: a. untuk diperdagangkan; b. untuk dikeluarkan kembali dari wilayah kepabeanan Indonesia; dan c. digunakan untuk pameran, objek penelitian, contoh, dan kegiatan olahraga bertaraf internasional."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

