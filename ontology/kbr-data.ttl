    kbr:hasSourceQuote "Pihak lain sebagaimana dimaksud pada ayat (1) merupakan pihak yang terlibat langsung atau memfasilitasi transaksi antarpihak yang bertransaksi."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_UU_1983_6_d08c22df8c a kbr:Hak ;
