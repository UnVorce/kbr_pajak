    kbr:hasSourceLocator "PMK-2024-81#BT/29/1/b#p2"^^xsd:string ;
    kbr:hasSourceQuote "Dalam tahun buku berjalan 2024, PT IJK membukukan total peredaran bruto melebihi Rp4.800.000.000,00 (empat miliar delapan ratusjuta rupiah) yangjatuh pada tanggal 7 Mei 2024, sehingga PT IJK seharusnya melaporkan usahanya untuk dikukuhkan sebagai Pengusaha Kena Pajak paling lambat tanggal 31 Desember 2024."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_46dc2853c8 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_438 ;
    kbr:hasRuleId "R-PMK-2024-81-46dc2853c8"^^xsd:string ;
