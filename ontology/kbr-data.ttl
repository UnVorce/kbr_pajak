    kbr:hasSourceLocator "PMK-2023-168#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "Tarifpemotongan Pajak Penghasilan Pasal 26 Sehubungan dengan Pekerjaan, Jasa, atau Kegiatan sebesar 20% (dua puluh persen) dan bersifat final atau sesuai dengan ketentuan persetujuan penghindaran pajak berganda yang berlaku antara Republik Indonesia dan negara atau yurisdiksi domisili wajib pajak luar negeri tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
