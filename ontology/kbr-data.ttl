kbr:Aturan_R_PP_2022_50_25ab02abe1 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p3 ;
    kbr:hasRuleId "R-PP-2022-50-25ab02abe1"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "Surat Ketetapan Pajak Pajak Bumi dan Bangunan adalah surat ketetapan yang menentukan besarnya pokok Pajak Bumi dan Bangunan atau selisih pokok Pajak Bumi dan Bangunan, besarnya denda administratif, dan jumlah Pajak Bumi dan Bangunan yang terutang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_25b96d9dbc a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_50 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_50_BT_1_p1 ;
    kbr:hasRuleId "R-PP-2022-50-25b96d9dbc"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-50#BT/1#p1"^^xsd:string ;
    kbr:hasSourceQuote "3. Undang-Undang Pajak Bumi dan Bangunan adalah Undang-Undang Nomor 12 Tahun 1985 tentang Pajak Bumi dan Bangunan sebagaimana telah diubah dengan Undang-Undang Nomor t2 Tahun 1994 tentang Perubahan atas Undang-Undang Nomor 12 Tahun 1985 tentang Pajak Bumi dan Bangunan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PP_2022_50_2912ef5e5b a kbr:Prosedur ;
