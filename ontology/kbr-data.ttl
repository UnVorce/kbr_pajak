    kbr:hasSourceLocator "PP-2021-91#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Tarif pajak penghasilan yang bersifat final sebagainaana dimaksud pada ayat (1) sebesar 10% (sepuluh persen) dari dasar pengenaan pajak penghasilan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PPH_FINAL_SEKTOR .

