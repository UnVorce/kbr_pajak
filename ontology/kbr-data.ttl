    kbr:hasSourceLocator "UU-2022-1#BT/44"^^xsd:string ;
    kbr:hasSourceQuote "Hak atas Tanah dan/atau Bangunan sebagaimana dimaksud pada ayat (1) meliputi: a. hak milik; b. hak guna usaha; c. hak guna bangunan; d. hakpakai; e. hak milik atas satuan rumah susun; dan f. hak pengelolaan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

