    kbr:hasSourceLocator "PMK-2024-78#BT/24/7..3"^^xsd:string ;
    kbr:hasSourceQuote "Pembayaran Bea Meterai dengan menggunakan Meterai Dalam Bentuk Lain sebagaimana dimaksud dalam Pasal 25 ayat (1) dilakukan dengan membubuhkan Meterai Dalam Bentuk Lain pada Dokumen yang terutang Bea Meterai. (2) Pembubuhan Meterai Dalam Bentuk Lain sebagaimana dimaksud pada ayat (1) dilakukan oleh Wajib Pajak yang telah memperoleh izin pembuatan Meterai Dalam Bentuk Lain."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

