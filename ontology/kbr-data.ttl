    kbr:hasRuleId "R-PMK-2024-81-fb6a41fc97"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/7/6..7"^^xsd:string ;
    kbr:hasSourceQuote "Tanggal yang tercantum dalam tanda bukti penerimaan dokumen sebagaimana dimaksud pada ayat (7) merupakan tanggal dokumen diterima oleh Direktorat Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

