    kbr:hasRuleId "R-PMK-2023-61-83345eeba0"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/72"^^xsd:string ;
    kbr:hasSourceQuote "(3) Izin perpanjangan jangka waktu Penyanderaan sebagaimana dimaksud pada ayat (1) paling sedikit memuat: a. identitas Penanggung Pajak; b. alasan perpanjangan jangka waktu Penyanderaan; dan c. lamanya perpanjangan jangka waktu Penyanderaan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

