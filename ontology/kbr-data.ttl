    kbr:hasSourceLocator "PMK-2020-237#BT/34/1..6"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Pengusaha Kena Pajak tidak menerima dokumen kepabeanan, PJKEK, dan/atau dokumen pemesanan barang (purchase order) atau tidak mencantumkan keterangan mengenai dokumen pemesanan barang (purchase order) dalam dokumen kepabeanan sebagaimana dimaksud pada ayat (2) dan ayat (3), Pengusaha Kena Pajak wajib memungut Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah atas penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak kepada Badan Usaha dan/atau Pelaku Usaha."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

