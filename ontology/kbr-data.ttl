    kbr:hasSourceQuote "kepentingan kepemilikan pada Entitas Konstituen lainnya dalam Grup PMN yang sama dan dimiliki lebih dari 20% (dua puluh persen) kepentingan kepemilikan atas laba yang dimiliki secara langsung atau tidak langsung oleh pihak yang bukan merupakan Entitas Konstituen dari Grup PMN."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
