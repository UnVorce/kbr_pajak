    kbr:hasSourceQuote "c. Wajib Pajak harus menyampaikan pemberitahuan tertulis kepada Direktur Jenderal Pajak sebelum melakukan penggantian aktiva tetap berwujud sebagaimana dimaksud pada ayat (2)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_091a8edab4 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_396 ;
    kbr:hasRuleId "R-PMK-2024-81-091a8edab4"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/396"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak yang telah melakukan pemindahtanganan harta dengan tujuan peningkatan efisiensi perusahaan sebagaimana dimaksud dalam Pasal 393 ayat (2) huruf e, harus mengajukan permohonan kepada Direktur Jenderal Pajak paling lama dalamjangka waktu 1 (satu) bulan setelah terjadinya pemindahtanganan harta."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

