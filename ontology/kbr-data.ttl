    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_228eebc794 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_29 ;
    kbr:hasRuleId "R-UU-1995-10-228eebc794"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/29"^^xsd:string ;
    kbr:hasSourceQuote "Pengurusan Pemberitahuan Pabean yang diwajibkan Undang-undang ini dilakukan oleh pengangkut, importir, atau eksportir."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

