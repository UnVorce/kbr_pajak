    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_56 ;
    kbr:hasRuleId "R-PMK-2023-61-6d6068f720"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/56"^^xsd:string ;
    kbr:hasSourceQuote "(5) Permintaan Pencegahan sampai dengan penerbitan keputusan Menteri dilakukan secara: a. elektronik; atau b. tertulis, dalam hal sistem informasi sebagaimana dimaksud dalam huruf a belum tersedia atau terdapat gangguan pada jaringan termasuk gangguan pada sistem dan/ atau keadaan luar biasa lainnya."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_7029c04f81 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_116 ;
    kbr:hasRuleId "R-PMK-2023-61-7029c04f81"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/116"^^xsd:string ;
    kbr:hasSourceQuote "Pembayaran sebagaimana dimaksud pada ayat (1) dilakukan dengan mencantumkan informasi yang paling sedikit memuat: a. nama Penanggung Pajak atas Klaim Pajak; b. nomor identitas Penanggung Pajak atas Klaim Pajak; c. nomor referensi Klaim Pajak; dan d. nominal pembayaran."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_70e6b1cf81 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_74 ;
    kbr:hasRuleId "R-PMK-2023-61-70e6b1cf81"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/74"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Penanggung Pajak memenuhi salah satu pertimbangan tertentu sebagaimana dimaksud dalam Pasal 73 ayat (2), Pejabat menyampaikan usulan pelepasan sandera kepada Menteri."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_7414cfa7ee a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_52_1__4 ;
