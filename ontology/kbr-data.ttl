    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_69_1__8 ;
    kbr:hasRuleId "R-PMK-2023-172-1f5a88ae72"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-172#BT/69/1..8"^^xsd:string ;
    kbr:hasSourceQuote "(6) Formulir permohonan penmjauan kembali Kesepakatan Harga Transfer sebagaimana dimaksud pada ayat (5) dibuat dengan menggunakan contoh format sebagaimana tercantum dalam Lampiran huruf S yang merupakan bagian tidak terpisahkan dari Peraturan Menteri ini."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

kbr:Aturan_R_PMK_2023_172_1fddc7f1b4 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_172 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_172_BT_56_6__12 ;
    kbr:hasRuleId "R-PMK-2023-172-1fddc7f1b4"^^xsd:string ;
