    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_6_8__10 ;
    kbr:hasRuleId "R-PMK-2023-61-351e82d233"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/6/8..10"^^xsd:string ;
    kbr:hasSourceQuote "d. terdapat tanda-tanda bahwa Badan akan dibubarkan, digabungkan, dimekarkan, dipindahtangankan, atau dilakukan perubahan bentuk lainnya;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
