    kbr:hasSourceLocator "PMK-2023-80#BT/14"^^xsd:string ;
    kbr:hasSourceQuote "Nota penghitungan Surat Ketetapan Pajak sebagaimana dimaksud pada ayat ( 1) dibuat berdasarkan laporan hasil penelitian, laporan hasil Pemeriksaan, atau laporan hasil Pemeriksaan Ulang."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
