    kbr:diaturDalam kbr:Reg_PMK_2023_143 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_143_BT_5 ;
    kbr:hasRuleId "R-PMK-2023-143-ddc596ba0b"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/5"^^xsd:string ;
    kbr:hasSourceQuote "(5) Terhadap pembayaran Pajak Rokok sebagaimana dimaksud pada ayat (1) diterbitkan BPN."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2023_143_de50c8d3e9 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2023_143 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_143_BT_22 ;
    kbr:hasRuleId "R-PMK-2023-143-de50c8d3e9"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/22"^^xsd:string ;
    kbr:hasSourceQuote "Berdasarkan keputusan sebagaimana dimaksud pada ayat (2), gubernur menyalurkan bagi hasil Pajak Rokok kepada kabupaten/kota dalamjangka waktu paling lama 7 (tujuh) hari kerja terhitung sejak diterimanya Pajak Rokok di RKUD Provinsi."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_PMK_2023_143_df24535489 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PMK_2023_143 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_143_BT_31_1__11 ;
    kbr:hasRuleId "R-PMK-2023-143-df24535489"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-143#BT/31/1..11"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal pemcriksaan dan pengujian SPP sebagaimana dimaksud pada ayat (8) memenuhi ketentuan, PPSPM mencrbitkan SPM dalam rangkap 3 (tiga) dengan peruntukan sebagai berikut: a. Lcmbar ke-J dan ke-2 untuk KPPN Jakarta II; dan b. Lcmbar ke-3 scbagai pertinggal."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

