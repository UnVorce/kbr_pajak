    kbr:hasSourceQuote "(4) Kontraktor dan Satuan Kerja Khusus Pelaksana Kegiatan Usaha Hulu Minyak dan Gas Bumi atau Badan Pengelola Migas Aceh melakukan perhitungan final Lifting yang merupakan hak negara dan hak jdih.kemenkeu.go.id - 190 - Kontraktor dari masing-masing Wilayah Kerja pada akhir tahun."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

