kbr:Aturan_R_PP_2023_35_bad6a5fcc5 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2023_35 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2023_35_BT_69 ;
    kbr:hasRuleId "R-PP-2023-35-bad6a5fcc5"^^xsd:string ;
