    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_265 ;
    kbr:hasRuleId "R-PMK-2024-81-e31dab6fe6"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/265"^^xsd:string ;
    kbr:hasSourceQuote "(9) Turis Asing sebagaimana dimaksud pada ayat (1) merupakan Turis Asing yang bukan Warga Negara Indonesia atau bukan permanent resident of Indonesia, yang tinggal atau berada di Indonesia tidak lebih dari 60 (enam puluh) hari sejak tanggal kedatangannya."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

