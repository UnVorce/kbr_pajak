    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/135/1..9"^^xsd:string ;
    kbr:hasSourceQuote "Walikota menetapkan jangka waktu pembayaran atau penyetoran Pajak terutang untuk jenis Pajak yang dipungut berdasarkan penghitungan sendiri oleh Wajib Pajak sebagaimana dimaksud dalam Pasal 2 huruf b dan huruf c paling lama 10 (sepuluh) hari kerja setelah berakhirnya masa Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_4cb93ebeae a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_163 ;
