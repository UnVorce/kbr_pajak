    kbr:hasSourceQuote "Penyetoran Pajak Pertambahan Nilai oleh Pengusaha Kena Pajak sebagaimana dimaksud dalam Pasal 9 ayat (3) harus dilakukan paling lama akhir bulan berikutnya setelah berakhirnya Masa Pajak dan sebelum Surat Pemberitahuan Masa Pajak Pertambahan Nilai disampaikan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

