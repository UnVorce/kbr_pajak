    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_103A ;
    kbr:hasRuleId "R-UU-1995-10-84d8d4d7ea"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/103A"^^xsd:string ;
    kbr:hasSourceQuote "Setiap orang yang secara tidak sah mengakses sistem elektronik yang berkaitan dengan pelayanan dan/atau pengawasan di bidang kepabeanan dipidana dengan pidana penjara paling singkat 1 (satu) tahun dan pidana penjara paling lama 5 (lima) tahun dan/atau pidana denda paling sedikit Rp50.000.000,00 (lima puluh juta rupiah) dan paling banyak Rp1.000.000.000,00 (satu miliar rupiah)."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_859c9d8f2a a kbr:Pengecualian ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_2 ;
    kbr:hasRuleId "R-UU-1995-10-859c9d8f2a"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Barang sebagaimana dimaksud pada ayat (2) bukan merupakan barang ekspor dalam hal dapat dibuktikan bahwa barang tersebut ditujukan untuk dibongkar di suatu tempat dalam daerah pabean."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_8699b7197e a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
    kbr:diaturDalamPasal kbr:Pasal_UU_1995_10_BT_46_1__4 ;
    kbr:hasRuleId "R-UU-1995-10-8699b7197e"^^xsd:string ;
    kbr:hasSourceLocator "UU-1995-10#BT/46/1..4"^^xsd:string ;
    kbr:hasSourceQuote "Pengusaha Tempat Penimbunan Berikat yang tidak dapat mempertanggungjawabkan barang yang seharusnya berada di tempat tersebut, dikenakan sanksi administrasi berupa denda sebesar seratus persen dari Bea Masuk yang seharusnya dibayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_KEPABEANAN_CUKAI .

kbr:Aturan_R_UU_1995_10_887ff22b4b a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_UU_1995_10 ;
