    kbr:hasRuleId "R-UU-1983-7-d7614c4ae1"^^xsd:string ;
    kbr:hasSourceLocator "UU-1983-7#BT/10"^^xsd:string ;
    kbr:hasSourceQuote "(2) Nilai perolehan atau nilai penjualan dalam hal terjadi tukar-menukar harta adalah jumlah yang seharusnya dikeluarkan atau diterima berdasarkan harga pasar."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
