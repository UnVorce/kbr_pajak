    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_ee50a67f8a a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_81_BT_291 ;
    kbr:hasRuleId "R-PMK-2024-81-ee50a67f8a"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-81#BT/291"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal terjadi penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak oleh Pemungut Pajak Pertambahan Nilai sebagaimana dimaksud pada ayat (1) kepada Pemungut Pajak Pertambahan Nilai sebagaimana dimaksud pada ayat (1) lainnya, Pajak Pertambahan Nilai atau Pajak Pertambahan Nilai dan Pajak Penjualan atas Barang Mewah yang terutang dipungut, disetor, dan dilaporkan oleh Pemungut Pajak Pertambahan Nilai yang melakukan penyerahan Barang Kena Pajak dan/atau Jasa Kena Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_ee556b1f36 a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
