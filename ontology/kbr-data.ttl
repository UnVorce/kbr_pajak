    kbr:hasSourceQuote "Pengusaha Kena Pajak Toko Retail yang tidak memenuhi ketentuan sebagaimana dimaksud pada ayat ( 1) dikenai sanksi sebagaimana diatur dalam Undang-Undang Ketentuan Umum dan Tata Cara Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2024_81_fb598a041a a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2024_81 ;
