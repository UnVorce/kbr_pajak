    kbr:hasSourceQuote "(4) Dalam hal Reklame diselenggarakan melalui pihak ketiga, pihak ketiga tersebut menjadi Wajib Pajak Reklame."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
