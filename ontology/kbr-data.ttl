kbr:Aturan_R_PMK_2024_136_48dec156af a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2024_136 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_136_BT_35_1__7 ;
    kbr:hasRuleId "R-PMK-2024-136-48dec156af"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-136#BT/35/1..7"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal Entitas Konstituen Pelapor melakukan pemilihan rugi GloBE sebagaimana dimaksud pada ayat (1) untuk suatu negara atau yurisdiksi, Aset Pajak Tangguhan rugi GloBE (GloBE loss deferred tax asset) - 52 - dibentuk di setiap Tahun Pajak saat terdapat Rugi GloBE Bersih untuk negara atau yurisdiksi tersebut."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

