kbr:Aturan_R_PMK_2024_118_fb4f83a3d7 a kbr:Larangan ;
    kbr:diaturDalam kbr:Reg_PMK_2024_118 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_118_BT_2_4__5 ;
    kbr:hasRuleId "R-PMK-2024-118-fb4f83a3d7"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-118#BT/2/4..5"^^xsd:string ;
    kbr:hasSourceQuote "(5) Dalam hal kekeliruan pengkreditan pajak sebagaimana dimaksud pada ayat (4) huruf f merupakan kekeliruan pengkreditan pajak masukan pajak pertambahan nilai pada surat keputusan atau surat ketetapan, pembetulan atas kekeliruan tersebut hanya dapat dilakukan jika: a. terdapat perbedaan besarnya pajak masukan yang menjadi kredit pajak; dan b. pajak masukan tersebut tidak mengandung persengketaan antara fiskus dan Wajib Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2024_118_fb5af55860 a kbr:BatasWaktu ;
    kbr:diaturDalam kbr:Reg_PMK_2024_118 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2024_118_BT_19 ;
    kbr:hasRuleId "R-PMK-2024-118-fb5af55860"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2024-118#BT/19"^^xsd:string ;
    kbr:hasSourceQuote "(1) Dalam hal terdapat putusan gugatan atas surat pemberitahuan sebagaimana dimaksud dalam Pasal 13 ayat (3), jangka waktu paling lama 12 (dua belas) bulan sebagaimana dimaksud dalam Pasal 18 ayat (1) tertangguh, terhitung sejak tanggal dikirim surat pemberitahuan tersebut kepada Wajib Pajak sampai dengan Putusan Gugatan Pengadilan Pajak diterima oleh Direktur Jenderal Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

