    kbr:hasSourceQuote "Satuan Kerja Perangkat Daerah/Unit Satuan Kerja Perangkat Daerah pemungut jenis Retribusi sebagaimana dimaksud pada ayat (1) ditetapkan dengan Peraturan Gubernur."^^xsd:string ;
