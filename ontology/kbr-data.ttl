    kbr:diaturDalamPasal kbr:Pasal_PMK_2023_61_BT_64 ;
    kbr:hasRuleId "R-PMK-2023-61-4f247cc679"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2023-61#BT/64"^^xsd:string ;
    kbr:hasSourceQuote "(2) Penanggung Pajak diragukan iktikad baiknya sebagaimana dimaksud pada ayat (1), dalam hal: a. tidak melunasi Utang Pajak baik sekaligus maupun angsuran, walaupun telah diberitahukan Surat Paksa; dan/atau b. menyembunyikan atau memindahtangankan Barang yang dimiliki atau yang dikuasai, termasuk .akan - jdih.kemenkeu.go.id -46- membubarkan Badan, setelah timbulnya Utang Pajak."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2023_61_500b3e611c a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2023_61 ;
