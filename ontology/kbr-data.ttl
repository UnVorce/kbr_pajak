    kbr:hasSourceQuote "c. memberikan kesempatan Direktur Jenderal Pajak untuk mewawancarai pengurus dan/ atau karyawan Wajib Pajak sebagaimana dimaksud pada ayat (2) hurufc;dan d. memberikan tambahan data dan/ atau informasi dalam bentuk bukti, baik berupa dokumen atau keterangan sebagaimana dimaksud pada ayat (2) huruf d."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

