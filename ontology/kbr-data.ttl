    kbr:hasSourceQuote "Dalam hal pembetulan didasarkan atas permohonan Wajib Pajak sebagaimana dimaksud pada ayat (3), Walikota atau Pejabat yang ditunjuk wajib menerbitkan Surat Keputusan Pembetulan sebagaimana dimaksud pada ayat (2) dalam jangka waktu paling lama 6 (enam) bulan sejak tanggal surat permohonan pembetulan diterima."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SURABAYA_2023_7_8cc37282d3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PERDA_KOTA_SURABAYA_2023_7 ;
    kbr:diaturDalamPasal kbr:Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_54 ;
