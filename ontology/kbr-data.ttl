    kbr:hasSourceLocator "PP-2022-15#BT/21#p2"^^xsd:string ;
    kbr:hasSourceQuote "pemegang IUPK sebagai Kelanjutan Operasi Kontrak/ Perjanjian yang izinnya telah diterbitlan sebelum tahun berlakunya Peraturan Pemerintah ini wajib menyetorkan seluruh kewajiban Penerimaan Negara Bukan Pajak ke Kas Negara paling lambat 30 (tiga puluh) hari kalender terhitung sejak tanggal terbit surat ketetapan Penerimaan Negara Bukan Pajak kurang bayar."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2022_15_1e491618b3 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PP_2022_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_15_BT_2 ;
    kbr:hasRuleId "R-PP-2022-15-1e491618b3"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-15#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "Pengaturan dalam Peraturan Pemerintah ini berlaku untuk: a. pemegang IUP; b. pemegang IUPK; c. pemegang IUPK sebagai Kelanjutan Operasi Kontrak/ Perj anj ian; d. pemegang PKP2B yang dalam kontraknya diatur ketentuan kewajiban Pajak Penghasilan berdasarkan PKP2B dimaksud; dan e. pemegang PKP2B yang dalam kontraknya diatur ketentuan kewajiban Pajak Penghasilan sesuai dengan ketentuan peraturan perundang-undangan di bidang Pajak Penghasilan, di bidang Usaha Pertambangan."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

kbr:Aturan_R_PP_2022_15_1fe41c1632 a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_PP_2022_15 ;
    kbr:diaturDalamPasal kbr:Pasal_PP_2022_15_BT_7 ;
    kbr:hasRuleId "R-PP-2022-15-1fe41c1632"^^xsd:string ;
    kbr:hasSourceLocator "PP-2022-15#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal wajib pajak sebagaimana dimaksud dalam Pasal 3 melakukan kegiatan eksplorasi lanjutan pada tahap kegiatan Operasi Produksi, pengeluaran untuk kegiatan tersebut dibebankan sebagai biaya dengan ketentuan: a. memiliki masa manfaat lebih dari 1 (satu) tahun dibebankan melalui penyusutan atau amortisasi; atau b. memiliki masa manfaat kurang dari 1 (satu) tahun dibebankan pada saat terjadinya pengeluaran dimaksud."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

