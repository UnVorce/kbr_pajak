    kbr:hasSourceQuote "(1) Pengusaha Kena Pajak dapat membuat Faktur Pajak pengganti atas Faktur Pajak sebagaimana dimaksud dalam Pasal 386 ayat ( 1) jika terdapat kesalahan dalam pengisian atau penulisan Faktur Pajak sehingga tidak memuat keterangan yang benar, lengkap, danjelas."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
