    kbr:hasSourceQuote "(3) Pelayanan sebagaimana dimaksud pada ayat (2) termasuk pelayanan yang diberikan oleh BLUD."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

