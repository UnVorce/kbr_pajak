    kbr:hasSourceQuote "(2) Pembayaran tunai Pajak Penghasilan Pasal 21 ditanggung pemerintah sebagaimana dimaksud pada ayat (1), tidak diperhitungkan sebagai penghasilan yang dikenakan pajak."^^xsd:string ;
