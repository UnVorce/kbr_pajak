kbr:Aturan_R_PMK_2020_237_1b3b84a77e a kbr:Sanksi ;
    kbr:diaturDalam kbr:Reg_PMK_2020_237 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2020_237_BT_52_4__5 ;
    kbr:hasRuleId "R-PMK-2020-237-1b3b84a77e"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2020-237#BT/52/4..5"^^xsd:string ;
    kbr:hasSourceQuote "Dalam hal barang yang dikeluarkan sementara dari Badan Usaha dan/atau Pelaku Usaha di KEK ke perusahaan di TLDDP tidak dimasukkan kembali ke Badan Usaha dan/atau Pelaku Usaha di KEK dalam jangka waktu yang telah diberitahukan sebagaimana dimaksud pada ayat (2), atas pengeluaran barang tersebut telah terjadi penyerahan Barang Kena Pajak dan: a. jaminan sebagaimana dimaksud pada ayat (5) dicairkan; b. Badan Usaha dan/atau Pelaku Usaha di KEK dikenakan sanksi administrasi sesuai dengan ketentuan peraturan perundang-undangan mengenai sanksi administrasi di bidang kepabeanan; dan c. Badan U saha dan/ a tau Pelaku U saha di KEK wajib memenuhi kewajiban Pajak Pertambahan Nilai sebagaimana dimaksud dala:qi Pasal 24 dan Pasal 25."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_FASILITAS_SEKTOR .

