    kbr:hasSourceLocator "PERDA-PROV-JAWA-BARAT-2023-9#BT/1#p2"^^xsd:string ;
    kbr:hasSourceQuote "Pajak Kendaraan Bermotor yang selanjutnya disebut PKB adalah Pajak atas kepemilikan dan/atau penguasaan kendaraan bermotor."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_6e8d18f5c4 a kbr:Definisi ;
