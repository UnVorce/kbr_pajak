    kbr:hasSourceQuote "Urusan Pemerintahan adalah kekuasaan pemerintahan yang menjadi kewenangan Presiden yang pelaksanaannya dilakukan oleh kementerian negara dan penyelenggara Pemerintahan Daerah unluk melindungi, melayani, memberdayakan, dan menyejahterakan masyarakat."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_C_PBB_HKPD .

kbr:Aturan_R_UU_2022_1_1df02f08ad a kbr:Prosedur ;
    kbr:diaturDalam kbr:Reg_UU_2022_1 ;
