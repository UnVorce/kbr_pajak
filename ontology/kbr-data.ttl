    kbr:hasSourceQuote "a. Pengusaha Kena Pajak Pedagang Emas Perhiasan tidak diperkenankan melakukan penyesuaian besarnya Pajak Pertambahan Nilai yang seharusnya dipungut dengan cara pembetulan atau penggantian Faktur Pajak yang dibuat berdasarkan ketentuan Pasal 13 ayat (Sa) Undang- Undang Pajak Pertambahan Nilai;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

