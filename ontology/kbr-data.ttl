    kbr:hasSourceQuote "b. tidak memproses permohonan, dalam hal permohonan Wajib Pajak tidak dilengkapi informasi sebagaimana dimaksud dalam Pasal 6 ayat (2), tidak dilengkapi dokumen pendukung sebagaimana dimaksud dalam Pasal 6 ayat (4), dan/atau tidak memenuhi ketentuan sebagaimana dimaksud dalam Pasal 6 ayat (5)."^^xsd:string ;
    kbr:hasStatusValidasi "REVIEW_REQUIRED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_B_PPN .

kbr:Aturan_R_PMK_2021_96_e7aff5cf26 a kbr:BatasWaktu ;
