    kbr:hasSourceQuote "(3) Dalam penggunaan Nomor Pokok Wajib Pajak dengan format 16 (enam belas) digit, Direktur Jenderal Pajak menyampaikan permintaan klarifikasi kepada: a. Wajib Pajak orang pribadi bukan Penduduk, berupa: 1. data alamat pos elektronik dan nomor telepon seluler; 2. data alamat tempat tinggal Wajib Pajak berdasarkan keadaan yang sebenarnya; 3. data Klasifikasi Lapangan U saha; dan 4. data unit keluarga; b. Wajib Pajak Badan dan Wajib Pajak Instansi Pemerintah, berupa: 1. data alamat pos elektronik dan nomor telepon seluler; / jdih.kemenkeu.go.id - 9 - 2. data alamat tempat kedudukan Wajib Pajak berdasarkan keadaan yang sebenarnya; dan 3. data Klasifikasi Lapangan Usaha."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2022_112_a38c195de7 a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2022_112 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2022_112_BT_1 ;
    kbr:hasRuleId "R-PMK-2022-112-a38c195de7"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2022-112#BT/1"^^xsd:string ;
    kbr:hasSourceQuote "Wajib Pajak Warisan yang Belum Terbagi Sebagai Satu Kesatuan Menggantikan yang Berhak yang selanjutnya disebut Wajib Pajak Warisan Belum Terbagi adalah Wajib Pajak warisan yang belum terbagi sebagai satu kesatuan menggantikan yang berhak sesuai dengan ketentuan peraturan perundang-undangan di bidang perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2022_112_a91070d05f a kbr:Definisi ;
    kbr:diaturDalam kbr:Reg_PMK_2022_112 ;
    kbr:diaturDalamPasal kbr:Pasal_PMK_2022_112_BT_2 ;
    kbr:hasRuleId "R-PMK-2022-112-a91070d05f"^^xsd:string ;
    kbr:hasSourceLocator "PMK-2022-112#BT/2"^^xsd:string ;
    kbr:hasSourceQuote "(1) Terhitung sejak tanggal 14 Juli 2022: a. Wajib Pajak orang pribadi yang merupakan Penduduk menggunakan Nomor Induk Kependudukan;"^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_D_ADMIN_SANKSI .

kbr:Aturan_R_PMK_2022_112_b1bb0b44cb a kbr:Kewajiban ;
    kbr:diaturDalam kbr:Reg_PMK_2022_112 ;
