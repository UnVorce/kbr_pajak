    kbr:hasSourceLocator "PERDA-KOTA-SEMARANG-2023-10#BT/1#p3"^^xsd:string ;
    kbr:hasSourceQuote "38. Pajak Sarang Burung Walet adalah Pajak atas kegiatan pengambilan dan/atau pengusahaan sarang burung walet."^^xsd:string ;
    kbr:hasStatusValidasi "VALIDATED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

kbr:Aturan_R_PERDA_KOTA_SEMARANG_2023_10_e4380cbe0e a kbr:Prosedur ;
