    kbr:hasSourceQuote "Tarif PBB-P2 sebagaimana dimaksud pada ayat (1) yang berupa lahan produksi pangan dan ternak ditetapkan sebesar 0,25% (nol koma dua lima persen)."^^xsd:string ;
