    kbr:hasSourceLocator "PERDA-KOTA-SURABAYA-2023-7#BT/7"^^xsd:string ;
    kbr:hasSourceQuote "(4) NJOP yang digunakan untuk perhitungan PBB-P2 sebagaimana dimaksud pada ayat (1) ditetapkan paling rendah 20% (dua puluh persen) dan paling tinggi 100% (seratus persen) dari NJOP setelah dikurangi NJOP tidak kena pajak sebagaimana dimaksud pada ayat (3)."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_PERDA_PDRD .

