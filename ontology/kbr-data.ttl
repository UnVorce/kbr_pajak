    kbr:hasSourceQuote "Tarif Pajak Penghasilan yang diterapkan atas penghasilan kena pqiak bagi Wajib Pajak badan dalam negeri dan bentuk usaha tetap sebesar: a. 22% {dua puluh dua persen) yang berlaku pada Tahun Pajak 2020 dan Tahun Pajak 202L; dart b. 22% (dua puluh dua persen) yang mulai berlalnr pada Tahun Pajak 2022, sesuai dengan ketentuan Undang- Undang Nomor 7 Tahun 202L tentang Harmonisasi Peraturan Perpajakan."^^xsd:string ;
    kbr:hasStatusValidasi "HUMAN_FIXED"^^xsd:string ;
    kbr:termasukDomain kbr:Domain_A2_PPH_BADAN .

