  <rdf:type rdf:resource="#AturanTarif"/>
  <diaturDalam rdf:resource="#Reg_PERDA_KOTA_SURABAYA_2023_7"/>
  <diaturDalamPasal rdf:resource="#Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_7"/>
  <hasRuleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PERDA-KOTA-SURABAYA-2023-7-87412c5c55</hasRuleId>
  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-KOTA-SURABAYA-2023-7#BT/7</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(4) NJOP yang digunakan untuk perhitungan PBB-P2 sebagaimana dimaksud pada ayat (1) ditetapkan paling rendah 20% (dua puluh persen) dan paling tinggi 100% (seratus persen) dari NJOP setelah dikurangi NJOP tidak kena pajak sebagaimana dimaksud pada ayat (3).</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Angka 20% dan 100% sesuai teks, tetapi bukan tarif pajak melainkan batas paling rendah dan paling tinggi persentase NJOP untuk perhitungan PBB-P2 setelah dikurangi NJOP tidak kena pajak; perlu kejelasan subjek dan kondisi.</hasCatatanMKSEMA>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Aturan_R_PERDA_KOTA_SURABAYA_2023_7_2572d5ea34">
  <rdf:type rdf:resource="#AturanTarif"/>
  <diaturDalam rdf:resource="#Reg_PERDA_KOTA_SURABAYA_2023_7"/>
  <diaturDalamPasal rdf:resource="#Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_13"/>
  <hasRuleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PERDA-KOTA-SURABAYA-2023-7-2572d5ea34</hasRuleId>
  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-KOTA-SURABAYA-2023-7#BT/13</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(5) Besarnya nilai perolehan objek pajak tidak kena pajak ditetapkan sebesar Rp 90.000.000,00 (sembilan puluh juta rupiah) untuk perolehan hak pertama Wajib Pajak di wilayah Daerah tempat terutangnya BPHTB.</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Nominal NPOPTKP Rp90.000.000,00 benar, namun syarat perolehan hak pertama Wajib Pajak perlu dicantumkan pada condition agar terbedakan dari NPOPTKP waris/hibah wasiat pada ayat (6).</hasCatatanMKSEMA>
</owl:NamedIndividual>

