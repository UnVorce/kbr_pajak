  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Nominal denda Rp225.000,00 untuk keterlambatan 6–9 bulan benar, tetapi rule_type harus sanction, kondisi jenis pajak PBJT serta pengecualian keadaan kahar belum dicantumkan.</hasCatatanMKSEMA>
</owl:NamedIndividual>

