<owl:NamedIndividual rdf:about="#Aturan_R_PERDA_KOTA_SURABAYA_2023_7_7758b066bb">
  <rdf:type rdf:resource="#AturanTarif"/>
  <diaturDalam rdf:resource="#Reg_PERDA_KOTA_SURABAYA_2023_7"/>
  <diaturDalamPasal rdf:resource="#Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_172"/>
  <hasRuleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PERDA-KOTA-SURABAYA-2023-7-7758b066bb</hasRuleId>
  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-KOTA-SURABAYA-2023-7#BT/172</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(1) Dalam hal permohonan banding dikabulkan sebagian atau seluruhnya, kelebihan pembayaran Pajak dikembalikan dengan ditambah imbalan bunga sebesar 0,6% (nol koma enam persen) per bulan dihitung dari Pajak yang lebih dibayar untuk jangka waktu paling lama 24 (dua puluh empat) bulan serta bagian dari bulan dihitung penuh 1 (satu) bulan.</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Satuan pada 0,6% kurang 'per bulan', serta jangka waktu maksimal 24 bulan dan pembulatan 1 bulan ikut masuk ke rate_or_value; subjek perlu ditegaskan sebagai imbalan bunga kelebihan pembayaran Pajak atas banding.</hasCatatanMKSEMA>
</owl:NamedIndividual>

