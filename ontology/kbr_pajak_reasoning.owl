<owl:Ontology rdf:about="http://www.semanticweb.org/ontology/kbr_pajak"/>

<owl:ObjectProperty rdf:about="#diaturDalam">
  <rdfs:domain rdf:resource="#AturanHukum"/>
  <rdfs:range rdf:resource="#Regulasi"/>
  <owl:inverseOf rdf:resource="#mengatur"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#diaturDalamPasal"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#bagianDariRegulasi"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mengatur">
  <rdfs:domain rdf:resource="#Regulasi"/>
  <rdfs:range rdf:resource="#AturanHukum"/>
  <owl:inverseOf rdf:resource="#diaturDalam"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#diaturDalamPasal">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="#AturanHukum"/>
  <rdfs:range rdf:resource="#Pasal"/>
  <owl:inverseOf rdf:resource="#memuatAturan"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#memuatAturan">
  <rdfs:domain rdf:resource="#Pasal"/>
