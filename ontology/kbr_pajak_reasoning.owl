<owl:NamedIndividual rdf:about="#Aturan_R_PERDA_KOTA_SURABAYA_2023_7_3bca86b988">
  <rdf:type rdf:resource="#AturanTarif"/>
  <diaturDalam rdf:resource="#Reg_PERDA_KOTA_SURABAYA_2023_7"/>
  <diaturDalamPasal rdf:resource="#Pasal_PERDA_KOTA_SURABAYA_2023_7_BT_167"/>
  <hasRuleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PERDA-KOTA-SURABAYA-2023-7-3bca86b988</hasRuleId>
  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-KOTA-SURABAYA-2023-7#BT/167</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dalam hal pengajuan keberatan Pajak dikabulkan sebagian atau seluruhnya, kelebihan pembayaran Pajak dikembalikan dengan ditambah imbalan bunga sebesar 0,6% (nol koma enam persen) per bulan dihitung dari Pajak yang lebih dibayar untuk jangka waktu paling lama 24 (dua puluh empat) bulan serta bagian dari bulan dihitung penuh 1 (satu) bulan.</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Besaran imbalan bunga 0,6% sesuai teks, tetapi satuan dan raw kehilangan keterangan 'per bulan' serta subjek perlu ditegaskan sebagai imbalan bunga kelebihan pembayaran Pajak atas keberatan.</hasCatatanMKSEMA>
</owl:NamedIndividual>

