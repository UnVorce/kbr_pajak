  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">umur kendaraan diatas 5 tahun sampai dengan 10 tahun, sebesar 10% (sepuluh persen) dari hasil perkalian 40% (empat puluh persen) dari NJKB;</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Angka 10% dan 40% sesuai teks, namun subject belum ada, condition kurang batas atas &lt;= 10 tahun, dan belum mencantumkan cakupan kendaraan Ex Dump.</hasCatatanMKSEMA>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_24c4eec1ab">
  <rdf:type rdf:resource="#AturanTarif"/>
