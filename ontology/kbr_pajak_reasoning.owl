  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-KOTA-SURABAYA-2023-7#BT/7</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(2) NJOP tidak kena pajak ditetapkan sebesar Rp15.000.000,00 (lima belas juta rupiah) untuk setiap Wajib Pajak.</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Nominal Rp15.000.000,00 akurat, tetapi merupakan NJOP tidak kena pajak (NJOPTKP) PBB-P2 dan belum memuat subjek maupun batasan hanya untuk salah satu objek per Tahun Pajak bila Wajib Pajak menguasai lebih dari satu objek.</hasCatatanMKSEMA>
</owl:NamedIndividual>

