<owl:NamedIndividual rdf:about="#Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_d7213ad994">
  <rdf:type rdf:resource="#AturanTarif"/>
  <diaturDalam rdf:resource="#Reg_PERDA_PROV_JAWA_BARAT_2023_9"/>
  <diaturDalamPasal rdf:resource="#Pasal_PERDA_PROV_JAWA_BARAT_2023_9_BT_7"/>
