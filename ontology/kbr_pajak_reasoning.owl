        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasNilaiInvestasi"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1000000000000.0</xsd:maxExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <rdf:Description>
                          <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">500000000000.0</xsd:minInclusive>
                        </rdf:Description>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
