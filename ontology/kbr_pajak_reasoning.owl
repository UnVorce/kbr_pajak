  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-PROV-JAWA-BARAT-2023-9#BT/14</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">umur kendaraan di atas 10 tahun, sebesar 10% (sepuluh persen) dari hasil perkalian 20% (dua puluh persen) dari NJKB.</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Angka tarif 10% dan 20% sesuai teks, namun subject belum ada dan condition terlalu luas karena tidak mencantumkan cakupan kendaraan Ex Dump yang belum dikenakan BBNKB atas penyerahan pertama.</hasCatatanMKSEMA>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Aturan_R_PERDA_PROV_JAWA_BARAT_2023_9_90d8d8acd6">
