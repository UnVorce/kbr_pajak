  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-KOTA-SURABAYA-2023-7#BT/179</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Besaran pokok Opsen PKB dan Opsen BBNKB yang terutang dihitung dengan cara mengalikan tarif Pajak sebesar 66% (enam puluh enam persen) dengan dasar pengenaan Pajak sebagaimana dimaksud dalam Pasal 44 ayat (1) dan Pasal 47 ayat (1).</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_APPROVED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Tarif Opsen PKB dan Opsen BBNKB sebesar 66% sesuai teks Pasal 179 ayat (3), tipe 'rate' tepat.</hasCatatanMKSEMA>
</owl:NamedIndividual>

