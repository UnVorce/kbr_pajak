  <diaturDalamPasal rdf:resource="#Pasal_PERDA_KOTA_SEMARANG_2023_10_BT_99"/>
  <hasRuleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PERDA-KOTA-SEMARANG-2023-10-9a7aca53cf</hasRuleId>
  <hasSourceLocator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERDA-KOTA-SEMARANG-2023-10#BT/99</hasSourceLocator>
  <hasSourceQuote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Besaran sanksi administrasi berupa denda sebagaimana dimaksud pada ayat (3) ditetapkan sebesar Rp100.000,00 (seratus ribu rupiah) untuk wajib pajak perorangan dan Rp250.000,00 (dua ratus lima puluh ribu rupiah) untuk wajib pajak berbentuk badan.</hasSourceQuote>
  <hasStatusValidasi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HUMAN_FIXED</hasStatusValidasi>
  <hasCatatanMKSEMA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[LLM-preaudit hydrogen-4-hi] Aturan merupakan denda administratif atas kelalaian pelaporan SPTPD (rule_type harus sanction), kondisi harus merujuk kewajiban pelaporan SPTPD, serta pengecualian keadaan kahar pada ayat (6) belum tercatat.</hasCatatanMKSEMA>
</owl:NamedIndividual>

