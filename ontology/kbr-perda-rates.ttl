    kbr:hasDocumentId "PERDA-KOTA-SAWAH-LUNTO-2024-1"^^xsd:string ;
    kbr:hasJenisPajakDaerah "NJOPTKP"^^xsd:string ;
    kbr:hasNominalRupiah 10000000.0 ;
    kbr:hasSourceLocator "PERDA-KOTA-SAWAH-LUNTO-2024-1#BT/6/1"^^xsd:string ;
    kbr:hasSourceQuote "ditetapkan berdasarkan proses penilaian PBB-P2. NJOP sebagaimana dimaksud pada ayat (1) ditetapkan setiap 3 (tiga) tahun, kecuali untuk objek Pajak tertentu dapat ditetapkan setiap tahun sesuai dengan perkembangan wilayah Daerah. Besaran NJOP ditetapkan oleh Wali Kota. NJOP tidak kena pajak ditetapkan sebesar Rp10.000.000,00 (sepuluh juta rupiah) untuk setiap Wajib Pajak. Dalam hal Wajib Pajak memiliki atau menguasai lebih dari satu objek PBB-P2 "^^xsd:string ;
    kbr:isPerdaPerubahan false ;
    kbr:untukPemda kbr:Pemda_KOTA_SAWAHLUNTO .

