                        owl:onProperty :hasNilaiInvestasi ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxExclusive 5000000000000.0 ] [ xsd:minInclusive 1000000000000.0 ] ) ] ] ) ] .

:LayakTaxHoliday_50Pct_5Thn a owl:Class ;
    rdfs:subClassOf :LayakTaxHoliday ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Badan [ a owl:Restriction ;
                        owl:hasValue true ;
