            owl:unionOf ( :OrangPribadi :Badan ) ] .

:TarifProgresif a owl:Class ;
    rdfs:subClassOf :TarifPajak ;
    owl:disjointWith :TarifFinal .

:UMKM a owl:Class ;
    rdfs:subClassOf :WajibPajak .

:WajibPajakNonUMKM a owl:Class ;
