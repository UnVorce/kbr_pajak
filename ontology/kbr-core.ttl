:BadanTerbukaTbk a owl:Class ;
    rdfs:subClassOf :Badan ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Badan [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isPerseroanTerbuka ] [ a owl:Restriction ;
                        owl:onProperty :hasPersentaseSahamPublik ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 40.0 ] ) ] ] ) ] .

:BadanUsahaTetap a owl:Class ;
    rdfs:subClassOf :Badan .

