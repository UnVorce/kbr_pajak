:WajibPajakUMKM a owl:Class ;
    rdfs:subClassOf :WajibPajak ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :WajibPajak [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isUMKM_PP55 ] [ a owl:Restriction ;
                        owl:onProperty :hasOmzetTahunan ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxInclusive 4800000000.0 ] ) ] ] ) ] .

:bagianDariRegulasi a owl:ObjectProperty ;
    rdfs:domain :Pasal ;
    rdfs:range :Regulasi ;
    owl:inverseOf :memilikiPasal .

:diaturDalam a owl:ObjectProperty ;
    rdfs:domain :AturanHukum ;
    rdfs:range :Regulasi ;
    owl:inverseOf :mengatur .

:didasarkanPadaAturan a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range :AturanHukum .

:hasPersentaseSahamPublik a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Badan ;
    rdfs:range xsd:decimal .

:isPerseroanTerbuka a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Badan ;
    rdfs:range xsd:boolean .

:isUMKM_PP55 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:boolean .

:memilikiPasal a owl:ObjectProperty ;
    rdfs:domain :Regulasi ;
    rdfs:range :Pasal ;
    owl:inverseOf :bagianDariRegulasi .

:memuatAturan a owl:ObjectProperty ;
    rdfs:domain :Pasal ;
    rdfs:range :AturanHukum ;
    owl:inverseOf :diaturDalamPasal .

:mengatur a owl:ObjectProperty ;
    rdfs:domain :Regulasi ;
    rdfs:range :AturanHukum ;
    owl:inverseOf :diaturDalam .

:KewajibanPajak a owl:Class ;
    rdfs:subClassOf owl:Thing .

:PutusanMK a owl:Class ;
    rdfs:subClassOf :DokumenHukum .

:SEMA_TUN a owl:Class ;
    rdfs:subClassOf :DokumenHukum .

:SanksiAdministratif a owl:Class ;
    rdfs:subClassOf owl:Thing .

:diaturDalamPasal a owl:ObjectProperty ;
    rdfs:domain :AturanHukum ;
    rdfs:range :Pasal ;
    owl:inverseOf :memuatAturan .

:hasOmzetTahunan a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:decimal .

