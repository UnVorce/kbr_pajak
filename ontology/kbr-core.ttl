:JenisPekerjaan a owl:Class ;
    rdfs:subClassOf owl:Thing .

:OP_PelakuUsahaNonProfesi a owl:Class ;
    rdfs:subClassOf :OrangPribadi ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OrangPribadi [ a owl:Restriction ;
                        owl:onProperty :memilikiPekerjaan ;
                        owl:someValuesFrom :UsahaDagangJasa ] ) ] .

:OP_PemilikKendaraanDKI a owl:Class ;
    rdfs:subClassOf :OrangPribadi .

:TarifPajak a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AturanHukum ;
            owl:onProperty :didasarkanPadaAturan ],
        owl:Thing .

:berdomisiliDi a owl:ObjectProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range :WilayahDaerah .

:hasJumlahTanggungan a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :OrangPribadi ;
    rdfs:range xsd:integer .

:hasPenghasilanKenaPajakTahunan a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:decimal .

:isKawin a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :OrangPribadi ;
    rdfs:range xsd:boolean .

:memilikiPekerjaan a owl:ObjectProperty ;
    rdfs:domain :OrangPribadi ;
    rdfs:range :JenisPekerjaan .

:LayakTaxHoliday a owl:Class ;
    rdfs:subClassOf :BadanDalamNegeri .

:Pasal a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Regulasi ;
            owl:onProperty :bagianDariRegulasi ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :DokumenHukum .

:WP_Wilayah_DKI a owl:Class ;
    rdfs:subClassOf :WajibPajak ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :WajibPajak [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:hasValue :Wilayah_DKI_Jakarta ;
                                    owl:onProperty :berdomisiliDi ] [ a owl:Restriction ;
                                    owl:hasValue true ;
                                    owl:onProperty :isDomisiliDKI ] ) ] ) ] .

:hasNilaiInvestasi a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:decimal .

:hasNilaiNJOP a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:decimal .

:hasSuratKeteranganFiskal a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Badan ;
    rdfs:range xsd:boolean .

:isBelumPernahPutusTaxHoliday a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Badan ;
    rdfs:range xsd:boolean .

:isIndustriPionir a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Badan ;
    rdfs:range xsd:boolean .

:isMemilikiObjekPBB a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:boolean .

:WP_Wilayah_Jabar a owl:Class ;
    rdfs:subClassOf :WajibPajak ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :WajibPajak [ a owl:Restriction ;
                        owl:hasValue :Wilayah_Jawa_Barat ;
                        owl:onProperty :berdomisiliDi ] ) ] .

:WP_Wilayah_Surabaya a owl:Class ;
    rdfs:subClassOf :WajibPajak ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :WajibPajak [ a owl:Restriction ;
                        owl:hasValue :Wilayah_Kota_Surabaya ;
                        owl:onProperty :berdomisiliDi ] ) ] .

:WilayahDaerah a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :Wilayah_DKI_Jakarta :Wilayah_Jawa_Barat :Wilayah_Kota_Surabaya :Wilayah_Kota_Semarang :Wilayah_Prov_Bali ) ] .

:hasOmzetTahunan a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:decimal .

:BadanHukumIndonesia a owl:Class ;
    rdfs:subClassOf :BadanDalamNegeri .

:DokumenHukum a owl:Class ;
    rdfs:subClassOf owl:Thing .

:OP_PenerimaPPh21_PegawaiTetap a owl:Class ;
    rdfs:subClassOf :OrangPribadi ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OrangPribadi [ a owl:Restriction ;
                        owl:onProperty :memilikiPekerjaan ;
                        owl:someValuesFrom :PekerjaanPegawaiTetap ] ) ] .

:isPenanamanModalBaru a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Badan ;
    rdfs:range xsd:boolean .

:isMilikPribadi a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:boolean .

:DomainPajak a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :Domain_A2_PPhBadan :Domain_B_PPN :Domain_C_PBB_HKPD :Domain_D_AdminSanksi :Domain_Perda_PDRD :Domain_Fasilitas_Sektor :Domain_Kepabeanan_Cukai :Domain_PPh_OP_Potput :Domain_PPh_Final_Sektor ) ] .

:Regulasi a owl:Class ;
    rdfs:subClassOf :DokumenHukum .

:BadanDalamNegeri a owl:Class ;
    rdfs:subClassOf :Badan ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Badan [ a owl:Class ;
                        owl:complementOf :BadanUsahaTetap ] ) ] .

:hasJumlahKendaraan a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WajibPajak ;
    rdfs:range xsd:integer .

:Badan a owl:Class ;
    rdfs:subClassOf :WajibPajak .

:AturanHukum a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Pasal ;
            owl:onProperty :diaturDalamPasal ],
        owl:Thing .

:OrangPribadi a owl:Class ;
    rdfs:subClassOf :WajibPajak ;
    owl:disjointWith :Badan .

:WajibPajak a owl:Class ;
    rdfs:subClassOf owl:Thing .

[] a owl:AllDisjointClasses ;
    owl:members ( :PekerjaanPegawai :PekerjaanBebas :UsahaDagangJasa ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Kewajiban :Hak :Larangan ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :WajibPajak :JenisPekerjaan :WilayahDaerah :Regulasi :Pasal :AturanHukum :TarifPajak :FasilitasPerpajakan :KewajibanPajak :SanksiAdministratif :DomainPajak ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :OP_TER_Kategori_A :OP_TER_Kategori_B :OP_TER_Kategori_C ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :UndangUndang :PeraturanPemerintah :PeraturanMenteriKeuangan :PeraturanDirjenPajak :PeraturanDaerah ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :PT :CV :Koperasi :Yayasan :BadanUsahaTetap ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :PekerjaanPegawaiTetap :PekerjaanPegawaiTidakTetap :PekerjaanPesertaKegiatan ) .

