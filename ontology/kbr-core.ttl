:OP_KendaraanKe5Plus_DKI a owl:Class ;
    rdfs:subClassOf :OP_PemilikKendaraanDKI ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OrangPribadi [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isDomisiliDKI ] [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isMilikPribadi ] [ a owl:Restriction ;
                        owl:onProperty :hasJumlahKendaraan ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 5 ] ) ] ] ) ] .

:ObjekPajak a owl:Class ;
