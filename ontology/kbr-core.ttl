@prefix : <http://www.semanticweb.org/ontology/kbr_pajak#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/ontology/kbr_pajak> a owl:Ontology .

:AturanTarif a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :AturanHukum ;
            owl:onProperty :didasarkanPadaAturan ],
        :AturanHukum .

:BUT a owl:Class ;
    rdfs:subClassOf :BadanUsahaTetap .

:BadanNonTbk a owl:Class ;
    rdfs:subClassOf :Badan ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Badan [ a owl:Class ;
                        owl:complementOf :BadanTerbukaTbk ] ) ] .

:BatasWaktu a owl:Class ;
    rdfs:subClassOf :AturanHukum .

:CV a owl:Class ;
    rdfs:subClassOf :Badan .

:Definisi a owl:Class ;
