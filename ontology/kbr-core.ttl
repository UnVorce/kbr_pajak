:LayakTaxHoliday_100Pct_10Thn a owl:Class ;
    rdfs:subClassOf :LayakTaxHoliday ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Badan [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isIndustriPionir ] [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isPenanamanModalBaru ] [ a owl:Restriction ;
                        owl:onProperty :hasNilaiInvestasi ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxExclusive 15000000000000.0 ] [ xsd:minInclusive 5000000000000.0 ] ) ] ] ) ] .

