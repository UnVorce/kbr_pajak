:BadanLayakPadatKarya a owl:Class ;
    rdfs:subClassOf :BadanDalamNegeri ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :BadanDalamNegeri [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isIndustriPadatKarya ] [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty :isPenanamanModalBaru ] ) ] .

:BadanLayakPasal31E a owl:Class ;
    rdfs:subClassOf :BadanDalamNegeri ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :BadanDalamNegeri [ a owl:Class ;
                        owl:complementOf :BadanUMKM ] [ a owl:Restriction ;
                        owl:onProperty :hasOmzetTahunan ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxInclusive 50000000000.0 ] ) ] ] ) ] .

