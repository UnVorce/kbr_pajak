# Salin menjadi `.env` lalu sesuaikan. Jangan commit berkas `.env` yang berisi nilai produksi.

# Port host untuk API (default 8000) dan untuk nginx opsional (default 8080).
KBR_API_PORT=8000
KBR_EDGE_PORT=8080

# Origin frontend yang diizinkan, dipisah koma. Gunakan `*` hanya untuk development.
# Contoh produksi: https://yoeke.example.ac.id,https://app.example.ac.id
KBR_CORS_ORIGINS=*

# Jumlah worker uvicorn. 1 worker = 1 reasoning HermiT pada satu waktu (~5,5 s/request).
# Ukur RAM dulu: setiap worker memuat graf RDF (~60-120 MB) + spike JVM per request.
KBR_WORKERS=2

# Batas memori container API.
KBR_MEMORY_LIMIT=4g
