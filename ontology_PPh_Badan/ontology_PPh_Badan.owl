    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#nonDeductibleExpenses"/>
        <NamedIndividual IRI="#CV_Perdagangan_003"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">10000000</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#isPubliclyTraded"/>
        <NamedIndividual IRI="#CV_Perdagangan_003"/>
